{
    "name": "elas-no-congresso",
    "type": "module",
    "version": "0.0.1",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro",
        "knip": "knip",
        "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
        "pretest:coverage": "node -e \"require('node:fs').mkdirSync('reports', { recursive: true })\"",
        "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-coverage-exclude=\"src/**/*.test.ts\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=reports/coverage.lcov --test \"src/**/*.test.ts\"",
        "test:build": "node --test tests/build.test.mjs",
        "check:assets": "node scripts/check-assets.mjs",
        "check": "npm run check:types && npm run knip && npm run check:assets && npm test",
        "check:types": "astro check"
    },
    "dependencies": {
        "@astrojs/react": "7.0.1",
        "@astrojs/sitemap": "3.7.4",
        "@base-ui/react": "^1.8.0",
        "@tailwindcss/vite": "^4.2.3",
        "astro": "7.3.8",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tailwindcss": "^4.2.3"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "esbuild": "^0.28.2",
        "knip": "^6.40.0",
        "sharp": "^0.35.1",
        "typescript": "^5.9.3"
    }
}
