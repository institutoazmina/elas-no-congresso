---
import { url } from "../lib/url";
import Expediente from "./Expediente.astro";
---

<footer>
    <article class="container-fluid wrap">
        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-3 mb2">
                <a href={url()} class="logo-footer"></a>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-3 mb3">
                <nav class="nav-rodape">
                    <ul>
                        <li>
                            <a href={url("propostas-e-votacoes")}>Propostas</a>
                        </li>
                        <li><a href={url("acompanhe")}>Reportagens</a></li>
                        <li><a href={url("quiteria")}>Quitéria</a></li>
                        <li><a href={url("newsletter")}>Newsletter</a></li>
                        <li><a href={url("apoiadores")}>Apoiadores</a></li>
                        <li><a href={url("metodologia")}>Sobre</a></li>
                    </ul>
                </nav>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-3">
                <a
                    href="https://elasnocongresso.substack.com/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mb2 block"
                >
                    <div
                        class="tw:bg-white tw:px-4 tw:py-3 tw:shadow-lg tw:z-10 bgam tw:text-center tw:cursor-pointer tw:rounded-xs tw:duration-75 tw:hover:!bg-[#def279]"
                    >
                        <p class="tw:!mb-0 tw:uppercase ff1">
                            Assine nossa <span class="tw:font-black"
                                >newsletter</span
                            >
                        </p>
                        <p class="tw:text-xs tw:!mb-0">
                            Acompanhe o debate de gênero no Congresso
                        </p>
                    </div>
                </a>
                <div class="mb2">
                    <p class="t2 w600 tcb uc ls1">Siga AzMina</p>
                    <ul class="flex">
                        <li>
                            <a
                                href="https://instagram.com/revistaazmina"
                                target="_blank"
                                class="instagram"></a>
                        </li>
                        <li>
                            <a
                                href="https://www.tiktok.com/@revistaazmina"
                                target="_blank"
                                class="tiktok"></a>
                        </li>
                        <li>
                            <a
                                href="https://substack.com/@institutoazmina"
                                target="_blank"
                                class="substack"></a>
                        </li>
                        <li>
                            <a
                                href="https://www.youtube.com/channel/UCoyYnOCs_pr0oaXSitYi35g"
                                target="_blank"
                                class="youtube"></a>
                        </li>
                        <li>
                            <a
                                href="https://github.com/revistaazmina/"
                                target="_blank"
                                class="github"></a>
                        </li>
                        <li>
                            <a
                                href="https://bsky.app/profile/revistaazmina.bsky.social"
                                target="_blank"
                                class="bluesky"></a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-3">
                <Expediente />
            </div>
        </div>
    </article>
</footer>
