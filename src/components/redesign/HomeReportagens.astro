---
import chevronRight from "../../assets/images/redesign/home-reportagens/chevron-right.svg";
import cuttingMatPattern from "../../assets/images/redesign/home-reportagens/bg-pattern-cutting-mat.svg";
import { fetchReportagens } from "../../lib/wp";

const reports = await fetchReportagens(1988, 3);

function formatDate(date: string) {
    return new Intl.DateTimeFormat("pt-BR", {
        day: "numeric",
        month: "long",
        year: "numeric",
        timeZone: "UTC",
    }).format(new Date(`${date}Z`));
}
---

<section class="tw:overflow-hidden tw:bg-[#0B0F5E] tw:py-12 tw:text-white tw:lg:py-24" style={`background-image: url('${cuttingMatPattern.src}'); background-position: center top; background-repeat: repeat; background-size: 200px 200px;`} aria-labelledby="home-reportagens-title">
    <header class="tw:mx-auto tw:flex tw:w-full tw:max-w-[720px] tw:flex-col tw:items-center tw:px-[15px] tw:text-center tw:lg:h-[62px] tw:lg:px-0">
        <h2 id="home-reportagens-title" class="tw:m-0 tw:font-[ETC_Anybody] tw:text-[32px] tw:font-bold tw:leading-8 tw:uppercase tw:[font-variation-settings:'wdth'_75]">
            Reportagens
        </h2>
        <p class="tw:m-0 tw:mt-[6px] tw:font-[Plus_Jakarta_Sans] tw:text-[18px] tw:font-normal tw:leading-6">
            O que os dados do Elas no Congresso revelam sobre o que está em disputa no Congresso e na vida das mulheres
        </p>
    </header>

    <div class="tw:mt-10 tw:overflow-x-auto tw:overflow-y-hidden tw:px-[15px] tw:lg:mt-2.5 tw:lg:overflow-hidden tw:lg:px-12 tw:lg:pt-12" aria-label="Lista de reportagens em destaque">
        <div class="tw:flex tw:w-max tw:justify-start tw:gap-4 tw:pb-2 tw:lg:w-full tw:lg:justify-center-safe tw:lg:gap-12 tw:lg:pb-0">
            {reports.map((report) => {
                const image = report._embedded?.["wp:featuredmedia"]?.[0];
                const imageUrl = image && new URL(image.source_url ?? image.link, report.link).href;
                const date = report.modified || report.date;

                return (
                <article class="tw:flex tw:w-[min(384px,calc(100vw-72px))] tw:shrink-0 tw:flex-col tw:gap-4 tw:lg:w-96">
                    <a href={report.link} class="home-reportagem-image-link tw:block tw:w-full" aria-label={`Ler: ${report.title.rendered.replace(/<[^>]*>/g, "").trim()}`}>
                        <figure class="tw:m-0 tw:w-full tw:border-2 tw:border-[#4242F6]">
                            {imageUrl && <img class="tw:block tw:aspect-[384/216] tw:w-full tw:object-cover" src={imageUrl} alt={image?.alt_text ?? ""} loading="lazy" decoding="async" />}
                        </figure>
                    </a>
                    <h3 class="tw:m-0 tw:font-[ETC_Anybody] tw:text-[24px] tw:font-bold tw:leading-8 tw:uppercase tw:[font-variation-settings:'wdth'_75]">
                        <a href={report.link} class="home-reportagem-title-link" aria-label={`Ler: ${report.title.rendered.replace(/<[^>]*>/g, "").trim()}`}>
                            <Fragment set:html={report.title.rendered} />
                        </a>
                    </h3>
                    <div class="tw:mt-auto tw:flex tw:h-[70px] tw:flex-col tw:items-start tw:gap-4">
                        <a class="tw:flex tw:h-[38px] tw:items-center tw:gap-2 tw:bg-[#4242F6] tw:pb-1.5 tw:pl-[14px] tw:pr-3 tw:pt-2 tw:font-[ETC_Anybody] tw:text-[18px] tw:font-bold tw:leading-6 tw:uppercase tw:[font-variation-settings:'wdth'_75]" href={report.link}>
                            <span>Ler reportagem</span>
                            <span class="tw:flex tw:h-6 tw:w-3 tw:items-center tw:justify-end" aria-hidden="true">
                                <img class="tw:h-[6px] tw:w-3 tw:rotate-[-90deg]" src={chevronRight.src} alt="" />
                            </span>
                        </a>
                        <time datetime={date} class="tw:font-[Plus_Jakarta_Sans] tw:text-[14px] tw:font-normal tw:leading-4">Atualizada em {formatDate(date)}</time>
                    </div>
                </article>
                );
            })}
        </div>
    </div>
</section>

<style>
    .home-reportagem-image-link { display: block; cursor: pointer; }
    .home-reportagem-title-link { color: inherit; text-decoration: none; }
    .home-reportagem-title-link:hover { color: inherit; text-decoration: none; }
    .home-reportagem-title-link:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
    @media (max-width: 767px) {
        section[aria-labelledby="home-reportagens-title"] > header {
            align-items: flex-start;
            text-align: left;
        }

        section[aria-labelledby="home-reportagens-title"] > header > h2,
        section[aria-labelledby="home-reportagens-title"] > header > p {
            margin-left: 0;
            margin-right: 0;
            text-align: left;
        }
    }
</style>
