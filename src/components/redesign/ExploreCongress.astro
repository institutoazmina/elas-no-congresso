---
import pattern from "../../assets/images/redesign/explore/bg-pattern-cutting-mat.svg";
import chevron from "../../assets/images/redesign/explore/form-button-chevron.svg";
import screenTool from "../../assets/images/redesign/explore/screen-tool-@3x.png";
---

<section class="explore-congress" aria-labelledby="explore-congress-title" style={`--explore-pattern: url(${pattern.src})`}>
    <div class="explore-congress__content">
        <h2 id="explore-congress-title">Explore</h2>
        <p class="explore-congress__subtitle">Quer saber mais sobre o que tá tramitando sobre<br />pautas de gênero, raça e LGBTQIAPN+?</p>
        <div class="explore-congress__screen-wrap">
            <img class="explore-congress__screen" src={screenTool.src} alt="" />
        </div>
        <a class="explore-congress__button" href="/atividade-legislativa">Explore a produção do Congresso <img src={chevron.src} alt="" /></a>
    </div>
</section>

<style>
    .explore-congress {
        box-sizing: border-box;
        display: flex;
        width: 100%;
        min-height: 684px;
        height: auto;
        margin-top: 48px;
        padding: 96px 24px;
        align-items: center;
        justify-content: center;
        overflow: clip;
        background-color: #0b0f5e;
        box-shadow: 0 -48px 0 #fff;
        background-image: var(--explore-pattern);
        background-repeat: repeat;
        background-position: center top;
        background-size: 200px 200px;
    }

    .explore-congress *,
    .explore-congress *::before,
    .explore-congress *::after { box-sizing: border-box; }

    .explore-congress__content {
        display: flex;
        width: 100%;
        height: auto;
        min-width: 0;
        flex-direction: column;
        align-items: center;
        gap: 16px;
    }

    .explore-congress h2,
    .explore-congress p { margin: 0; }

    .explore-congress h2 {
        width: 99px;
        height: 22px;
        color: #fff;
        font-family: "ETC Anybody", sans-serif;
        font-size: 32px;
        font-weight: 700;
        font-variation-settings: "wdth" 75;
        line-height: 32px;
        text-align: center;
        text-transform: uppercase;
    }

    .explore-congress__subtitle {
        width: 100%;
        height: auto;
        color: #fff;
        font-family: "Plus Jakarta Sans", sans-serif;
        font-size: 18px;
        font-weight: 400;
        line-height: 24px;
        text-align: center;
    }

    .explore-congress__screen-wrap {
        display: flex;
        width: 100%;
        max-width: 720px;
        height: auto;
        padding: 24px 0;
        align-items: flex-start;
        justify-content: center;
    }

    .explore-congress__screen {
        display: block;
        width: 100%;
        height: auto;
        flex: none;
        border: 2px solid #4242f6;
        border-radius: 16px;
        background: #fff;
    }

    .explore-congress__button {
        display: flex;
        width: 100%;
        max-width: 340px;
        height: 56px;
        margin: 0;
        padding: 18px 24px 14px;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: 0;
        border-radius: 0;
        background: #4242f6;
        color: #fff;
        font-family: "ETC Anybody", sans-serif;
        font-size: 20px;
        font-weight: 700;
        font-variation-settings: "wdth" 75;
        line-height: 24px;
        text-align: left;
        text-transform: uppercase;
        cursor: pointer;
        text-decoration: none;
    }

    .explore-congress__button img {
        display: block;
        width: 13.4142px;
        height: 8.12132px;
        transform: rotate(-90deg);
    }
    .explore-congress__button:hover { background: #0b0f5e; outline: 1px solid #fff; }
    .explore-congress__button:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }

    @media (max-width: 767px) {
        .explore-congress {
            width: 100%;
            min-height: 0;
            padding: 52px 24px;
            align-items: flex-start;
            justify-content: flex-start;
        }

        .explore-congress__content {
            align-items: flex-start;
        }

        .explore-congress h2 {
            width: auto;
            height: auto;
            font-size: 28px;
            line-height: 32px;
            text-align: left;
        }

        .explore-congress__subtitle {
            max-width: 100%;
            font-size: 17px;
            line-height: 24px;
            text-align: left;
        }

        .explore-congress__screen-wrap {
            justify-content: flex-start;
        }

        .explore-congress__button {
            width: max-content;
            max-width: 100%;
            align-self: flex-start;
            justify-content: flex-start;
            font-size: 16px;
            white-space: nowrap;
        }
    }

    @media (min-width: 768px) {
        .explore-congress {
            padding: 96px max(24px, calc((100vw - 720px) / 2));
        }

        .explore-congress__content {
            width: 720px;
            min-width: 720px;
        }

        .explore-congress__subtitle {
            width: 720px;
            height: 48px;
        }

        .explore-congress__screen-wrap {
            width: 720px;
        }

        .explore-congress__button {
            width: 340px;
            max-width: none;
        }
    }
</style>
