---
import attention from "../../assets/images/redesign/party-chart/attention.svg";
import documentImage from "../../assets/images/redesign/hero/proposicao-9.png";
import backgroundPattern from "../../assets/images/redesign/parliamentarians/bg-pattern.svg";
import halftoneShadow from "../../assets/images/redesign/hero/halftone-shadow.png";
import thumbBase from "../../assets/images/redesign/party-chart/thumbs-down-base.svg";
import thumb from "../../assets/images/redesign/party-chart/thumbs-down.svg";
import arrowBack from "../../assets/images/redesign/parliamentarians/arrow-back.svg";
import arrowForward from "../../assets/images/redesign/parliamentarians/arrow-forward.svg";

const carouselCards = Array.from({ length: 15 }, (_, index) => ({ id: index, featured: index === 7 }));
---

<section class="fast-moving-proposals" aria-labelledby="fast-moving-proposals-title" style={`--fast-moving-proposals-background: url(${backgroundPattern.src}); --fast-moving-proposals-halftone-shadow: url(${halftoneShadow.src})`}>
    <header class="fast-moving-proposals__header">
        <img src={attention.src} alt="" />
        <h2 id="fast-moving-proposals-title">Veja o que restringe nossos direitos<br />e tá tramitando rapidinho</h2>
        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
    </header>
    <div class="fast-moving-proposals__carousel" data-carousel>
        <div class="fast-moving-proposals__controls">
            <button type="button" aria-label="Proposição anterior" data-previous><img src={arrowBack.src} alt="" /></button>
            <button type="button" aria-label="Próxima proposição" data-next><img src={arrowForward.src} alt="" /></button>
        </div>
        <div class="fast-moving-proposals__viewport">
            <div class="fast-moving-proposals__track" data-track>
                {carouselCards.map((proposal) => (
                    <article class:list={["fast-moving-proposals__card", { "fast-moving-proposals__card--featured": proposal.featured }]} aria-hidden={proposal.id === 7 ? undefined : "true"}>
                        <header class="fast-moving-proposals__card-header">
                            <strong>PL 2104/2026</strong>
                            <span class="fast-moving-proposals__status"><img class="fast-moving-proposals__document" src={documentImage.src} alt="" /><span class="fast-moving-proposals__thumb"><img src={thumbBase.src} alt="" /><img src={thumb.src} alt="" /></span><b>Desfavorável</b></span>
                        </header>
                        <div class="fast-moving-proposals__card-content">
                            <p class="fast-moving-proposals__author"><span>Baleia Rossi</span><strong>MDB/SP</strong></p>
                            <span class="fast-moving-proposals__badge">Saúde</span>
                            <p class="fast-moving-proposals__description">Estabelece diretrizes para a atenção à saúde da mulher no climatério e na menopausa, no âmbito do Sistema Único de Saúde, e institui a Semana Nacional de Conscientização sobre o Climatério e a Menopausa</p>
                        </div>
                        <footer class="fast-moving-proposals__card-footer">Teve <strong>4 movimentações</strong> em <b>3 meses</b></footer>
                    </article>
                ))}
            </div>
        </div>
    </div>
</section>

<script>
    const initializeFastMovingProposals = () => {
    document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
        if (carousel.dataset.carouselInitialized) return;
        carousel.dataset.carouselInitialized = "true";
        const track = carousel.querySelector<HTMLElement>("[data-track]");
        const previous = carousel.querySelector<HTMLButtonElement>("[data-previous]");
        const next = carousel.querySelector<HTMLButtonElement>("[data-next]");
        if (!track || !previous || !next) return;
        let physicalIndex = 7;
        let isResetting = false;
        const cards = Array.from(track.querySelectorAll<HTMLElement>(".fast-moving-proposals__card"));
        const update = () => {
            track.style.transform = `translateX(${-192 - physicalIndex * 432}px)`;
            cards.forEach((card, cardIndex) => {
                const isActive = cardIndex === physicalIndex;
                card.classList.toggle("fast-moving-proposals__card--featured", isActive);
                card.setAttribute("aria-hidden", String(!isActive));
            });
        };
        const move = (direction: number) => {
            if (isResetting) return;
            physicalIndex += direction;
            update();
        };
        track.addEventListener("transitionend", (event) => {
            if (event.propertyName !== "transform" || physicalIndex > 4 && physicalIndex < 10) return;
            isResetting = true;
            physicalIndex += physicalIndex < 5 ? 5 : -5;
            track.style.transition = "none";
            update();
            requestAnimationFrame(() => requestAnimationFrame(() => {
                track.style.transition = "";
                isResetting = false;
            }));
        });
        previous.addEventListener("click", () => move(-1));
        next.addEventListener("click", () => move(1));
    });
    };

    initializeFastMovingProposals();
    document.addEventListener("astro:page-load", initializeFastMovingProposals);
</script>

<style>
    .fast-moving-proposals { width: 100%; height: 821.9435424804688px; overflow: hidden; background: #fff; color: #0b0f5e; font-family: "Plus Jakarta Sans", sans-serif; }
    .fast-moving-proposals *, .fast-moving-proposals *::before, .fast-moving-proposals *::after { box-sizing: border-box; }
    .fast-moving-proposals__header { display: flex; width: 816px; height: 174px; margin: 0 auto; padding: 48px; flex-direction: column; align-items: flex-start; gap: 16px; }
    .fast-moving-proposals__header > img { width: 96px; height: 4px; }
    .fast-moving-proposals h2, .fast-moving-proposals p { margin: 0; }
    .fast-moving-proposals h2 { width: 720px; height: 66px; font-family: "ETC Anybody", "Anybody", sans-serif; font-size: 36px; font-weight: 700; line-height: 32px; text-transform: uppercase; font-variation-settings: "wdth" 75; }
    .fast-moving-proposals__header p { width: 720px; font-size: 18px; line-height: 24px; }
    .fast-moving-proposals__carousel { position: relative; width: 100%; height: 541.9435424804688px; margin-top: 34px; overflow: hidden; background-color: #fff; background-image: var(--fast-moving-proposals-background); background-position: left top; background-repeat: repeat; background-size: 400px 400px; }
    .fast-moving-proposals__carousel::before, .fast-moving-proposals__carousel::after { position: absolute; z-index: 1; display: block; width: 100%; height: 24px; background-image: var(--fast-moving-proposals-halftone-shadow); background-position: left bottom; background-repeat: repeat-x; background-size: 1440px 24px; content: ""; pointer-events: none; mix-blend-mode: multiply; }
    .fast-moving-proposals__carousel::before { top: 0; left: 0; transform: scaleY(-1); }
    .fast-moving-proposals__carousel::after { bottom: 0; left: 0; }
    .fast-moving-proposals__controls { position: absolute; z-index: 3; top: 48px; left: calc(50% - 58px); display: flex; width: 116px; height: 40px; gap: 4px; }
    .fast-moving-proposals__controls button { display: grid; width: 56px; height: 40px; padding: 8px 16px; place-items: center; border: 2px solid #4242f6; border-radius: 0; background: #fff; }
    .fast-moving-proposals__controls img { display: block; width: 24px; height: 24px; }
    .fast-moving-proposals__viewport { position: absolute; z-index: 2; top: 112px; width: 100%; overflow-x: clip; overflow-y: visible; }
    .fast-moving-proposals__track { position: relative; left: 50%; display: flex; width: max-content; gap: 48px; transform: translateX(-3216px); transition: transform .2s ease; }
    .fast-moving-proposals__card { display: flex; width: 384px; height: 381.94354248046875px; flex: none; flex-direction: column; overflow: hidden; border: 1px solid #a3a3a3; background: #fff; }
    .fast-moving-proposals__card--featured { border: 1px solid #0b0f5e; box-shadow: -4px 4px 0 #0b0f5e; }
    .fast-moving-proposals__card-header { position: relative; display: flex; height: 69px; align-items: center; justify-content: space-between; border-bottom: 1px solid #a3a3a3; padding: 8px 16px; }
    .fast-moving-proposals__card-header > strong { font-family: "ETC Anybody", "Anybody", sans-serif; font-size: 20px; font-weight: 700; line-height: 24px; font-variation-settings: "wdth" 75; }
    .fast-moving-proposals__status { position: absolute; top: 8px; right: 16px; width: 168.30795288085938px; height: 53.94354248046875px; }
    .fast-moving-proposals__document { position: absolute; top: 0; left: 4.444942951202393px; width: 36px; height: 51px; transform: rotate(-5deg); object-fit: fill; }
    .fast-moving-proposals__thumb { position: absolute; top: 10.971768379211426px; left: 32.307952880859375px; display: block; width: 32px; height: 32px; overflow: hidden; border-radius: 50%; }
    .fast-moving-proposals__thumb > img:first-child { position: absolute; inset: 0; width: 32px; height: 32px; }
    .fast-moving-proposals__thumb > img:last-child { position: absolute; inset: 4px; width: 24px; height: 24px; transform: rotate(180deg); }
    .fast-moving-proposals__status b { position: absolute; top: 14.971768379211426px; left: 72.30795288085938px; width: 96px; height: 24px; font-family: "ETC Anybody", "Anybody", sans-serif; font-size: 16px; font-weight: 700; line-height: 24px; text-transform: uppercase; font-variation-settings: "wdth" 75; }
    .fast-moving-proposals__card-content { display: flex; height: 256px; flex-direction: column; align-items: flex-start; padding: 24px 16px; }
    .fast-moving-proposals__author { display: flex; width: 100%; justify-content: space-between; font-size: 18px; line-height: 24px; }
    .fast-moving-proposals__author strong { font-weight: 700; }
    .fast-moving-proposals__badge { margin-top: 16px; padding: 4px 8px; background: #4242f6; color: #fff; font-family: "ETC Anybody", "Anybody", sans-serif; font-size: 16px; font-weight: 700; line-height: 24px; text-transform: uppercase; font-variation-settings: "wdth" 75; }
    .fast-moving-proposals__description { margin-top: 16px !important; color: #62628f; font-size: 16px; line-height: 24px; }
    .fast-moving-proposals__card-footer { display: flex; height: 56px; align-items: center; border-top: 1px solid #a3a3a3; padding: 8px 16px; font-size: 18px; line-height: 24px; white-space: nowrap; }
    .fast-moving-proposals__card-footer strong { margin: 0 4px; color: #ff5865; font-weight: 700; }
    .fast-moving-proposals__card-footer b { margin-left: 4px; font-weight: 700; }
    @media (max-width: 767px) {
        .fast-moving-proposals { height: 696.0792236328125px; padding: 48px 0; }
        .fast-moving-proposals__header { width: 100%; height: auto; padding: 0 15px; }
        .fast-moving-proposals h2, .fast-moving-proposals__header p { width: 343px; max-width: 100%; }
        .fast-moving-proposals h2 { height: auto; font-size: 28px; line-height: 32px; letter-spacing: 0; }
        .fast-moving-proposals__header p { height: auto; font-size: 14px; font-weight: 400; line-height: 24px; }
        .fast-moving-proposals h2 br { display: none; }
        .fast-moving-proposals__carousel { height: 386.0792541503906px; margin-top: 10px; }
        .fast-moving-proposals__carousel::before, .fast-moving-proposals__carousel::after { height: 12px; }
        .fast-moving-proposals__viewport { overflow-x: clip; overflow-y: visible; }
        .fast-moving-proposals__track {
            --mobile-card-width: 224.345458984375px;
            --mobile-card-gap: 25px;
            --mobile-active-index: 7;
            gap: var(--mobile-card-gap);
            transform: translateX(calc(var(--mobile-active-index) * -1 * (var(--mobile-card-width) + var(--mobile-card-gap)) - var(--mobile-card-width) / 2)) !important;
        }
        .fast-moving-proposals__card { width: var(--mobile-card-width); height: 226.07925415039062px; border: 0; box-shadow: inset 0 0 0 0.5842328071594238px #998d96; }
        .fast-moving-proposals__card-header { height: 40.86332702636719px; flex: none; padding: 4.673864364624023px 9.347728729248047px; border-bottom-width: 0.5842328071594238px; }
        .fast-moving-proposals__card-header > strong { font-size: 14.02159309387207px; line-height: 18.695457458496094px; letter-spacing: 0; }
        .fast-moving-proposals__status { top: 4.673864364624023px; right: 9.347728729248047px; width: 98.33106994628906px; height: 31.51559829711914px; }
        .fast-moving-proposals__document { top: 0.8598003387451172px; left: 3.8554019927978516px; width: 21.032px; height: 29.796px; transform: rotate(5deg); }
        .fast-moving-proposals__thumb { top: 6.410069465637207px; left: 18.87537384033203px; width: 18.695457458496094px; height: 18.695457458496094px; }
        .fast-moving-proposals__thumb > img:first-child { width: 18.695457458496094px; height: 18.695457458496094px; }
        .fast-moving-proposals__thumb > img:last-child { inset: 2.3369321823120117px; width: 14.02159309387207px; height: 14.02159309387207px; }
        .fast-moving-proposals__status b { top: 8.746999740600586px; left: 42.24469757080078px; width: auto; height: 14.02159309387207px; font-size: 10.516194343566895px; line-height: 14.02159309387207px; letter-spacing: 0; }
        .fast-moving-proposals__card-content { display: flex; height: 151.52047729492188px; flex: none; gap: 9.347728729248047px; padding: 14.02159309387207px 9.347728729248047px; }
        .fast-moving-proposals__author { height: 15px; flex: none; font-size: 10.516194343566895px; line-height: 14.02159309387207px; }
        .fast-moving-proposals__badge { display: inline-flex; width: 37.34772872924805px; height: 19.673864364624023px; flex: none; align-items: center; justify-content: center; margin-top: 0; padding: 2.9211652278900146px 4.673864364624023px 1.7526991367340088px; font-size: 11.684660911560059px; line-height: 14.02159309387207px; letter-spacing: 0; }
        .fast-moving-proposals__description { display: -webkit-box; height: 70.10796356201172px; flex: none; margin-top: 0 !important; overflow: hidden; color: rgb(11 15 94 / 66%); font-size: 9.347728729248047px; line-height: 14.02159309387207px; -webkit-box-orient: vertical; -webkit-line-clamp: 5; }
        .fast-moving-proposals__card-footer { display: block; height: 33.695457458496094px; flex: none; padding: 9.347728729248047px; border-top-width: 0.5842328071594238px; font-size: 10.516194343566895px; line-height: 14.02159309387207px; }
        .fast-moving-proposals__card-footer strong, .fast-moving-proposals__card-footer b { margin: 0; }
        .fast-moving-proposals__card--featured { border: 0; box-shadow: inset 0 0 0 0.5842328071594238px #0b0f5e, -2.3369312286376953px 2.3369312286376953px 0 #0b0f5e; }
        .fast-moving-proposals__track:has(> .fast-moving-proposals__card:nth-child(5).fast-moving-proposals__card--featured) { --mobile-active-index: 4; }
        .fast-moving-proposals__track:has(> .fast-moving-proposals__card:nth-child(6).fast-moving-proposals__card--featured) { --mobile-active-index: 5; }
        .fast-moving-proposals__track:has(> .fast-moving-proposals__card:nth-child(7).fast-moving-proposals__card--featured) { --mobile-active-index: 6; }
        .fast-moving-proposals__track:has(> .fast-moving-proposals__card:nth-child(8).fast-moving-proposals__card--featured) { --mobile-active-index: 7; }
        .fast-moving-proposals__track:has(> .fast-moving-proposals__card:nth-child(9).fast-moving-proposals__card--featured) { --mobile-active-index: 8; }
        .fast-moving-proposals__track:has(> .fast-moving-proposals__card:nth-child(10).fast-moving-proposals__card--featured) { --mobile-active-index: 9; }
        .fast-moving-proposals__track:has(> .fast-moving-proposals__card:nth-child(11).fast-moving-proposals__card--featured) { --mobile-active-index: 10; }
    }
</style>
