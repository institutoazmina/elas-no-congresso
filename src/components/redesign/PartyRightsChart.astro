---
import attention from "../../assets/images/redesign/party-chart/attention.svg";
import StanceToggle from "./StanceToggle.astro";
import SectionDivider from "./SectionDivider.astro";
import thumbsDown from "../../assets/images/thumbs-down.svg";
import thumbsUp from "../../assets/images/thumbs-up.svg";
import Papelada from "./Papelada.astro";
import { pileGap } from "../../lib/papelada";
import { getStanceByParty, type GroupStat, type Stance } from "../../service/api/stats";

// Escala do design: pilha de 46px de largura, ~200px de altura no topo.
const PILE_WIDTH = 46;
const PILE_PEAK = 200;

const [unfavourableRanking, favourableRanking] = await Promise.all([
    getStanceByParty({ stance: "unfavorable" }),
    getStanceByParty({ stance: "favorable" }),
]);

const counts = [...unfavourableRanking, ...favourableRanking].flatMap((party) => [party.favorable, party.unfavorable]);
// Um único gap para os dois filtros: sem isso, alternar mudaria a escala e o
// gráfico mentiria.
const gap = pileGap({ width: PILE_WIDTH, height: PILE_PEAK, peak: Math.max(...counts) || 1 });

const toView = (ranking: GroupStat[], stance: Stance) =>
    ranking.map((party, index) => {
        const total = party.favorable + party.unfavorable;
        const share = total ? Math.round((party[stance] / total) * 100) : 0;
        return {
            name: party.label,
            // o 1º cartão carrega a legenda inteira; os demais só o número
            percentage: index === 0
                ? `${share}% das proposições\nsão ${stance === "unfavorable" ? "desfavoráveis" : "favoráveis"}`
                : `${share}%`,
            width: index === 0 ? 167 : 108,
            negative: party.unfavorable,
            positive: party.favorable,
        };
    });

const views = [
    { stance: "unfavorable" as const, caption: "atacam", parties: toView(unfavourableRanking, "unfavorable") },
    { stance: "favorable" as const, caption: "defendem", parties: toView(favourableRanking, "favorable") },
];
---

<section class="party-rights-chart" data-stance="unfavorable" aria-labelledby="party-rights-chart-title">
    <div class="party-rights-chart__container">
        <header class="party-rights-chart__header">
            <img class="party-rights-chart__attention" src={attention.src} alt="" />
            <h2 id="party-rights-chart-title">
                <span>Estes são os partidos que mais têm</span>
                <StanceToggle labels={{ unfavorable: "Atacado", favorable: "Defendido" }} />
                <span>Nossos direitos<span class="party-rights-chart__mobile-question">?</span></span>
            </h2>
            <p>Extrema-direita, centro e esquerda têm atuação diferente em relação ao gênero</p>
        </header>

        {views.map((view) => (
        <figure class="party-rights-chart__figure" data-stance-view={view.stance} aria-label={`Partidos com mais proposições que ${view.caption} direitos`}>
            {view.parties.map((party) => (
                <article class="party-rights-chart__party" style={`width: ${party.width}px`}>
                    <div class="party-rights-chart__piles">
                        <div class="party-rights-chart__pile">
                            <div class="party-rights-chart__value"><strong>{party.negative}</strong><img class="party-rights-chart__thumb" src={thumbsDown.src} alt="" /></div>
                            <Papelada class="party-rights-chart__paper" arrangement="pile" category="desfavoravel" size="a4" gap={gap} amount={party.negative} alt={`${party.negative} proposições desfavoráveis`} />
                        </div>
                        <div class="party-rights-chart__pile">
                            <div class="party-rights-chart__value"><strong>{party.positive}</strong><img class="party-rights-chart__thumb" src={thumbsUp.src} alt="" /></div>
                            <Papelada class="party-rights-chart__paper" arrangement="pile" category="favoravel" size="a4" gap={gap} amount={party.positive} alt={`${party.positive} proposições favoráveis`} />
                        </div>
                    </div>
                    <div class="party-rights-chart__description"><strong class="party-rights-chart__party-name">{party.name}</strong><span class="party-rights-chart__party-percentage">{party.percentage.split("\n").map((line) => <>{line}<br /></>)}</span></div>
                </article>
            ))}
        </figure>
        ))}

        <SectionDivider
            class="party-rights-chart__footer"
            content="Acesse a aba Atividade de Legislativa para ver em detalhes"
        />
    </div>
</section>


<style>
    .party-rights-chart { height: 729px; margin-bottom: 48px; overflow: hidden; background: #fff; box-shadow: 0 48px 0 #fff; color: #0b0f5e; font-family: "Plus Jakarta Sans", sans-serif; }
    .party-rights-chart *, .party-rights-chart *::before, .party-rights-chart *::after { box-sizing: border-box; }
    /* Só a visão do filtro ativo fica no fluxo — vale para o gráfico e para o
       rótulo/polegar dentro do próprio botão. */
    .party-rights-chart[data-stance="unfavorable"] [data-stance-view="favorable"],
    .party-rights-chart[data-stance="favorable"] [data-stance-view="unfavorable"] { display: none; }
    .party-rights-chart__container { position: relative; display: flex; width: 983px; height: 729px; margin: 0 auto; padding: 48px; flex-direction: column; align-items: center; gap: 10px; }
    .party-rights-chart__header { display: flex; width: 720px; height: 156px; flex-direction: column; align-items: flex-start; gap: 16px; }
    .party-rights-chart__attention { width: 96px; height: 4px; }
    .party-rights-chart h2, .party-rights-chart p, .party-rights-chart figure { margin: 0; }
    .party-rights-chart h2 { --stance-toggle-font-size: 36px; display: flex; width: 648px; height: 96px; flex-wrap: wrap; align-items: center; gap: 16px; font-family: "ETC Anybody", "Anybody", sans-serif; font-size: 36px; font-weight: 700; line-height: 42px; text-transform: uppercase; font-variation-settings: "wdth" 75; }
    .party-rights-chart h2 > span { height: 24px; white-space: nowrap; }
    .party-rights-chart__thumb { position: relative; display: block; width: 32px; height: 32px; flex: none; overflow: hidden; border-radius: 999px; }
    .party-rights-chart__header > p { width: 720px; height: 24px; font-size: 18px; line-height: 24px; }
    .party-rights-chart__figure { display: flex; width: 887px; height: 425px; padding: 24px 0; align-items: end; justify-content: center; gap: 72px; overflow: hidden; }
    .party-rights-chart__party { display: flex; flex: none; flex-direction: column; align-items: center; justify-content: end; gap: 16px; padding: 16px 0; }
    .party-rights-chart__piles { display: flex; min-width: 48px; min-height: 48px; align-items: end; justify-content: center; gap: 16px; overflow: hidden; }
    .party-rights-chart__pile { display: flex; flex-direction: column; align-items: center; justify-content: end; gap: 8px; }
    .party-rights-chart__value { display: flex; flex-direction: column; align-items: center; }
    .party-rights-chart__value strong { height: 32px; font-family: "ETC Anybody", "Anybody", sans-serif; font-size: 28px; font-weight: 700; line-height: 32px; font-variation-settings: "wdth" 75; }
    /* A altura vem da proporção do canvas — quanto maior a contagem, mais alta a pilha. */
    :global(.party-rights-chart__paper) { display: block; width: 46px; height: auto; }
    .party-rights-chart__description { display: flex; width: 100%; height: 88px; flex-direction: column; align-items: center; justify-content: center; padding: 8px 0; text-align: center; line-height: 24px; }
    .party-rights-chart__description strong { max-width: 192px; min-width: 96px; font-family: "ETC Anybody", "Anybody", sans-serif; font-size: 20px; font-weight: 700; line-height: 24px; text-transform: uppercase; font-variation-settings: "wdth" 75; }
    .party-rights-chart__description span { font-size: 16px; line-height: 24px; white-space: nowrap; }
    .party-rights-chart__footer { position: absolute; right: 48px; bottom: 48px; left: 48px; display: flex; width: 887px; height: 32px; align-items: flex-start; justify-content: space-between; border-top: 1px solid #0b0f5e; padding-top: 8px; font-size: 14px; line-height: 16px; }
    .party-rights-chart__footer :global(span) { margin-top: 4px; }
    .party-rights-chart__footer :global(img) { width: 113.217px; height: 12px; margin: 6px 8px 0; }
    .party-rights-chart__mobile-question { display: none; }

    @media (min-width: 984px) {
        .party-rights-chart h2 {
            display: grid;
            width: 648px;
            height: 96px;
            grid-template-columns: 230px 1fr;
            grid-template-rows: 24px 56px;
            align-items: center;
            column-gap: 16px;
            row-gap: 16px;
        }
        .party-rights-chart h2 > span:first-child {
            grid-column: 1 / -1;
            grid-row: 1;
            align-self: start;
            height: 24px;
            line-height: 24px;
        }
        .party-rights-chart h2 > span:last-child {
            grid-column: 2;
            grid-row: 2;
            align-self: center;
            height: 24px;
            line-height: 24px;
        }
        .party-rights-chart h2 :global(.stance-toggle) {
            grid-column: 1;
            grid-row: 2;
            width: max-content;
            height: 56px;
            flex: none;
            justify-content: flex-start;
            gap: 6px;
            font-size: 36px;
            line-height: 42px;
        }
        .party-rights-chart h2 :global(.stance-toggle__chevron) {
            flex: none;
        }

        .party-rights-chart__figure {
            width: 887px;
            height: 425px;
            padding: 0;
            align-items: start;
            gap: 72px;
        }
        .party-rights-chart__party {
            display: grid;
            height: 385px;
            grid-template-columns: minmax(0, 1fr);
            grid-template-rows: 281px 88px;
            align-content: start;
            align-items: stretch;
            gap: 16px;
            padding: 0;
        }
        .party-rights-chart__piles {
            height: 281px;
            min-height: 0;
            padding-top: 24px;
            align-items: end;
            overflow: hidden;
        }
        /* The tallest shared pile fills Y=24..281 without touching the header. */
        .party-rights-chart__pile {
            transform: scaleY(0.94632);
            transform-origin: bottom;
        }
        .party-rights-chart__description {
            height: 88px;
            min-height: 88px;
            padding: 8px 0 0;
            display: block;
            line-height: 24px;
        }
        .party-rights-chart__party-name {
            display: block;
            height: 24px;
            margin: 0;
            line-height: 24px;
            text-align: center;
            white-space: nowrap;
        }
        .party-rights-chart__party-percentage {
            display: block;
            min-height: 48px;
            margin: 0;
            line-height: 24px;
            text-align: center;
        }
    }

    @media (max-width: 983px) {
        .party-rights-chart { height: auto; overflow: hidden; }
        .party-rights-chart__container { width: 100%; height: auto; padding: 24px 16px; }
        .party-rights-chart__header { width: 100%; height: auto; margin: 0; }
        .party-rights-chart h2 { --stance-toggle-font-size: 28px; display: flex; width: 100%; height: auto; grid-template-columns: none; grid-template-rows: none; column-gap: normal; row-gap: normal; font-size: 28px; line-height: 34px; }
        .party-rights-chart h2 > span { height: auto; white-space: normal; }
        .party-rights-chart__header > p { width: 100%; height: auto; }
        .party-rights-chart__figure { width: 100%; height: auto; margin-top: 10px; flex-wrap: wrap; gap: 20px; overflow: visible; }
        .party-rights-chart__party { width: calc(50% - 10px) !important; }
        .party-rights-chart__footer { position: relative; right: auto; bottom: auto; left: auto; width: 100%; height: auto; min-height: 32px; margin-top: 10px; gap: 16px; }
        .party-rights-chart__footer :global(img) { flex: none; }
    }

    @media (max-width: 767px) {
        .party-rights-chart { margin-bottom: 0; box-shadow: none; }
        .party-rights-chart__container {
            width: min(343px, calc(100% - 32px));
            padding: 24px 0;
        }
        .party-rights-chart__header { width: 100%; height: auto; gap: 16px; }
        .party-rights-chart h2 {
            position: relative;
            display: block;
            width: min(332px, 100%);
            height: auto;
            min-height: 113px;
            flex: none;
            font-size: 28px;
            line-height: 32px;
        }
        .party-rights-chart h2 > span:first-child {
            position: absolute;
            top: 9.98px;
            left: 0;
            width: 100%;
            height: auto;
            font-size: 28px;
            line-height: 32px;
        }
        .party-rights-chart h2 > span:last-child {
            position: absolute;
            top: 88.98px;
            left: 0;
            height: auto;
            font-size: 28px;
            line-height: 32px;
            white-space: nowrap;
        }
        .party-rights-chart__mobile-question { display: inline; }
        .party-rights-chart :global(.stance-toggle) {
            position: absolute;
            top: 44.6px;
            left: 111px;
            width: auto;
            height: 40px;
            gap: 5.148px;
            border-width: 1.287px;
            padding: 7.722px 10.296px;
            justify-content: center;
            font-size: 14.91px;
            line-height: 17.391px;
            white-space: nowrap;
        }
        .party-rights-chart :global(.stance-toggle__thumb) {
            width: 20.591px;
            height: 20.591px;
        }
        .party-rights-chart :global(.stance-toggle__chevron) {
            width: 10.296px;
            height: 5.148px;
            margin-left: 10.296px;
        }
        .party-rights-chart__header > p {
            width: 100%;
            height: auto;
            font-size: 14px;
            font-weight: 400;
            line-height: 24px;
        }
        .party-rights-chart__figure {
            display: grid;
            width: 100%;
            height: auto;
            margin: 0;
            padding: 24px 0 0;
            grid-template-columns: minmax(0, 167px) 108px;
            grid-auto-rows: auto;
            column-gap: 50px;
            row-gap: 20px;
            align-items: end;
            justify-content: center;
            overflow: visible;
        }
        .party-rights-chart__party {
            width: 108px !important;
            min-width: 0;
            padding: 16px 0;
        }
        .party-rights-chart__party:nth-child(1) {
            width: 167px !important;
            grid-column: 1;
            grid-row: 1;
        }
        .party-rights-chart__party:nth-child(2) {
            grid-column: 2;
            grid-row: 1;
        }
        .party-rights-chart__party:nth-child(3) {
            grid-column: 1;
            grid-row: 2;
            justify-self: center;
        }
        .party-rights-chart__party:nth-child(4) {
            grid-column: 2;
            grid-row: 2;
        }
        .party-rights-chart__party:nth-child(5) {
            grid-column: 1 / -1;
            grid-row: 3;
            justify-self: center;
        }
        .party-rights-chart__footer {
            position: relative;
            width: 251px;
            height: 96px;
            min-height: 96px;
            margin: 0 auto;
            padding-top: 8px;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            gap: 24px;
            text-align: center;
        }
        .party-rights-chart__footer :global(span) {
            width: 100%;
            margin-top: 0;
            padding: 4px 0;
            font-size: 14px;
            line-height: 16px;
        }
        .party-rights-chart__footer :global(img) {
            width: 113.217px;
            height: 12px;
            margin: 6px 0 0;
        }
    }
</style>
