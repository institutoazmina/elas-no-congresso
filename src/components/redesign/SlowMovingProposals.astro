---
import attention from "../../assets/images/redesign/party-chart/attention.svg";
import documentImage from "../../assets/images/redesign/hero/proposicao-9.png";
import backgroundPattern from "../../assets/images/redesign/parliamentarians/bg-pattern.svg";
import halftoneShadow from "../../assets/images/redesign/hero/halftone-shadow.png";
import favorableThumb from "../../assets/images/thumbs-up.svg";
import arrowBack from "../../assets/images/redesign/parliamentarians/arrow-back.svg";
import arrowForward from "../../assets/images/redesign/parliamentarians/arrow-forward.svg";

const cards = Array.from({ length: 15 }, (_, id) => ({ id, featured: id === 7 }));
---

<section class="slow-moving-proposals" aria-labelledby="slow-moving-proposals-title" style={`--slow-moving-proposals-background: url(${backgroundPattern.src}); --slow-moving-proposals-halftone-shadow: url(${halftoneShadow.src})`}>
    <header class="slow-moving-proposals__header"><img src={attention.src} alt="" /><h2 id="slow-moving-proposals-title">E o que é bom pra gente, mas<br />tá indo beeeem devagar:</h2><p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p></header>
    <div class="slow-moving-proposals__carousel" data-slow-carousel>
        <div class="slow-moving-proposals__controls"><button type="button" aria-label="Proposição anterior" data-previous><img src={arrowBack.src} alt="" /></button><button type="button" aria-label="Próxima proposição" data-next><img src={arrowForward.src} alt="" /></button></div>
        <div class="slow-moving-proposals__viewport"><div class="slow-moving-proposals__track" data-track>
            {cards.map((card) => <article class:list={["slow-moving-proposals__card", { "slow-moving-proposals__card--featured": card.featured }]} aria-hidden={card.id === 7 ? undefined : "true"}>
                <header class="slow-moving-proposals__card-header"><strong>PDL 176/2021</strong><span class="slow-moving-proposals__status"><img class="slow-moving-proposals__document" src={documentImage.src} alt="" /><span class="slow-moving-proposals__thumbs"><img class="slow-moving-proposals__thumb" src={favorableThumb.src} alt="" /><b>Favorável</b></span></span></header>
                <div class="slow-moving-proposals__content"><div class="slow-moving-proposals__authors"><p>Jandira Feghali <strong>PCdoB/RJ</strong></p><p>Erika Kokay <strong>PT/DF</strong></p><p>Alice Portugal <strong>PCdoB/BA</strong></p><p class="slow-moving-proposals__more">+7 parlamentares</p></div><span class="slow-moving-proposals__badge">Saúde</span><p class="slow-moving-proposals__description">Susta a Portaria nº 13, de 19 de abril de 2021, que torna pública a decisão de incorporar o implante subdérmico de etonogestrel, condicionada à criação de programa específico, na prevenção da gravidez não planejada para mulheres em idade fértil: em situação de rua; com HIV/AIDS em uso de dolutegravir; em uso de talidomida; privadas de liberdade; trabalhadoras do sexo; e em tratamento de tuberculose em uso de aminoglicosídeos, no âmbito do Sistema Único de Saúde - SUS..</p></div>
                <footer>Teve <strong>1 movimentação</strong> em <b>14 meses</b></footer>
            </article>)}
        </div></div>
    </div>
</section>

<script>
    const initializeSlowMovingProposals = () => {
        document.querySelectorAll<HTMLElement>("[data-slow-carousel]").forEach((carousel) => {
            if (carousel.dataset.slowCarouselInitialized) return;
            carousel.dataset.slowCarouselInitialized = "true";
            const track = carousel.querySelector<HTMLElement>("[data-track]");
            const previous = carousel.querySelector<HTMLButtonElement>("[data-previous]");
            const next = carousel.querySelector<HTMLButtonElement>("[data-next]");
            if (!track || !previous || !next) return;
            const cards = Array.from(track.querySelectorAll<HTMLElement>(".slow-moving-proposals__card"));
            let physical = 7;
            let resetting = false;
            const update = () => {
                track.style.transform = `translateX(${-192 - physical * 432}px)`;
                cards.forEach((card, index) => {
                    const active = index === physical;
                    card.classList.toggle("slow-moving-proposals__card--featured", active);
                    card.setAttribute("aria-hidden", String(!active));
                });
            };
            const move = (direction: number) => {
                if (!resetting) {
                    physical += direction;
                    update();
                }
            };
            track.addEventListener("transitionend", (event) => {
                if (event.propertyName !== "transform" || (physical > 4 && physical < 10)) return;
                resetting = true;
                physical += physical < 5 ? 5 : -5;
                track.style.transition = "none";
                update();
                requestAnimationFrame(() => requestAnimationFrame(() => {
                    track.style.transition = "";
                    resetting = false;
                }));
            });
            previous.addEventListener("click", () => move(-1));
            next.addEventListener("click", () => move(1));
        });
    };

    initializeSlowMovingProposals();
    document.addEventListener("astro:page-load", initializeSlowMovingProposals);
</script>

