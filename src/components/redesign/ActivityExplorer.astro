---
import thumbsUp from "../../assets/images/redesign/activity/thumbs-up.svg";
import thumbsDown from "../../assets/images/redesign/activity/thumbs-down.svg";
import search from "../../assets/images/redesign/activity/search.svg";
import chevron from "../../assets/images/redesign/activity/chevron.svg";
import arrowBack from "../../assets/images/redesign/parliamentarians/arrow-back.svg";
import arrowForward from "../../assets/images/redesign/parliamentarians/arrow-forward.svg";
import cardTop from "../../assets/images/redesign/activity/parliamentarian-card-top.svg";
import cardHole from "../../assets/images/redesign/activity/parliamentarian-card-hole.svg";
import cardCircles from "../../assets/images/redesign/activity/parliamentarian-card-circles.svg";
import chartPattern from "../../assets/images/redesign/parliamentarians/bg-pattern.svg";
import halftone from "../../assets/images/redesign/hero/halftone-shadow.png";
---

<section
    class="activity-explorer"
    data-activity-root
    data-thumbs-up={thumbsUp.src}
    data-thumbs-down={thumbsDown.src}
    style={`--search-icon: url(${search.src}); --select-chevron: url(${chevron.src}); --arrow-back: url(${arrowBack.src}); --arrow-forward: url(${arrowForward.src}); --card-top: url(${cardTop.src}); --card-hole: url(${cardHole.src}); --card-circles: url(${cardCircles.src}); --chart-pattern: url(${chartPattern.src}); --chart-halftone: url(${halftone.src})`}
    aria-labelledby="activity-results-title"
>
    <form class="activity-filters" data-filters>
        <div class="activity-filters__search">
            <label class="activity-field activity-field--search">
                <span>Buscar</span>
                <input name="search" type="search" placeholder="Parlamentar, proposta, termo…" autocomplete="off" />
            </label>
            <button class="activity-search-button" type="submit" aria-label="Buscar"></button>
            <button class="activity-mobile-filter-button" type="button" data-open-filters="basic">Filtros <span data-filter-count hidden>0</span></button>
        </div>

        <div class="activity-filters__desktop-fields">
            <label class="activity-field"><span>Casa</span><select name="house"><option value="">Todas</option><option value="Deputado">Câmara</option><option value="Senador">Senado</option></select></label>
            <label class="activity-field"><span>Ano</span><select name="year"><option value="">Todos</option></select></label>
            <label class="activity-field"><span>Partido</span><select name="party"><option value="">Todos</option></select></label>
            <label class="activity-field activity-field--wide"><span>Categoria</span><select name="category" disabled title="A base atual ainda não fornece esta classificação"><option value="">Todas as categorias</option></select></label>
            <label class="activity-field activity-field--assessment"><span>Avaliação</span><select name="assessment"><option value="">Todas</option><option value="favorable">Favorável</option><option value="unfavorable">Desfavorável</option><option value="unrated">Sem avaliação</option></select></label>
            <button class="activity-more-filters" type="button" data-open-filters="advanced">Mais filtros <span data-filter-count hidden>0</span></button>
        </div>

        <aside class="activity-filter-panel" data-filter-panel hidden aria-label="Filtros da atividade legislativa">
            <header><h2>Filtros</h2><button type="button" data-close-filters aria-label="Fechar filtros">×</button></header>
            <div class="activity-filter-panel__scroll">
                <div class="activity-filter-panel__basic">
                    <label class="activity-field"><span>Casa</span><select name="house-mobile"><option value="">Todas</option><option value="Deputado">Câmara</option><option value="Senador">Senado</option></select></label>
                    <label class="activity-field"><span>Ano</span><select name="year-mobile"><option value="">Todos</option></select></label>
                    <label class="activity-field"><span>Partido</span><select name="party-mobile"><option value="">Todos</option></select></label>
                    <label class="activity-field"><span>Categoria</span><select name="category-mobile" disabled><option value="">Todas as categorias</option></select></label>
                    <label class="activity-field"><span>Avaliação</span><select name="assessment-mobile"><option value="">Todas</option><option value="favorable">Favorável</option><option value="unfavorable">Desfavorável</option><option value="unrated">Sem avaliação</option></select></label>
                </div>
                <button class="activity-filter-panel__toggle" type="button" data-toggle-advanced>Mais filtros</button>
                <div class="activity-filter-panel__advanced">
                    <fieldset>
                        <legend>Proposição</legend>
                        <label class="activity-field"><span>Apresentada em</span><select disabled><option>Qualquer período</option></select></label>
                        <label class="activity-field"><span>Como está?</span><select disabled><option>Qualquer status</option></select></label>
                        <label class="activity-field"><span>Movimentações</span><select disabled><option>Qualquer quantidade</option></select></label>
                        <label class="activity-field"><span>Marcadores analíticos</span><select disabled><option>Todos</option></select></label>
                    </fieldset>
                    <fieldset>
                        <legend>Autoria</legend>
                        <label class="activity-field"><span>Gênero de quem propôs</span><select name="gender"><option value="">Todos</option><option value="F">Mulher</option><option value="M">Homem</option></select></label>
                        <label class="activity-field"><span>Religião de quem propôs</span><select disabled><option>Não informada na listagem</option></select></label>
                        <label class="activity-field"><span>UF de quem propôs</span><select name="state"><option value="">Todas</option></select></label>
                    </fieldset>
                    <fieldset>
                        <legend>Avaliação</legend>
                        <label class="activity-field"><span>Com ressalvas?</span><select name="comments"><option value="">Todas</option><option value="yes">Com ressalvas</option><option value="no">Sem ressalvas</option></select></label>
                        <label class="activity-field"><span>Quem avaliou?</span><select name="evaluator"><option value="">Todas as organizações</option></select></label>
                        <label class="activity-field"><span>Relevância</span><select name="relevance"><option value="">Todas</option><option value="1">Alta</option><option value="0">Regular</option></select></label>
                    </fieldset>
                </div>
            </div>
            <button class="activity-filter-panel__apply" type="submit">Aplicar filtros</button>
        </aside>
    </form>

    <div class="activity-backdrop" data-backdrop hidden></div>

    <div class="activity-summary">
        <div class="activity-summary__heading">
            <h2 id="activity-results-title" data-total>Carregando proposições…</h2>
            <div>
                <button type="button" data-download>Baixar planilha</button>
                <button type="button" data-clear-filters hidden>Remover filtros</button>
            </div>
        </div>
        <div class="activity-summary__bar" data-result-bar><span></span><span></span></div>
        <div class="activity-summary__counts">
            <span><img src={thumbsUp.src} alt="" /><b data-favorable-count>0</b> favoráveis</span>
            <span><img src={thumbsDown.src} alt="" /><b data-unfavorable-count>0</b> desfavoráveis</span>
        </div>
    </div>

    <div class="activity-tabs" role="tablist" aria-label="Visualização dos resultados">
        <button class="is-active" type="button" role="tab" aria-selected="true" data-view="list"><span class="activity-tabs__desktop-label">Tabela</span><span class="activity-tabs__mobile-label">Lista</span></button>
        <button type="button" role="tab" aria-selected="false" data-view="charts">Gráficos</button>
    </div>

    <div class="activity-status is-loading" data-status role="status" aria-live="polite"><span aria-hidden="true"></span><p>Carregando atividade legislativa…</p></div>

    <div class="activity-results" data-results hidden>
        <div class="activity-results__tools">
            <label>Ordenar por <select data-sort name="sort"><option value="recent">Mais recentes</option><option value="oldest">Mais antigas</option><option value="number">Número</option><option value="assessment">Avaliação</option></select></label>
        </div>
        <div class="activity-table-wrap">
            <table class="activity-table">
                <thead><tr><th>Proposição</th><th>Autoria</th><th>Ementa</th><th>Avaliação</th><th>Quem avaliou?</th><th>Como está?</th><th>Categoria</th><th>Atualização</th></tr></thead>
                <tbody data-table-body></tbody>
            </table>
        </div>
        <div class="activity-cards" data-cards></div>
    </div>

    <div class="activity-empty" data-empty hidden>
        <strong>Será que sua busca foi muito específica?</strong>
        <p>Tente remover os filtros para encontrar outras proposições.</p>
        <button type="button" data-clear-filters>Remover filtros</button>
    </div>

    <div class="activity-chart" data-chart hidden></div>

    <nav class="activity-pagination" data-pagination aria-label="Paginação dos resultados" hidden>
        <div data-pages></div>
        <label>Itens por página <select data-items-per-page name="items"><option value="5">5</option><option value="10" selected>10</option><option value="20">20</option><option value="50">50</option></select></label>
    </nav>

    <dialog class="parliamentarian-dialog" data-parliamentarian-dialog aria-labelledby="parliamentarian-dialog-name">
        <article>
            <header><span aria-hidden="true"></span><button type="button" data-dialog-close aria-label="Fechar informações">×</button></header>
            <div class="parliamentarian-dialog__identity">
                <strong data-dialog-house>Parlamentar</strong>
                <div><img data-dialog-photo src="" alt="" /><p><b id="parliamentarian-dialog-name" data-dialog-name></b><span data-dialog-party></span></p></div>
            </div>
            <div class="parliamentarian-dialog__scores">
                <span><img src={thumbsUp.src} alt="" /><b data-dialog-favorable>0</b><small>favoráveis</small></span>
                <span><img src={thumbsDown.src} alt="" /><b data-dialog-unfavorable>0</b><small>desfavoráveis</small></span>
            </div>
            <dl>
                <div><dt>Nascimento</dt><dd data-dialog-birth>—</dd></div>
                <div><dt>Profissão</dt><dd data-dialog-profession>—</dd></div>
                <div><dt>Escolaridade</dt><dd data-dialog-education>—</dd></div>
                <div><dt>Raça/cor</dt><dd data-dialog-race>—</dd></div>
                <div><dt>Religião</dt><dd data-dialog-religion>—</dd></div>
            </dl>
        </article>
    </dialog>
</section>

<script>
    import "../../scripts/activity-legislative";
</script>

<style is:global>
    .activity-explorer, .activity-explorer * { box-sizing: border-box; }
    .activity-explorer { position: relative; width: 100%; min-height: 1367px; padding: 24px 0; overflow: clip; background: #fff; color: #0b0f5e; font-family: "Plus Jakarta Sans", sans-serif; }
    .activity-explorer.is-chart-view { min-height: 1085px; }
    .activity-explorer.is-empty-results { min-height: 0; }
    .sr-only { position: absolute !important; width: 1px !important; height: 1px !important; padding: 0 !important; overflow: hidden !important; clip: rect(0, 0, 0, 0) !important; white-space: nowrap !important; border: 0 !important; }
    .activity-explorer button, .activity-explorer input, .activity-explorer select { font: inherit; }
    .activity-explorer button { color: inherit; }
    .activity-explorer button:focus-visible, .activity-explorer a:focus-visible, .activity-explorer input:focus-visible, .activity-explorer select:focus-visible { outline: 3px solid #def279; outline-offset: 2px; }
    .activity-filters { display: flex; width: 100%; min-height: 60px; padding: 0 48px 24px; align-items: end; gap: 16px; }
    .activity-filters__search { display: grid; width: 366px; flex: 0 1 366px; grid-template-columns: 1fr 32px; grid-template-rows: 16px 36px; align-items: end; row-gap: 8px; }
    .activity-field { display: flex; min-width: 103px; flex: 1 1 auto; flex-direction: column; gap: 8px; color: #0b0f5e; font-size: 14px; font-weight: 700; line-height: 16px; }
    .activity-field > span { white-space: nowrap; }
    .activity-field input, .activity-field select, .activity-results__tools select, .activity-pagination select { width: 100%; height: 36px; border: 2px solid rgb(66 66 246 / 25%); border-radius: 0; background-color: #fff; color: #0b0f5e; font-size: 16px; font-weight: 700; line-height: 24px; }
    .activity-field input { padding: 4px 12px; }
    .activity-field select, .activity-results__tools select, .activity-pagination select { padding: 4px 34px 4px 10px; appearance: none; background-image: var(--select-chevron); background-position: right 12px center; background-repeat: no-repeat; background-size: 12px 8px; }
    .activity-field input:hover, .activity-field select:hover, .activity-results__tools select:hover, .activity-pagination select:hover { border-color: #4242f6; }
    .activity-field input:focus, .activity-field select:focus { border-color: #4242f6; outline: 0; }
    .activity-field select:disabled { cursor: not-allowed; opacity: .55; }
    .activity-field--search { display: contents; width: calc(100% - 32px); }
    .activity-field--search > span { grid-column: 1 / -1; grid-row: 1; color: #0b0f5e; font-size: 14px; font-weight: 700; line-height: 16px; }
    .activity-field--search input { grid-column: 1; grid-row: 2; }
    .activity-field--search input { border-color: #4242f6; font-weight: 400; }
    .activity-search-button { width: 32px; height: 36px; grid-column: 2; grid-row: 2; flex: none; border: 0; background: #4242f6 var(--search-icon) center / 16px 16px no-repeat; cursor: pointer; }
    .activity-search-button:hover { background-color: #0b0f5e; }
    .activity-filters__desktop-fields { display: flex; min-width: 0; flex: 1 1 auto; align-items: end; gap: 16px; }
    .activity-field--wide { min-width: 180px; }
    .activity-field--assessment { min-width: 160px; }
    .activity-more-filters, .activity-mobile-filter-button { position: relative; height: 36px; flex: none; border: 2px solid #4242f6; background: #4242f6; padding: 4px 12px; color: #fff; font-family: "ETC Anybody", sans-serif; font-size: 14px; font-weight: 700; font-variation-settings: "wdth" 75; line-height: 24px; text-transform: uppercase; cursor: pointer; }
    .activity-more-filters:hover, .activity-mobile-filter-button:hover { background: #0b0f5e; border-color: #0b0f5e; color: #fff; }
    [data-filter-count] { position: absolute; top: -11px; right: -9px; display: grid; width: 22px; height: 22px; place-items: center; border-radius: 50%; background: #ff5865; color: #fff; font-family: "Plus Jakarta Sans", sans-serif; font-size: 12px; line-height: 1; }
    .activity-mobile-filter-button { display: none; }

    .activity-summary { display: flex; min-height: 124px; padding: 24px 48px; flex-direction: column; gap: 8px; }
    .activity-summary__heading { display: flex; min-height: 32px; align-items: center; justify-content: space-between; gap: 24px; }
    .activity-summary h2 { margin: 0; font-family: "Plus Jakarta Sans", sans-serif; font-size: 16px; font-weight: 400; line-height: 24px; }
    .activity-explorer:not(.is-empty-results) .activity-summary h2::after { content: " encontradas"; }
    .activity-summary__heading > div { display: flex; gap: 24px; }
    .activity-summary button, .activity-empty button { border: 0; border-bottom: 1px solid currentColor; background: none; padding: 0; color: #4242f6; font-weight: 700; line-height: 24px; cursor: pointer; }
    .activity-summary__bar { display: grid; width: 100%; height: 6px; grid-template-columns: minmax(0, var(--favorable-share, 50%)) minmax(0, calc(100% - var(--favorable-share, 50%))); gap: 4px; }
    .activity-summary__bar span:first-child { background: #def279; }
    .activity-summary__bar span:last-child { background: #ff5865; }
    .activity-summary__bar.is-empty { display: block; background: rgb(66 66 246 / 25%); }
    .activity-summary__bar.is-empty span { display: none; }
    .activity-summary__counts { display: flex; align-items: center; justify-content: space-between; gap: 24px; font-family: "ETC Anybody", sans-serif; font-size: 18px; font-weight: 700; font-variation-settings: "wdth" 75; line-height: 24px; text-transform: uppercase; }
    .activity-summary__counts span { display: flex; align-items: center; gap: 8px; }
    .activity-summary__counts img { width: 24px; height: 24px; }

    .activity-tabs { display: flex; height: 40px; padding: 0; border-bottom: 4px solid #4242f6; align-items: end; justify-content: center; gap: 4px; }
    .activity-tabs button { height: 36px; min-width: 125px; border: 2px solid #4242f6; border-bottom: 0; border-radius: 16px 16px 0 0; background: #fff; padding: 6px 24px; color: #4242f6; font-family: "ETC Anybody", sans-serif; font-size: 16px; font-weight: 700; font-variation-settings: "wdth" 75; line-height: 24px; text-transform: uppercase; cursor: pointer; }
    .activity-tabs button.is-active, .activity-tabs button:hover { background: #4242f6; color: #fff; }
    .activity-tabs__mobile-label { display: none; }
    .activity-results__tools { display: flex; height: 52px; padding: 8px 48px; align-items: center; justify-content: flex-end; }
    .activity-results__tools label { display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 700; }
    .activity-results__tools select { width: 176px; }
    .activity-table-wrap { width: 100%; padding: 0 38px; overflow-x: auto; }
    .activity-table { width: 100%; border-collapse: collapse; table-layout: fixed; }
    .activity-table th { height: 52px; padding: 8px; border-bottom: 2px solid #4242f6; color: #4242f6; font-family: "ETC Anybody", sans-serif; font-size: 14px; font-weight: 700; font-variation-settings: "wdth" 75; line-height: 16px; text-align: left; text-transform: uppercase; }
    .activity-table th:nth-child(1) { width: 10%; }.activity-table th:nth-child(2) { width: 14%; }.activity-table th:nth-child(3) { width: 20%; }.activity-table th:nth-child(4) { width: 11%; }.activity-table th:nth-child(5) { width: 13%; }.activity-table th:nth-child(6) { width: 10%; }.activity-table th:nth-child(7) { width: 10%; }.activity-table th:nth-child(8) { width: 10%; }
    .activity-table td { height: 64px; padding: 8px; border-bottom: 1px solid rgb(11 15 94 / 25%); vertical-align: top; font-size: 13px; line-height: 16px; }
    .activity-table td > a:first-child { color: #4242f6; font-family: "ETC Anybody", sans-serif; font-size: 16px; font-weight: 700; font-variation-settings: "wdth" 75; line-height: 24px; text-decoration: none; text-transform: uppercase; }
    .activity-table td > small, .activity-table td:nth-child(6) small { display: block; margin-top: 4px; color: rgb(11 15 94 / 65%); font-size: 12px; line-height: 16px; }
    .activity-table td:nth-child(3) p { display: -webkit-box; margin: 0; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
    .activity-author button { display: flex; width: 100%; align-items: center; gap: 8px; border: 0; background: none; padding: 0; color: inherit; text-align: left; cursor: pointer; }
    .activity-author button:hover strong { color: #4242f6; text-decoration: underline; }
    .activity-author img { width: 40px; height: 40px; flex: none; border: 1px solid #4242f6; border-radius: 0; object-fit: cover; object-position: top center; }
    .activity-author button > span { display: flex; min-width: 0; flex-direction: column; }
    .activity-author strong { display: -webkit-box; overflow: hidden; font-size: 14px; line-height: 18px; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
    .activity-author small { color: rgb(11 15 94 / 65%); font-size: 12px; line-height: 16px; }
    .activity-author__extra { display: block; margin-top: 4px; }
    .activity-stance { display: flex; align-items: center; gap: 4px; font-family: "ETC Anybody", sans-serif; font-size: 12px; font-variation-settings: "wdth" 75; line-height: 16px; text-transform: uppercase; }
    .activity-stance img { width: 24px; height: 24px; }
    .activity-stance--favorable { color: #0b0f5e; }.activity-stance--unfavorable { color: #0b0f5e; }.activity-stance--neutral { color: rgb(11 15 94 / 55%); }
    .activity-cards { display: none; }

    .activity-pagination { display: flex; min-height: 108px; padding: 24px 48px; align-items: flex-start; justify-content: space-between; }
    .activity-pagination > div { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
    .activity-pagination > div > span:last-child { display: flex; align-items: center; gap: 4px; }
    .activity-pagination__page-label { font-size: 14px; line-height: 20px; }
    .activity-pagination button { display: grid; min-width: 36px; height: 36px; place-items: center; border: 2px solid transparent; background: #fff; color: #4242f6; font-weight: 700; cursor: pointer; }
    .activity-pagination button { background-position: center; background-repeat: no-repeat; background-size: 24px 16px; color: transparent; }
    .activity-pagination button:first-child { background-image: var(--arrow-back); }.activity-pagination button:last-child { background-image: var(--arrow-forward); }
    .activity-pagination button:hover, .activity-pagination button.is-current { border-color: #4242f6; }
    .activity-pagination button:disabled { cursor: not-allowed; opacity: .25; }
    .activity-pagination label { display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 700; }
    .activity-pagination select { width: 72px; }

    .activity-status { display: flex; min-height: 360px; align-items: center; justify-content: center; flex-direction: column; gap: 16px; text-align: center; }
    .activity-status[hidden] { display: none; }
    .activity-status.is-loading > span { width: 40px; height: 40px; border: 4px solid rgb(66 66 246 / 20%); border-top-color: #4242f6; border-radius: 50%; animation: activity-spin .8s linear infinite; }
    .activity-status p { margin: 0; line-height: 24px; }
    .activity-status button { height: 40px; border: 0; background: #4242f6; padding: 8px 20px; color: #fff; font-weight: 700; cursor: pointer; }
    @keyframes activity-spin { to { transform: rotate(360deg); } }
    @media (prefers-reduced-motion: reduce) { .activity-status.is-loading > span { animation-duration: 1.8s; } }

    .activity-empty { min-height: 260px; margin: 24px 48px; padding: 48px; border: 1px dashed rgb(66 66 246 / 35%); text-align: center; }
    .activity-empty[hidden] { display: none; }
    .activity-empty strong { font-size: 18px; line-height: 24px; }.activity-empty p { margin: 8px 0 16px; }

    .activity-chart { min-height: 680px; padding: 72px 0; background-color: #fff; background-image: var(--chart-halftone), var(--chart-pattern); background-position: left top, left top; background-repeat: repeat-x, repeat; background-size: 1440px 24px, 400px 400px; }
    .activity-chart[hidden] { display: none; }
    .activity-chart-card { width: min(864px, calc(100% - 96px)); min-height: 560px; margin: 0 auto; border: 1px solid #0b0f5e; background: #fff; padding: 40px 48px 32px; box-shadow: -4px 4px 0 #0b0f5e; }
    .activity-chart-card__attention { width: 96px; height: 4px; margin-bottom: 16px; background: #0b0f5e; }
    .activity-chart-card__eyebrow { margin: 0 0 8px; font-size: 14px; font-weight: 700; text-transform: uppercase; }
    .activity-chart-card h2 { width: 680px; max-width: 100%; margin: 0; font-family: "ETC Anybody", sans-serif; font-size: 36px; font-weight: 700; font-variation-settings: "wdth" 75; line-height: 42px; text-transform: uppercase; }
    .activity-chart-card__description { margin: 8px 0 0; font-size: 16px; line-height: 24px; }
    .activity-chart-bars { display: flex; height: 305px; align-items: flex-end; justify-content: center; gap: 42px; overflow: hidden; }
    .activity-chart-bars > article { display: flex; width: 110px; flex-direction: column; align-items: center; gap: 12px; }
    .activity-chart-bars__piles { display: flex; height: 230px; align-items: flex-end; justify-content: center; gap: 6px; overflow: hidden; }
    .activity-chart-bars__piles > div { display: flex; width: 46px; flex-direction: column; align-items: center; justify-content: flex-end; }
    .activity-chart-bars canvas { display: block; width: 46px; height: auto; }
    .activity-chart-bars b { font-family: "ETC Anybody", sans-serif; font-size: 16px; font-variation-settings: "wdth" 75; text-transform: uppercase; }
    .activity-chart-legend { display: flex; padding-top: 16px; border-top: 1px solid #0b0f5e; gap: 24px; font-size: 14px; }
