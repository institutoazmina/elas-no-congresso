---
import thumbsUp from "../../assets/images/redesign/activity/thumbs-up.svg";
import thumbsDown from "../../assets/images/redesign/activity/thumbs-down.svg";
import search from "../../assets/images/redesign/activity/search.svg";
import chevron from "../../assets/images/redesign/activity/chevron.svg";
import sortDown from "../../assets/images/redesign/activity/sort-down.svg";
import sortUp from "../../assets/images/redesign/activity/sort-up.svg";
import arrowBack from "../../assets/images/redesign/parliamentarians/arrow-back.svg";
import arrowForward from "../../assets/images/redesign/parliamentarians/arrow-forward.svg";
import cardTop from "../../assets/images/redesign/activity/parliamentarian-card-top.svg";
import cardHole from "../../assets/images/redesign/activity/parliamentarian-card-hole.svg";
import mapBase from "./assets/map/map-br-base@2.5x.png";
import mapLabels from "./assets/map/map-br-labels@2.5x.png";
import mapHitboxes from "./assets/map/map-br-ufs-vector.svg?raw";

const mapLayerModules = import.meta.glob<{ default: ImageMetadata }>("./assets/map/map-br-ufs-*@2.5x.png", { eager: true });
const mapLayers = Object.fromEntries(Object.entries(mapLayerModules).map(([path, module]) => {
    const match = path.match(/map-br-ufs-(favoravel|desfavoravel)-([A-Z]{2})@/);
    return match ? [`${match[2]}:${match[1]}`, module.default.src] : [];
}).filter((entry) => entry.length));
---

<section
    class="activity-explorer"
    data-activity-root
    data-thumbs-up={thumbsUp.src}
    data-thumbs-down={thumbsDown.src}
    data-map-base={mapBase.src}
    data-map-labels={mapLabels.src}
    style={`--search-icon: url(${search.src}); --select-chevron: url(${chevron.src}); --sort-down: url(${sortDown.src}); --sort-up: url(${sortUp.src}); --arrow-back: url(${arrowBack.src}); --arrow-forward: url(${arrowForward.src}); --card-top: url(${cardTop.src}); --card-hole: url(${cardHole.src})`}
    aria-labelledby="activity-results-title"
>
    <script type="application/json" data-map-layers set:html={JSON.stringify(mapLayers)}></script>
    <form class="activity-filters" data-filters>
        <div class="activity-filters__search">
            <label class="activity-field activity-field--search">
                <span>Buscar</span>
                <input name="search" type="search" placeholder="Parlamentar, proposta, termo…" autocomplete="off" />
            </label>
            <button class="activity-search-button" type="submit" aria-label="Buscar"></button>
            <button class="activity-mobile-filter-button" type="button" data-open-filters="basic">Filtros <span data-filter-count hidden>0</span></button>
        </div>

        <div class="activity-filters__desktop-fields">
            <label class="activity-field"><span>Casa</span><select name="house"><option value="">Todas</option><option value="Deputado">Câmara</option><option value="Senador">Senado</option></select></label>
            <label class="activity-field"><span>Ano</span><select name="year"><option value="">Todos</option></select></label>
            <label class="activity-field"><span>Partido</span><select name="party"><option value="">Todos</option></select></label>
            <label class="activity-field activity-field--wide"><span>Categoria</span><select name="category" disabled title="A base atual ainda não fornece esta classificação"><option value="">Todas as categorias</option></select></label>
            <label class="activity-field activity-field--assessment"><span>Avaliação</span><select name="assessment"><option value="">Todas</option><option value="favorable">Favorável</option><option value="unfavorable">Desfavorável</option><option value="unrated">Sem avaliação</option></select></label>
            <button class="activity-more-filters" type="button" data-open-filters="advanced">Mais filtros <span data-filter-count hidden>0</span></button>
        </div>

        <aside class="activity-filter-panel" data-filter-panel hidden aria-label="Filtros da atividade legislativa">
            <header><h2>Filtros</h2><button type="button" data-close-filters aria-label="Fechar filtros">×</button></header>
            <div class="activity-filter-panel__scroll">
                <div class="activity-filter-panel__basic">
                    <label class="activity-field"><span>Casa</span><select name="house-mobile"><option value="">Todas</option><option value="Deputado">Câmara</option><option value="Senador">Senado</option></select></label>
                    <label class="activity-field"><span>Ano</span><select name="year-mobile"><option value="">Todos</option></select></label>
                    <label class="activity-field"><span>Partido</span><select name="party-mobile"><option value="">Todos</option></select></label>
                    <label class="activity-field"><span>Categoria</span><select name="category-mobile" disabled><option value="">Todas as categorias</option></select></label>
                    <label class="activity-field"><span>Avaliação</span><select name="assessment-mobile"><option value="">Todas</option><option value="favorable">Favorável</option><option value="unfavorable">Desfavorável</option><option value="unrated">Sem avaliação</option></select></label>
                </div>
                <button class="activity-filter-panel__toggle" type="button" data-toggle-advanced>Mais filtros</button>
                <div class="activity-filter-panel__advanced">
                    <fieldset>
                        <legend>Proposição</legend>
                        <label class="activity-field"><span>Apresentada em</span><select disabled><option>Qualquer período</option></select></label>
                        <label class="activity-field"><span>Como está?</span><select disabled><option>Qualquer status</option></select></label>
                        <label class="activity-field"><span>Movimentações</span><select disabled><option>Qualquer quantidade</option></select></label>
                        <label class="activity-field"><span>Marcadores analíticos</span><select disabled><option>Todos</option></select></label>
                    </fieldset>
                    <fieldset>
                        <legend>Autoria</legend>
                        <label class="activity-field"><span>Gênero de quem propôs</span><select name="gender"><option value="">Todos</option><option value="F">Mulher</option><option value="M">Homem</option></select></label>
                        <label class="activity-field"><span>Religião de quem propôs</span><select disabled><option>Não informada na listagem</option></select></label>
                        <label class="activity-field"><span>UF de quem propôs</span><select name="state"><option value="">Todas</option></select></label>
                    </fieldset>
                    <fieldset>
                        <legend>Avaliação</legend>
                        <label class="activity-field"><span>Com ressalvas?</span><select name="comments"><option value="">Todas</option><option value="yes">Com ressalvas</option><option value="no">Sem ressalvas</option></select></label>
                        <label class="activity-field"><span>Quem avaliou?</span><select name="evaluator"><option value="">Todas as organizações</option></select></label>
                        <label class="activity-field"><span>Relevância</span><select name="relevance"><option value="">Todas</option><option value="1">Alta</option><option value="0">Regular</option></select></label>
                    </fieldset>
                </div>
            </div>
            <button class="activity-filter-panel__apply" type="submit">Aplicar filtros</button>
        </aside>
    </form>

    <div class="activity-backdrop" data-backdrop hidden></div>

    <div class="activity-summary">
        <div class="activity-summary__heading">
            <h2 id="activity-results-title" data-total>Carregando proposições…</h2>
            <div>
                <button type="button" data-download>Baixar planilha</button>
                <button type="button" data-clear-filters>Remover filtros</button>
            </div>
        </div>
    </div>

    <section class="activity-dashboard" data-dashboard hidden aria-label="Resumo visual das proposições">
        <div class="activity-dashboard__overview">
            <div class="activity-dashboard__score activity-dashboard__score--favorable">
                <img class="activity-dashboard__paper" src="/assets/papelada/proposicao-1-96w.png" alt="" />
                <img class="activity-dashboard__thumb" src={thumbsUp.src} alt="" />
                <span>Favorável</span><b data-favorable-count>0</b>
            </div>
            <div class="activity-dashboard__score activity-dashboard__score--unfavorable">
                <b data-unfavorable-count>0</b><span>Desfavorável</span>
                <img class="activity-dashboard__thumb" src={thumbsDown.src} alt="" />
                <img class="activity-dashboard__paper" src="/assets/papelada/proposicao-desfavoravel-9-96w.png" alt="" />
            </div>
            <div class="activity-dashboard__bar" data-result-bar><span></span><span></span></div>
            <div class="activity-dashboard__scale" aria-hidden="true"><span>0%</span><span>25%</span><span>50%</span><span>75%</span><span>100%</span></div>
        </div>

        <div class="activity-dashboard__grid">
            <div class="activity-dashboard__column">
                <article class="activity-dashboard-card activity-dashboard-card--gender"><header><h3>Por gênero</h3></header><div class="activity-dashboard-card__content" data-dashboard-gender></div><footer>Não há dados sobre outros gêneros no Congresso</footer></article>
                <article class="activity-dashboard-card activity-dashboard-card--house"><header><h3>Por casa</h3></header><div class="activity-dashboard-card__content" data-dashboard-house></div></article>
                <article class="activity-dashboard-card activity-dashboard-card--category"><header><h3>Por categoria</h3></header><div class="activity-dashboard-card__content activity-dashboard-card__empty" data-dashboard-category></div><footer>A base da listagem não informa a categoria principal</footer></article>
            </div>
            <div class="activity-dashboard__column">
                <article class="activity-dashboard-card activity-dashboard-card--state"><header><h3>Por unidade federativa</h3></header><div class="activity-dashboard-map" data-dashboard-map><div class="activity-dashboard-map__canvas"><img data-map-base-image src={mapBase.src} alt="" /><div data-map-state-layers></div><img data-map-labels-image src={mapLabels.src} alt="" /><div class="activity-dashboard-map__hitboxes" data-map-hitboxes><Fragment set:html={mapHitboxes} /></div></div><div class="activity-dashboard-map__legend"><span>Proposições Favoráveis</span><i><span></span><span></span></i><small data-map-percentages></small></div></div><footer>Considera a UF de cada parlamentar que assina</footer></article>
                <article class="activity-dashboard-card activity-dashboard-card--status"><header><h3>Por status</h3></header><div class="activity-dashboard-card__content activity-dashboard-card__empty" data-dashboard-status></div><footer>A base não fornece os status completos do design</footer></article>
            </div>
            <div class="activity-dashboard__column">
                <article class="activity-dashboard-card activity-dashboard-card--party"><header><h3>Por partido</h3><label>Ordem <select data-dashboard-sort="party"><option value="unfavorable">Mais Desfavorável (%)</option><option value="favorable">Mais Favorável (%)</option><option value="total">Mais proposições</option></select></label></header><div class="activity-dashboard-card__content activity-dashboard-card__scroll" data-dashboard-party></div><footer>Usamos o nome atual de partidos renomeados</footer></article>
            </div>
            <div class="activity-dashboard__column">
                <article class="activity-dashboard-card activity-dashboard-card--author"><header><div class="activity-dashboard-card__title"><h3>Por autoria</h3></div><label>Ordem <select data-dashboard-sort="author"><option value="unfavorable">Mais Desfavorável (%)</option><option value="favorable">Mais Favorável (%)</option><option value="total">Mais proposições</option></select></label></header><div class="activity-dashboard-card__content activity-dashboard-card__scroll" data-dashboard-author></div><footer>Inclui autorias institucionais, como “Presidência”, etc.</footer></article>
            </div>
        </div>
        <div class="activity-map-tooltip" data-map-tooltip role="status" aria-live="polite" hidden></div>
    </section>

    <div class="activity-dashboard-mobile-heading" aria-hidden="true">Proposições</div>

    <div class="activity-status is-loading" data-status role="status" aria-live="polite"><span aria-hidden="true"></span><p>Carregando atividade legislativa…</p></div>

    <div class="activity-results" data-results hidden>
        <div class="activity-table-wrap">
            <table class="activity-table">
                <thead><tr><th><button type="button" data-table-sort="number">Proposição</button></th><th><button type="button" data-table-sort="author">Autoria</button></th><th><button type="button" data-table-sort="summary">Ementa</button></th><th><button type="button" data-table-sort="assessment">Avaliação</button></th><th><button type="button" data-table-sort="evaluator">Quem avaliou?</button></th><th><button type="button" data-table-sort="progress">Como está?</button></th><th><button type="button" data-table-sort="category">Categoria</button></th><th aria-sort="descending"><button class="is-active" type="button" data-table-sort="updated">Atualização</button></th></tr></thead>
                <tbody data-table-body></tbody>
            </table>
        </div>
        <div class="activity-cards" data-cards></div>
    </div>

    <div class="activity-empty" data-empty hidden>
        <strong>Será que sua busca foi muito específica?</strong>
        <p>Tente remover os filtros para encontrar outras proposições.</p>
        <button type="button" data-clear-filters>Remover filtros</button>
    </div>

    <nav class="activity-pagination" data-pagination aria-label="Paginação dos resultados" hidden>
        <div data-pages></div>
        <label>Itens por página <select data-items-per-page name="items"><option value="5">5</option><option value="10" selected>10</option><option value="20">20</option><option value="50">50</option></select></label>
    </nav>

    <dialog class="parliamentarian-dialog" data-parliamentarian-dialog aria-labelledby="parliamentarian-dialog-name">
        <article>
            <header><span aria-hidden="true"></span><button type="button" data-dialog-close aria-label="Fechar informações">×</button></header>
            <div class="parliamentarian-dialog__identity">
                <strong data-dialog-house>Parlamentar</strong>
                <div><img data-dialog-photo src="" alt="" /><p><b id="parliamentarian-dialog-name" data-dialog-name></b><span data-dialog-party></span></p></div>
            </div>
            <div class="parliamentarian-dialog__scores">
                <span><img src={thumbsUp.src} alt="" /><b data-dialog-favorable>0</b><small>favoráveis</small></span>
                <span><img src={thumbsDown.src} alt="" /><b data-dialog-unfavorable>0</b><small>desfavoráveis</small></span>
            </div>
            <dl>
                <div><dt>Nascimento</dt><dd data-dialog-birth>—</dd></div>
                <div><dt>Profissão</dt><dd data-dialog-profession>—</dd></div>
                <div><dt>Escolaridade</dt><dd data-dialog-education>—</dd></div>
                <div><dt>Raça/cor</dt><dd data-dialog-race>—</dd></div>
                <div><dt>Religião</dt><dd data-dialog-religion>—</dd></div>
            </dl>
        </article>
    </dialog>
</section>

<script>
    import "../../scripts/activity-legislative";
</script>

<style is:global>
    .activity-explorer, .activity-explorer * { box-sizing: border-box; }
    .activity-explorer { position: relative; width: 100%; min-height: 2033px; margin: 48px 0 96px; padding: 24px 0; background: #fff; color: #0b0f5e; font-family: "Plus Jakarta Sans", sans-serif; }
    .activity-explorer.is-empty-results { min-height: 0; }
    .sr-only { position: absolute !important; width: 1px !important; height: 1px !important; padding: 0 !important; overflow: hidden !important; clip: rect(0, 0, 0, 0) !important; white-space: nowrap !important; border: 0 !important; }
    .activity-explorer button, .activity-explorer input, .activity-explorer select { font: inherit; }
    .activity-explorer button { color: inherit; }
    .activity-explorer button:focus-visible, .activity-explorer a:focus-visible, .activity-explorer input:focus-visible, .activity-explorer select:focus-visible { outline: 3px solid #def279; outline-offset: 2px; }
    .activity-filters { display: flex; width: 100%; min-height: 60px; padding: 0 48px; align-items: flex-end; gap: 16px; }
    .activity-filters__search { display: grid; width: 354px; min-width: 280px; flex: 1 1 354px; grid-template-columns: minmax(0, 1fr) 32px; grid-template-rows: 16px 36px; align-items: end; row-gap: 8px; }
    .activity-field { display: flex; min-width: 103px; flex: 1 1 auto; flex-direction: column; gap: 8px; color: #0b0f5e; font-size: 14px; font-weight: 400; line-height: 16px; }
    .activity-field > span { white-space: nowrap; }
    .activity-field input, .activity-field select, .activity-pagination select { width: 100%; height: 36px; border: 2px solid rgb(66 66 246 / 25%); border-radius: 0; background-color: #fff; color: #5d76dd; font-size: 16px; font-weight: 700; line-height: 24px; }
    .activity-field input { padding: 4px 12px; }
    .activity-field select, .activity-pagination select { padding: 4px 34px 4px 10px; appearance: none; background-image: var(--select-chevron); background-position: right 12px center; background-repeat: no-repeat; background-size: 12px 8px; }
    .activity-field input:hover, .activity-field select:hover, .activity-pagination select:hover { border-color: #4242f6; }
    .activity-field input:focus, .activity-field select:focus { border-color: #4242f6; outline: 0; }
    .activity-field select:disabled { cursor: not-allowed; opacity: .55; }
    .activity-field--search { display: contents; width: calc(100% - 32px); }
    .activity-field--search > span { grid-column: 1 / -1; grid-row: 1; color: #0b0f5e; font-size: 14px; font-weight: 700; line-height: 16px; }
    .activity-field--search input { grid-column: 1; grid-row: 2; }
    .activity-field--search input { border-color: #4242f6; font-weight: 400; }
    .activity-search-button { width: 32px; height: 36px; grid-column: 2; grid-row: 2; flex: none; border: 0; background: #4242f6 var(--search-icon) center / 16px 16px no-repeat; cursor: pointer; }
    .activity-search-button:hover { background-color: #0b0f5e; }
    .activity-filters__desktop-fields { display: flex; min-width: 0; flex: 0 1 auto; align-items: flex-end; gap: 16px; }
    .activity-filters__desktop-fields > .activity-field:nth-child(1) { width: 109px; flex: 0 1 109px; }
    .activity-filters__desktop-fields > .activity-field:nth-child(2) { width: 103px; flex: 0 1 103px; }
    .activity-filters__desktop-fields > .activity-field:nth-child(3) { width: 133px; flex: 0 1 133px; }
    .activity-filters__desktop-fields > .activity-field:nth-child(4) { width: 240px; flex: 1 1 240px; }
    .activity-filters__desktop-fields > .activity-field:nth-child(5) { width: 183px; flex: 0 1 183px; }
    .activity-field--wide { min-width: 180px; }
    .activity-field--assessment { min-width: 160px; }
    .activity-explorer .activity-more-filters, .activity-explorer .activity-mobile-filter-button { position: relative; display: inline-flex; width: 126px; height: 36px; flex: none; align-items: center; justify-content: center; border: 2px solid #4242f6; background: #4242f6; padding: 4px 12px; color: #fff; font-family: "ETC Anybody", sans-serif; font-size: 14px; font-weight: 700; font-variation-settings: "wdth" 75; line-height: 24px; text-align: center; text-transform: uppercase; white-space: nowrap; cursor: pointer; }
    .activity-more-filters:hover, .activity-mobile-filter-button:hover { background: #0b0f5e; border-color: #0b0f5e; color: #fff; }
    [data-filter-count] { position: absolute; top: -11px; right: -9px; display: grid; width: 22px; height: 22px; place-items: center; border-radius: 50%; background: #ff5865; color: #fff; font-family: "Plus Jakarta Sans", sans-serif; font-size: 12px; line-height: 1; }
    .activity-explorer .activity-mobile-filter-button { display: none; }

    .activity-summary { display: flex; min-height: 72px; padding: 24px 48px; flex-direction: column; }
    .activity-summary__heading { display: flex; min-height: 24px; align-items: center; justify-content: space-between; gap: 24px; }
    .activity-summary h2 { margin: 0; font-family: "Plus Jakarta Sans", sans-serif; font-size: 16px; font-weight: 400; line-height: 24px; }
    .activity-explorer:not(.is-empty-results) .activity-summary h2::after { content: " encontradas"; }
    .activity-summary__heading > div { display: flex; align-items: center; gap: 24px; white-space: nowrap; }
    .activity-summary button, .activity-empty button { border: 0; background: none; padding: 0; color: #4242f6; font-size: 14px; font-weight: 400; line-height: 16px; cursor: pointer; }
    .activity-summary button::before { display: inline-block; margin-right: 4px; }
    .activity-summary [data-download]::before { content: "↓"; }
    .activity-summary [data-clear-filters]::before { content: "×"; }
    .activity-summary [data-clear-filters]:disabled { cursor: default; opacity: .55; }

    .activity-dashboard[hidden] { display: none; }
    .activity-dashboard { position: relative; display: flex; width: 100%; padding: 0 48px 24px; flex-direction: column; gap: 8px; }
    .activity-dashboard__overview { display: grid; height: 118px; grid-template-columns: 1fr 1fr; grid-template-rows: 74px 12px 20px; column-gap: 8px; }
    .activity-dashboard__score { display: flex; height: 74px; align-items: center; gap: 8px; font-family: "ETC Anybody", sans-serif; font-size: 18px; font-weight: 700; font-variation-settings: "wdth" 75; line-height: 24px; text-transform: uppercase; }
    .activity-dashboard__score--unfavorable { justify-content: flex-end; }
    .activity-dashboard__score b { font-size: 28px; line-height: 32px; }
    .activity-dashboard__paper { width: 36px; height: 51px; object-fit: contain; transform: rotate(5deg); }
    .activity-dashboard__score--favorable .activity-dashboard__paper { margin-right: -16px; }
    .activity-dashboard__score--unfavorable .activity-dashboard__paper { margin-left: -16px; }
    .activity-dashboard__thumb { width: 32px; height: 32px; }
    .activity-dashboard__bar { display: grid; grid-column: 1 / -1; width: 100%; height: 12px; grid-template-columns: minmax(0, var(--favorable-share, 50%)) minmax(0, calc(100% - var(--favorable-share, 50%))); gap: 2px; }
    .activity-dashboard__bar span:first-child { background: #c1e639; }
    .activity-dashboard__bar span:last-child { background: #ff5865; }
    .activity-dashboard__bar.is-empty { display: block; background: rgb(66 66 246 / 25%); }
    .activity-dashboard__bar.is-empty span { display: none; }
    .activity-dashboard__scale { display: flex; grid-column: 1 / -1; height: 20px; justify-content: space-between; color: rgb(11 15 94 / 75%); font-size: 12px; line-height: 12px; }
    .activity-dashboard__scale span { position: relative; min-width: 36px; padding-top: 8px; }
    .activity-dashboard__scale span:not(:first-child):not(:last-child) { text-align: center; }
    .activity-dashboard__scale span:last-child { text-align: right; }
    .activity-dashboard__scale span::before { position: absolute; top: 0; left: 0; width: 1px; height: 6px; background: rgb(66 66 246 / 25%); content: ""; }
    .activity-dashboard__scale span:not(:first-child):not(:last-child)::before { left: 50%; }
    .activity-dashboard__scale span:last-child::before { right: 0; left: auto; }

    .activity-dashboard__grid { display: grid; width: 100%; height: 752px; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
    .activity-dashboard__column { display: flex; min-width: 0; height: 752px; flex-direction: column; gap: 8px; }
    .activity-dashboard-card { position: relative; display: flex; min-width: 0; overflow: hidden; flex-direction: column; color: #0b0f5e; }
    .activity-dashboard-card--gender { height: 141px; }.activity-dashboard-card--house { height: 159px; }.activity-dashboard-card--category { height: 436px; }
    .activity-dashboard-card--state { height: 423px; }.activity-dashboard-card--status { height: 321px; }.activity-dashboard-card--party, .activity-dashboard-card--author { height: 752px; }
    .activity-dashboard-card > header { display: flex; height: 23px; min-width: 0; flex: 0 0 23px; align-items: flex-start; justify-content: space-between; border-bottom: 1px solid rgb(66 66 246 / 25%); }
    .activity-dashboard-card h3 { position: relative; z-index: 1; height: 23px; margin: 0 0 -1px; border: 1px solid rgb(66 66 246 / 25%); border-bottom-color: #fff; background: #fff; padding: 4px 12px 2px; font-family: "ETC Anybody", sans-serif; font-size: 14px; font-weight: 700; font-variation-settings: "wdth" 75; line-height: 16px; text-transform: uppercase; white-space: nowrap; }
    .activity-dashboard-card__title { display: flex; min-width: 0; height: 23px; align-items: flex-start; }
    .activity-dashboard-card header label { display: flex; min-width: 0; height: 23px; flex: none; align-items: center; gap: 3px; color: rgb(11 15 94 / 55%); font-size: 12px; line-height: 16px; white-space: nowrap; }
