---
import Papelada from "./Papelada.astro";
import SectionDivider from "./SectionDivider.astro";
import { pileGap } from "../../lib/papelada";
import thumbsDown from "../../assets/images/thumbs-down.svg";
import info from "../../assets/images/redesign/home-chart/info.svg";
import attention from "../../assets/images/redesign/hero/attention.svg";
import { getUnfavorableByCategory } from "../../service/api/stats";

// A API devolve 10 categorias; o gráfico do design tem 8 colunas.
const COLUMNS = 7;
// Escala do design: pilhas de 46px de largura, a mais alta com 127px.
const PILE_WIDTH = 46;
const PILE_PEAK = 127;

const categories = (await getUnfavorableByCategory()).slice(0, COLUMNS);
const gap = pileGap({
    width: PILE_WIDTH,
    height: PILE_PEAK,
    peak: Math.max(...categories.map((category) => category.unfavorable), 1),
});

const themes = categories.map((category, index) => {
    const isFirst = index === 0;
    return {
        count: category.unfavorable,
        title: category.label,
        // ponytail: largura pelo tamanho do rótulo. Se algum título novo quebrar
        // feio, vira um mapa de largura por categoria.
        width:
            category.label.length > 24
                ? 192
                : category.label.length > 14
                  ? 147
                  : 110,
        chartWidth: isFirst ? 113 : 66,
        countSize: isFirst ? 36 : 28,
        label: isFirst,
    };
});
---

<div class="legislative-setbacks-spacing">
<section
    class="tw:overflow-hidden tw:bg-white tw:text-[#0B0F5E] tw:lg:pt-12"
    aria-labelledby="legislative-setbacks-title"
>
    <div
        class="tw:mx-auto tw:flex tw:w-full tw:max-w-[1352px] tw:flex-col tw:gap-2.5 tw:px-6 tw:py-12 tw:lg:h-[657px] tw:lg:w-[1352px] tw:lg:max-w-none tw:lg:p-12"
    >
        <header
            class="tw:mx-auto tw:flex tw:w-full tw:max-w-[720px] tw:flex-col tw:items-start tw:gap-4 tw:lg:mx-auto tw:h-[126px]"
        >
            <img class="tw:h-1 tw:w-24" src={attention.src} alt="" />
            <h2
                id="legislative-setbacks-title"
                class="tw:m-0 tw:w-full tw:font-[ETC_Anybody] tw:text-[28px] tw:font-bold tw:leading-[34px] tw:uppercase tw:[font-variation-settings:'wdth'_75] tw:sm:text-[36px] tw:sm:leading-[42px]"
            >
                Estes são Os temas com mais<br class="tw:hidden tw:sm:block" /> retrocesso
                no legislativo
            </h2>
            <p
                class="tw:m-0 tw:w-full tw:font-[Plus_Jakarta_Sans] tw:text-[18px] tw:leading-6"
            >
                Lorem ipsum dolor sit amet, consectetur adipiscing elit
            </p>
        </header>

        <figure
            class="tw:m-0 tw:h-[383px] tw:w-full tw:overflow-x-auto tw:py-6"
        >
            <div
                class="tw:relative tw:mx-auto tw:flex tw:h-[335px] tw:min-w-[1256px] tw:items-end tw:gap-6"
            >
                {
                    themes.map((theme) => (
                        <article
                            class="tw:relative tw:flex tw:h-full tw:shrink-0 tw:flex-col tw:items-center tw:justify-end tw:gap-4 tw:py-4"
                            style={`width: ${theme.width}px;`}
                            aria-label={`${theme.count} proposições desfavoráveis: ${theme.title}`}
                        >
                            <div
                                class="tw:absolute tw:bottom-[124px] tw:left-1/2 tw:flex tw:-translate-x-1/2 tw:flex-col tw:items-center tw:justify-end tw:gap-2"
                                style={`width: ${theme.chartWidth}px;`}
                            >
                                <div
                                    class={`legislative-setbacks__indicator tw:flex tw:items-center tw:justify-center tw:gap-2 ${theme.label ? "tw:flex-col tw:gap-1" : "tw:flex-row"}`}
                                >
                                    <div class="legislative-setbacks__indicator-value tw:flex tw:items-center tw:justify-center tw:gap-2">
                                        <span
                                            class={`legislative-setbacks__indicator-number tw:font-[ETC_Anybody] tw:font-bold tw:leading-8 tw:uppercase tw:[font-variation-settings:'wdth'_75] ${theme.countSize === 36 ? "tw:text-[36px] tw:leading-[42px]" : "tw:text-[28px]"}`}
                                        >
                                            {theme.count}
                                        </span>
                                        <span class="legislative-setbacks__indicator-thumb tw:relative tw:block tw:size-8 tw:shrink-0 tw:rounded-full">
                                            <img
                                                class="tw:block tw:size-full"
                                                src={thumbsDown.src}
                                                alt=""
                                            />
                                        </span>
                                    </div>
                                    {theme.label && (
                                        <span class="legislative-setbacks__desktop-unfavorable tw:font-[ETC_Anybody] tw:text-[20px] tw:font-bold tw:leading-6 tw:uppercase tw:[font-variation-settings:'wdth'_75]">
                                            Desfavoráveis
                                        </span>
                                    )}
                                    {theme.label && (
                                        <span class="legislative-setbacks__mobile-unfavorable">Desfavoráveis</span>
                                    )}
                                </div>
                                <Papelada
                                    class="tw:w-[46px]"
                                    arrangement="pile"
                                    category="desfavoravel"
                                    size="a4"
                                    gap={gap}
                                    amount={theme.count}
                                />
                            </div>
                            <div class="tw:absolute tw:top-[227px] tw:flex tw:h-[92px] tw:w-full tw:flex-col tw:items-center tw:justify-center tw:gap-1 tw:py-2">
                                <img class="tw:size-6" src={info.src} alt="" />
                                <h3 class="tw:m-0 tw:text-center tw:font-[ETC_Anybody] tw:text-[20px] tw:font-bold tw:leading-6 tw:uppercase tw:[font-variation-settings:'wdth'_75]">
                                    {theme.title}
                                </h3>
                            </div>
                        </article>
                    ))
                }
            </div>
        </figure>

        <SectionDivider
            content="Lorem ipsum dolor sit amet, consectetur adipiscing eli"
            class="tw:flex tw:w-full tw:items-start tw:justify-between tw:gap-6 tw:border-t tw:border-[#0B0F5E] tw:pt-2 tw:font-[Plus_Jakarta_Sans] tw:text-[14px] tw:leading-4 tw:lg:h-8"
        />
    </div>
</section>
</div>

<style>
    /* This extra element only participates in the mobile indicator layout. */
    .legislative-setbacks__mobile-unfavorable { display: none; }
    section[aria-labelledby="legislative-setbacks-title"] footer :global(span) { padding-top: 4px; }
    section[aria-labelledby="legislative-setbacks-title"] footer :global(img) { width: 113.217px; height: 12px; margin-top: 4px; flex-shrink: 0; }

    @media (max-width: 767px) {
        section[aria-labelledby="legislative-setbacks-title"] > div {
            box-sizing: border-box;
            width: 100%; height: auto; padding: 24px 16px; gap: 10px;
        }
        section[aria-labelledby="legislative-setbacks-title"] header {
            width: 100%; max-width: none; height: auto; gap: 16px;
        }
        section[aria-labelledby="legislative-setbacks-title"] header h2 {
            font-size: 28px; line-height: 32px;
        }
        section[aria-labelledby="legislative-setbacks-title"] header p {
            font-size: 14px; line-height: 24px;
        }
        section[aria-labelledby="legislative-setbacks-title"] figure {
            height: auto; overflow: visible; padding: 24px 0;
        }
        section[aria-labelledby="legislative-setbacks-title"] figure > div {
            display: grid; width: 100%; max-width: 100%; min-width: 0; height: auto;
            margin: 0 auto;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            grid-template-rows: none; grid-auto-rows: auto;
            align-items: stretch;
            gap: 24px;
        }
        section[aria-labelledby="legislative-setbacks-title"] figure article {
            width: auto !important; min-width: 0; min-height: 0; height: auto;
            padding: 16px 0;
            transform: none !important;
        }
        section[aria-labelledby="legislative-setbacks-title"] figure article > div:first-child {
            display: flex; position: static;
            width: 100% !important;
            max-width: 288px;
            top: auto; right: auto; bottom: auto; left: auto;
            align-items: center;
            justify-content: flex-end;
            gap: 8px;
            transform: none;
            translate: none;
        }
        section[aria-labelledby="legislative-setbacks-title"] figure article > div:last-child {
            position: static;
            top: auto; right: auto; bottom: auto; left: auto;
            height: 92px;
            justify-content: center;
            gap: 4px;
            padding: 8px 0;
            box-sizing: border-box;
            transform: none;
            translate: none;
        }
        .legislative-setbacks__indicator {
            display: inline-flex !important;
            max-width: 288px;
            flex-direction: column !important;
            align-items: center !important;
            justify-content: flex-end !important;
            gap: 8px !important;
        }
        .legislative-setbacks__indicator-value {
            align-items: center !important;
            justify-content: center !important;
            gap: 4px !important;
        }
        .legislative-setbacks__indicator-number {
            color: #0B0F5E;
            font-family: "ETC Anybody", "Anybody", sans-serif;
            font-size: 36px !important;
            font-style: normal;
            font-weight: 700;
            line-height: 42px !important;
            text-align: center;
            text-transform: uppercase;
        }
        .legislative-setbacks__indicator-thumb {
            width: 32px !important;
            height: 32px !important;
            aspect-ratio: 1 / 1;
            border-radius: 999px;
        }
        .legislative-setbacks__indicator-thumb img {
            inset: 0 !important;
            width: 100% !important;
            height: 100% !important;
        }
        .legislative-setbacks__desktop-unfavorable { display: none; }
        .legislative-setbacks__mobile-unfavorable {
            display: block;
            color: #0B0F5E;
            font-family: ETC Anybody, Anybody, sans-serif;
            font-size: 20px;
            font-style: normal;
            font-weight: 700;
            line-height: 24px;
            text-align: center;
            text-transform: uppercase;
            white-space: nowrap;
        }
        section[aria-labelledby="legislative-setbacks-title"] figure article > div:first-child canvas {
            width: 46px !important;
            height: auto !important;
            flex: none;
        }
        section[aria-labelledby="legislative-setbacks-title"] figure article > div:last-child img {
            width: 24px !important;
            height: 24px !important;
            flex: none;
        }
        section[aria-labelledby="legislative-setbacks-title"] figure article > div:last-child h3 {
            width: 100%;
            min-width: 96px;
            max-width: 192px;
            min-height: 48px;
            margin: 0;
            color: #0B0F5E;
            font-family: "ETC Anybody", "Anybody", sans-serif;
            font-size: 20px;
            font-style: normal;
            font-weight: 700;
            line-height: 24px;
            text-align: center;
            text-transform: uppercase;
            mix-blend-mode: multiply;
            white-space: normal;
        }
        section[aria-labelledby="legislative-setbacks-title"] footer {
            display: flex;
            width: min(251px, 100%);
            height: 96px;
            margin: 0 auto;
            padding-top: 8px;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            gap: 24px;
            box-sizing: border-box;
            text-align: center;
        }
        section[aria-labelledby="legislative-setbacks-title"] footer :global(span) {
            width: 100%;
            padding: 4px 0;
            font-size: 14px;
            line-height: 16px;
        }
        section[aria-labelledby="legislative-setbacks-title"] footer :global(img) {
            width: 113.217px;
            height: 12px;
            margin: 6px 0 0;
        }
    }

    @media (min-width: 821px) {
        .legislative-setbacks-spacing {
            width: 100%;
            padding-block: 48px;
            background-color: #fff;
            background-image: none;
        }
        section[aria-labelledby="legislative-setbacks-title"] { margin: 0; padding-top: 0; }
        section[aria-labelledby="legislative-setbacks-title"] h2 {
            height: 66px;
            line-height: 32px;
        }
        section[aria-labelledby="legislative-setbacks-title"] figure > div > article > div:last-child {
            display: grid;
            grid-template-rows: 24px 48px;
            row-gap: 4px;
            align-items: start;
            justify-items: center;
            padding: 8px 0;
        }
        section[aria-labelledby="legislative-setbacks-title"] figure > div > article > div:last-child img {
            width: 24px;
            height: 24px;
        }
        section[aria-labelledby="legislative-setbacks-title"] figure > div > article > div:last-child h3 {
            width: 100%;
            height: 48px;
            min-height: 48px;
            margin: 0;
            line-height: 24px;
        }
    }
</style>
