---
import AlertsSearch from "./AlertsSearch.astro";
import AlertsSort from "./AlertsSort.astro";
---

<div class="alerts-toolbar">
    <AlertsSearch />
    <AlertsSort />
</div>

<style>
    .alerts-toolbar { align-items: center; display: flex; gap: 16px; height: 55px; width: 816px; }
    @media (max-width: 940px) { .alerts-toolbar { width: 100%; } }
    @media (max-width: 700px) { .alerts-toolbar { align-items: stretch; flex-direction: column; height: auto; } }
</style>
