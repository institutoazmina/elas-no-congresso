---
import chevron from "../../../assets/images/redesign/home-reportagens/chevron-right.svg";
import { getCategoryOptions } from "../../../service/api/alerts";
import AlertsEmailDialog from "./AlertsEmailDialog";
import AlertsProposalCombobox from "./AlertsProposalCombobox";

const categories = await getCategoryOptions();
---

<AlertsEmailDialog client:load>
        <div class="alerts-email-modal__content">
            <header class="alerts-email-modal__intro">
                <h2 id="alerts-email-modal-title">Receba alertas do que acontece no Congresso Nacional!</h2>
                <p id="alerts-email-modal-description"><span>Quer saber quando uma nova proposta sobre gênero é apresentada,<br />ou quando algo de muita importância avança? A gente te avisa!</span><br /><span class="alerts-email-modal__intro-choice">Escolha como e quando quer receber os e-mails.</span></p>
            </header>

            <form class="alerts-email-modal__form">
                <div class="alerts-email-modal__email-field">
                    <label for="alerts-email">E-mail</label>
                    <input id="alerts-email" type="email" placeholder="seu@email.com" autocomplete="email" />
                </div>

                <fieldset class="alerts-email-modal__section" data-alerts-themes>
                    <legend>Temas</legend>
                    <p>Selecione os temas sobre os quais quer receber alertas.<br />Valem para alertas semanais e diários.</p>
                    <div class="alerts-email-modal__topics">
                        {categories.map((category) => (
                            <label><input type="checkbox" name="tema" value={category.value} /><span>{category.label}</span></label>
                        ))}
                    </div>
                </fieldset>

                <fieldset class="alerts-email-modal__section alerts-email-modal__frequency-section">
                    <legend>Frequência</legend>
                    <p>Escolha uma das opções.<br />Cada frequência tem regras diferentes — leia antes de selecionar.</p>
                    <div class="alerts-email-modal__frequencies">
                        <div class="alerts-email-modal__weekly-card">
                            <label class="alerts-email-modal__frequency-card">
                                <span class="alerts-email-modal__frequency-heading"><strong>Semanal</strong><input type="radio" name="frequencia" value="semanal" /></span>
                                <span>Um resumo semanal dos temas selecionados que acompanha a newsletter do Elas no Congresso.</span>
                            </label>
                            <aside class="alerts-email-modal__weekly-note" hidden aria-label="Informação sobre a newsletter">
                                <p>A newsletter do Elas no Congresso reúne, contextualiza e analisa os impactos políticos das tramitações.</p>
                            </aside>
                        </div>
                        <label class="alerts-email-modal__frequency-card alerts-email-modal__daily-card">
                            <span class="alerts-email-modal__frequency-heading"><strong>Diário</strong><input type="radio" name="frequencia" value="diario" /></span>
                            <span>Alertas enviados assim que uma movimentação acontecer.</span>
                        </label>
                    </div>
                    <section class="alerts-email-modal__daily-options" hidden aria-label="Filtros para alertas diários">
                        <p class="alerts-email-modal__daily-intro">Escolha uma proposição para filtrar seus alertas diários.</p>
                        <section class="alerts-email-modal__daily-control" aria-label="Proposição">
                            <h3>Proposição</h3>
                            <div class="alerts-email-modal__daily-select-wrap">
                                <AlertsProposalCombobox client:load />
                            </div>
                            <p class="alerts-email-modal__daily-helper">Opcional. Deixe em branco para receber alertas de todas as proposições dos temas selecionados.</p>
                        </section>
                    </section>
                </fieldset>

                <label class="alerts-email-modal__terms"><input type="checkbox" name="termos" /><span>Li e aceito os <a href="/termos-de-uso">Termos de Uso</a> e a <a href="/politica-de-privacidade">Política de Privacidade</a> do Elas no Congresso.</span></label>
                <button class="alerts-email-modal__submit" type="submit" disabled>Quero me inscrever <img src={chevron.src} alt="" /></button>
            </form>
            <p class="alerts-email-modal__status" data-alerts-status role="status" aria-live="polite" hidden></p>
        </div>
</AlertsEmailDialog>

<script>
    import { PUBLIC_API_BASE_URL } from "astro:env/client";
    import { buildAst } from "../../../lib/alerts/ast.ts";

    let activeWindowListeners: AbortController | null = null;

    const initializeAlertsEmailModal = () => {
    const dialog = document.querySelector<HTMLElement>(".alerts-email-modal");
    if (!dialog) {
        activeWindowListeners?.abort();
        activeWindowListeners = null;
        return;
    }
    if (dialog.dataset.alertsEmailModalInitialized) return;
    activeWindowListeners?.abort();
    activeWindowListeners = new AbortController();
    dialog.dataset.alertsEmailModalInitialized = "true";
    const siteHeader = document.querySelector<HTMLElement>(".redesign-header");
    const opener = document.querySelector<HTMLButtonElement>(".alerts-hero__button");
    const form = dialog?.querySelector<HTMLFormElement>(".alerts-email-modal__form");
    const email = dialog?.querySelector<HTMLInputElement>("#alerts-email");
    let topics = Array.from(dialog?.querySelectorAll<HTMLInputElement>('input[name="tema"]') ?? []);
    const weekly = dialog?.querySelector<HTMLInputElement>('input[name="frequencia"][value="semanal"]');
    const terms = dialog?.querySelector<HTMLInputElement>('input[name="termos"]');
    const submit = dialog?.querySelector<HTMLButtonElement>(".alerts-email-modal__submit");
    const status = dialog?.querySelector<HTMLElement>("[data-alerts-status]");
    const weeklyNote = dialog?.querySelector<HTMLElement>(".alerts-email-modal__weekly-note");
    const daily = dialog?.querySelector<HTMLInputElement>('input[name="frequencia"][value="diario"]');
    const dailyOptions = dialog?.querySelector<HTMLElement>(".alerts-email-modal__daily-options");
    const proposalIds = () => Array.from(dialog?.querySelectorAll<HTMLInputElement>("[data-alerts-proposal-id]") ?? [])
        .map((input) => Number(input.value));

    const say = (message: string, kind: "erro" | "ok" | "" = "") => {
        if (!status) return;
        status.textContent = message;
        status.hidden = !message;
        status.dataset.kind = kind;
    };

    const updateSubmitState = () => {
        if (!submit || !email || !weekly || !daily || !terms) return;
        const temTema = topics.some((topic) => topic.checked);
        const temFrequencia = weekly.checked || daily.checked;
        submit.disabled = !(
            email.validity.valid && email.value && temTema && temFrequencia && terms.checked
        );
    };

    const syncHeaderHeight = () => {
        if (!siteHeader) return;
        document.documentElement.style.setProperty("--alerts-header-height", `${siteHeader.getBoundingClientRect().height}px`);
    };

    const isDesktopModal = () => window.matchMedia("(min-width: 821px)").matches;
    const setModalState = (expanded: boolean) => {
        if (!dialog) return;
        const desktop = isDesktopModal();
        dialog.dataset.state = desktop && expanded ? "expanded" : "initial";
    };
    const expandModal = () => {
        if (isDesktopModal()) setModalState(true);
    };
    const syncModalState = () => {
        setModalState(Boolean(email?.value.trim()));
    };

    opener?.addEventListener("click", () => {
        if (window.matchMedia("(max-width: 767px)").matches) {
            window.scrollTo(0, 0);
        }
        syncHeaderHeight();
        syncModalState();
        document.body.classList.add("alerts-email-modal-open");
        document.dispatchEvent(new Event("alerts-email-dialog-open"));
    });
    document.addEventListener("alerts-email-dialog-closed", () => {
        setModalState(false);
        document.body.classList.remove("alerts-email-modal-open");
        if (isDesktopModal()) opener?.focus();
    }, { signal: activeWindowListeners.signal });
    window.addEventListener("resize", syncHeaderHeight, { signal: activeWindowListeners.signal });
    window.addEventListener("resize", syncModalState, { signal: activeWindowListeners.signal });

    email?.addEventListener("focus", expandModal);
    email?.addEventListener("input", () => {
        expandModal();
        updateSubmitState();
    });
    email?.addEventListener("change", expandModal);
    terms?.addEventListener("change", updateSubmitState);
    topics.forEach((topic) => topic.addEventListener("change", updateSubmitState));

    const updateFrequency = () => {
        if (!weekly || !daily) return;
        if (weeklyNote) weeklyNote.hidden = !weekly.checked;
        if (dailyOptions) dailyOptions.hidden = !daily.checked;
        dialog?.classList.toggle("alerts-email-modal--weekly-open", weekly.checked);
        dialog?.classList.toggle("alerts-email-modal--daily-open", daily.checked);
        updateSubmitState();
    };
    weekly?.addEventListener("change", updateFrequency);
    daily?.addEventListener("change", updateFrequency);

    form?.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!submit || !email || !weekly || !daily || !terms) return;

        const categorias = topics.filter((topic) => topic.checked).map((topic) => topic.value);
        const alerts: { frequency: string; ast: unknown }[] = [];
        if (weekly.checked) alerts.push({ frequency: "weekly", ast: buildAst({ categorias }) });
        if (daily.checked) {
            alerts.push({
                frequency: "daily",
                ast: buildAst({
                    categorias,
                    proposicoes: proposalIds(),
                }),
            });
        }

        submit.disabled = true;
        say("Enviando…");
        try {
            const isLocal = ["localhost", "127.0.0.1", "[::1]"].includes(window.location.hostname);
            const apiBase = isLocal ? `${window.location.origin}/api/v1` : PUBLIC_API_BASE_URL;
            const resposta = await fetch(`${apiBase}/subscriptions/`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ email: email.value, accepted_terms: terms.checked, alerts }),
            });
            if (resposta.status === 429) {
                say("Muitas tentativas deste dispositivo. Tente de novo daqui a pouco.", "erro");
                return;
            }
            if (!resposta.ok) throw new Error(String(resposta.status));
            form.hidden = true;
            dialog.classList.add("alerts-email-modal--success");
            say(`Quase lá! Enviamos um e-mail para ${email.value}. Confira sua caixa de entrada e clique no link de confirmação para ativar sua assinatura. Se não encontrar, verifique também a pasta de spam.`, "ok");
        } catch {
            say("Não conseguimos concluir a inscrição. Tente novamente em alguns minutos.", "erro");
        } finally {
            updateSubmitState();
        }
    });

    syncModalState();
    updateSubmitState();
    };

    initializeAlertsEmailModal();
    const alertsEmailModalObserver = new MutationObserver(initializeAlertsEmailModal);
    alertsEmailModalObserver.observe(document.documentElement, { childList: true, subtree: true });
    document.addEventListener("alerts-email-dialog-mounted", initializeAlertsEmailModal);
    document.addEventListener("astro:after-swap", initializeAlertsEmailModal);
    document.addEventListener("astro:page-load", initializeAlertsEmailModal);
</script>

<style is:global>
    :global(body.alerts-email-modal-open) { overflow: auto; }
    .alerts-email-dialog-host, .alerts-email-dialog-portal, .alerts-email-dialog-viewport { width: 100%; background: #fff; }
    .alerts-email-modal, .alerts-email-modal * { box-sizing: border-box; }
    .alerts-email-modal { position: relative; width: min(672px, calc(100vw - 48px)); margin: 0 auto; padding: 0; border: 0; background: #fff; color: #1e2546; }
    .alerts-email-modal__shell { min-height: 100%; }
    .alerts-email-modal__close-row { display: flex; width: 624px; max-width: calc(100% - 48px); height: 92px; margin: 0 auto; padding-top: 50px; justify-content: flex-end; }
    .alerts-email-modal__close { display: grid; width: 42px; height: 42px; place-items: center; padding: 0 0 4px; border: 2.222px solid #1e2546; background: #fff; color: #1e2546; font-family: Arial, sans-serif; font-size: 37px; font-weight: 400; line-height: 1; cursor: pointer; }
    .alerts-email-modal__content { display: flex; width: 100%; padding: 80px 24px 40px; flex-direction: column; align-items: flex-start; gap: 24px; }
    .alerts-email-modal--success .alerts-email-modal__content { padding-bottom: 120px; }
    .alerts-email-modal__intro { width: 624px; max-width: 100%; }
    .alerts-email-modal h2, .alerts-email-modal p { margin: 0; }
    .alerts-email-modal h2 { color: #1e2546; font-family: "ETC Anybody", "Anybody", sans-serif; font-size: 33px; font-weight: 800; font-variation-settings: "wdth" 75; line-height: 45px; }
    .alerts-email-modal__intro p, .alerts-email-modal__section > p { color: #998d96; font-family: "Plus Jakarta Sans", sans-serif; font-size: 16px; font-weight: 400; line-height: 24px; }
    .alerts-email-modal__intro p { padding-top: 16px; }
    .alerts-email-modal__form { display: flex; width: 624px; max-width: 100%; padding-top: 40px; flex-direction: column; align-items: flex-start; }
    .alerts-email-modal__email-field { display: flex; width: 100%; flex-direction: column; gap: 5px; }
    .alerts-email-modal__email-field label, .alerts-email-modal fieldset > legend, .alerts-email-modal__daily-options legend, .alerts-email-modal__select-label { padding: 0; color: #1e2546; font-family: "ETC Anybody", "Anybody", sans-serif; font-size: 20px; font-weight: 700; font-variation-settings: "wdth" 75; line-height: 24px; text-transform: uppercase; }
    .alerts-email-modal input, .alerts-email-modal select { accent-color: #def279; }
    .alerts-email-modal__email-field input { width: 100%; height: 50px; padding: 12px 16px; border: 1px solid #998d96; border-radius: 0; color: #1e2546; font: 400 18px/24px "Plus Jakarta Sans", sans-serif; }
    .alerts-email-modal__email-field input:not(:placeholder-shown) { border: 2px solid #0b0f5e; }
    .alerts-email-modal__email-field input::placeholder, .alerts-email-modal__select-label input::placeholder { color: #998d96; opacity: 1; }
    .alerts-email-modal__section { width: 100%; min-width: 0; margin: 0; padding: 0; border: 0; }
    .alerts-email-modal__section > legend { margin: 0; }
    .alerts-email-modal__section > p { padding-top: 5px; }
    .alerts-email-modal__topics { display: grid; grid-template-columns: repeat(2, 300px); gap: 12px 24px; padding-top: 16px; }
    .alerts-email-modal__topics label, .alerts-email-modal__terms, .alerts-email-modal__daily-options label, .alerts-email-modal__daily-options fieldset label { display: flex; align-items: center; gap: 10px; color: #998d96; font: 400 16px/24px "Plus Jakarta Sans", sans-serif; }
    .alerts-email-modal input[type="checkbox"], .alerts-email-modal__frequency-card input[type="radio"] { position: relative; width: 16px; height: 16px; margin: 0; appearance: none; border: 1px solid #998d96; border-radius: 0; background: #fff; flex: 0 0 16px; }
    .alerts-email-modal input[type="checkbox"]:checked, .alerts-email-modal__frequency-card input[type="radio"]:checked { border: 2px solid #0b0f5e; background: #def279; }
    .alerts-email-modal input[type="checkbox"]:checked::after, .alerts-email-modal__frequency-card input[type="radio"]:checked::after { position: absolute; top: 2px; left: 2px; width: 8px; height: 5px; border-bottom: 2px solid #0b0f5e; border-left: 2px solid #0b0f5e; content: ""; transform: rotate(-45deg); }
    .alerts-email-modal__topics input:checked + span { padding: 3.195px 5px; background: #def279; color: #0b0f5e; }
    .alerts-email-modal__frequencies { display: grid; grid-template-columns: repeat(2, 304px); gap: 16px; padding-top: 25px; }
    .alerts-email-modal__weekly-card { display: flex; min-height: 146.25px; flex-direction: column; gap: 16px; }
    .alerts-email-modal__weekly-card .alerts-email-modal__frequency-card { height: 100%; }
    .alerts-email-modal__frequency-card { display: flex; min-height: 146.25px; padding: 21px; flex-direction: column; border: 1px solid #998d96; background: #fff; color: #998d96; font: 400 14px/16px "Plus Jakarta Sans", sans-serif; cursor: pointer; }
    .alerts-email-modal__frequency-card:has(input:checked) { padding: 22px; border: 2px solid #0b0f5e; }
    .alerts-email-modal__frequency-card input[type="radio"] { width: 20px; height: 20px; flex-basis: 20px; }
    .alerts-email-modal__frequency-card input[type="radio"]:checked::after { top: 3px; left: 3px; width: 10px; height: 7px; }
    .alerts-email-modal__frequency-heading { display: flex; align-items: center; justify-content: space-between; color: #1e2546; font-family: "ETC Anybody", "Anybody", sans-serif; font-size: 18px; font-weight: 700; font-variation-settings: "wdth" 75; line-height: 24px; text-transform: uppercase; }
    .alerts-email-modal__frequency-card > span:last-child { padding-top: 12px; }
    .alerts-email-modal__frequency-section { position: relative; }
    .alerts-email-modal__weekly-note { display: flex; width: 180.232px; min-height: 110.229px; align-items: center; justify-content: center; align-self: flex-end; padding: 12.614px 18.716px; background: #def279; color: #0b0f5e; filter: drop-shadow(0 3.119px 0 #0b0f5e); font-family: "Plus Jakarta Sans", sans-serif; font-size: 12px; font-weight: 500; line-height: 17px; text-align: center; transform: rotate(-3.215deg); transform-origin: center; }
    .alerts-email-modal__weekly-note p { width: 142.801px; }
    .alerts-email-modal__daily-options { position: relative; z-index: 2; width: 624px; margin-top: 16px; padding: 21px; border: 1px solid rgba(30, 37, 70, .12); background: #0b0f5e; color: #fff; }
    .alerts-email-modal__daily-options::before { position: absolute; top: -8px; left: 458px; width: 12px; height: 12px; background: #0b0f5e; content: ""; transform: rotate(45deg); }
    .alerts-email-modal__daily-options h3, .alerts-email-modal__daily-options p { margin: 0; }
    .alerts-email-modal__daily-intro { display: flex; width: 100%; min-height: 46px; align-items: center; padding: 15px 17px; background: #2b65d9; color: #fff; font: 400 12px/16px "Plus Jakarta Sans", sans-serif; }
    .alerts-email-modal__daily-control { width: 582px; padding-top: 20px; }
    .alerts-email-modal__daily-control h3 { color: #fff; font-family: "ETC Anybody", "Anybody", sans-serif; font-size: 18px; font-weight: 700; font-variation-settings: "wdth" 75; line-height: 24px; text-transform: uppercase; }
    .alerts-email-modal__daily-select-wrap { position: relative; margin-top: 8px; }
    .alerts-email-modal__proposal-input { display: block; width: 100%; height: 50px; padding: 12px 16px; border: 1px solid rgba(30, 37, 70, .15); border-radius: 0; background: #fff; color: #0b0f5e; font: 400 16px/20px "Plus Jakarta Sans", sans-serif; }
    .alerts-email-modal__proposal-input::placeholder { color: #998d96; opacity: 1; }
    .alerts-email-modal__proposal-input:focus-visible { outline: 2px solid #def279; outline-offset: 2px; }
    .alerts-email-modal__proposal-positioner { z-index: 101; outline: none; }
    .alerts-email-modal__proposal-popup { width: var(--anchor-width); border: 1px solid rgba(30, 37, 70, .15); background: #fff; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, .1), 0 4px 6px -4px rgba(0, 0, 0, .1); color: #0b0f5e; }
    .alerts-email-modal__proposal-list { max-height: 240px; overflow-y: auto; padding: 0; }
    .alerts-email-modal__proposal-item { display: grid; min-height: 46px; align-items: center; grid-template-columns: minmax(0, 1fr) 20px; gap: 8px; padding: 10px 16px; border-bottom: 1px solid rgba(30, 37, 70, .15); background: #fff; color: #0b0f5e; font: 400 14px/20px "Plus Jakarta Sans", sans-serif; cursor: pointer; outline: none; }
    .alerts-email-modal__proposal-item:last-child { border-bottom: 0; }
    .alerts-email-modal__proposal-item[data-highlighted] { background: #def279; }
    .alerts-email-modal__proposal-item[data-selected] { background: #4242f6; color: #fff; }
    .alerts-email-modal__proposal-indicator { justify-self: end; font-weight: 700; }
    .alerts-email-modal__proposal-message { display: block; padding: 12px 16px; color: #998d96; font: 400 14px/20px "Plus Jakarta Sans", sans-serif; }
    .alerts-email-modal__proposal-combobox { display: flex; width: 100%; flex-direction: column; gap: 10px; }
    .alerts-email-modal__selected-proposals { display: flex; flex-wrap: wrap; gap: 8px; }
    .alerts-email-modal__proposal-chip { display: inline-flex; min-height: 34px; align-items: center; gap: 10px; padding: 5px 6px 5px 10px; border: 1px solid #def279; background: #def279; color: #0b0f5e; font: 700 14px/20px "Plus Jakarta Sans", sans-serif; }
    .alerts-email-modal__proposal-remove { display: grid; width: 24px; height: 24px; place-items: center; padding: 0 0 2px; border: 0; background: #0b0f5e; color: #fff; font: 400 21px/1 Arial, sans-serif; cursor: pointer; }
    .alerts-email-modal__proposal-remove:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
    .alerts-email-modal__daily-helper { width: 582px; padding-top: 6px; color: rgba(30, 37, 70, .35); font: 400 14px/20px "Plus Jakarta Sans", sans-serif; }
    .alerts-email-modal__terms { padding-top: 28px; color: #998d96; font-size: 14px; line-height: 20px; }
    .alerts-email-modal--weekly-open .alerts-email-modal__terms { padding-top: 28px; }
    .alerts-email-modal--daily-open .alerts-email-modal__terms { padding-top: 28px; }
    .alerts-email-modal .alerts-email-modal__status { width: 100%; margin-top: 24px; padding: 12px 16px; background: #f4f2f4; color: #1e2546; font: 400 15px/22px "Plus Jakarta Sans", sans-serif; }
    .alerts-email-modal__status[data-kind="ok"] { background: #def279; color: #0b0f5e; }
    .alerts-email-modal__status[data-kind="erro"] { background: #ffe3e3; color: #8a1f1f; }
    .alerts-email-modal__terms a { color: #1e2546; font-weight: 700; }
    .alerts-email-modal__submit { display: flex; height: 56px; margin: 32px 0 0 auto; padding: 18px 20px 14px 24px; align-items: center; justify-content: center; gap: 8px; border: 0; border-radius: 0; background: #4242f6; color: #fff; font-family: "ETC Anybody", "Anybody", sans-serif; font-size: 18px; font-weight: 700; font-variation-settings: "wdth" 75; line-height: 24px; text-transform: uppercase; cursor: pointer; }
    .alerts-email-modal__submit:disabled { background: #c3c5ff; cursor: default; }
    .alerts-email-modal__submit:not(:disabled) { padding-right: 24px; }
    .alerts-email-modal__submit:not(:disabled) img { display: none; }
    .alerts-email-modal__submit img { width: 13.414px; height: 8.121px; transform: rotate(-90deg); filter: brightness(0) invert(1); }
    @media (min-width: 821px) {
        .alerts-email-modal {
            background-color: #fff;
            background-image: none;
            opacity: 1;
        }
        .alerts-email-modal__shell,
        .alerts-email-modal__content { background-color: #fff; background-image: none; opacity: 1; }
        .alerts-email-modal__content { gap: 0; }
        .alerts-email-modal__intro { display: flex; margin-inline: auto; flex-direction: column; gap: 16px; }
        .alerts-email-modal__intro p { width: 624px; max-width: 100%; padding-top: 0; margin: 0; }
        .alerts-email-modal[data-state="initial"] .alerts-email-modal__intro { align-items: center; text-align: center; }
        .alerts-email-modal[data-state="initial"] h2 { color: #1e2546; font-size: 36px; font-weight: 700; line-height: 42px; text-align: center; text-transform: uppercase; }
        .alerts-email-modal[data-state="initial"] .alerts-email-modal__intro p { margin-inline: auto; color: #998d96; text-align: center; }
        .alerts-email-modal[data-state="expanded"] .alerts-email-modal__intro { align-items: flex-start; text-align: left; }
        .alerts-email-modal[data-state="expanded"] h2 { color: #1e2546; font-size: 33px; font-weight: 800; font-variation-settings: "wdth" 100; line-height: 45px; text-align: left; text-transform: none; }
        .alerts-email-modal[data-state="expanded"] .alerts-email-modal__intro p { text-align: left; }
        .alerts-email-modal__form { padding-top: 40px; padding-bottom: 16px; }
