---
import attention from "../../../assets/images/redesign/hero/attention.svg";
import circleBottom from "../../../assets/images/redesign/hero/circle-bottom.svg";
import circleTop from "../../../assets/images/redesign/hero/circle-top.svg";
import halftoneShadow from "../../../assets/images/redesign/hero/halftone-shadow.png";
import proposicaoFive from "../../../assets/images/redesign/hero/proposicao-5.png";
import proposicaoNine from "../../../assets/images/redesign/hero/proposicao-9.png";
import stroke from "../../../assets/images/redesign/hero/stroke.svg";
import chevron from "../../../assets/images/redesign/home-reportagens/chevron-right.svg";
---

<section class="alerts-hero redesign-shared-background" aria-labelledby="alerts-hero-title" style={`--alerts-hero-halftone-shadow: url(${halftoneShadow.src})`}>
    <div class="alerts-hero__top-row">
        <div class="alerts-hero__content">
            <img class="alerts-hero__attention" src={attention.src} alt="" />
            <h1 id="alerts-hero-title">Alertas</h1>
            <p>Acompanhe as movimentações do Legislativo no Radar do Congresso</p>
            <button class="alerts-hero__button" type="button">
                <span>Receber alertas por e-mail</span>
                <span class="alerts-hero__button-icon"><img src={chevron.src} alt="" /></span>
            </button>
        </div>

        <div class="alerts-hero__illustration" aria-hidden="true">
            <span class="alerts-hero__stroke"><img src={stroke.src} alt="" /></span>
            <span class="alerts-hero__document alerts-hero__document--top"><img src={proposicaoFive.src} alt="" /></span>
            <span class="alerts-hero__square"></span>
            <span class="alerts-hero__circle alerts-hero__circle--top"><img src={circleTop.src} alt="" /></span>
            <span class="alerts-hero__document alerts-hero__document--bottom"><img src={proposicaoNine.src} alt="" /></span>
            <span class="alerts-hero__circle alerts-hero__circle--bottom"><img src={circleBottom.src} alt="" /></span>
        </div>
    </div>
    <div class="alerts-hero__shadow" aria-hidden="true"></div>
</section>

<style>
    .alerts-hero, .alerts-hero * { box-sizing: border-box; }
    .alerts-hero { color: #0b0f5e; height: 500px; overflow: hidden; position: relative; }
    .alerts-hero__top-row { align-items: center; display: flex; height: 476px; justify-content: space-between; padding: 48px; position: relative; z-index: 2; }
    .alerts-hero__content { align-items: flex-start; display: flex; flex: 1 0 0; flex-direction: column; gap: 24px; justify-content: center; max-width: 960px; min-width: 0; }
    .alerts-hero__attention { display: block; flex: none; height: 8px; width: 96px; }
    .alerts-hero h1, .alerts-hero p { margin: 0; mix-blend-mode: multiply; }
    .alerts-hero h1 { color: #0b0f5e; font-family: "ETC Anybody", sans-serif; font-size: 72px; font-weight: 700; font-variation-settings: "wdth" 75; letter-spacing: 0; line-height: 72px; text-transform: uppercase; }
    .alerts-hero p { color: #0b0f5e; font-family: "Plus Jakarta Sans", sans-serif; font-size: 18px; font-weight: 700; letter-spacing: 0; line-height: 24px; width: 640px; }
    .alerts-hero__button { align-items: center; background: #4242f6; border: 0; color: #fff; display: flex; flex: none; gap: 8px; height: 56px; justify-content: center; padding: 18px 24px 14px; width: 282px; }
    .alerts-hero__button span { font-family: "ETC Anybody", sans-serif; font-size: 20px; font-weight: 700; font-variation-settings: "wdth" 75; line-height: 24px; text-transform: uppercase; white-space: nowrap; }
    .alerts-hero__button-icon { align-items: center; display: flex; height: 24px; justify-content: center; width: 12px; }
    .alerts-hero__button-icon img { display: block; height: 8.12132px; transform: rotate(-90deg); width: 13.4142px; }
    .alerts-hero__illustration { flex: none; height: 360px; margin: 10px; overflow: hidden; position: relative; width: 360px; }
    .alerts-hero__stroke { height: 234.809px; left: 60.097px; position: absolute; top: 62.445px; width: 239.807px; }
    .alerts-hero__stroke img { bottom: -1.94%; left: -3.64%; max-width: none; position: absolute; right: -2.13%; top: -1.74%; width: 105.77%; }
    .alerts-hero__document { align-items: center; display: flex; justify-content: center; position: absolute; }
    .alerts-hero__document img { display: block; max-width: none; object-fit: cover; }
    .alerts-hero__document--top { height: 142.66px; left: 163.94px; top: 11.55px; width: 106.196px; }
    .alerts-hero__document--top img { height: 135.647px; transform: rotate(4.43deg); width: 96px; }
    .alerts-hero__document--bottom { height: 146.059px; left: 60px; top: 154.21px; width: 111.886px; }
    .alerts-hero__document--bottom img { height: 135.295px; transform: rotate(-7.05deg); width: 96px; }
    .alerts-hero__square { border: 8px solid #def279; height: 96px; left: 228px; position: absolute; top: 132.44px; width: 96px; }
    .alerts-hero__circle { position: absolute; }
    .alerts-hero__circle img { max-width: none; position: absolute; }
    .alerts-hero__circle--top { height: 72px; left: 36px; top: 72px; width: 72px; }
    .alerts-hero__circle--top img { bottom: -4.76%; height: 112.64%; left: -5.63%; top: -7.88%; width: 113.3%; }
    .alerts-hero__circle--bottom { height: 144px; left: 36px; top: 179.424px; width: 144px; }
    .alerts-hero__circle--bottom img { bottom: -3.23%; height: 106.56%; left: -.75%; top: -3.33%; width: 104.22%; }
    .alerts-hero__shadow { background-image: var(--alerts-hero-halftone-shadow); background-position: left bottom; background-repeat: repeat-x; background-size: 1440px 24px; bottom: 0; display: block; height: 24px; left: 0; mix-blend-mode: multiply; pointer-events: none; position: absolute; width: 100%; z-index: 1; }

    @media (max-width: 1100px) {
        .alerts-hero h1 { font-size: 58px; line-height: 60px; }
        .alerts-hero__illustration { transform: scale(.86); transform-origin: right center; }
    }

    @media (max-width: 760px) {
        .alerts-hero { height: 610px; }
        .alerts-hero__top-row { align-items: flex-start; height: 586px; padding: 48px 24px; }
        .alerts-hero__content { gap: 20px; max-width: 100%; }
        .alerts-hero h1 { font-size: clamp(42px, 11vw, 58px); line-height: .98; }
        .alerts-hero p { font-size: 16px; line-height: 22px; width: min(100%, 500px); }
        .alerts-hero__button span { font-size: 16px; }
        .alerts-hero__illustration { bottom: 16px; margin: 0; position: absolute; right: -88px; transform: scale(.54); transform-origin: bottom right; }
    }
</style>
