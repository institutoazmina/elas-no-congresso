---
const { placeholder = "Buscar por termo, proposta ou parlamentar" } = Astro.props;
---

<form class="alerts-search" role="search" data-alerts-search>
    <input type="search" name="q" aria-label="Buscar por termo, proposta ou parlamentar" placeholder={placeholder} />
    <button type="submit" aria-label="Buscar alertas">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4 4" /></svg>
    </button>
</form>

<style>
    .alerts-search { border: 2px solid #1b2548; box-sizing: border-box; display: flex; height: 55px; width: 625px; }
    .alerts-search input { border: 0; box-sizing: border-box; color: #1e2546; flex: 1 0 0; font: 400 14px/16px "Plus Jakarta Sans", sans-serif; min-width: 0; outline: 0; padding: 13px 16px 16px; }
    .alerts-search input::placeholder { color: #949494; opacity: 1; }
    .alerts-search button { align-items: center; align-self: center; background: #1b2548; border: 0; box-sizing: border-box; color: #c8f53e; cursor: pointer; display: flex; height: 55px; justify-content: center; padding: 12px 20px; transition: background-color 160ms ease-out, color 160ms ease-out; width: 58px; }
    .alerts-search button:hover { background: #4242f6; color: #c8f53e; }
    .alerts-search input:focus-visible, .alerts-search button:focus-visible { outline: 2px solid #4242f6; outline-offset: -2px; }
    .alerts-search svg { fill: none; height: 18px; stroke: currentColor; stroke-linecap: square; stroke-width: 2px; width: 18px; }
    @media (prefers-reduced-motion: reduce) { .alerts-search button { transition: none; } }
    @media (max-width: 940px) { .alerts-search { width: 100%; } }
</style>
