---
import azmLogo from "./assets/azm.svg?url";
import HighlighterMarks from "./HighlighterMarks.astro";
import "../../styles/redesign-shared-background.css";

const links = [
    { href: "/propostas-e-votacoes", label: "Atividade legislativa" },
    { href: "/alertas", label: "Alertas" },
    { href: "/ia-feminista", label: "IA feminista" },
    { href: "/reportagens", label: "Reportagens" },
    { href: "/sobre", label: "Sobre" },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<header class="redesign-header redesign-shared-background" transition:persist="redesign-header">
    <nav
        class="redesign-header__content container-fluid wrap tw:!max-w-screen"
        aria-label="Navegação principal"
    >
        <a
            href="/"
            class="redesign-header__brand logo-header"
            data-highlighter-target
            data-highlighter-routes="/"
            aria-label="Elas no Congresso"
        ></a>

        <div class="redesign-header__desktop-links">
            {
                links.map((link) => (
                    <a
                        href={link.href}
                        class="ff1"
                        data-highlighter-target
                        data-highlighter-routes={link.href}
                        aria-current={currentPath === link.href ? "page" : undefined}
                    >
                        {link.label}
                    </a>
                ))
            }
        </div>

        <a
            class="redesign-header__azm"
            href="https://azmina.com.br/"
            aria-label="Revista AzMina"
            style={`--redesign-header-azm-logo: url("${azmLogo}")`}
        ></a>

        <HighlighterMarks />

        <details class="redesign-header__mobile-menu">
            <summary aria-label="Abrir menu">
                <span></span><span></span><span></span>
            </summary>
            <div class="redesign-header__mobile-panel">
                {
                links.map((link) => (
                    <a
                        href={link.href}
                        class="ff1"
                        data-highlighter-target
                        data-highlighter-routes={link.href}
                        aria-current={currentPath === link.href ? "page" : undefined}
                    >
                        <span>{link.label}</span>
                    </a>
                    ))
                }
            </div>
        </details>
    </nav>
</header>

<style>
    .redesign-header {
        color: #0b0f5e;
        min-height: 52px;
    }

    .redesign-header__content {
        align-items: center;
        display: flex;
        gap: 16px;
        justify-content: space-between;
        margin: 0 auto;
        min-height: 52px;
        padding: 0 16px;
        position: relative;
    }

    .redesign-header__content > :not(.highlighter-marks) {
        position: relative;
        z-index: 1;
    }

    .redesign-header__brand {
        background-color: #0b0f5e;
        background-image: none;
        flex: 0 0 auto;
        height: 14px;
        width: 128px;
        -webkit-mask: url("/assets/images/logo-header.svg") center / contain no-repeat;
        mask: url("/assets/images/logo-header.svg") center / contain no-repeat;
        transition: background-color 0.4s ease;
    }

    .redesign-header__brand:hover {
        background-color: #4745e8;
    }

    .redesign-header__desktop-links {
        align-items: center;
        display: flex;
        gap: 40px;
        margin-left: auto;
    }

    .redesign-header__desktop-links a,
    .redesign-header__mobile-panel a {
        color: inherit;
        font-family: "ETC Anybody", sans-serif;
        font-size: 18px;
        font-weight: 700;
        font-variation-settings: "wdth" 75;
        letter-spacing: 0;
        line-height: 24px;
        text-decoration: none;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .redesign-header__desktop-links a {
        transition: color 0.4s ease;
    }

    .redesign-header__desktop-links a:hover {
        color: #6075ce;
    }

    .redesign-header__azm {
        background-color: #0b0f5e;
        flex: 0 0 auto;
        height: 35px;
        width: 64px;
        -webkit-mask: var(--redesign-header-azm-logo) center / contain no-repeat;
        mask: var(--redesign-header-azm-logo) center / contain no-repeat;
        transition: background-color 0.4s ease;
    }

    .redesign-header__azm:hover {
        background-color: #4745e8;
    }

    .redesign-header__mobile-menu {
        display: block;
        position: relative;
    }

    .redesign-header__desktop-links,
    .redesign-header__azm {
        display: none;
    }

    .redesign-header__mobile-menu summary {
        cursor: pointer;
        display: grid;
        gap: 5px;
        height: 22px;
        list-style: none;
        padding: 0;
        width: 28px;
    }

    .redesign-header__mobile-menu summary::-webkit-details-marker {
        display: none;
    }

    .redesign-header__mobile-menu summary span {
        background: currentColor;
        display: block;
        height: 2px;
        width: 28px;
    }

    .redesign-header__mobile-panel {
        background: #ffffff;
        border-top: 4px solid #def279;
        box-shadow: 0 12px 20px rgba(11, 15, 94, 0.16);
        display: grid;
        gap: 20px;
        padding: 24px;
        position: absolute;
        right: 0;
        top: calc(100% + 8px);
        width: min(320px, calc(100vw - 32px));
        z-index: 10;
    }

    .redesign-header__mobile-panel a {
        position: relative;
        z-index: 12;
    }

    @media (max-width: 767px) {
        :global(html:has(.redesign-header__mobile-menu[open])),
        :global(body:has(.redesign-header__mobile-menu[open])) {
            overflow: hidden;
        }

        .redesign-header.redesign-shared-background {
            position: sticky;
            z-index: 100;
            top: 0;
            width: 100%;
            background-color: #fff;
            background-image: url("../../assets/images/redesign/background/bg-pattern-rough-paper.png");
            background-position: center top;
            background-repeat: repeat;
            background-size: 400px 400px;
            transition: transform 180ms ease;
            transform: translateY(0);
            will-change: transform;
        }

        .redesign-header:has(.redesign-header__mobile-menu[open]) {
            position: fixed;
            inset: 0 0 auto;
            transform: translateY(0);
        }

        .redesign-header.redesign-shared-background.redesign-header--hidden {
            transform: translateY(-100%);
        }

        .redesign-header.redesign-shared-background.redesign-header--scrolled:not(:has(.redesign-header__mobile-menu[open])) {
            border: 0;
            background: transparent;
            box-shadow: none;
        }

        .redesign-header--scrolled:not(:has(.redesign-header__mobile-menu[open])) :global(.highlighter-marks) {
            display: none;
        }

        .redesign-header__content {
            min-height: 52px;
            padding: 0 16px;
        }

        .redesign-header__mobile-menu {
            position: static;
        }

        .redesign-header__mobile-menu summary {
            position: relative;
            display: block;
            width: 28px;
            height: 28px;
        }

        .redesign-header__mobile-menu summary span {
            position: absolute;
            left: 0;
            transition: top 180ms ease, opacity 180ms ease, transform 180ms ease;
        }

        .redesign-header__mobile-menu summary span:nth-child(1) { top: 4px; }
        .redesign-header__mobile-menu summary span:nth-child(2) { top: 13px; }
        .redesign-header__mobile-menu summary span:nth-child(3) { top: 22px; }

        .redesign-header__mobile-menu[open] summary span:nth-child(1) {
            top: 13px;
            transform: rotate(45deg);
        }

        .redesign-header__mobile-menu[open] summary span:nth-child(2) {
            opacity: 0;
        }

        .redesign-header__mobile-menu[open] summary span:nth-child(3) {
            top: 13px;
            transform: rotate(-45deg);
        }

        .redesign-header__mobile-panel {
            position: fixed;
            inset: 52px 0 0;
            z-index: 99;
            display: grid;
            width: 100%;
            min-height: calc(100dvh - 52px);
            padding: 0;
            align-content: start;
            gap: 0;
            overflow-y: auto;
            border: 0;
            background: #0b0f5e;
            box-shadow: none;
        }

        .redesign-header__mobile-panel a {
            display: flex;
            width: 100%;
            padding: 16px 24px;
            align-items: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.3);
            color: #fff;
            text-align: left;
        }
    }

    @media (min-width: 821px) {
        :global(.redesign-home-background) .redesign-header.redesign-shared-background {
            position: sticky;
            top: 0;
            z-index: 100;
            width: 100%;
            transition: transform 180ms ease, background-color 180ms ease, background-image 180ms ease;
        }

        :global(.redesign-home-background) .redesign-header.redesign-shared-background.redesign-header--desktop-hidden {
            transform: translateY(-100%);
        }

        :global(.redesign-home-background) .redesign-header.redesign-shared-background.redesign-header--desktop-scrolled {
            background: transparent;
            box-shadow: none;
        }

        :global(.redesign-home-background) .redesign-header.redesign-header--desktop-scrolled :global(.highlighter-marks) {
            display: none;
        }

        .redesign-header {
            min-height: 104px;
        }

        .redesign-header__content {
            gap: 22px;
            min-height: 104px;
            padding: 0 24px;
        }

        .redesign-header__brand {
            height: 25px;
            width: 230px;
        }

        .redesign-header__desktop-links {
            gap: 22px;
            display: flex;
        }

        .redesign-header__desktop-links a {
            font-size: 16px;
        }

        .redesign-header__azm {
            display: block;
        }

        .redesign-header__mobile-menu {
            display: none;
        }
    }

    @media (min-width: 1051px) {
        .redesign-header__content {
            gap: 32px;
            padding: 0 48px;
        }

        .redesign-header__desktop-links {
            gap: 40px;
        }

        .redesign-header__desktop-links a {
            font-size: 18px;
        }
    }
</style>

<script>
    const updateHighlighter = () => {
        const nav = document.querySelector(".redesign-header__content");
        const highlighter = nav?.querySelector(".highlighter-marks");

        if (!nav || !highlighter) return;

        const currentPath = (window.location.pathname.replace(/\/+$/, "") || "/");
        nav.querySelectorAll(
            ".redesign-header__desktop-links a[data-highlighter-routes], .redesign-header__mobile-panel a[data-highlighter-routes]",
        ).forEach((link) => {
            const routes = link.dataset.highlighterRoutes?.split(",") ?? [];
            if (routes.includes(currentPath)) {
                link.setAttribute("aria-current", "page");
            } else {
                link.removeAttribute("aria-current");
            }
        });
        const isMobile = window.matchMedia("(max-width: 820px)").matches;
        const matchesMobileDesign = window.matchMedia("(max-width: 767px)").matches;
        const target = isMobile
            ? nav.querySelector(".redesign-header__brand")
            : [...nav.querySelectorAll("[data-highlighter-target]")].find(
                (element) => {
                    const styles = window.getComputedStyle(element);
                    const routes = element.dataset.highlighterRoutes?.split(",") ?? [];
                    return (
                        routes.includes(currentPath) &&
                        styles.display !== "none" &&
                        element.getClientRects().length > 0
                    );
                },
            );

        if (!target) {
            highlighter.hidden = true;
            return;
        }

        const navBounds = nav.getBoundingClientRect();
        const targetBounds = target.getBoundingClientRect();
        const horizontalPadding = 16;
        const isBrandTarget = target.classList.contains("redesign-header__brand");
        const isMobileBrandTarget = matchesMobileDesign && isBrandTarget;
        const mobileBrandScale = isMobileBrandTarget ? targetBounds.width / 128 : 1;
        const highlighterWidth = isBrandTarget
            ? isMobileBrandTarget
                ? 149 * mobileBrandScale
                : 217
            : targetBounds.width + horizontalPadding * 2;
        const highlighterLeft = isMobileBrandTarget
            ? targetBounds.left - navBounds.left - 10 * mobileBrandScale
            : isBrandTarget
              ? targetBounds.left - navBounds.left
                + (targetBounds.width - highlighterWidth) / 2
              : targetBounds.left - navBounds.left - horizontalPadding;
        const highlighterTop =
            targetBounds.top - navBounds.top + targetBounds.height / 2
            - (isMobileBrandTarget ? mobileBrandScale : 0);

        highlighter.style.setProperty(
            "--highlighter-left",
            `${highlighterLeft}px`,
        );
        highlighter.style.setProperty(
            "--highlighter-top",
            `${highlighterTop}px`,
        );
        highlighter.style.setProperty(
            "--highlighter-width",
            `${highlighterWidth}px`,
        );
        if (isMobileBrandTarget) {
            highlighter.style.setProperty(
                "--highlighter-height",
                `${30 * mobileBrandScale}px`,
            );
        } else {
            highlighter.style.removeProperty("--highlighter-height");
        }
        highlighter.style.setProperty(
            "--highlighter-z-index",
            target.closest(".redesign-header__mobile-panel") ? "11" : "0",
        );
        highlighter.hidden = false;
    };

    const scheduleHighlighterUpdate = () => {
        window.requestAnimationFrame(updateHighlighter);
    };

    const prepareMobileHeaderNavigation = () => {
        const header = document.querySelector<HTMLElement>(".redesign-header");
        const mobileMenu = header?.querySelector<HTMLDetailsElement>(
            ".redesign-header__mobile-menu",
        );
        if (!header || !mobileMenu) return;

        mobileMenu.open = false;
        header.classList.remove("redesign-header--hidden", "redesign-header--scrolled");
        header.dataset.mobilePreviousScroll = "0";
    };

    const bindMobileMenu = () => {
        const mobileMenu = document.querySelector<HTMLDetailsElement>(
            ".redesign-header__mobile-menu",
        );

        if (!mobileMenu) return;

        const summary = mobileMenu.querySelector("summary");
        const header = mobileMenu.closest<HTMLElement>(".redesign-header");
        const syncMenuState = () => {
            const isOpen = mobileMenu.open;
            summary?.setAttribute("aria-label", isOpen ? "Fechar menu" : "Abrir menu");
            if (isOpen) header?.classList.remove("redesign-header--hidden");
            if (header) header.dataset.mobilePreviousScroll = String(Math.max(window.scrollY, 0));
            scheduleHighlighterUpdate();
        };

        if (!mobileMenu.dataset.highlighterBound) {
            mobileMenu.dataset.highlighterBound = "true";
            mobileMenu.addEventListener("toggle", syncMenuState);
            mobileMenu.querySelectorAll("a").forEach((link) => {
                link.addEventListener("click", prepareMobileHeaderNavigation);
            });
        }

        const brand = header?.querySelector<HTMLElement>(".redesign-header__brand");
        if (brand && !brand.dataset.mobileStateBound) {
            brand.dataset.mobileStateBound = "true";
            brand.addEventListener("click", prepareMobileHeaderNavigation);
        }

        syncMenuState();
    };

    const bindMobileHeaderScroll = () => {
        const header = document.querySelector<HTMLElement>(".redesign-header");
        if (!header) return;

        const mobileViewport = window.matchMedia("(max-width: 767px)");
        const threshold = 8;

        const updateHeader = (forceVisible = false) => {
            const currentScroll = Math.max(window.scrollY, 0);
            const previousScroll = Number(header.dataset.mobilePreviousScroll ?? currentScroll);
            const mobileMenu = header.querySelector<HTMLDetailsElement>(
                ".redesign-header__mobile-menu",
            );

            if (!mobileViewport.matches) {
                header.classList.remove("redesign-header--hidden");
                header.classList.remove("redesign-header--scrolled");
                header.dataset.mobilePreviousScroll = String(currentScroll);
                return;
            }

            const isAtTop = currentScroll <= threshold;

            header.classList.toggle("redesign-header--scrolled", !isAtTop);

            if (forceVisible || mobileMenu?.open || isAtTop) {
                header.classList.remove("redesign-header--hidden");
                header.dataset.mobilePreviousScroll = String(currentScroll);
                return;
            }

            const delta = currentScroll - previousScroll;
            if (Math.abs(delta) >= threshold) {
                header.classList.toggle("redesign-header--hidden", delta > 0);
                header.dataset.mobilePreviousScroll = String(currentScroll);
            }
        };

        if (!header.dataset.mobileScrollBound) {
            header.dataset.mobileScrollBound = "true";
            let ticking = false;
            window.addEventListener("scroll", () => {
                if (!ticking) {
                    ticking = true;
                    window.requestAnimationFrame(() => {
                        updateHeader();
                        ticking = false;
                    });
                }
            }, { passive: true });

            mobileViewport.addEventListener("change", () => { updateHeader(true); });
        }

        updateHeader(true);
    };

    const bindDesktopHeaderScroll = () => {
        const header = document.querySelector<HTMLElement>(".redesign-header");
        if (!header || !header.closest(".redesign-home-background")) return;

        const desktopViewport = window.matchMedia("(min-width: 821px)");
        const threshold = 8;

        const updateHeader = (forceVisible = false) => {
            const currentScroll = Math.max(window.scrollY, 0);
            const previousScroll = Number(header.dataset.desktopPreviousScroll ?? currentScroll);

            if (!desktopViewport.matches) {
                header.classList.remove(
                    "redesign-header--desktop-hidden",
                    "redesign-header--desktop-scrolled",
                );
                header.dataset.desktopPreviousScroll = String(currentScroll);
                return;
            }

            const isAtTop = currentScroll <= threshold;
            if (isAtTop) {
                header.classList.remove(
                    "redesign-header--desktop-hidden",
                    "redesign-header--desktop-scrolled",
                );
                header.dataset.desktopPreviousScroll = String(currentScroll);
                return;
            }

            if (forceVisible) {
                header.classList.remove("redesign-header--desktop-hidden");
                header.classList.add("redesign-header--desktop-scrolled");
                header.dataset.desktopPreviousScroll = String(currentScroll);
                return;
            }

            const delta = currentScroll - previousScroll;
            if (Math.abs(delta) >= threshold) {
                const isScrollingUp = delta < 0;
                header.classList.toggle("redesign-header--desktop-hidden", !isScrollingUp);
                header.classList.add("redesign-header--desktop-scrolled");
                header.dataset.desktopPreviousScroll = String(currentScroll);
            }
        };

        if (!header.dataset.desktopScrollBound) {
            header.dataset.desktopScrollBound = "true";
            let ticking = false;
            window.addEventListener("scroll", () => {
                if (!ticking) {
                    ticking = true;
                    window.requestAnimationFrame(() => {
                        updateHeader();
                        ticking = false;
                    });
                }
            }, { passive: true });

            desktopViewport.addEventListener("change", () => { updateHeader(true); });
        }

        updateHeader(true);
    };

    const bindSobreReportagensScroll = () => {
        const header = document.querySelector<HTMLElement>(
            ".sobre-page .redesign-header, .reportagens-page .redesign-header",
        );

        if (!(header instanceof HTMLElement) || header.dataset.sobreReportagensScrollBound) {
            return;
        }

        header.dataset.sobreReportagensScrollBound = "true";
        let lastScrollY = window.scrollY;
        let ticking = false;

        const updateScrollDirection = () => {
            const currentScrollY = window.scrollY;
            const isRevealPage = header.closest(".sobre-page, .reportagens-page");

            if (!isRevealPage || !window.matchMedia("(max-width: 700px)").matches) {
                delete header.dataset.scrollDirection;
                delete header.dataset.scrollPosition;
                lastScrollY = currentScrollY;
                return;
            }

            header.dataset.scrollPosition = currentScrollY <= 0 ? "top" : "scrolled";

            const menuIsOpen = header.querySelector(
                ".redesign-header__mobile-menu[open]",
            );

            if (menuIsOpen || currentScrollY <= 0) {
                header.dataset.scrollDirection = "up";
            } else if (Math.abs(currentScrollY - lastScrollY) >= 4) {
                header.dataset.scrollDirection =
                    currentScrollY > lastScrollY ? "down" : "up";
            }

            lastScrollY = currentScrollY;
        };

        const handleScroll = () => {
            if (ticking) return;

            ticking = true;
            window.requestAnimationFrame(() => {
                updateScrollDirection();
                ticking = false;
            });
        };

        updateScrollDirection();
        window.addEventListener("scroll", handleScroll, { passive: true });
        window.addEventListener("resize", updateScrollDirection);
    };

    const resetDesktopHeaderState = () => {
        const header = document.querySelector<HTMLElement>(".redesign-header");
        if (!header) return;

        header.classList.remove(
            "redesign-header--desktop-hidden",
            "redesign-header--desktop-scrolled",
        );
        header.dataset.desktopPreviousScroll = String(Math.max(window.scrollY, 0));
    };

    const resetMobileHeaderState = () => {
        const header = document.querySelector<HTMLElement>(".redesign-header");
        const mobileMenu = header?.querySelector<HTMLDetailsElement>(
            ".redesign-header__mobile-menu",
        );
        if (!header || !mobileMenu) return;

        mobileMenu.open = false;
        header.classList.remove("redesign-header--hidden");
        header.classList.toggle(
            "redesign-header--scrolled",
            window.matchMedia("(max-width: 767px)").matches && window.scrollY > 8,
        );
        header.dataset.mobilePreviousScroll = String(Math.max(window.scrollY, 0));
    };

    const bindHighlighterLayoutObserver = () => {
        const nav = document.querySelector(".redesign-header__content");

        if (!nav || nav.dataset.highlighterLayoutBound) return;

        nav.dataset.highlighterLayoutBound = "true";

        const observer = new ResizeObserver(scheduleHighlighterUpdate);
        observer.observe(nav);
        nav.querySelectorAll("[data-highlighter-target]").forEach((target) => {
            observer.observe(target);
        });

        document.fonts?.ready.then(scheduleHighlighterUpdate);
    };

    const refreshHighlighter = (resetState = false) => {
        if (resetState) resetMobileHeaderState();
        if (resetState) resetDesktopHeaderState();
        bindMobileMenu();
        bindMobileHeaderScroll();
        bindDesktopHeaderScroll();
        bindSobreReportagensScroll();
        bindHighlighterLayoutObserver();
        scheduleHighlighterUpdate();
    };

    refreshHighlighter(true);
    window.addEventListener("resize", scheduleHighlighterUpdate);
    window.addEventListener("popstate", scheduleHighlighterUpdate);
    document.addEventListener("astro:before-swap", prepareMobileHeaderNavigation);
    document.addEventListener("astro:after-swap", () => { refreshHighlighter(true); });
    document.addEventListener("astro:page-load", () => { refreshHighlighter(); });
</script>
