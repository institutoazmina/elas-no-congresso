---
import "../../styles/global.less";
import "../../styles/tailwind.css";
import { ClientRouter } from "astro:transitions";
import RedesignHeader from "./RedesignHeader.astro";
import Footer from "../../components/Footer.astro";
import BgStyles from "../../components/BgStyles.astro";

interface Props {
    title?: string;
    description?: string;
    ogImage?: string;
    currentUrl?: string;
    /** Load the Mautic newsletter form + reCAPTCHA only on pages that render it. */
    hasForm?: boolean;
}

const {
    title,
    description = "",
    ogImage = "/assets/images/share.jpg",
    currentUrl,
    hasForm = false,
} = Astro.props;

const pageTitle =
    title && title !== "Home"
        ? `${title} - Elas no congresso`
        : "Elas no congresso";

const canonicalUrl = currentUrl ?? Astro.url.href;
---

<!doctype html>
<html lang="pt_br">
    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
        <meta name="HandheldFriendly" content="True" />
        <meta name="mobile-web-app-capable" content="yes" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700;900&display=swap" />
        <meta http-equiv="X-UA-Compatible" content="ie=edge" />
        <meta name="language" content="pt-br" />
        <title>{pageTitle}</title>
        <meta property="og:type" content="website" />
        <meta property="og:title" content="Elas no Congresso | AzMina" />
        <meta property="og:description" content={description} />
        <meta
            property="og:image"
            content={`https://www.elasnocongresso.com.br${ogImage}`}
        />
        <meta property="og:url" content={canonicalUrl} />
        <meta name="copyright" content="AzMina" />
        <link rel="icon" type="image/png" href="/assets/images/favicon.png" />
        <link href="/assets/images/favicon.png" rel="shortcut icon" />
        <link
            rel="preload"
            href="/assets/fonts/ETCAnybodyVariable.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
        <ClientRouter fallback="swap" />
        <BgStyles />
    </head>
    <body class="tw:!pt-0 tw:!bg-white">
        <RedesignHeader />
        <slot />
        <Footer />
        {
            hasForm && (
                <script src="https://www.google.com/recaptcha/api.js" async defer />
            )
        }
        {hasForm && (
        <script is:inline>
            var _grecaptcha_response;
            var _grepatcha_autosubmit = false;
            if (typeof MauticSDKLoaded == "undefined") {
                var MauticSDKLoaded = true;
                var head = document.getElementsByTagName("head")[0];
                var script = document.createElement("script");
                script.type = "text/javascript";
                script.src =
                    "https://mautic.azmina.com.br/media/js/mautic-form.js";
                script.onload = function () {
                    MauticSDK.onLoad();
                };
                head.appendChild(script);
                var MauticDomain = "https://mautic.azmina.com.br";
                var MauticLang = { submittingMessage: "Enviando..." };
            }
            if (typeof MauticFormCallback == "undefined") {
                var MauticFormCallback = {};
            }
            MauticFormCallback["cadastroelasnocongresso"] = {
                onResponseEnd: function (a, b) {
                    if (a.success) {
                        document.getElementById(
                            "mauticform_input_cadastroelasnocongresso_submit",
                        ).style.display = "none";
                        document.getElementById(
                            "mauticform_input_cadastroelasnocongresso_email",
                        ).style.display = "none";
                    }
                },
                onValidateEnd: function () {
                    if (_grecaptcha_response) {
                        document.getElementById(
                            "mauticform_input_cadastroelasnocongresso_recaptcha",
                        ).value = _grecaptcha_response;
                        return null;
                    } else {
                        grecaptcha.execute();
                        _grepatcha_autosubmit = true;
                        document.getElementById(
                            "mauticform_input_cadastroelasnocongresso_submit",
                        ).innerHTML = "Aguarde...";
                        return false;
                    }
                },
            };
            function verifyCallback_e10068afdf79d881576531463016bb15(response) {
                _grecaptcha_response = response;
                if (_grepatcha_autosubmit) {
                    document.getElementById(
                        "mauticform_input_cadastroelasnocongresso_submit",
                    ).innerHTML = "Enviando...";
                    document.getElementById(
                        "mauticform_input_cadastroelasnocongresso_recaptcha",
                    ).value = _grecaptcha_response;
                    document
                        .getElementById("mauticform_cadastroelasnocongresso")
                        .submit();
                }
            }
        </script>
        )}
    </body>
</html>

<style is:global>
    @font-face {
        font-family: "ETC Anybody";
        font-style: normal;
        font-weight: 50 1000;
        font-display: swap;
        src: url("/assets/fonts/ETCAnybodyVariable.woff2") format("woff2-variations");
    }

    .redesign-header,
    .redesign-header * {
        box-sizing: border-box;
    }

    body:has(.redesign-header) {
        margin: 0;
    }

    .redesign-header .container-fluid {
        width: 100%;
    }

    .redesign-header .wrap {
        max-width: 1310px;
    }

    .redesign-header .ff1 {
        font-family: "ETC Anybody", sans-serif;
    }
</style>
