---
import elasHorizontal from "../../assets/images/redesign/home-chart/elas-horizontal.svg";

interface Props {
    content: string;
    class?: string;
    href?: string;
}

const { content, class: className, href, ...attributes } = Astro.props;
---

<footer class:list={["section-divider", className]} {...attributes}>
    {href ? <a href={href}>{content}</a> : <span>{content}</span>}
    <img src={elasHorizontal.src} alt="Elas no Congresso" />
</footer>

<style>
    .section-divider {
        margin-inline: auto;
    }
    .section-divider a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
    .section-divider a:hover { color: #4242f6; }
    .section-divider a:focus-visible { outline: 2px solid #4242f6; outline-offset: 2px; }
</style>
