---
import attention from "../../assets/images/redesign/party-chart/attention.svg";
import buttonChevron from "../../assets/images/redesign/home-reportagens/chevron-right.svg";
import elasHorizontal from "../../assets/images/redesign/party-chart/elas-horizontal.svg";
import { Image } from "astro:assets";
import mapBase from "./assets/map/map-br-base@2.5x.png";
import mapLabels from "./assets/map/map-br-labels@2.5x.png";
import mapHitboxes from "./assets/map/map-br-ufs-vector.svg?raw";
import StanceToggle from "./StanceToggle.astro";
import { getStanceByState, type GroupStat, type Stance } from "../../service/api/stats";

// A tabela lista as 27 UFs; o mapa destaca só o topo do mesmo ranking, então
// uma busca por stance serve os dois — a ordem já vem da API.
const UF_COUNT = 27;
const MAP_HIGHLIGHTS = 5;

const [unfavourableRanking, favourableRanking] = await Promise.all([
    getStanceByState({ stance: "unfavorable", limit: UF_COUNT }),
    getStanceByState({ stance: "favorable", limit: UF_COUNT }),
]);

const toRows = (ranking: GroupStat[], stance: Stance) =>
    ranking.map((state) => {
        const total = state.favorable + state.unfavorable;
        return {
            uf: state.label,
            unfavorable: state.unfavorable,
            favorable: state.favorable,
            total,
            share: total ? Math.round((state[stance] / total) * 100) : 0,
        };
    });

const views = [
    { stance: "unfavorable" as const, heading: "Desfavoráveis", rows: toRows(unfavourableRanking, "unfavorable") },
    { stance: "favorable" as const, heading: "Favoráveis", rows: toRows(favourableRanking, "favorable") },
];

// O design entrega um PNG por UF/stance, todos no mesmo canvas 1800x1800 do
// mapa base — destacar um estado é só empilhar o recorte dele sobre a base.
const ufLayers = import.meta.glob<{ default: ImageMetadata }>("./assets/map/map-br-ufs-*@2.5x.png", {
    eager: true,
});
const layerSlug: Record<Stance, string> = { unfavorable: "desfavoravel", favorable: "favoravel" };

const highlights = views.map((view) => {
    const top = view.rows.slice(0, MAP_HIGHLIGHTS).map((row) => row.uf.trim().toUpperCase());
    return {
        stance: view.stance,
        ufs: top,
        layers: top.flatMap((uf) => {
            const layer = ufLayers[`./assets/map/map-br-ufs-${layerSlug[view.stance]}-${uf}@2.5x.png`];
            return layer ? [{ uf, image: layer.default }] : [];
        }),
    };
});

// Dados por UF para o tooltip do mapa. A API já devolve favorable e
// unfavorable juntos em cada item, independente do stance usado na ordenação;
// basta fundir os dois rankings num mapa único por sigla.
// Quando a API passar a fornecer o total de parlamentares por UF, basta somar
// o campo aqui (sem dados.json, sem derivação de /dataset, sem valores fixos).
type UfData = { favorable: number; unfavorable: number };
const ufData: Record<string, UfData> = {};
for (const state of [...favourableRanking, ...unfavourableRanking]) {
    const uf = state.label.trim().toUpperCase();
    ufData[uf] = { favorable: state.favorable, unfavorable: state.unfavorable };
}

const ufLabels: Record<string, string> = {
    AC: "Acre", AL: "Alagoas", AP: "Amapá", AM: "Amazonas", BA: "Bahia", CE: "Ceará",
    DF: "Distrito Federal", ES: "Espírito Santo", GO: "Goiás", MA: "Maranhão",
    MT: "Mato Grosso", MS: "Mato Grosso do Sul", MG: "Minas Gerais", PA: "Pará",
    PB: "Paraíba", PR: "Paraná", PE: "Pernambuco", PI: "Piauí", RJ: "Rio de Janeiro",
    RN: "Rio Grande do Norte", RS: "Rio Grande do Sul", RO: "Rondônia", RR: "Roraima",
    SC: "Santa Catarina", SP: "São Paulo", SE: "Sergipe", TO: "Tocantins",
};
---

<section class="uf-projects-chart" data-stance="unfavorable" data-panel="map" aria-labelledby="uf-projects-chart-title">
    <div class="uf-projects-chart__container">
        <header class="uf-projects-chart__header">
            <img class="uf-projects-chart__attention" src={attention.src} alt="" />
            <div class="uf-projects-chart__heading">
                <h2 id="uf-projects-chart-title">Estas são as UFs dos parlamentares<br />que apresentam mais projetos</h2>
                <StanceToggle labels={{ unfavorable: "Desfavoráveis", favorable: "Favoráveis" }} />
            </div>
            <p>Boa parte das bancadas dos estados do Centro-Oeste, além das de Rondônia,<br />Espírito Santo e Santa Catarina, lidera a apresentação de propostas que restringem<br />direitos de mulheres, meninas e da população LGBTQIAPN+</p>
        </header>

        <figure class="uf-projects-chart__figure">
            <div class="uf-projects-chart__map-table">
                <div class="uf-projects-chart__tabs" role="tablist">
                    <button class="uf-projects-chart__tab" type="button" role="tab" data-panel-tab="map" aria-selected="true" aria-controls="uf-panel-map">Mapa</button>
                    <button class="uf-projects-chart__tab" type="button" role="tab" data-panel-tab="table" aria-selected="false" aria-controls="uf-panel-table">Tabela</button>
                </div>

                <div class="uf-projects-chart__panel" id="uf-panel-map" role="tabpanel" data-panel-view="map">
                    <div class="uf-projects-chart__map">
                        <Image src={mapBase} alt="" width={720} height={720} densities={[1, 2]} loading="lazy" draggable={false} />
                        {highlights.map((view) => (
                            <div data-stance-view={view.stance} role="img" aria-label={`Mapa do Brasil com destaque para ${view.ufs.join(", ")}`}>
                                {view.layers.map((layer) => (
                                    <Image src={layer.image} alt="" width={720} height={720} densities={[1, 2]} loading="lazy" draggable={false} />
                                ))}
                            </div>
                        ))}
                        <Image src={mapLabels} alt="" width={720} height={720} densities={[1, 2]} loading="lazy" draggable={false} />
                        <div class="uf-projects-chart__map-hitbox" aria-hidden="true">
                            <Fragment set:html={mapHitboxes} />
                        </div>
                    </div>
                </div>

                <div class="uf-projects-chart__panel" id="uf-panel-table" role="tabpanel" data-panel-view="table">
                    {views.map((view) => (
                        <table class="uf-projects-chart__table" data-stance-view={view.stance}>
                            <caption>As {view.rows.length} UFs por proposições {view.heading.toLowerCase()}</caption>
                            <thead>
                                <tr><th scope="col">UF</th><th scope="col">Desfavoráveis</th><th scope="col">Favoráveis</th><th scope="col">Total</th><th scope="col">% {view.heading.toLowerCase()}</th></tr>
                            </thead>
                            <tbody>
                                {view.rows.map((row) => (
                                    <tr>
                                        <th scope="row">{row.uf}</th>
                                        <td>{row.unfavorable}</td>
                                        <td>{row.favorable}</td>
                                        <td>{row.total}</td>
                                        <td>{row.share}%</td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    ))}
                </div>
            </div>
        </figure>

        <footer class="uf-projects-chart__footer">
            <span>Lorem ipsum dolor sit amet, consectetur adipiscing elit</span>
            <img src={elasHorizontal.src} alt="Elas no Congresso" />
        </footer>
    </div>
    <button class="uf-projects-chart__button" type="button">Veja como está o seu estado <img src={buttonChevron.src} alt="" /></button>
    <div class="uf-projects-chart__tooltip" role="status" aria-live="polite" data-tooltip hidden>
        <p class="uf-projects-chart__tooltip-uf" data-tooltip-uf></p>
        <p>Favoráveis: <strong data-tooltip-fav></strong></p>
        <p>Desfavoráveis: <strong data-tooltip-des></strong></p>
    </div>
</section>

<script define:vars={{ ufData, ufLabels }}>
    // Mapa e tabela vêm os dois no HTML; a aba só troca qual o CSS mostra.
    const section = document.querySelector(".uf-projects-chart");
    const tabs = section?.querySelectorAll("[data-panel-tab]");

    tabs?.forEach((tab) => {
        tab.addEventListener("click", () => {
            section.dataset.panel = tab.dataset.panelTab;
            tabs.forEach((other) => other.setAttribute("aria-selected", String(other === tab)));
        });
    });

    // Hover nas UFs: o SVG do Design vira camada de hitboxes transparente sobre
    // os PNGs. Um par de listeners delegados (pointerover/pointerout) cobre as
    // 27 UFs; mover o mouse dentro da mesma UF não re-dispara nada (sem piscar).
    const hitbox = section?.querySelector(".uf-projects-chart__map-hitbox");
    const tooltip = section?.querySelector("[data-tooltip]");
    let currentUf = null;

    function positionTooltip(event) {
        if (!tooltip) return;
        const pad = 16;
        const width = tooltip.offsetWidth;
        const height = tooltip.offsetHeight;
        let left = event.clientX + pad;
        let top = event.clientY + pad;
        if (left + width > window.innerWidth) left = event.clientX - width - pad;
        if (top + height > window.innerHeight) top = event.clientY - height - pad;
        tooltip.style.left = Math.max(pad, left) + "px";
        tooltip.style.top = Math.max(pad, top) + "px";
    }

    function showTooltip(uf, event) {
        if (!tooltip) return;
        const data = ufData[uf] ?? { favorable: 0, unfavorable: 0 };
        const ufEl = tooltip.querySelector("[data-tooltip-uf]");
        const favEl = tooltip.querySelector("[data-tooltip-fav]");
        const desEl = tooltip.querySelector("[data-tooltip-des]");
        if (ufEl) ufEl.textContent = ufLabels[uf] ?? uf;
        if (favEl) favEl.textContent = String(data.favorable);
        if (desEl) desEl.textContent = String(data.unfavorable);
        tooltip.hidden = false;
        positionTooltip(event);
    }

    hitbox?.addEventListener("pointerover", (event) => {
        const target = event.target;
        const path = target instanceof Element ? target.closest("path") : null;
        if (!path) return;
        const uf = path.id;
        if (uf === currentUf) return;
        currentUf = uf;
        showTooltip(uf, event);
    });

    hitbox?.addEventListener("pointerout", (event) => {
        const related = event.relatedTarget;
        if (!(related instanceof Element) || !related.closest("path")) {
            currentUf = null;
            if (tooltip) tooltip.hidden = true;
        }
    });

    hitbox?.addEventListener("pointermove", (event) => {
        if (currentUf) positionTooltip(event);
    });
</script>

<style>
    .uf-projects-chart { position: relative; min-height: 1266px; overflow: hidden; background: #fff; box-shadow: 0 48px 0 #fff; color: #0b0f5e; font-family: "Plus Jakarta Sans", sans-serif; }
    .uf-projects-chart *, .uf-projects-chart *::before, .uf-projects-chart *::after { box-sizing: border-box; }
    .uf-projects-chart__container { position: relative; width: 816px; height: 1210px; margin: 0 auto; padding: 48px; }
    .uf-projects-chart__header { display: flex; width: 720px; height: 246px; flex-direction: column; align-items: flex-start; gap: 16px; }
    .uf-projects-chart__attention { display: block; width: 96px; height: 4px; }
    .uf-projects-chart h2, .uf-projects-chart p, .uf-projects-chart figure { margin: 0; }
    .uf-projects-chart__heading { display: flex; width: 720px; height: 138px; flex-direction: column; align-items: flex-start; gap: 16px; }
    .uf-projects-chart h2 { width: 525px; height: 66px; font-family: "ETC Anybody", "Anybody", sans-serif; font-size: 36px; font-weight: 700; line-height: 32px; text-transform: uppercase; font-variation-settings: "wdth" 75; }
    .uf-projects-chart__header > p { width: 720px; height: 72px; font-size: 18px; font-weight: 400; line-height: 24px; }
    .uf-projects-chart__figure { width: 720px; height: 816px; margin-top: 10px; padding: 24px 0; }
    .uf-projects-chart__map-table { width: 720px; height: 768px; }
    .uf-projects-chart__tabs { display: flex; width: 720px; height: 48px; align-items: flex-end; justify-content: flex-end; gap: 0; border-bottom: 4px solid #4242f6; }
    .uf-projects-chart__tab { display: grid; width: 104px; height: 48px; place-items: center; border: 0; background: none; color: #4242f6; font-family: "ETC Anybody", "Anybody", sans-serif; font-size: 20px; font-weight: 700; line-height: 24px; text-transform: uppercase; font-variation-settings: "wdth" 75; cursor: pointer; }
    .uf-projects-chart__tab[aria-selected="true"] { border-radius: 16px 16px 0 0; background: #4242f6; color: #fff; }
    /* Base, destaques e rótulos são recortes do mesmo canvas: empilhar basta. */
    .uf-projects-chart__map { position: relative; width: 720px; aspect-ratio: 1; }
    .uf-projects-chart__map img { position: absolute; inset: 0; width: 100%; height: 100%; }
    .uf-projects-chart__map > img:first-child { position: relative; }
    /* Hitbox das UFs: SVG do Design por cima dos PNGs, transparente, só capta o pointer. */
    .uf-projects-chart__map-hitbox { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
    .uf-projects-chart__map-hitbox :global(svg) { display: block; width: 100%; height: 100%; pointer-events: none; }
    .uf-projects-chart__map-hitbox :global(path) { pointer-events: all; fill: transparent; }
    /* Tooltip do mapa de UFs. */
    .uf-projects-chart__tooltip { position: fixed; z-index: 1000; pointer-events: none; max-width: 240px; padding: 12px 16px; background: #fff; color: #0b0f5e; border: 1px solid #4242f6; box-shadow: 0 15px 30px rgba(0, 0, 0, 0.2); font-family: "Plus Jakarta Sans", sans-serif; font-size: 14px; line-height: 1.5; }
    .uf-projects-chart__tooltip[hidden] { display: none; }
    .uf-projects-chart__tooltip p { margin: 0; }
    .uf-projects-chart__tooltip-uf { margin-bottom: 8px; font-family: "ETC Anybody", "Anybody", sans-serif; font-size: 16px; font-weight: 700; text-transform: uppercase; font-variation-settings: "wdth" 75; }
    .uf-projects-chart__tooltip strong { font-variant-numeric: tabular-nums; }
    /* Um painel e uma visão de cada vez; o resto sai do fluxo. */
    .uf-projects-chart[data-panel="map"] [data-panel-view="table"],
    .uf-projects-chart[data-panel="table"] [data-panel-view="map"],
    .uf-projects-chart[data-stance="unfavorable"] [data-stance-view="favorable"],
    .uf-projects-chart[data-stance="favorable"] [data-stance-view="unfavorable"] { display: none; }
    /* 27 linhas não cabem nos 720px do mapa: rola por dentro e o cabeçalho fica. */
    .uf-projects-chart__panel[data-panel-view="table"] { max-height: 720px; overflow-y: auto; }
    .uf-projects-chart__table { width: 720px; border-collapse: collapse; font-size: 16px; line-height: 24px; }
    .uf-projects-chart__table thead th { position: sticky; top: 0; background: #fff; }
    .uf-projects-chart__table caption { padding: 16px 0; text-align: left; font-family: "ETC Anybody", "Anybody", sans-serif; font-size: 20px; font-weight: 700; text-transform: uppercase; font-variation-settings: "wdth" 75; }
    .uf-projects-chart__table th, .uf-projects-chart__table td { padding: 12px 8px; border-bottom: 1px solid #0b0f5e; text-align: right; }
    .uf-projects-chart__table th[scope="col"] { font-family: "ETC Anybody", "Anybody", sans-serif; font-weight: 700; text-transform: uppercase; font-variation-settings: "wdth" 75; }
    .uf-projects-chart__table th:first-child { text-align: left; }
    .uf-projects-chart__footer { position: absolute; right: 48px; bottom: 48px; left: 48px; display: flex; width: 720px; height: 32px; align-items: flex-start; justify-content: space-between; border-top: 1px solid #0b0f5e; padding-top: 8px; font-size: 14px; line-height: 16px; }
    .uf-projects-chart__footer span { margin-top: 4px; }
    .uf-projects-chart__footer img { width: 113.217px; height: 12px; margin: 6px 8px 0; }
    .uf-projects-chart__button { position: absolute; bottom: 0; left: 50%; display: flex; width: 294px; height: 56px; align-items: center; justify-content: center; gap: 16px; border: 0; padding: 16px 24px; transform: translateX(-50%); background: #4242f6; color: #fff; font-family: "ETC Anybody", "Anybody", sans-serif; font-size: 18px; font-weight: 700; line-height: 24px; text-transform: uppercase; font-variation-settings: "wdth" 75; }
    .uf-projects-chart__button img { width: 13.4142px; height: 8.12132px; transform: rotate(-90deg); }
    @media (max-width: 767px) {
        .uf-projects-chart { min-height: 0; overflow: visible; padding: 48px 24px; }
        .uf-projects-chart__container { width: 100%; height: auto; padding: 0; }
        .uf-projects-chart__header, .uf-projects-chart__heading, .uf-projects-chart h2, .uf-projects-chart__header > p, .uf-projects-chart__figure, .uf-projects-chart__map-table, .uf-projects-chart__tabs, .uf-projects-chart__map, .uf-projects-chart__footer { width: 100%; height: auto; }
        .uf-projects-chart__header { gap: 16px; }
        .uf-projects-chart__heading { gap: 16px; }
        .uf-projects-chart h2 { font-size: 28px; line-height: 34px; }
        .uf-projects-chart__header > p { height: auto; }
        .uf-projects-chart__figure { margin-top: 10px; padding: 24px 0; }
        .uf-projects-chart__tabs { height: 48px; }
        .uf-projects-chart__map { aspect-ratio: 1; }
        .uf-projects-chart__footer { position: relative; right: auto; bottom: auto; left: auto; min-height: 32px; margin-bottom: 48px; gap: 16px; }
        .uf-projects-chart__footer img { flex: none; }
        .uf-projects-chart__button { position: relative; bottom: auto; left: 50%; }
    }
</style>
