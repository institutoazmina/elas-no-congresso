---
import attentionMark from "../../assets/images/redesign/hero/attention.svg";
import circleBottom from "../../assets/images/redesign/hero/circle-bottom.svg";
import circleTop from "../../assets/images/redesign/hero/circle-top.svg";
import highlighterOne from "../../assets/images/redesign/hero/highlighter-desfavoraveis-1.svg";
import highlighterTwo from "../../assets/images/redesign/hero/highlighter-desfavoraveis-2.svg";
import proposicaoFive from "../../assets/images/redesign/hero/proposicao-5.png";
import proposicaoNine from "../../assets/images/redesign/hero/proposicao-9.png";
import stroke from "../../assets/images/redesign/hero/stroke.svg";
---

<section
    class="hero redesign-shared-background"
    aria-labelledby="hero-title"
>
    <div class="hero__top-row">
        <div class="hero__content">
            <img class="hero__attention" src={attentionMark.src} alt="" />
            <h1 id="hero-title" class="hero__title">
                De olho <span class="hero__title-narrow">nas</span> pautas de gênero<br />
                <span class="hero__title-narrow">no</span> Congresso Nacional
            </h1>
            <p class="hero__description"><span class="hero__description-text">{`Nos últimos 8 anos, mais de 700 proposições  apresentadas na Câmara dos Deputados e no Senado Federal  são    `}</span><span class="hero__highlighted-word"><span class="hero__highlighter" aria-hidden="true">
                    <span class="hero__highlighter-layer hero__highlighter-layer--one">
                        <span class="hero__highlighter-image-wrap hero__highlighter-image-wrap--one">
                            <img src={highlighterOne.src} alt="" />
                        </span>
                    </span>
                    <span class="hero__highlighter-layer hero__highlighter-layer--two">
                        <span class="hero__highlighter-image-wrap hero__highlighter-image-wrap--two">
                            <img src={highlighterTwo.src} alt="" />
                        </span>
                    </span>
                </span><span class="hero__highlighted-word-text">desfavoráveis</span></span><span class="hero__description-text">{`    aos direitos de mulheres, meninas e pessoas LGBTQIAPN+`}</span></p>
        </div>

        <div class="hero__illustration" aria-hidden="true">
            <span class="hero__stroke-frame"><img src={stroke.src} alt="" /></span>
            <span class="hero__document hero__document--top"><img src={proposicaoFive.src} alt="" /></span>
            <span class="hero__square"></span>
            <span class="hero__circle hero__circle--top"><img src={circleTop.src} alt="" /></span>
            <span class="hero__document hero__document--bottom"><img src={proposicaoNine.src} alt="" /></span>
            <span class="hero__circle hero__circle--bottom"><img src={circleBottom.src} alt="" /></span>
        </div>
    </div>

    <a class="hero__cta" href="#conteudo-principal">O que descobrimos?</a>
</section>

<style>
    .hero {
        color: #0b0f5e;
        height: 500px;
        overflow: hidden;
        position: relative;
    }

    .hero__top-row {
        align-items: center;
        display: flex;
        height: 476px;
        justify-content: space-between;
        padding: 48px;
    }

    .hero__content {
        align-items: flex-start;
        display: flex;
        flex: 1 0 0;
        flex-direction: column;
        gap: 24px;
        justify-content: center;
        max-width: 960px;
        min-width: 0;
    }

    .hero__attention {
        display: block;
        height: 8px;
        width: 96px;
    }

    .hero__title {
        color: #0b0f5e;
        font-family: "ETC Anybody", sans-serif;
        font-size: 72px;
        font-variation-settings: "wdth" 75;
        font-weight: 700;
        letter-spacing: 0;
        line-height: 72px;
        margin: 0;
        mix-blend-mode: multiply;
        text-transform: uppercase;
    }

    .hero__title-narrow {
        font-variation-settings: "wdth" 60;
        font-weight: 400;
    }

    .hero__description {
        color: #0b0f5e;
        font-family: "Plus Jakarta Sans", sans-serif;
        font-size: 18px;
        font-weight: 700;
        line-height: 24px;
        margin: 0;
        position: relative;
        white-space: pre-wrap;
        width: 640px;
    }

    .hero__description-text {
        position: relative;
        z-index: 1;
    }

    .hero__highlighter {
        aspect-ratio: 152.629 / 35.967;
        left: 50%;
        z-index: -1;
        pointer-events: none;
        position: absolute;
        top: calc(50% + 3px);
        transform: translate(-50%, -50%);
        width: calc(100% + 24px);
    }

    .hero__highlighted-word {
        display: inline-block;
        isolation: isolate;
        position: relative;
        z-index: 1;
    }

    .hero__highlighted-word-text {
        position: relative;
        z-index: 1;
    }

    .hero__highlighter-layer,
    .hero__highlighter-image-wrap,
    .hero__highlighter img {
        display: block;
        position: absolute;
    }

    .hero__highlighter-layer {
        mix-blend-mode: darken;
    }

    .hero__highlighter-layer--one {
        bottom: 23.53%;
        left: 5.73%;
        right: 0;
        top: 3.92%;
    }

    .hero__highlighter-image-wrap--one {
        bottom: 0.14%;
        left: 0.39%;
        right: 0.54%;
        top: 0.15%;
    }

    .hero__highlighter-layer--two {
        bottom: 17.65%;
        left: 1.91%;
        right: 0;
        top: 13.73%;
    }

    .hero__highlighter-image-wrap--two {
        bottom: 0.15%;
        left: 0.29%;
        right: 0.56%;
        top: 0.39%;
    }

    .hero__highlighter img {
        height: 100%;
        inset: 0;
        max-width: none;
        width: 100%;
    }

    .hero__illustration {
        flex: 0 0 auto;
        height: 360px;
        margin: 10px;
        overflow: hidden;
        position: relative;
        width: 360px;
    }

    .hero__stroke-frame {
        height: 234.809px;
        left: 60.097px;
        position: absolute;
        top: 62.445px;
        width: 239.807px;
    }

    .hero__stroke-frame img {
        bottom: -1.94%;
        left: -3.64%;
        max-width: none;
        position: absolute;
        right: -2.13%;
        top: -1.74%;
        width: 105.77%;
    }

    .hero__document {
        align-items: center;
        display: flex;
        justify-content: center;
        position: absolute;
    }

    .hero__document img {
        display: block;
        max-width: none;
        object-fit: cover;
    }

    .hero__document--top {
        height: 142.66px;
        left: 163.94px;
        top: 11.55px;
        width: 106.196px;
    }

    .hero__document--top img {
        height: 135.647px;
        transform: rotate(4.43deg);
        width: 96px;
    }

    .hero__document--bottom {
        height: 146.059px;
        left: 60px;
        top: 154.21px;
        width: 111.886px;
    }

    .hero__document--bottom img {
        height: 135.295px;
        transform: rotate(-7.05deg);
        width: 96px;
    }

    .hero__square {
        border: 8px solid #def279;
        height: 96px;
        left: 228px;
        position: absolute;
        top: 132.44px;
        width: 96px;
    }

    .hero__circle {
        position: absolute;
    }

    .hero__circle img {
        max-width: none;
        position: absolute;
    }

    .hero__circle--top {
        height: 72px;
        left: 36px;
        top: 72px;
        width: 72px;
    }

    .hero__circle--top img {
        bottom: -4.76%;
        height: 112.64%;
        left: -5.63%;
        top: -7.88%;
        width: 113.3%;
    }

    .hero__circle--bottom {
        height: 144px;
        left: 36px;
        top: 179.424px;
        width: 144px;
    }

    .hero__circle--bottom img {
        bottom: -3.23%;
        height: 106.56%;
        left: -0.75%;
        top: -3.33%;
        width: 104.22%;
    }

    .hero__cta {
        align-items: center;
        background: #4242f6;
        bottom: 0.12px;
        color: #fff;
        display: flex;
        font-family: "ETC Anybody", sans-serif;
        font-size: 20px;
        font-variation-settings: "wdth" 75;
        font-weight: 700;
        height: 56px;
        justify-content: center;
        left: 50%;
        line-height: 24px;
        padding: 18px 24px 14px;
        position: absolute;
        text-decoration: none;
        text-transform: uppercase;
        transform: translateX(-50%);
        white-space: nowrap;
    }

    @media (max-width: 1100px) {
        .hero__title {
            font-size: 58px;
            line-height: 60px;
        }

        .hero__illustration {
            transform: scale(0.86);
            transform-origin: right center;
        }
    }

    @media (max-width: 760px) {
        .hero {
            height: 610px;
        }

        .hero__top-row {
            align-items: flex-start;
            height: 586px;
            padding: 48px 24px;
        }

        .hero__content {
            gap: 20px;
            max-width: 100%;
        }

        .hero__title {
            font-size: clamp(42px, 11vw, 58px);
            line-height: 0.98;
        }

        .hero__description {
            font-size: 16px;
            line-height: 22px;
            width: min(100%, 500px);
        }

        .hero__illustration {
            bottom: 16px;
            margin: 0;
            position: absolute;
            right: -88px;
            transform: scale(0.54);
            transform-origin: bottom right;
        }

        .hero__cta {
            font-size: 16px;
            padding: 18px 18px 14px;
        }
    }
</style>
