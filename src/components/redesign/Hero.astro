---
import { Image } from "astro:assets";
import attentionMark from "../../assets/images/redesign/hero/attention.svg";
import highlighterOne from "../../assets/images/redesign/hero/highlighter-desfavoraveis-1.svg";
import highlighterTwo from "../../assets/images/redesign/hero/highlighter-desfavoraveis-2.svg";
import halftoneShadow from "../../assets/images/redesign/hero/halftone-shadow.png";
import heroIllustration from "../../assets/images/redesign/hero/hero-congresso-ilustracao.png";
---

<section
    class="hero redesign-shared-background"
    aria-labelledby="hero-title"
    style={`--hero-halftone-shadow: url(${halftoneShadow.src})`}
>
    <div class="hero__top-row">
        <div class="hero__content">
            <img class="hero__attention" src={attentionMark.src} alt="" />
            <h1 id="hero-title" class="hero__title">
                De olho <span class="hero__title-narrow">nas</span> pautas de gênero<br class="hero__title-break-desktop" />
                <span class="hero__title-narrow">no</span> Congresso Nacional
            </h1>
            <p class="hero__description"><span class="hero__description-text">{`Nos últimos 8 anos, mais de 700 proposições  apresentadas na Câmara dos Deputados e no Senado Federal  são    `}</span><span class="hero__highlighted-word"><span class="hero__highlighter" aria-hidden="true">
                    <span class="hero__highlighter-layer hero__highlighter-layer--one">
                        <span class="hero__highlighter-image-wrap hero__highlighter-image-wrap--one">
                            <img src={highlighterOne.src} alt="" />
                        </span>
                    </span>
                    <span class="hero__highlighter-layer hero__highlighter-layer--two">
                        <span class="hero__highlighter-image-wrap hero__highlighter-image-wrap--two">
                            <img src={highlighterTwo.src} alt="" />
                        </span>
                    </span>
                </span><span class="hero__highlighted-word-text">desfavoráveis</span></span><span class="hero__description-text">{`    aos direitos de mulheres, meninas e pessoas LGBTQIAPN+`}</span></p>
            <a class="hero__cta" href="#conteudo-principal">O que descobrimos?</a>
        </div>

        <div class="hero__illustration" aria-hidden="true">
            <span class="hero__illustration-image"><Image src={heroIllustration} alt="" loading="eager" /></span>
        </div>
    </div>

    <div class="hero__halftone-shadow" aria-hidden="true"></div>
</section>

<style>
    .hero {
        color: #0b0f5e;
        display: flex;
        flex-direction: column;
        height: 435px;
        overflow: hidden;
        position: relative;
    }

    .hero__top-row {
        align-items: flex-start;
        display: flex;
        flex-direction: column;
        height: auto;
        justify-content: flex-start;
        padding: 32px 24px 0;
        position: relative;
        z-index: 2;
    }

    .hero__halftone-shadow {
        background-image: var(--hero-halftone-shadow);
        background-position: left bottom;
        background-repeat: repeat-x;
        background-size: 1440px 24px;
        bottom: 0;
        display: block;
        height: 24px;
        left: 0;
        mix-blend-mode: multiply;
        pointer-events: none;
        position: absolute;
        width: 100%;
        z-index: 1;
    }

    .hero__content {
        align-items: flex-start;
        display: flex;
        flex: none;
        flex-direction: column;
        gap: 15px;
        justify-content: flex-start;
        max-width: 100%;
        min-width: 0;
        width: 100%;
    }

    .hero__attention {
        display: block;
        height: 4px;
        width: 32px;
    }

    .hero__title {
        color: #0b0f5e;
        font-family: "ETC Anybody", sans-serif;
        font-size: 32px;
        font-variation-settings: "wdth" 75;
        font-weight: 700;
        letter-spacing: 0;
        line-height: 32px;
        margin: 0;
        mix-blend-mode: multiply;
        text-transform: uppercase;
    }

    .hero__title-narrow {
        font-variation-settings: "wdth" 60;
        font-weight: 400;
    }

    .hero__title-break-mobile {
        display: inline;
    }

    .hero__title-break-desktop {
        display: none;
    }

    .hero__description {
        color: #0b0f5e;
        font-family: "Plus Jakarta Sans", sans-serif;
        font-size: 18px;
        font-weight: 700;
        line-height: 24px;
        margin: 0;
        position: relative;
        white-space: pre-wrap;
        max-width: 320px;
        width: 100%;
    }

    .hero__description-text {
        position: relative;
        z-index: 1;
    }

    .hero__highlighter {
        aspect-ratio: 152.629 / 35.967;
        left: 50%;
        z-index: -1;
        pointer-events: none;
        position: absolute;
        top: calc(50% + 3px);
        transform: translate(-50%, -50%);
        width: calc(100% + 24px);
    }

    .hero__highlighted-word {
        display: inline-block;
        isolation: isolate;
        position: relative;
        z-index: 1;
    }

    .hero__highlighted-word-text {
        position: relative;
        z-index: 1;
    }

    .hero__highlighter-layer,
    .hero__highlighter-image-wrap,
    .hero__highlighter img {
        display: block;
        position: absolute;
    }

    .hero__highlighter-layer {
        mix-blend-mode: darken;
    }

    .hero__highlighter-layer--one {
        bottom: 23.53%;
        left: 5.73%;
        right: 0;
        top: 3.92%;
    }

    .hero__highlighter-image-wrap--one {
        bottom: 0.14%;
        left: 0.39%;
        right: 0.54%;
        top: 0.15%;
    }

    .hero__highlighter-layer--two {
        bottom: 17.65%;
        left: 1.91%;
        right: 0;
        top: 13.73%;
    }

    .hero__highlighter-image-wrap--two {
        bottom: 0.15%;
        left: 0.29%;
        right: 0.56%;
        top: 0.39%;
    }

    .hero__highlighter img {
        height: 100%;
        inset: 0;
        max-width: none;
        width: 100%;
    }

    .hero__illustration {
        display: none;
        flex: 0 0 auto;
        height: 389px;
        margin: 10px;
        position: relative;
        width: 513px;
    }

    .hero__illustration-image {
        inset: 0;
        position: absolute;
    }

    .hero__illustration-image img {
        display: block;
        height: auto;
        max-width: 100%;
        width: 100%;
    }

    .hero__cta {
        align-items: center;
        background: #4242f6;
        color: #fff;
        cursor: pointer;
        display: flex;
        font-family: "ETC Anybody", sans-serif;
        font-size: 18px;
        font-variation-settings: "wdth" 75;
        font-weight: 700;
        height: 45px;
        justify-content: center;
        line-height: 24px;
        margin: 0;
        padding: 12px;
        position: static;
        width: fit-content;
        text-decoration: none;
        text-transform: uppercase;
        transform: none;
        transition: background-color 220ms ease-out;
        white-space: nowrap;
        z-index: 3;
    }

    .hero__cta:hover {
        background-color: #3a3ad8;
    }

    .hero__cta:focus-visible {
        outline: 2px solid #0b0f5e;
        outline-offset: 4px;
    }

    @media (max-width: 760px) {
        .hero {
            height: auto;
        }

        .hero__top-row {
            padding-bottom: 45px;
        }

        .hero__halftone-shadow {
            bottom: auto;
            position: relative;
        }

        .hero__cta {
            height: auto;
            min-height: 45px;
            padding: 12px 12px 9px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero__cta {
            transition: none;
        }

    }

    @media (min-width: 761px) {
        .hero {
            display: block;
            height: 500px;
        }

        .hero__top-row {
            align-items: center;
            flex-direction: row;
            height: 476px;
            justify-content: space-between;
            padding: 48px;
        }

        .hero__content {
            flex: 1 0 0;
            gap: 24px;
            justify-content: center;
            max-width: 960px;
            width: auto;
        }

        .hero__attention {
            height: 8px;
            width: 96px;
        }

        .hero__title {
            font-size: 58px;
            line-height: 60px;
            white-space: nowrap;
        }

        .hero__title-break-mobile {
            display: none;
        }

        .hero__title-break-desktop {
            display: inline;
        }

        .hero__description {
            font-size: 18px;
            line-height: 24px;
            max-width: 640px;
            min-height: 144px;
            width: 640px;
        }

        .hero__illustration {
            display: block;
            transform: scale(0.86);
            transform-origin: right center;
        }

        .hero__cta {
            bottom: auto;
            font-size: 20px;
            height: 56px;
            left: 50%;
            line-height: 24px;
            margin: 0;
            padding: 18px 24px 14px;
            position: absolute;
            top: calc(100% - 32px);
            transform: translateX(-50%);
            width: auto;
        }
    }

    @media (min-width: 1101px) {
        .hero__title {
            font-size: 72px;
            line-height: 72px;
        }

        .hero__illustration {
            transform: none;
        }
    }
</style>
