---
import attention from "../../assets/images/redesign/party-chart/attention.svg";
import documentImage from "../../assets/images/redesign/hero/proposicao-9.png";
import favorableThumb from "../../assets/images/thumbs-up.svg";
import unfavorableThumb from "../../assets/images/thumbs-down.svg";
import bookIcon from "../../assets/images/redesign/enacted-projects/book.svg";
import mobileBackgroundPattern from "../../assets/images/redesign/enacted-projects/carousel-pattern.png";
import backgroundPattern from "../../assets/images/redesign/parliamentarians/bg-pattern.svg";
import halftoneShadow from "../../assets/images/redesign/hero/halftone-shadow.png";
import arrowBack from "../../assets/images/redesign/parliamentarians/arrow-back.svg";
import arrowForward from "../../assets/images/redesign/parliamentarians/arrow-forward.svg";

const sourceCards = [
    { approved: false, rating: "favorável", proposal: "PDL 176/2021", authors: [["Jandira Feghali", "PCdoB/RJ"], ["Erika Kokay", "PT/DF"], ["Alice Portugal", "PCdoB/BA"]], more: "+7 parlamentares", description: "Susta a Portaria nº 13, de 19 de abril de 2021, que torna pública a decisão de incorporar o implante subdérmico de etonogestrel, condicionada à criação de programa específico, na prevenção da gravidez não planejada para mulheres em idade fértil: em situação de rua; com HIV/AIDS em uso de dolutegravir; em uso de talidomida; privadas de liberdade; trabalhadoras do sexo; e em tratamento de tuberculose em uso de aminoglicosídeos, no âmbito do Sistema Único de Saúde - SUS.." },
    { approved: true, rating: "favorável", proposal: "PDL 176/2021", authors: [["Jandira Feghali", "PCdoB/RJ"], ["Erika Kokay", "PT/DF"], ["Alice Portugal", "PCdoB/BA"]], more: "+7 parlamentares", description: "Susta a Portaria nº 13, de 19 de abril de 2021, que torna pública a decisão de incorporar o implante subdérmico de etonogestrel, condicionada à criação de programa específico, na prevenção da gravidez não planejada para mulheres em idade fértil." },
    { approved: false, rating: "desfavorável", proposal: "PL 2104/2026", authors: [["Baleia Rossi", "MDB/SP"]], description: "Estabelece diretrizes para a atenção à saúde da mulher no climatério e na menopausa, no âmbito do Sistema Único de Saúde, e institui a Semana Nacional de Conscientização sobre o Climatério e a Menopausa" },
    { approved: true, rating: "favorável", proposal: "PDL 176/2021", authors: [["Jandira Feghali", "PCdoB/RJ"], ["Erika Kokay", "PT/DF"], ["Alice Portugal", "PCdoB/BA"]], more: "+7 parlamentares", description: "Susta a Portaria nº 13, de 19 de abril de 2021, que torna pública a decisão de incorporar o implante subdérmico de etonogestrel." },
    { approved: true, rating: "desfavorável", proposal: "PL 2104/2026", authors: [["Baleia Rossi", "MDB/SP"]], description: "Estabelece diretrizes para a atenção à saúde da mulher no climatério e na menopausa, no âmbito do Sistema Único de Saúde, e institui a Semana Nacional de Conscientização sobre o Climatério e a Menopausa" },
];

const cards = Array.from({ length: 15 }, (_, physical) => ({ ...sourceCards[physical % sourceCards.length], physical }));
---

<section class="enacted-projects" aria-labelledby="enacted-projects-title">
    <header class="enacted-projects__header">
        <img src={attention.src} alt="" />
        <h2 id="enacted-projects-title">Projetos que viraram lei</h2>
        <p>Projetos desfavoráveis que estão avançando nas comissões e no Plenário<span class="enacted-projects__desktop-period"></span></p>
    </header>

    <div class="enacted-projects__figure" data-enacted-carousel>
        <div class="enacted-projects__carousel" style={`--enacted-projects-background: url(${backgroundPattern.src}); --enacted-projects-mobile-background: url(${mobileBackgroundPattern.src}); --enacted-projects-halftone-shadow: url(${halftoneShadow.src}); background-image: url(${backgroundPattern.src})`} aria-label="Projetos que viraram lei">
            <div class="enacted-projects__controls">
                <button type="button" aria-label="Projeto anterior" data-previous><img src={arrowBack.src} alt="" /></button>
                <button type="button" aria-label="Próximo projeto" data-next><img src={arrowForward.src} alt="" /></button>
            </div>
            <div class="enacted-projects__viewport"><div class="enacted-projects__track" data-track>
                {cards.map((card) => <article class:list={["enacted-projects__card", `enacted-projects__card--${card.rating}`, { "enacted-projects__card--featured": card.physical === 7 }]} data-approved={String(card.approved)} aria-hidden={card.physical === 7 ? undefined : "true"}>
                    <header class="enacted-projects__card-header">
                        <strong>{card.proposal}</strong>
                        <span class="enacted-projects__status">
                            <img class="enacted-projects__document" src={documentImage.src} alt="" />
                            <span class="enacted-projects__rating">
                                <span class="enacted-projects__rating-icon"><img src={card.rating === "favorável" ? favorableThumb.src : unfavorableThumb.src} alt="" /></span>
                                <b>{card.rating}</b>
                            </span>
                        </span>
                    </header>
                    <div class="enacted-projects__details">
                        <div class="enacted-projects__authors">
                            {card.authors.map(([name, party]) => <p><span>{name}</span><strong>{party}</strong></p>)}
                            {card.more && <p class="enacted-projects__more">{card.more}</p>}
                        </div>
                        <span class="enacted-projects__theme">Saúde</span>
                        <p class="enacted-projects__description">{card.description}</p>
                    </div>
                    <footer class="enacted-projects__law-footer">
                        <div><p><span class="enacted-projects__law-icon"><img src={bookIcon.src} alt="" /></span><strong>Lei 11.340/2026</strong></p><small>Aprovada em 7 de agosto de 2026</small></div>
                        <span aria-hidden="true">›</span>
                    </footer>
                </article>)}
            </div></div>
        </div>
    </div>
</section>

<script>
    const initializeEnactedProjects = () => {
        document.querySelectorAll<HTMLElement>("[data-enacted-carousel]").forEach((carousel) => {
            if (carousel.dataset.enactedCarouselInitialized) return;
            carousel.dataset.enactedCarouselInitialized = "true";
            const track = carousel.querySelector<HTMLElement>("[data-track]");
            const previous = carousel.querySelector<HTMLButtonElement>("[data-previous]");
            const next = carousel.querySelector<HTMLButtonElement>("[data-next]");
            if (!track || !previous || !next) return;
            const cards = Array.from(track.querySelectorAll<HTMLElement>(".enacted-projects__card"));
            let physical = 7;
            let resetting = false;
            const update = () => {
                const activeCard = cards[physical];
                const cardWidth = activeCard?.getBoundingClientRect().width ?? 0;
                const gap = Number.parseFloat(getComputedStyle(track).columnGap) || 0;
                track.style.transform = `translateX(${-physical * (cardWidth + gap) - cardWidth / 2}px)`;
                cards.forEach((card, index) => {
                    const active = index === physical;
                    card.classList.toggle("enacted-projects__card--featured", active);
                    card.setAttribute("aria-hidden", String(!active));
                });
            };
            const move = (direction: number) => {
                if (!resetting) {
                    physical += direction;
                    update();
                }
            };
            track.addEventListener("transitionend", (event) => {
                if (event.propertyName !== "transform" || (physical > 4 && physical < 10)) return;
                resetting = true;
                physical += physical < 5 ? 5 : -5;
                track.style.transition = "none";
                update();
                requestAnimationFrame(() => requestAnimationFrame(() => {
                    track.style.transition = "";
                    resetting = false;
                }));
            });
            previous.addEventListener("click", () => move(-1));
            next.addEventListener("click", () => move(1));
            window.addEventListener("resize", update, { passive: true });
            update();
        });
    };

    initializeEnactedProjects();
    document.addEventListener("astro:page-load", initializeEnactedProjects);
</script>

