---
import pile242 from "../../assets/images/redesign/home-chart/papelada-desfavoravel-242.png";
import pile460 from "../../assets/images/redesign/home-chart/papelada-desfavoravel-460.png";
import thumbsDown from "../../assets/images/redesign/home-chart/thumbs-down.svg";
import attention from "../../assets/images/redesign/hero/attention.svg";
---

<section
    class="tw:relative tw:h-auto tw:overflow-hidden tw:py-12 tw:text-[#0B0F5E] tw:lg:h-[1241.5px] tw:lg:overflow-visible tw:lg:bg-white tw:lg:pt-12 tw:lg:pb-0"
    aria-labelledby="rights-under-attack-title"
>
    <div class="tw:mx-auto tw:flex tw:w-full tw:max-w-[816px] tw:flex-col tw:gap-10 tw:px-6 tw:lg:h-[1193.5px] tw:lg:w-[816px] tw:lg:max-w-none tw:lg:gap-2.5 tw:lg:p-12">
        <header class="tw:flex tw:w-full tw:flex-col tw:items-start tw:gap-4 tw:lg:h-[174px]">
            <img class="tw:h-1 tw:w-24" src={attention.src} alt="" />
            <h2
                id="rights-under-attack-title"
                class="tw:m-0 tw:w-full tw:font-[ETC_Anybody] tw:text-[clamp(28px,7vw,36px)] tw:font-bold tw:leading-[1.1667] tw:uppercase tw:[font-variation-settings:'wdth'_75] tw:lg:h-[66px] tw:text-[36px] tw:leading-[42px]"
            >
                Os direitos das mulheres e pessoas LGBTQIA+ nunca foram tão atacados
            </h2>
            <p class="tw:m-0 tw:w-full tw:font-[Plus_Jakarta_Sans] tw:text-[18px] tw:leading-6 tw:lg:h-[72px]">
                Legislar sobre nossos direitos não é sinônimo de fortalecê-los. Muito do trabalho legislativo faz o contrário: retrocesso e restrição de direitos já conquistados. E o atual Congresso tem sido campeão nos ataques:
            </p>
        </header>

        <figure class="tw:relative tw:m-0 tw:flex tw:min-h-[930px] tw:w-full tw:flex-col tw:items-center tw:justify-between tw:gap-12 tw:py-6 tw:lg:h-[871.5px] tw:lg:min-h-0 tw:lg:block">
            <div class="tw:relative tw:flex tw:h-[562px] tw:w-[113px] tw:flex-col tw:items-center tw:justify-end tw:gap-4 tw:py-4 tw:lg:absolute tw:lg:left-[235px] tw:lg:top-[285.5px]">
                <div class="tw:flex tw:h-[450px] tw:w-[113px] tw:flex-col tw:items-center tw:justify-end tw:gap-2 tw:overflow-hidden">
                    <div class="tw:flex tw:flex-col tw:items-center tw:gap-1">
                        <div class="tw:flex tw:h-8 tw:items-center tw:justify-center tw:gap-2">
                            <span class="tw:font-[ETC_Anybody] tw:text-[36px] tw:font-bold tw:leading-[42px] tw:uppercase tw:[font-variation-settings:'wdth'_75]">242</span>
                            <span class="tw:relative tw:block tw:size-8 tw:rounded-full tw:bg-[#FF5865] tw:shadow-[-0.5px_-0.5px_0_#0B0F5E]">
                                <img class="tw:absolute tw:inset-[12.5%] tw:size-6 tw:rotate-180" src={thumbsDown.src} alt="" />
                            </span>
                        </div>
                        <span class="tw:font-[ETC_Anybody] tw:text-[20px] tw:font-bold tw:leading-6 tw:uppercase tw:[font-variation-settings:'wdth'_75]">Desfavoráveis</span>
                    </div>
                    <img class="tw:h-[382px] tw:w-[92.5px] tw:object-cover" src={pile242.src} alt="242 proposições desfavoráveis" />
                </div>
                <div class="tw:flex tw:h-16 tw:w-[113px] tw:flex-col tw:items-center tw:justify-center tw:py-2">
                    <span class="tw:font-[ETC_Anybody] tw:text-[20px] tw:font-bold tw:leading-6 tw:uppercase tw:[font-variation-settings:'wdth'_75]">2019 a 2022</span>
                    <span class="tw:font-[Plus_Jakarta_Sans] tw:text-[16px] tw:leading-6">56ª Legislatura</span>
                </div>
            </div>

            <div class="tw:relative tw:flex tw:h-[823.5px] tw:w-[113px] tw:flex-col tw:items-center tw:justify-end tw:gap-4 tw:py-4 tw:lg:absolute tw:lg:left-[372px] tw:lg:top-6">
                <div class="tw:flex tw:h-[711.5px] tw:w-[113px] tw:flex-col tw:items-center tw:justify-end tw:gap-2 tw:overflow-hidden">
                    <div class="tw:flex tw:flex-col tw:items-center tw:gap-1">
                        <div class="tw:flex tw:h-8 tw:items-center tw:justify-center tw:gap-2">
                            <span class="tw:font-[ETC_Anybody] tw:text-[36px] tw:font-bold tw:leading-[42px] tw:uppercase tw:[font-variation-settings:'wdth'_75]">460</span>
                            <span class="tw:relative tw:block tw:size-8 tw:rounded-full tw:bg-[#FF5865] tw:shadow-[-0.5px_-0.5px_0_#0B0F5E]">
                                <img class="tw:absolute tw:inset-[12.5%] tw:size-6 tw:rotate-180" src={thumbsDown.src} alt="" />
                            </span>
                        </div>
                        <span class="tw:font-[ETC_Anybody] tw:text-[20px] tw:font-bold tw:leading-6 tw:uppercase tw:[font-variation-settings:'wdth'_75]">Desfavoráveis</span>
                    </div>
                    <img class="tw:h-[643.5px] tw:w-[92.5px] tw:object-cover" src={pile460.src} alt="460 proposições desfavoráveis" />
                </div>
                <div class="tw:flex tw:h-16 tw:w-[113px] tw:flex-col tw:items-center tw:justify-center tw:py-2">
                    <span class="tw:font-[ETC_Anybody] tw:text-[20px] tw:font-bold tw:leading-6 tw:uppercase tw:[font-variation-settings:'wdth'_75]">2023 a 2026*</span>
                    <span class="tw:font-[Plus_Jakarta_Sans] tw:text-[16px] tw:leading-6">57ª Legislatura</span>
                </div>
            </div>
        </figure>

        <footer class="tw:flex tw:w-full tw:flex-col tw:gap-3 tw:border-t tw:border-[#0B0F5E] tw:pt-2 tw:font-[Plus_Jakarta_Sans] tw:text-[14px] tw:leading-4 tw:lg:h-8 tw:lg:flex-row tw:lg:items-center tw:lg:justify-between tw:lg:gap-6">
            <span>*Foram avaliadas proposições até março de 2026</span>
            <span
                class="tw:h-3 tw:w-[113.217px] tw:self-end tw:bg-[#0B0F5E] tw:lg:self-auto"
                style="mask: url('/assets/images/logo-header.svg') center / contain no-repeat; -webkit-mask: url('/assets/images/logo-header.svg') center / contain no-repeat;"
                role="img"
                aria-label="Elas no Congresso"
            ></span>
        </footer>
    </div>

    <aside class="tw:mx-auto tw:mt-0 tw:flex tw:h-[180px] tw:w-60 tw:rotate-[-5deg] tw:flex-col tw:items-center tw:justify-center tw:gap-2 tw:bg-[#FF808A] tw:px-6 tw:py-12 tw:text-center tw:shadow-[0_4px_0_#0B0F5E] tw:lg:absolute tw:lg:right-[296.225px] tw:lg:bottom-[173.268px] tw:lg:mt-0" aria-label="Contexto">
        <p class="tw:m-0 tw:w-48 tw:font-[Plus_Jakarta_Sans] tw:text-[18px] tw:font-bold tw:leading-6">Em 2023 começou o mandato da bancada mais conservadora desde 1964</p>
        <span class="tw:w-48 tw:font-[Plus_Jakarta_Sans] tw:text-[14px] tw:leading-4">Ler mais →</span>
    </aside>
</section>
