---
import Papelada from "./Papelada.astro";
import { pileGap } from "../../lib/papelada";
import thumbsDown from "../../assets/images/thumbs-down.svg";
import attention from "../../assets/images/redesign/hero/attention.svg";
import { getUnfavorableByLegislature } from "../../service/api/stats";

// Escala do design: pilhas de 92.5px de largura, a mais alta com 643.5px.
const PILE_WIDTH = 92.5;
const PILE_PEAK = 643.5;

const legislatures = await getUnfavorableByLegislature();
const gap = pileGap({
    width: PILE_WIDTH,
    height: PILE_PEAK,
    peak: Math.max(...legislatures.map((legislature) => legislature.unfavorable), 1),
});
---

<section
    class="tw:relative tw:h-auto tw:overflow-hidden tw:py-12 tw:text-[#0B0F5E] tw:lg:h-[1241.5px] tw:lg:overflow-visible tw:lg:bg-white tw:lg:pt-12 tw:lg:pb-0"
    aria-labelledby="rights-under-attack-title"
>
    <div class="tw:mx-auto tw:flex tw:w-full tw:max-w-[816px] tw:flex-col tw:gap-10 tw:px-6 tw:lg:h-[1193.5px] tw:lg:w-[816px] tw:lg:max-w-none tw:lg:gap-2.5 tw:lg:px-12 tw:lg:pb-12 tw:lg:pt-6">
        <header class="tw:flex tw:w-full tw:flex-col tw:items-start tw:gap-4 tw:lg:mx-auto tw:lg:h-auto tw:lg:max-w-[960px] tw:lg:justify-center">
            <img class="tw:h-1 tw:w-24" src={attention.src} alt="" />
            <h2
                id="rights-under-attack-title"
                class="tw:m-0 tw:w-full tw:font-[ETC_Anybody] tw:text-[clamp(28px,7vw,36px)] tw:font-bold tw:leading-[1.1667] tw:uppercase tw:[font-variation-settings:'wdth'_75] tw:text-[36px] tw:leading-[42px]"
            >
                Os direitos das mulheres e pessoas LGBTQIA+ nunca foram tão atacados
            </h2>
            <p class="tw:m-0 tw:w-full tw:font-[Plus_Jakarta_Sans] tw:text-[18px] tw:leading-6 tw:lg:h-[72px]">
                Legislar sobre nossos direitos não é sinônimo de fortalecê-los. Muito do trabalho legislativo faz o contrário: retrocesso e restrição de direitos já conquistados. E o atual Congresso tem sido campeão nos ataques:
            </p>
        </header>

        <figure class="tw:relative tw:m-0 tw:flex tw:w-full tw:flex-col tw:items-center tw:gap-12 tw:py-6 tw:lg:h-[871.5px] tw:lg:flex-row tw:lg:items-end tw:lg:justify-center tw:lg:gap-6">
            {legislatures.map((legislature, index) => (
                <div class="rights-under-attack__column tw:flex tw:w-[113px] tw:flex-col tw:items-center tw:justify-end tw:gap-4 tw:py-4">
                    <div class="rights-under-attack__tower tw:flex tw:w-[113px] tw:flex-col tw:items-center tw:justify-end tw:gap-2">
                        <div class="rights-under-attack__value tw:flex tw:flex-col tw:items-center tw:gap-1">
                            <div class="tw:flex tw:h-8 tw:items-center tw:justify-center tw:gap-2">
                                <span class="tw:font-[ETC_Anybody] tw:text-[36px] tw:font-bold tw:leading-[42px] tw:uppercase tw:[font-variation-settings:'wdth'_75]">{legislature.unfavorable}</span>
                                <span class="tw:relative tw:block tw:size-8 tw:rounded-full">
                                    <img class="tw:block tw:size-full" src={thumbsDown.src} alt="" />
                                </span>
                            </div>
                            <span class="tw:font-[ETC_Anybody] tw:text-[20px] tw:font-bold tw:leading-6 tw:uppercase tw:[font-variation-settings:'wdth'_75]">Desfavoráveis</span>
                        </div>
                        <Papelada class="rights-under-attack__papers tw:w-[92.5px]" arrangement="pile" category="desfavoravel" size="a4" gap={gap} amount={legislature.unfavorable} alt={`${legislature.unfavorable} proposições desfavoráveis na ${legislature.number}ª Legislatura`} />
                    </div>
                    <div class="rights-under-attack__caption tw:flex tw:h-16 tw:w-[113px] tw:flex-col tw:items-center tw:justify-center tw:py-2">
                        <span class="tw:font-[ETC_Anybody] tw:text-[20px] tw:font-bold tw:leading-6 tw:uppercase tw:[font-variation-settings:'wdth'_75]">{legislature.from} a {legislature.to}{index === legislatures.length - 1 ? "*" : ""}</span>
                        <span class="tw:font-[Plus_Jakarta_Sans] tw:text-[16px] tw:leading-6">{legislature.number}ª Legislatura</span>
                    </div>
                </div>
            ))}
        </figure>

        <aside class="rights-under-attack__note--mobile" aria-label="Contexto">
            <p>Em 2023 começou o mandato da bancada mais conservadora desde 1964</p>
            <span>Ler mais →</span>
        </aside>

        <footer class="tw:relative tw:flex tw:w-full tw:flex-col tw:gap-3 tw:border-t tw:border-[#0B0F5E] tw:pt-2 tw:font-[Plus_Jakarta_Sans] tw:text-[14px] tw:leading-4 tw:lg:block tw:lg:h-[74.972px]">
            <div class="tw:flex tw:h-[26.972px] tw:items-center tw:gap-2 tw:lg:absolute tw:lg:left-0 tw:lg:top-3">
                <span class="tw:flex tw:h-[26.972px] tw:w-[20.154px] tw:items-center tw:justify-center"><img class="tw:h-[25.5px] tw:w-[18px] tw:rotate-[5deg] tw:border-[0.5px] tw:border-[#4242F6] tw:object-cover" src="/assets/papelada/proposicao-desfavoravel-9-192w.png" alt="" /></span>
                <span>Cada folha representa 1 proposição</span>
            </div>
            <span class="tw:lg:absolute tw:lg:left-0 tw:lg:top-[54.972px]">*Foram avaliadas proposições até março de 2026</span>
            <span
                class="tw:h-3 tw:w-[113.217px] tw:self-end tw:bg-[#0B0F5E] tw:lg:absolute tw:lg:right-0 tw:lg:top-2"
                style="mask: url('/assets/images/logo-header.svg') center / contain no-repeat; -webkit-mask: url('/assets/images/logo-header.svg') center / contain no-repeat;"
                role="img"
                aria-label="Elas no Congresso"
            ></span>
        </footer>
    </div>

    <aside class="rights-under-attack__note--desktop tw:mx-auto tw:mt-0 tw:flex tw:h-[180px] tw:w-60 tw:rotate-[-5deg] tw:flex-col tw:items-center tw:justify-center tw:gap-2 tw:bg-[#FF808A] tw:px-6 tw:py-12 tw:text-center tw:shadow-[0_4px_0_#0B0F5E] tw:lg:absolute tw:lg:right-[296.225px] tw:lg:bottom-[173.268px] tw:lg:mt-0" aria-label="Contexto">
        <p class="tw:m-0 tw:w-48 tw:font-[Plus_Jakarta_Sans] tw:text-[18px] tw:font-bold tw:leading-6">Em 2023 começou o mandato da bancada mais conservadora desde 1964</p>
        <span class="tw:w-48 tw:font-[Plus_Jakarta_Sans] tw:text-[14px] tw:leading-4">Ler mais →</span>
    </aside>
</section>

<style>
    /* Mobile is deliberately kept in normal document flow. The shared page
       texture sits behind this section, so the section itself owns the white
       surface required by the mobile design. */
    @media (max-width: 767px) {
        section[aria-labelledby="rights-under-attack-title"] {
            height: auto;
            overflow: visible;
            padding: 0;
            background-color: #fff;
            background-image: none;
        }
        section[aria-labelledby="rights-under-attack-title"] > div {
            width: 100%; max-width: none; height: auto; padding: 24px 16px;
            gap: 10px;
        }
        section[aria-labelledby="rights-under-attack-title"] > div > header {
            width: 100%; height: auto; gap: 16px;
        }
        section[aria-labelledby="rights-under-attack-title"] > div > header > h2 {
            font-size: 28px; line-height: 32px;
        }
        section[aria-labelledby="rights-under-attack-title"] > div > header > p {
            font-size: 14px;
            line-height: 24px;
        }
        section[aria-labelledby="rights-under-attack-title"] > div > figure {
            width: 100%; height: auto; min-height: 192px; margin: 0;
            padding: 24px 0 14px;
            flex-direction: row; align-items: end; justify-content: center; gap: 24px;
        }
        /* Node 947:7442 — column width is 72px; the paper canvas has its own
           measured width. Keeping these dimensions separate preserves the
           dynamically calculated pile height instead of stretching the canvas. */
        .rights-under-attack__column {
            width: 72px !important;
            gap: 10.196px !important;
            padding: 10.196px 0 !important;
        }
        .rights-under-attack__tower {
            width: 72px !important;
            gap: 3.223px !important;
        }
        .rights-under-attack__value {
            height: auto;
            justify-content: center;
            gap: 1.622px !important;
        }
        .rights-under-attack__value > div {
            height: auto !important;
            gap: 3.223px !important;
        }
        .rights-under-attack__value > div > span:first-child {
            font-size: 22.909px !important;
            line-height: 26.728px !important;
        }
        .rights-under-attack__value > div > span:nth-child(2) {
            width: 20.364px !important;
            height: 20.364px !important;
            aspect-ratio: 1 / 1;
        }
        .rights-under-attack__value > div > span:nth-child(2) img {
            inset: 0 !important;
            width: 100% !important;
            height: 100% !important;
            margin: auto;
        }
        .rights-under-attack__value > span {
            font-size: 12.727px !important;
            line-height: 15.273px !important;
        }
        .rights-under-attack__papers {
            width: 58.637px !important;
            height: auto !important;
        }
        .rights-under-attack__caption {
            width: 72px !important;
            height: auto !important;
            padding: 10.169px 0 !important;
            justify-content: flex-end !important;
            gap: 10.169px !important;
        }
        .rights-under-attack__caption > span:first-child {
            font-size: 12.71px !important;
            line-height: 15.254px !important;
        }
        .rights-under-attack__caption > span:last-child {
            font-size: 10.169px !important;
            line-height: 15.254px !important;
        }
        .rights-under-attack__column:nth-child(2) {
            gap: 10.196px !important;
            padding: 10.196px 0 !important;
        }
        .rights-under-attack__column:nth-child(2) .rights-under-attack__tower { gap: 3.223px !important; }
        .rights-under-attack__column:nth-child(2) .rights-under-attack__value {
            height: auto;
            gap: 1.622px !important;
        }
        .rights-under-attack__column:nth-child(2) .rights-under-attack__value > div { gap: 3.244px !important; }
        .rights-under-attack__column:nth-child(2) .rights-under-attack__value > div > span:first-child {
            font-size: 22.909px !important;
            line-height: 26.728px !important;
        }
        .rights-under-attack__column:nth-child(2) .rights-under-attack__value > div > span:nth-child(2) {
            width: 20.364px !important;
            height: 20.364px !important;
        }
        .rights-under-attack__column:nth-child(2) .rights-under-attack__value > span {
            font-size: 12.727px !important;
            line-height: 15.273px !important;
        }
        .rights-under-attack__column:nth-child(2) .rights-under-attack__papers { width: 58.864px !important; }
        .rights-under-attack__column:nth-child(2) .rights-under-attack__caption {
            height: auto !important;
            padding: 10.169px 0 !important;
            gap: 10.169px !important;
        }
        .rights-under-attack__column:nth-child(2) .rights-under-attack__caption > span:first-child {
            font-size: 12.75px !important;
            line-height: 15.295px !important;
        }
        .rights-under-attack__column:nth-child(2) .rights-under-attack__caption > span:last-child {
            font-size: 10.169px !important;
            line-height: 15.254px !important;
        }
        .rights-under-attack__note--desktop { display: none; }
        .rights-under-attack__note--mobile {
            display: flex;
            width: 227.492px;
            height: 181px;
            margin: 12px auto 24px;
            padding: 48px 24px;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transform: rotate(-5deg);
            background: #ff808a;
            box-shadow: 0 4px 0 #0b0f5e;
            color: #0b0f5e;
            flex-direction: column;
            font-family: "Plus Jakarta Sans", sans-serif;
            text-align: center;
        }
        .rights-under-attack__note--mobile p { margin: 0; font-size: 14px; font-weight: 700; line-height: 24px; }
        .rights-under-attack__note--mobile span { font-size: 14px; line-height: 16px; }
        section[aria-labelledby="rights-under-attack-title"] > div > footer {
            position: static;
            width: min(251px, 100%);
            height: 96px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 24px;
            padding-top: 8px;
            text-align: center;
        }
        section[aria-labelledby="rights-under-attack-title"] > div > footer > div { display: none; }
        section[aria-labelledby="rights-under-attack-title"] > div > footer > span:nth-of-type(1) {
            display: flex;
            width: 100%;
            height: 40px;
            align-items: center;
            justify-content: center;
            padding: 4px 0;
            box-sizing: border-box;
            font-size: 14px;
            line-height: 16px;
        }
        section[aria-labelledby="rights-under-attack-title"] > div > footer > span:nth-of-type(2) {
            width: 113.217px;
            height: 24px;
            align-self: center;
            padding: 6px 0;
            box-sizing: border-box;
        }
    }
    @media (min-width: 768px) {
        .rights-under-attack__note--mobile { display: none; }
        section[aria-labelledby="rights-under-attack-title"] > div > header > h2 {
            height: auto;
            text-box-trim: trim-both;
            text-box-edge: cap alphabetic;
        }
        @supports not (text-box-trim: trim-both) {
            section[aria-labelledby="rights-under-attack-title"] > div > header > h2 {
                height: 76px;
            }
        }
    }
</style>
