---
import siren from "../../assets/images/redesign/home-alerts/alert-siren.png";
import chevron from "../../assets/images/redesign/home-reportagens/chevron-right.svg";
---

<section class="home-alerts" aria-labelledby="home-alerts-title">
    <img class="home-alerts__siren" src={siren.src} alt="" />
    <div class="home-alerts__content">
        <h2 id="home-alerts-title">A gente te avisa</h2>
        <p class="home-alerts__intro">Pra evitar retrocessos, é essencial saber o que<br />está acontecendo no Congresso e agir!</p>
        <p class="home-alerts__detail">Por isso, temos uma IA que faz esse <strong>monitoramento</strong> pra você</p>
        <a class="home-alerts__button" href="/alertas">Receba alertas <img src={chevron.src} alt="" /></a>
    </div>
</section>

<style>
    .home-alerts { position: relative; display: flex; width: 100%; min-height: 605.4716796875px; align-items: center; justify-content: center; margin-top: 48px; overflow: hidden; background-color: #0b0f5e; background-image: url("../../assets/images/redesign/home-reportagens/bg-pattern-cutting-mat.svg"); background-repeat: repeat; background-position: left top; background-size: 200px 200px; padding: 32px; color: #fff; font-family: "Plus Jakarta Sans", sans-serif; }
    .home-alerts *, .home-alerts *::before, .home-alerts *::after { box-sizing: border-box; }
    .home-alerts__siren { position: absolute; top: 108px; left: calc(50% - 60px); display: block; width: 120px; height: 128px; }
    .home-alerts__content { position: relative; display: flex; width: 720px; max-width: 100%; flex-direction: column; align-items: center; gap: 24px; padding: 210px 32px 64px; text-align: center; }
    .home-alerts h2, .home-alerts p { margin: 0; }
    .home-alerts h2 { font-family: "ETC Anybody", "Anybody", sans-serif; font-size: 28px; font-weight: 700; line-height: 32px; text-transform: uppercase; font-variation-settings: "wdth" 75; }
    .home-alerts__intro, .home-alerts__detail { font-size: 18px; font-weight: 400; line-height: 24px; }
    .home-alerts__detail strong { font-weight: 700; }
    .home-alerts__button { display: flex; width: 190px; height: 56px; align-items: center; justify-content: center; gap: 16px; border: 0; padding: 16px 24px; background: #4242f6; color: #fff; font-family: "ETC Anybody", "Anybody", sans-serif; font-size: 18px; font-weight: 700; line-height: 24px; text-transform: uppercase; font-variation-settings: "wdth" 75; text-decoration: none; }
    .home-alerts__button img { width: 13.4142px; height: 8.12132px; transform: rotate(-90deg); }
    .home-alerts__button:hover { background: #0b0f5e; outline: 1px solid #fff; }
    .home-alerts__button:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
    @media (max-width: 767px) {
        .home-alerts { min-height: 605.4716796875px; align-items: stretch; padding: 32px; }
        .home-alerts__siren { top: 48px; left: 24px; width: 80px; height: auto; }
        .home-alerts__content { width: 100%; align-items: flex-start; padding: 136px 0 64px; text-align: left; }
        .home-alerts h2, .home-alerts__intro, .home-alerts__detail { width: 100%; text-align: left; }
        .home-alerts__intro br { display: none; }
    }
</style>
