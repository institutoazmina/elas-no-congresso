---
interface Props {
  title?: string;
  url?: string;
}
const { title = '', url: urlProp } = Astro.props;
const currentUrl = urlProp ?? Astro.url.href;
const shareTitle = title ? `${title} - Elas no Congresso` : 'Elas no Congresso';
---
<ul class="compartilhar">
    <li><p>Compartilhar:</p></li>
    <li><a onclick={`copyToClipboard('${currentUrl}')`} class="share"></a></li>
    <li><a target="_blank" href={`https://api.whatsapp.com/send?text=${encodeURIComponent(currentUrl)}`} class="whatsapp"></a></li>
    <li><a target="_blank" href={`http://www.facebook.com/sharer.php?u=${encodeURIComponent(currentUrl)}&t=${encodeURIComponent(shareTitle)}`} class="facebook"></a></li>
    <li><a target="_blank" href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(shareTitle)}&url=${encodeURIComponent(currentUrl)}`} class="twitter"></a></li>
</ul>
