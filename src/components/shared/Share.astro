---
interface Props { title?: string; url?: string; inline?: boolean }
const { title = '', url: urlProp, inline = false } = Astro.props;
const currentUrl = urlProp ?? Astro.url.href;
const shareTitle = title ? `${title} - Elas no Congresso` : 'Elas no Congresso';
const links = [
    ['WhatsApp', '/assets/images/social/whatsapp.svg', `https://api.whatsapp.com/send?text=${encodeURIComponent(currentUrl)}`],
    ['Facebook', '/assets/images/social/facebook.svg', `https://www.facebook.com/sharer.php?u=${encodeURIComponent(currentUrl)}`],
    ['X', '/assets/images/social/twitter.svg', `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareTitle)}&url=${encodeURIComponent(currentUrl)}`],
];
---
<nav aria-label="Compartilhar" class:list={[inline && "tw:min-[992px]:static! tw:min-[992px]:translate-x-0! tw:min-h-12", "tw:relative tw:z-10 tw:mx-auto tw:flex tw:w-full tw:max-w-[1310px] tw:items-center tw:justify-start tw:gap-2 tw:px-4 tw:text-lime tw:min-[992px]:absolute tw:min-[992px]:left-1/2 tw:min-[992px]:top-4 tw:min-[992px]:-translate-x-1/2 tw:min-[992px]:justify-end tw:min-[992px]:px-8"]}>
    <span class="tw:mr-2 tw:mb-2 tw:font-display tw:text-[clamp(10px,calc(.625rem_+_2*(100vw_-_500px)/700),12px)] tw:font-black tw:[font-variation-settings:'wdth'_300] tw:uppercase">Compartilhar:</span>
    <button type="button" data-copy-url={currentUrl} aria-label="Copiar link" class="tw:mb-2 tw:size-[25px] tw:shrink-0 tw:cursor-pointer tw:hover:brightness-150">
        <img src="/assets/images/social/share.svg" alt="" class="tw:size-full" />
    </button>
    {links.map(([label, icon, href]) => <a href={href} aria-label={label} target="_blank" rel="noopener noreferrer" class="tw:mb-2 tw:size-[25px] tw:shrink-0 tw:hover:brightness-150"><img src={icon} alt="" class="tw:size-full" /></a>)}
    <span data-copy-status aria-live="polite" class="tw:sr-only"></span>
</nav>
<script>
    document.addEventListener('click', async (event) => {
        const button = (event.target as Element).closest<HTMLButtonElement>('[data-copy-url]');
        if (!button) return;
        const status = button.parentElement?.querySelector('[data-copy-status]');
        try { await navigator.clipboard.writeText(button.dataset.copyUrl!); if (status) status.textContent = 'Link copiado!'; }
        catch { if (status) status.textContent = 'Não foi possível copiar o link'; }
    });
</script>
