---
const { placeholder = "Buscar por termo, proposta ou parlamentar" } = Astro.props;
---

<form class="alerts-search tw:border-2 tw:border-solid tw:border-[#1b2548] tw:flex tw:h-14 tw:w-156.5 tw:[&_button]:items-center tw:[&_button]:self-center tw:[&_button]:bg-[#1b2548] tw:[&_button]:border-0 tw:[&_button]:box-border tw:[&_button]:text-[#c8f53e] tw:[&_button]:cursor-pointer tw:[&_button]:flex tw:[&_button]:h-14 tw:[&_button]:justify-center tw:[&_button]:[transition:background-color_160ms_ease-out,color_160ms_ease-out] tw:[&_button]:w-14.5 tw:[&_button]:py-3 tw:[&_button]:px-5 tw:motion-reduce:[&_button]:[transition:none] tw:max-[941px]:w-full" role="search" data-alerts-search>
    <input class="tw:border-0 tw:text-navy tw:flex-[1_0_0] tw:font-normal tw:text-sm tw:leading-4 tw:font-sans tw:min-w-0 tw:[outline:0] tw:pt-3.5 tw:pb-4 tw:px-4 tw:placeholder:text-[#949494] tw:placeholder:opacity-100 tw:focus-visible:outline-2 tw:focus-visible:outline-accent tw:focus-visible:-outline-offset-1" type="search" name="q" aria-label="Buscar por termo, proposta ou parlamentar" placeholder={placeholder} />
    <button class="tw:hover:bg-accent tw:hover:text-[#c8f53e] tw:focus-visible:outline-2 tw:focus-visible:outline-accent tw:focus-visible:-outline-offset-1" type="submit" aria-label="Buscar alertas">
        <svg class="tw:fill-none tw:h-4.5 tw:stroke-[currentColor] tw:[stroke-linecap:square] tw:stroke-[2px] tw:w-4.5" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4 4" /></svg>
    </button>
</form>


