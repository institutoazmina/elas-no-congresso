---
import AlertCard from "./AlertCard.astro";
import type { AlertProposition } from "../../service/api/alerts";

interface Props {
    propositions: AlertProposition[];
    total: number;
}

const { propositions, total } = Astro.props;
const pageSize = 5;
const pageCount = Math.ceil(total / pageSize);
const serializedPropositions = JSON.stringify(propositions).replaceAll("<", "\\u003c");
const formatDate = (date: string) => {
    const [year, month, day] = date.split("-");
    return `${day}/${month}/${year}`;
};
---

<div class="alerts-results tw:flex tw:flex-col tw:gap-8" data-alerts-results data-page-size={pageSize} data-total={total}>
    <section class="alerts-list tw:flex tw:flex-col tw:w-204 tw:max-[941px]:w-full tw:[&_>_div_+_div]:-mt-0.5" aria-label="Alertas recentes" aria-live="polite">
        {propositions.slice(0, pageSize).map((proposition, index) => (
            <div data-alert-item>
                <AlertCard
                    alert={{
                        category: proposition.typeCode,
                        date: formatDate(proposition.presentedAt),
                        dateIso: proposition.presentedAt,
                        title: proposition.numberLabel,
                        description: proposition.summary,
                        href: proposition.url,
                    }}
                    featured={index === 0}
                />
            </div>
        ))}
    </section>
    {pageCount > 1 && (
        <nav class="alerts-pagination tw:items-center tw:flex tw:gap-4 tw:justify-center tw:w-204 tw:[&_button]:items-center tw:[&_button]:bg-white tw:[&_button]:border-[2px] tw:[&_button]:border-solid tw:[&_button]:border-transparent tw:[&_button]:text-accent tw:[&_button]:cursor-pointer tw:[&_button]:flex tw:[&_button]:font-bold tw:[&_button]:text-lg tw:[&_button]:leading-6 tw:[&_button]:font-display tw:[&_button]:h-10 tw:[&_button]:justify-center tw:[&_button]:min-w-10 tw:[&_button]:p-1.5 tw:[&_span]:text-navy tw:[&_span]:font-bold tw:[&_span]:text-lg tw:[&_span]:leading-6 tw:[&_span]:font-display tw:[&_span]:min-w-40 tw:[&_span]:text-center tw:[&_span]:uppercase tw:max-[941px]:w-full tw:[&[hidden]]:hidden" aria-label="Paginação das proposições">
            <button class="tw:hover:border-accent tw:focus-visible:outline-2 tw:focus-visible:outline-accent tw:focus-visible:outline-offset-0.5 tw:disabled:cursor-not-allowed tw:disabled:opacity-30" type="button" data-previous aria-label="Página anterior">&larr;</button>
            <span data-page-status>Página 1 de {pageCount}</span>
            <button class="tw:hover:border-accent tw:focus-visible:outline-2 tw:focus-visible:outline-accent tw:focus-visible:outline-offset-0.5 tw:disabled:cursor-not-allowed tw:disabled:opacity-30" type="button" data-next aria-label="Próxima página">&rarr;</button>
        </nav>
    )}
    <p class="alerts-results__empty tw:text-navy tw:font-bold tw:text-base tw:leading-6 tw:font-sans tw:text-center tw:m-0 tw:[&[hidden]]:hidden" data-empty hidden>Nenhuma proposição encontrada para essa busca.</p>
    <p class="alerts-results__error tw:text-navy tw:font-bold tw:text-base tw:leading-6 tw:font-sans tw:text-center tw:m-0 tw:[&[hidden]]:hidden" data-load-error hidden>Não foi possível carregar esta página. Tente novamente.</p>
    <template data-alert-template>
        <div data-alert-item>
            <AlertCard alert={{ category: "", date: "", dateIso: "", title: "", description: "", href: "" }} />
        </div>
    </template>
    <script type="application/json" data-initial-propositions set:html={serializedPropositions} />
</div>

<script>
    import { PUBLIC_API_BASE_URL } from "astro:env/client";
    import { onAlertsQueryStateChange, parseAlertsQueryState, updateAlertsQueryState, type AlertsQueryState, type AlertsSortOrder, type HistoryMode } from "../../lib/alerts/query-state";

    type Proposition = {
        id: number;
        typeCode: string;
        numberLabel: string;
        presentedAt: string;
        summary: string;
        url: string;
    };

    type PropositionResponse = {
        id: number;
        type_code: string;
        number_label: string;
        presented_at: string;
        ementa: string;
        tramitation_url: string;
    };

    const initializePagination = () => {
        document.querySelectorAll<HTMLElement>("[data-alerts-results]:not([data-ready])").forEach((results) => {
            results.dataset.ready = "true";
            const list = results.querySelector<HTMLElement>(".alerts-list");
            const template = results.querySelector<HTMLTemplateElement>("[data-alert-template]");
            const initialData = results.querySelector<HTMLScriptElement>("[data-initial-propositions]");
            const content = results.closest<HTMLElement>(".alerts-content");
            const searchForm = content?.querySelector<HTMLFormElement>("[data-alerts-search]");
            const pagination = results.querySelector<HTMLElement>(".alerts-pagination");
            const previous = results.querySelector<HTMLButtonElement>("[data-previous]");
            const next = results.querySelector<HTMLButtonElement>("[data-next]");
            const status = results.querySelector<HTMLElement>("[data-page-status]");
            const empty = results.querySelector<HTMLElement>("[data-empty]");
            const error = results.querySelector<HTMLElement>("[data-load-error]");
            const pageSize = Number(results.dataset.pageSize);
            const initialTotal = Number(results.dataset.total);
            const initialPropositions = JSON.parse(initialData?.textContent || "[]") as Proposition[];
            const pageCache = new Map<string, Proposition[]>();
            const totals = new Map<string, number>([["", initialTotal]]);
            pageCache.set(`|newest|0`, initialPropositions.slice(0, pageSize));
            let pageCount = Math.ceil(initialTotal / pageSize);
            let currentPage = 0;
            let activeQuery = "";
            let activeSort: AlertsSortOrder = "newest";
            let requestVersion = 0;

            const renderCards = (items: Proposition[]) => {
                if (!list || !template) return;
                const cards = items.map((item, index) => {
                    const card = template.content.firstElementChild?.cloneNode(true) as HTMLElement;
                    const [year, month, day] = item.presentedAt.split("-");
                    const article = card.querySelector("article");
                    if (currentPage === 0 && index === 0) article?.classList.add("alert-card--featured");
                    const category = card.querySelector<HTMLElement>("[data-alert-category]");
                    const date = card.querySelector<HTMLTimeElement>("[data-alert-date]");
                    const title = card.querySelector<HTMLElement>("[data-alert-title]");
                    const description = card.querySelector<HTMLElement>("[data-alert-description]");
                    const link = card.querySelector<HTMLAnchorElement>("[data-alert-link]");
                    if (category) category.textContent = item.typeCode;
                    if (date) { date.textContent = `${day}/${month}/${year}`; date.dateTime = item.presentedAt; }
                    if (title) title.textContent = item.numberLabel;
                    if (description) description.textContent = item.summary;
                    if (link) link.href = item.url;
                    return card;
                });
                list.replaceChildren(...cards);
            };

            const fetchPropositions = async (offset: number, limit: number) => {
                const isLocal = ["localhost", "127.0.0.1", "[::1]"].includes(location.hostname);
                const apiBase = isLocal ? `${location.origin}/api/v1` : PUBLIC_API_BASE_URL;
                const url = new URL(`${apiBase}/propositions/`);
                url.searchParams.set("limit", String(limit));
                url.searchParams.set("offset", String(offset));
                url.searchParams.set("sort", activeSort);
                if (activeQuery) url.searchParams.set("q", activeQuery);
                const response = await fetch(url);
                if (!response.ok) throw new Error(String(response.status));
                const { items, count } = await response.json() as { items: PropositionResponse[]; count: number };
                return {
                    count,
                    items: items.map((item) => ({
                        id: item.id,
                        typeCode: item.type_code,
                        numberLabel: item.number_label,
                        presentedAt: item.presented_at,
                        summary: item.ementa,
                        url: item.tramitation_url,
                    })),
                };
            };

            const showPage = async (page: number, historyMode: HistoryMode = "replace") => {
                const version = ++requestVersion;
                previous && (previous.disabled = true);
                next && (next.disabled = true);
                if (error) error.hidden = true;
                if (empty) empty.hidden = true;

                try {
                    const total = totals.get(activeQuery) ?? initialTotal;
                    pageCount = Math.ceil(total / pageSize);
                    const requestedPage = Math.max(0, Math.min(page, Math.max(0, pageCount - 1)));
                    const visualStart = requestedPage * pageSize;
                    const cacheKey = `${activeQuery}|${activeSort}|${visualStart}`;
                    let pageItems = pageCache.get(cacheKey);
                    if (!pageItems) {
                        const result = await fetchPropositions(visualStart, pageSize);
                        if (version !== requestVersion) return;
                        totals.set(activeQuery, result.count);
                        pageCount = Math.ceil(result.count / pageSize);
                        if (pageCount > 0 && requestedPage >= pageCount) {
                            await showPage(pageCount - 1, historyMode);
                            return;
                        }
                        pageItems = result.items;
                        pageCache.set(cacheKey, pageItems);
                    }
                    currentPage = requestedPage;
                    renderCards(pageItems);
                    if (empty) empty.hidden = pageItems.length > 0;
                    if (pagination) pagination.hidden = pageCount <= 1;
                    if (status && pageCount > 0) status.textContent = `Página ${currentPage + 1} de ${pageCount}`;
                    updateAlertsQueryState({ q: activeQuery, page: currentPage + 1, sort: activeSort }, historyMode);
                } catch {
                    if (version !== requestVersion) return;
                    if (error) error.hidden = false;
                }

                if (previous) previous.disabled = currentPage === 0;
                if (next) next.disabled = currentPage === pageCount - 1;
            };

            previous?.addEventListener("click", () => showPage(currentPage - 1));
            next?.addEventListener("click", () => showPage(currentPage + 1));
            const applyQueryState = (state: AlertsQueryState, historyMode: HistoryMode) => {
                const queryInput = searchForm?.querySelector<HTMLInputElement>('input[name="q"]');
                if (queryInput) queryInput.value = state.q;
                activeQuery = state.q;
                activeSort = state.sort;
                pageCount = Math.ceil((totals.get(activeQuery) ?? initialTotal) / pageSize);
                showPage(state.page - 1, historyMode);
            };
            searchForm?.addEventListener("submit", (event) => {
                event.preventDefault();
                const queryInput = searchForm.querySelector<HTMLInputElement>('input[name="q"]');
                applyQueryState({ q: queryInput?.value.trim() ?? "", page: 1, sort: activeSort }, "replace");
            });
            const handleSortChange = (event: Event) => {
                const sort = (event as CustomEvent<AlertsSortOrder>).detail;
                applyQueryState({ q: activeQuery, page: 1, sort }, "replace");
            };
            window.addEventListener("alerts-sort-change", handleSortChange);
            const stopQueryStateListener = onAlertsQueryStateChange((state) => applyQueryState(state, "none"));
            document.addEventListener("astro:before-swap", () => {
                stopQueryStateListener();
                window.removeEventListener("alerts-sort-change", handleSortChange);
            }, { once: true });
            applyQueryState(parseAlertsQueryState(window.location.href), "replace");
        });
    };

    document.addEventListener("astro:page-load", initializePagination);
    initializePagination();
</script>


