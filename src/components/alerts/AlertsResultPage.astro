---
import AlertsResult from "./AlertsResult";
import PageLayout from "../../layouts/PageLayout.astro";
/**
 * Página de aterrissagem dos links de e-mail (confirmar / cancelar).
 *
 * A API redireciona para cá com `?status=ok|invalido`, então a mensagem é
 * escolhida no browser — a página em si é estática.
 */

interface Props {
    title: string;
    ok: { heading: string; body: string };
    invalido: { heading: string; body: string };
}

const { title, ok, invalido } = Astro.props;
---

<PageLayout title={`${title} | Elas no Congresso`} noindex
    headerClass="site-alerts-header-background site-shared-background tw:bg-white tw:bg-[url('/src/assets/images/background/bg-pattern-rough-paper.png')] tw:bg-top tw:bg-repeat tw:bg-size-[400px_400px]"
>
        <AlertsResult ok={ok} invalido={invalido} client:load />
</PageLayout>
