        <div class="
            site-header__desktop-links tw:items-center tw:hidden tw:gap-10 tw:ml-auto tw:[&_a]:text-inherit
            tw:[&_a]:font-display tw:[&_a]:text-lg tw:[&_a]:font-bold tw:[&_a]:[font-variation-settings:'wdth'_75]
