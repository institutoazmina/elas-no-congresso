            tw:max-md:[.site-header.site-shared-background.site-header--scrolled.site-header--over-hero:not(:has(&[open]))]:[background-blend-mode:multiply]
            tw:max-md:[&[open]_summary_span:nth-child(1)]:top-[13px]
            tw:max-md:[&[open]_summary_span:nth-child(1)]:[transform:rotate(45deg)]
            tw:max-md:[&[open]_summary_span:nth-child(2)]:opacity-0 tw:max-md:[&[open]_summary_span:nth-child(3)]:top-[13px]
            tw:max-md:[&[open]_summary_span:nth-child(3)]:[transform:rotate(-45deg)]
            tw:max-md:[body.alerts-email-modal-open_&_summary]:w-7 tw:max-md:[body.alerts-email-modal-open_&_summary]:h-5.5
            tw:max-md:[body.alerts-email-modal-open_&_summary_span]:left-1
            tw:max-md:[body.alerts-email-modal-open_&_summary_span]:w-5
            tw:max-md:[body.alerts-email-modal-open_&_summary_span:nth-child(1)]:top-1
            tw:max-md:[body.alerts-email-modal-open_&_summary_span:nth-child(2)]:top-2.5
            tw:max-md:[body.alerts-email-modal-open_&_summary_span:nth-child(3)]:top-4
            tw:max-md:[body.alerts-email-modal-open_&[open]_summary_span:nth-child(1)]:top-2.5
            tw:max-md:[body.alerts-email-modal-open_&[open]_summary_span:nth-child(3)]:top-2.5
        ">
            <summary class="tw:cursor-pointer tw:gap-[5px] tw:h-5.5 tw:list-none tw:w-7 tw:p-0 tw:max-md:relative tw:max-md:block tw:max-md:w-7 tw:max-md:h-7 tw:flex tw:flex-col" aria-label="Abrir menu">
                <span class="
                    tw:bg-current tw:block tw:h-0.5 tw:w-7 tw:max-md:absolute tw:max-md:left-0
                    tw:max-md:[transition:top_180ms_ease,_opacity_180ms_ease,_transform_180ms_ease] tw:max-md:top-1
                "></span><span class="
                    tw:bg-current tw:block tw:h-0.5 tw:w-7 tw:max-md:absolute tw:max-md:left-0
                    tw:max-md:[transition:top_180ms_ease,_opacity_180ms_ease,_transform_180ms_ease] tw:max-md:top-[13px]
                "></span><span class="
                    tw:bg-current tw:block tw:h-0.5 tw:w-7 tw:max-md:absolute tw:max-md:left-0
                    tw:max-md:[transition:top_180ms_ease,_opacity_180ms_ease,_transform_180ms_ease] tw:max-md:top-5.5
                "></span>
            </summary>
            <div class="
                site-header__mobile-panel tw:[&_a]:text-inherit tw:[&_a]:font-display tw:[&_a]:text-lg tw:[&_a]:font-bold
                tw:[&_a]:[font-variation-settings:'wdth'_75] tw:[&_a]:tracking-normal tw:[&_a]:leading-6 tw:[&_a]:no-underline
                tw:[&_a]:uppercase tw:[&_a]:whitespace-nowrap tw:[&_a]:relative tw:[&_a]:z-12 tw:bg-white tw:border-t-[4px]
                tw:border-solid tw:border-t-lime tw:shadow-[0_12px_20px_rgba(11,_15,_94,_0.16)] tw:gap-5 tw:absolute tw:right-0
                tw:top-[calc(100%_+_8px)] tw:w-[min(320px,_calc(100vw_-_32px))] tw:z-10 tw:p-6 tw:max-md:[&_a]:flex
                tw:max-md:[&_a]:w-full tw:max-md:[&_a]:items-center tw:max-md:[&_a]:border-b tw:max-md:[&_a]:border-solid
                tw:max-md:[&_a]:border-b-[rgba(255,_255,_255,_0.3)] tw:max-md:[&_a]:text-white tw:max-md:[&_a]:text-left
                tw:max-md:[&_a]:py-4 tw:max-md:[&_a]:px-6 tw:max-md:fixed tw:max-md:inset-[52px_0_0] tw:max-md:z-99
                tw:max-md:w-full tw:max-md:min-h-[calc(100dvh_-_52px)] tw:max-md:[align-content:start] tw:max-md:gap-0
                tw:max-md:overflow-y-auto tw:max-md:border-0 tw:max-md:bg-ink tw:max-md:shadow-none tw:max-md:p-0 tw:flex
                tw:flex-col tw:max-md:flex tw:max-md:flex-col
            ">
                {
                links.map((link) => (
                    <a
                        href={link.href}
                        class="ff1 tw:[.site-header_&]:font-display tw:[.author-route-page_.site-header_&]:font-display"
                        data-highlighter-target
                        data-highlighter-routes={link.href}
                        aria-current={currentPath === link.href ? "page" : undefined}
                    >
                        <span>{link.label}</span>
                    </a>
                    ))
                }
            </div>
        </details>
    </nav>
</header>



<script>
    // O módulo executa uma vez por sessão, mas o header é re-renderizado a
    // cada navegação client-side. Por isso, listeners de window e observers
    // vivem em escopo de módulo (registrados uma única vez, sem duplicar a
    // cada rota) e os handlers sempre resolvem o header atual do documento,
    // nunca um nó de página anterior.
    let mobileScrollBound = false;
    let desktopScrollBound = false;
    let highlighterLayoutObserver: ResizeObserver | null = null;
    let heroCache: { element: Element | null; surface: string | null } | null = null;

    // Superfície real do Hero ([data-page-hero]): primeira cor de fundo
    // opaca do Hero ou de seus ancestrais. Resolve uma vez por página;
    // se o Hero mudar de cor, o header acompanha sem hardcode por rota.
    const resolveHeroSurface = (hero: Element): string => {
        let node: Element | null = hero;
        while (node && node !== document.documentElement) {
            const bg = window.getComputedStyle(node).backgroundColor;
            const match = bg.match(/rgba?\(([^)]+)\)/);
            if (match) {
                const parts = match[1].split(",").map((part) => part.trim());
                const alpha = parts.length === 4 ? Number.parseFloat(parts[3]) : 1;
                if (alpha > 0) return bg;
            }
            node = node.parentElement;
        }
        return "#fff";
    };

    // Liga/desliga .site-header--over-hero conforme a faixa do header
    // ([0, altura real]) cruza a região real do Hero. Sem números mágicos.
    const syncHeroState = (header: HTMLElement) => {
        if (!heroCache || (heroCache.element && !heroCache.element.isConnected)) {
            const hero = document.querySelector("[data-page-hero]");
            heroCache = { element: hero, surface: hero ? resolveHeroSurface(hero) : null };
        }
        const hero = heroCache.element;
        if (!hero || !heroCache.surface) {
            header.classList.remove("site-header--over-hero");
            header.style.removeProperty("--header-hero-surface");
            return;
        }
        const heroBounds = hero.getBoundingClientRect();
        const headerHeight = header.offsetHeight || 0;
        const overHero = heroBounds.top <= headerHeight && heroBounds.bottom > headerHeight;
        // Durante a animação de saída (escondido), congela a superfície de
        // entrada: a troca hero<->sólido só volta a avaliar com ele visível,
        // evitando qualquer flash no meio do movimento.
        if (
            header.classList.contains("site-header--hidden") ||
            header.classList.contains("site-header--desktop-hidden")
        ) {
            return;
        }
        header.classList.toggle("site-header--over-hero", overHero);
        if (overHero) header.style.setProperty("--header-hero-surface", heroCache.surface);
    };

    const updateHighlighter = () => {
        const nav = document.querySelector(".site-header__content");
        const highlighter = nav?.querySelector(".highlighter-marks");

        if (!nav || !highlighter) return;

        const currentPath = (window.location.pathname.replace(/\/+$/, "") || "/");
        nav.querySelectorAll(
            ".site-header__desktop-links a[data-highlighter-routes], .site-header__mobile-panel a[data-highlighter-routes]",
        ).forEach((link) => {
            const routes = link.dataset.highlighterRoutes?.split(",") ?? [];
            if (routes.includes(currentPath)) {
                link.setAttribute("aria-current", "page");
            } else {
                link.removeAttribute("aria-current");
            }
        });
        const isMobile = window.matchMedia("(max-width: 820px)").matches;
        const matchesMobileDesign = window.matchMedia("(max-width: 767px)").matches;
        const target = isMobile
            ? (["/sobre", "/ia-feminista", "/reportagens"].includes(currentPath) ? null : nav.querySelector(".site-header__brand"))
            : [...nav.querySelectorAll("[data-highlighter-target]")].find(
                (element) => {
                    const styles = window.getComputedStyle(element);
                    const routes = element.dataset.highlighterRoutes?.split(",") ?? [];
                    return (
                        routes.includes(currentPath) &&
                        styles.display !== "none" &&
                        element.getClientRects().length > 0
                    );
                },
            );

        if (!target) {
            highlighter.hidden = true;
            return;
        }

        const navBounds = nav.getBoundingClientRect();
        const targetBounds = target.getBoundingClientRect();
        const horizontalPadding = 16;
        const isBrandTarget = target.classList.contains("site-header__brand");
        const isMobileBrandTarget = matchesMobileDesign && isBrandTarget;
        const mobileBrandScale = isMobileBrandTarget ? targetBounds.width / 128 : 1;
        const highlighterWidth = isBrandTarget
            ? isMobileBrandTarget
                ? 149 * mobileBrandScale
                : 217
            : targetBounds.width + horizontalPadding * 2;
        const highlighterLeft = isMobileBrandTarget
            ? targetBounds.left - navBounds.left - 10 * mobileBrandScale
            : isBrandTarget
              ? targetBounds.left - navBounds.left
                + (targetBounds.width - highlighterWidth) / 2
              : targetBounds.left - navBounds.left - horizontalPadding;
        const highlighterTop =
            targetBounds.top - navBounds.top + targetBounds.height / 2
            - (isMobileBrandTarget ? mobileBrandScale : 0);

        highlighter.style.setProperty(
            "--highlighter-left",
            `${highlighterLeft}px`,
        );
        highlighter.style.setProperty(
            "--highlighter-top",
            `${highlighterTop}px`,
        );
        highlighter.style.setProperty(
            "--highlighter-width",
            `${highlighterWidth}px`,
        );
        if (isMobileBrandTarget) {
            highlighter.style.setProperty(
                "--highlighter-height",
                `${30 * mobileBrandScale}px`,
            );
        } else {
            highlighter.style.removeProperty("--highlighter-height");
        }
        highlighter.style.setProperty(
            "--highlighter-z-index",
            target.closest(".site-header__mobile-panel") ? "11" : "0",
        );
        highlighter.hidden = false;
    };

    const scheduleHighlighterUpdate = () => {
        window.requestAnimationFrame(updateHighlighter);
    };

    const prepareMobileHeaderNavigation = () => {
        const header = document.querySelector<HTMLElement>(".site-header");
        const mobileMenu = header?.querySelector<HTMLDetailsElement>(
            ".site-header__mobile-menu",
        );
        if (!header || !mobileMenu) return;

        mobileMenu.open = false;
        header.classList.remove("site-header--hidden", "site-header--scrolled");
        header.dataset.mobilePreviousScroll = "0";
    };

    const bindMobileMenu = () => {
        const mobileMenu = document.querySelector<HTMLDetailsElement>(
            ".site-header__mobile-menu",
        );

        if (!mobileMenu) return;

        const summary = mobileMenu.querySelector("summary");
        const header = mobileMenu.closest<HTMLElement>(".site-header");
        const syncMenuState = () => {
            const isOpen = mobileMenu.open;
            summary?.setAttribute("aria-label", isOpen ? "Fechar menu" : "Abrir menu");
            if (isOpen) header?.classList.remove("site-header--hidden");
            if (header) header.dataset.mobilePreviousScroll = String(Math.max(window.scrollY, 0));
            scheduleHighlighterUpdate();
        };

        if (!mobileMenu.dataset.highlighterBound) {
            mobileMenu.dataset.highlighterBound = "true";
            mobileMenu.addEventListener("toggle", syncMenuState);
            mobileMenu.querySelectorAll("a").forEach((link) => {
                link.addEventListener("click", prepareMobileHeaderNavigation);
            });
        }

        const brand = header?.querySelector<HTMLElement>(".site-header__brand");
        if (brand && !brand.dataset.mobileStateBound) {
            brand.dataset.mobileStateBound = "true";
            brand.addEventListener("click", prepareMobileHeaderNavigation);
        }

        syncMenuState();
    };

    const bindMobileHeaderScroll = () => {
        const mobileViewport = window.matchMedia("(max-width: 767px)");
        const threshold = 8;

        const updateHeader = (forceVisible = false) => {
            const header = document.querySelector<HTMLElement>(".site-header");
            if (!header || !header.isConnected) return;
            const currentScroll = Math.max(window.scrollY, 0);
            const previousScroll = Number(header.dataset.mobilePreviousScroll ?? currentScroll);
            const mobileMenu = header.querySelector<HTMLDetailsElement>(
                ".site-header__mobile-menu",
            );

            if (!mobileViewport.matches) {
                header.classList.remove("site-header--hidden");
                header.classList.remove("site-header--scrolled");
                header.dataset.mobilePreviousScroll = String(currentScroll);
                return;
            }

            const isAtTop = currentScroll <= threshold;

            header.classList.toggle("site-header--scrolled", !isAtTop);

            if (forceVisible || mobileMenu?.open || isAtTop) {
                header.classList.remove("site-header--hidden");
                if (isAtTop) {
                    header.classList.remove(
                        "site-header--scrolling-up",
                        "site-header--scrolling-down",
                    );
                }
                header.dataset.mobilePreviousScroll = String(currentScroll);
                return;
            }

            const delta = currentScroll - previousScroll;
            if (Math.abs(delta) >= threshold) {
                header.classList.toggle("site-header--hidden", delta > 0);
                header.classList.toggle("site-header--scrolling-down", delta > 0);
                header.classList.toggle("site-header--scrolling-up", delta < 0);
                header.dataset.mobilePreviousScroll = String(currentScroll);
            }

            syncHeroState(header);
        };

        if (!mobileScrollBound) {
            mobileScrollBound = true;
            let ticking = false;
            window.addEventListener("scroll", () => {
                if (!ticking) {
                    ticking = true;
                    window.requestAnimationFrame(() => {
                        updateHeader();
                        ticking = false;
                    });
                }
            }, { passive: true });

            mobileViewport.addEventListener("change", () => { updateHeader(true); });
        }

        updateHeader(true);
    };

    const bindDesktopHeaderScroll = () => {
        const desktopViewport = window.matchMedia("(min-width: 768px)");
        const threshold = 8;

        const updateHeader = (forceVisible = false) => {
            const header = document.querySelector<HTMLElement>(".site-header");
            if (!header || !header.isConnected) return;
            const currentScroll = Math.max(window.scrollY, 0);
            const previousScroll = Number(header.dataset.desktopPreviousScroll ?? currentScroll);
            const mobileMenu = header.querySelector<HTMLDetailsElement>(
                ".site-header__mobile-menu",
            );

            syncHeroState(header);

            if (!desktopViewport.matches) {
                header.classList.remove(
                    "site-header--desktop-hidden",
                    "site-header--desktop-scrolled",
                );
                header.dataset.desktopPreviousScroll = String(currentScroll);
                return;
            }

            const isAtTop = currentScroll <= threshold;
            if (isAtTop) {
                header.classList.remove(
                    "site-header--desktop-hidden",
                    "site-header--desktop-scrolled",
                );
                header.classList.remove(
                    "site-header--scrolling-up",
                    "site-header--scrolling-down",
                );
                header.dataset.desktopPreviousScroll = String(currentScroll);
                return;
            }

            if (forceVisible || mobileMenu?.open) {
                header.classList.remove("site-header--desktop-hidden");
                header.classList.add("site-header--desktop-scrolled");
                header.dataset.desktopPreviousScroll = String(currentScroll);
                return;
            }

            const delta = currentScroll - previousScroll;
            if (Math.abs(delta) >= threshold) {
                const isScrollingUp = delta < 0;
                header.classList.toggle("site-header--desktop-hidden", !isScrollingUp);
                header.classList.toggle("site-header--scrolling-down", !isScrollingUp);
                header.classList.toggle("site-header--scrolling-up", isScrollingUp);
                header.classList.add("site-header--desktop-scrolled");
                header.dataset.desktopPreviousScroll = String(currentScroll);
            }

            syncHeroState(header);
        };

        if (!desktopScrollBound) {
            desktopScrollBound = true;
            let ticking = false;
            window.addEventListener("scroll", () => {
                if (!ticking) {
                    ticking = true;
                    window.requestAnimationFrame(() => {
                        updateHeader();
                        ticking = false;
                    });
                }
            }, { passive: true });

            desktopViewport.addEventListener("change", () => { updateHeader(true); });
        }

        updateHeader(true);
    };

    const resetDesktopHeaderState = () => {
        const header = document.querySelector<HTMLElement>(".site-header");
        if (!header) return;

        header.classList.remove(
            "site-header--desktop-hidden",
            "site-header--desktop-scrolled",
        );
        header.classList.remove(
            "site-header--scrolling-up",
            "site-header--scrolling-down",
        );
        header.classList.remove("site-header--over-hero");
        header.style.removeProperty("--header-hero-surface");
        header.dataset.desktopPreviousScroll = String(Math.max(window.scrollY, 0));
    };

    const resetMobileHeaderState = () => {
        const header = document.querySelector<HTMLElement>(".site-header");
        const mobileMenu = header?.querySelector<HTMLDetailsElement>(
            ".site-header__mobile-menu",
        );
        if (!header || !mobileMenu) return;

        mobileMenu.open = false;
        header.classList.remove("site-header--hidden");
        header.classList.remove(
            "site-header--scrolling-up",
            "site-header--scrolling-down",
        );
        header.classList.remove("site-header--over-hero");
        header.style.removeProperty("--header-hero-surface");
        header.classList.toggle(
            "site-header--scrolled",
            window.matchMedia("(max-width: 767px)").matches && window.scrollY > 8,
        );
        header.dataset.mobilePreviousScroll = String(Math.max(window.scrollY, 0));
    };

    const bindHighlighterLayoutObserver = () => {
        const nav = document.querySelector(".site-header__content");

        if (!nav) return;

        highlighterLayoutObserver?.disconnect();
        highlighterLayoutObserver = new ResizeObserver(scheduleHighlighterUpdate);
        highlighterLayoutObserver.observe(nav);
        nav.querySelectorAll("[data-highlighter-target]").forEach((target) => {
            highlighterLayoutObserver?.observe(target);
        });

        document.fonts?.ready.then(scheduleHighlighterUpdate);
    };

    const refreshHighlighter = (resetState = false) => {
        if (resetState) resetMobileHeaderState();
        if (resetState) resetDesktopHeaderState();
        heroCache = null;
        bindMobileMenu();
        bindMobileHeaderScroll();
        bindDesktopHeaderScroll();
        bindHighlighterLayoutObserver();
        scheduleHighlighterUpdate();
    };

    refreshHighlighter(true);
    window.addEventListener("resize", scheduleHighlighterUpdate);
    window.addEventListener("popstate", scheduleHighlighterUpdate);
    document.addEventListener("astro:before-swap", prepareMobileHeaderNavigation);
    document.addEventListener("astro:after-swap", () => { refreshHighlighter(true); });
    document.addEventListener("astro:page-load", () => { refreshHighlighter(); });
</script>
