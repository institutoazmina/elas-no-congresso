---
import { Picture } from 'astro:assets';
import FormSubstack from './FormSubstack.astro';
import novidades from '../assets/images/novidades-exclusivas.png';
---
<section class="redes">
    <div class="container-fluid wrap">
        <div class="row">
            <div class="col-xs-12 col-md-6">
                <figure style="margin: 0 auto; width: fit-content">
                    <Picture src={novidades} formats={["avif", "webp"]} alt="" loading="lazy" />
                </figure>
            </div>
            <div class="col-xs-12 col-md-6" style="align-self: center">
                <h3 class="titulo-variavel t8 mb1 tw:text-center tw:leading-tight tcvm">
                    <span class="w300 wdth200">Receba</span>
                    <span class="w900 wdth150">novidades</span>
                    <span class="w900 wdth400">exclusivas</span>
                </h3>
                <div style="margin: 0 auto; width: fit-content">
                    <FormSubstack />
                </div>
            </div>
        </div>
    </div>
</section>
