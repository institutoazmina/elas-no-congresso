---
---
<script src="https://unpkg.com/petite-vue" is:inline></script>
<!-- d3 is already loaded globally by BaseLayout (used by /build/script.js); not re-imported here -->
<script src="https://cdn.jsdelivr.net/npm/lodash@4.17.21/lodash.min.js" is:inline></script>
<script src="https://cdn.jsdelivr.net/npm/motion@latest/dist/motion.js" is:inline></script>
<script is:inline>
    const {
        animate,
        inView,
        scroll
    } = Motion;
    const vueApp = {
        data: null,
        legislatura: null,
        casa: null,
        genero: null,
        parlamentares: null,
        tooltip: null,
        tooltipContent: "",
        selectedParlamentar: null,
        isLoaded: false,
        porPartidoModo: "porcentagem",
        // getters
        get proposicoes56() {
            if (!this.data) return [];
            return Object.values(this.data.legislaturas["56"].proposicoes);
        },
        get proposicoes57() {
            if (!this.data) return [];
            return Object.values(this.data.legislaturas["57"].proposicoes);
        },
        get proposicoesCount() {
            const proposicoesCount = document.getElementById("proposicoesCount");
            inView(
                "#homeNumbers",
                (element) => {
                    animate("#proposicoesCount", {
                        opacity: 1
                    }, {
                        duration: 0.3
                    });
                    animate(
                        0,
                        2413,
                        {
                            duration: 3,
                            ease: "circOut",
                            onUpdate: (latest) => (proposicoesCount.innerHTML = Math.round(latest)),
                        }
                    );
                }, {
                    amount: 0.3
                }
            );
            return "";
        },
        get assinaturasCount() {
            const assinaturasCount = document.getElementById("assinaturasCount");
            inView(
                "#homeNumbers",
                (element) => {
                    animate("#assinaturasCount", {
                        opacity: 1
                    }, {
                        duration: 0.3
                    });
                    animate(
                        0,
                        3809,
                        {
                            duration: 3,
                            ease: "circOut",
                            onUpdate: (latest) => (assinaturasCount.innerHTML = Math.round(latest)),
                        }
                    );
                }, {
                    amount: 0.3
                }
            );
            return "";
        },
        get orgsCount() {
            const orgsCount = document.getElementById("orgsCount");
            inView(
                "#homeNumbers",
                (element) => {
                    animate("#orgsCount", {
                        opacity: 1
                    }, {
                        duration: 0.3
                    });
                    animate(
                        0,
                        25,
                        {
                            duration: 3,
                            ease: "circOut",
                            onUpdate: (latest) => (orgsCount.innerHTML = Math.round(latest)),
                        }
                    );
                }, {
                    amount: 0.3
                }
            );
            return "";
        },
        get genderData() {
            if (!this.data) return null;
            return this.filteredProposicoes();
        },
        parlamentares() {
            if (!this.data) return null;
            return _.orderBy(
                _.uniqBy(
                    [
                        ...Object.values(this.data.legislaturas["56"].parlamentares),
                        ...Object.values(this.data.legislaturas["57"].parlamentares),
                    ],
                    "numero"
                ).map((p) => {
                    p.indice =
                        Object.values(p.autorias).filter((v) => v === 1).length / Object.values(p.autorias).length;
                    p.totalProposicoes = Object.values(p.autorias).length;
                    return p;
                }),
                "indice"
            );
        },
        filteredProposicoes() {
            if (!this.data) return null;
            let parlamentares = this.parlamentares();
            let masculino = parlamentares.filter((p) => p.genero === "M");

            let feminino = parlamentares.filter((p) => p.genero === "F");

            let proposicoes = this.legislatura ?
                Object.values(this.data.legislaturas[this.legislatura].proposicoes) : [
                    ...Object.values(this.data.legislaturas["56"].proposicoes),
                    ...Object.values(this.data.legislaturas["57"].proposicoes),
                ];
            const totalProposicoes = proposicoes.length;

            if (this.casa) {
                proposicoes = proposicoes.filter((p) =>
                    this.casa === "sf" ? p.casa === "Senador" : p.casa === "Deputado"
                );
            }
            if (this.genero) {
                let parlamentares = this.genero === "M" ? masculino : feminino;
                proposicoes = _.uniq(_.flatten(parlamentares.map((p) => _.toPairs(p.autorias)))).map((p) => ({
                    favoravel: p[1],
                }));
            }
            return {
                proposicoes,
                masculino,
                feminino,
                totalProposicoes
            };
        },
        // methods
        mounted() {
            this.tooltip = document.getElementById("tooltipVue");
            this.loadData();
        },
        unmounted() {},
        color(value, range, values) {
            const interpolate = d3.scaleLinear().domain(range).range(values).interpolate(d3.interpolateRgb.gamma(2.2));
            return interpolate(value);
        },
        async loadData() {
            if (this.data === null) {
                const data = await d3.json("/dados.json");
                this.data = data;
                this.isLoaded = true;
            }
        },
        get dadosPartidos() {
            if (!this.data) return null;

            const parlamentares = this.parlamentares();
            const parlamentaresPorPartido = _.groupBy(parlamentares, "partido");
            let partidos = Object.keys(parlamentaresPorPartido)
                .filter((k) => k !== "undefined")
                .map((sigla) => {
                    let parlamentaresPartido = parlamentaresPorPartido[sigla];
                    let proposicoes = _.chain(
                            parlamentaresPartido.map((parlamentar) => _.toPairs(parlamentar.autorias))
                        )
                        .flatten()
                        .uniqBy((o) => o[0])
                        .value();

                    return {
                        partido: sigla,
                        favoravel: proposicoes.filter((p) => p[1] === 1).length,
                        desfavoravel: proposicoes.filter((p) => p[1] === -1).length,
                        indice: parseFloat(
                            (proposicoes.filter((p) => p[1] === 1).length / proposicoes.length).toFixed(2)
                        ),
                    };
                })
                .filter((p) => p.favoravel + p.desfavoravel >= 10);
            partidos = _.orderBy(partidos, (o) => o.favoravel + o.desfavoravel, "desc");
            if (this.porPartidoModo === "porcentagem") {
                partidos = _.orderBy(partidos, "indice");
            }
            return {
                partidos,
                max: _.maxBy(partidos, "favoravel")
            };
        },
        positionTooltip(targetEl) {
            if (!targetEl || !this.tooltip) return;

            if (targetEl.target && targetEl.target.getBoundingClientRect) {
                targetEl = targetEl.target;
            }

            const rect = targetEl.getBoundingClientRect();
            const tipW = this.tooltip.offsetWidth;
            const tipH = this.tooltip.offsetHeight;
            const elW = rect.width;
            const elH = rect.height;
            const m = 8;

            const tipStyle = window.getComputedStyle(this.tooltip);
            const isFixed = tipStyle.position === "fixed";

            const originX = isFixed ? 0 : window.scrollX;
            const originY = isFixed ? 0 : window.scrollY;

            let left = rect.left + elW + m + originX;
            let top = rect.top + originY;

            const viewportLeft = isFixed ? 0 : window.scrollX;
            const viewportTop = isFixed ? 0 : window.scrollY;
            const viewportRight = viewportLeft + window.innerWidth;
            const viewportBottom = viewportTop + window.innerHeight;

            if (left + tipW + m > viewportRight) {
                left = rect.left - tipW - m + originX;
                if (left < viewportLeft) {
                    left = rect.left + (elW - tipW) / 2 + originX;
                }
            }

            if (Math.abs(left - (rect.left + (elW - tipW) / 2 + originX)) < 0.5) {
                top = rect.top + elH + m + originY;
                if (top + tipH > viewportBottom) {
                    top = rect.top - tipH - m + originY;
                }
            }

            if (top + tipH + m > viewportBottom) {
                top = rect.top + (elH - tipH) / 2 + originY;
                top = Math.max(viewportTop + m, Math.min(top, viewportBottom - tipH - m));
            }

            left = Math.max(viewportLeft + m, Math.min(left, viewportRight - tipW - m));

            this.tooltip.style.left = `${left}px`;
            this.tooltip.style.top = `${top}px`;
            this.tooltip.style.opacity = 1;
        },
        handleHoverParlamentar(parlamentar, $el) {
            this.tooltipContent = "parlamentar";
            this.selectedParlamentar = parlamentar;
            setTimeout(() => this.positionTooltip($el), 5);
        },
        handleLeaveParlamentar() {
            this.tooltipContent = "";
            this.selectedParlamentar = null;
            this.tooltip.style.opacity = 0;
        },
    };
</script>
