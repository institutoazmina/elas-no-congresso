---
import { fetchReportagens, type WpPost } from '../../lib/wp';

export interface Props {
  posts: WpPost[];
}

const { posts } = Astro.props;
---

{posts.length > 0 && (
<article class="novidades tw:!py-0">
    <div class="container-fluid wrap">
        <div class="row">
            <div class="col-xs-12">
                <h3 class="tw:uppercase tw:text-xl ff1 tca"><span class="w900 wdth350">Reportagens</span></h3>
                <a href="/acompanhe" class="btn-seta-vermelha tw:!text-sm">Ver todas as matérias</a>
            </div>
        </div>
        <div id="posts" class="row tw:!mt-12">
            {posts.slice(0, 3).map((post) => {
                const link = post.link;
                const title = post.title.rendered;
                const img = post._embedded?.['wp:featuredmedia']?.[0]?.link || "/assets/images/card1.png";
                return (
                <div class="col-xs-12 col-sm-6 tw:mb-12 tw:opacity-0 tw:translate-y-[50px]">
                    <a href={link} class="card">
                        <figure class="tw:h-36 tw:w-full tw:!mx-0 tw:!mb-8">
                            <img src={img} class="tw:w-full tw:h-full tw:object-cover tw:object-center" />
                        </figure>
                        <h3 class="tw:text-4xl tw:xl:text-5xl tw:font-black ff1 wdth150">{title}</h3>
                        <button class="btn-seta tw:!text-sm">Ler matéria</button>
                    </a>
                </div>
                );
            })}
        </div>
    </div>
</article>
)}
<script>
    const posts = document.getElementById('posts')
    inView(
    "#posts",
        (element) => {
            animate("#posts > div", { opacity: 1, y: -50 }, { duration: 1 });

        },
        { amount: 0.3 }
    );
</script>