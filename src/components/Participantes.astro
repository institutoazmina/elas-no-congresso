---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// Optimized at build time; SVG logos stay as plain <img> (Astro doesn't
// rasterize/optimize SVGs).
const logos = import.meta.glob<ImageMetadata>(
    "../assets/images/logos/*.{png,jpg,jpeg}",
    { eager: true, import: "default" },
);
const L = (name: string) => logos[`../assets/images/logos/${name}`];
