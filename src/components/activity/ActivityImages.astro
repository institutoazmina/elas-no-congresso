---
import { Image } from "astro:assets";
import { apiGet } from "../../service/api/client";
import thumbsUp from "../../assets/images/activity/thumbs-up.svg";
import thumbsDown from "../../assets/images/activity/thumbs-down.svg";

// Templates are inert: photos are downloaded only when a result uses them.
const { dashboard } = await apiGet<{ dashboard: { author: { photo: string | null }[] } }>(
    "/activity/explorer", { author_minimum: 1, page_size: 1 }
);
const photos = [...new Set(dashboard.author.flatMap(({ photo }) =>
    photo ? [photo.replace(/^http:/, "https:")] : []
))];
---

{photos.map((src) => (
    <template data-activity-image={src}>
        <Image src={src} alt="" width={30} height={40} loading="lazy" />
    </template>
))}
{[thumbsUp, thumbsDown].map((src) => (
    <template data-activity-image={src.src}>
        <Image src={src} alt="" width={24} height={24} loading="lazy" />
    </template>
))}
