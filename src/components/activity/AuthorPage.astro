---
import AuthorPage from "./AuthorPage";

import { fetchReportagensPage } from "../../lib/wp";
import { selectAuthorReports } from "../../lib/author-page";

import { type AuthorInitialData } from "../../lib/author-page";

interface Props { authorId: number; house: string; initial: AuthorInitialData | null; }
const { authorId, house, initial } = Astro.props;
const initialName = initial?.person.social_name || initial?.person.full_name || initial?.activity.author.nome || "Carregando…";
const relatedPosts = (await fetchReportagensPage(undefined, 3, 1, true, initialName)).posts;
const latestPosts = relatedPosts.length ? [] : (await fetchReportagensPage(undefined, 3, 1, true)).posts;
const reports = selectAuthorReports(relatedPosts, latestPosts);
// The offline OG renderer reads this inert data payload from built pages.
const ogData = JSON.stringify(initial).replace(/</g, "\\u003c");
---
<AuthorPage authorId={authorId} house={house} initial={initial} reports={reports} client:load />

<script type="application/json" data-author-initial set:html={ogData} />
