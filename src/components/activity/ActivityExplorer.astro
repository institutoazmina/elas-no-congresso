---
import { readFileSync } from "node:fs";
const thumbsUp = "/assets/images/activity/thumbs-up.svg";
const thumbsDown = "/assets/images/activity/thumbs-down.svg";
const search = "/assets/images/activity/search.svg";
const chevron = "/assets/images/activity/chevron.svg";
const sortDown = "/assets/images/activity/sort-down.svg";
const sortUp = "/assets/images/activity/sort-up.svg";
const arrowBack = "/assets/images/parliamentarians/arrow-back.svg";
const arrowForward = "/assets/images/parliamentarians/arrow-forward.svg";
const infoTooltip = "/assets/images/activity/info-tooltip.svg";
const tooltipTip = "/assets/images/activity/tooltip-tip.svg";
import { DEFAULT_DASHBOARD_ORDER, MAP_UF_CODES, MIN_PROPOSICOES_POR_PARLAMENTAR } from "../../lib/dashboard-utils";
const mapBase = "/assets/images/activity/map/map-br-base@2.5x.png";
const mapLegend = "/assets/images/activity/map/legend-diverging-elas-palette.svg";
const mapUfsVector = readFileSync("public/assets/images/activity/map/ufs-vector-diverging-elas-palette.svg", "utf8");
import ActivityYearRange from "./ActivityYearRange";
import ActivityMultiSelect from "./ActivityMultiSelect";
import ActivitySelect from "./ActivitySelect";
import { ACTIVITY_SINGLE_FILTERS } from "../../lib/activity-select";
import { ACTIVITY_MULTI_FILTERS } from "../../lib/activity-multiselect";
const houseOptions = [{ value: "", label: "Todas" }, { value: "Deputado", label: "Câmara" }, { value: "Senador", label: "Senado" }];
const assessmentOptions = [{ value: "", label: "Todas" }, { value: "favorable", label: "Favorável" }, { value: "unfavorable", label: "Desfavorável" }];
const dashboardSortOptions = [{ value: DEFAULT_DASHBOARD_ORDER, label: "Mais Desfavorável (%)" }, { value: "favorable", label: "Mais Favorável (%)" }, { value: "total", label: "Mais proposições" }];
const authorMinimumOptions = [1, MIN_PROPOSICOES_POR_PARLAMENTAR, 10, 20].map((value) => ({ value: String(value), label: `Com ${value}+ ${value === 1 ? "proposição" : "proposições"}` }));
---

<section
    class="activity-explorer tw:relative tw:w-full tw:min-h-[2033px] tw:bg-white tw:text-ink tw:font-sans tw:py-6 tw:px-0 tw:mt-12 tw:mb-24 tw:mx-0 tw:max-md:min-h-0 tw:max-md:pt-6 tw:max-md:mt-0 tw:max-md:mb-12 tw:max-md:mx-0 tw:[&.is-compact-results]:min-h-0 tw:[&.is-empty-results]:min-h-0 tw:[&_a:focus-visible]:outline-3 tw:[&_a:focus-visible]:outline-lime tw:[&_a:focus-visible]:outline-offset-0.5"
    data-activity-root
    data-thumbs-up={thumbsUp}
    data-thumbs-down={thumbsDown}
    style={`--search-icon: url(${search}); --select-chevron: url(${chevron}); --sort-down: url(${sortDown}); --sort-up: url(${sortUp}); --arrow-back: url(${arrowBack}); --arrow-forward: url(${arrowForward})`}
    aria-labelledby="activity-results-title"
>
    <form class="activity-filters tw:relative tw:flex tw:w-full tw:min-h-9 tw:items-end tw:gap-4 tw:px-6 tw:max-md:px-4 tw:min-[1400px]:grid tw:min-[1400px]:min-h-15 tw:min-[1400px]:grid-cols-[311fr_109fr_158fr_133fr_240fr_183fr_auto] tw:min-[1400px]:px-12 tw:*:min-w-0" data-filters data-astro-reload>
        <input class="tw:focus-visible:outline-3 tw:focus-visible:outline-lime tw:focus-visible:outline-offset-0.5" type="hidden" name="year_start" value="" />
        <input class="tw:focus-visible:outline-3 tw:focus-visible:outline-lime tw:focus-visible:outline-offset-0.5" type="hidden" name="year_end" value="" />
        {ACTIVITY_MULTI_FILTERS.map((name) => <input class="tw:focus-visible:outline-3 tw:focus-visible:outline-lime tw:focus-visible:outline-offset-0.5" type="hidden" name={name} data-activity-multiple={name} value="[]" />)}
        {ACTIVITY_SINGLE_FILTERS.map((name) => <input class="tw:focus-visible:outline-3 tw:focus-visible:outline-lime tw:focus-visible:outline-offset-0.5" type="hidden" name={name} data-activity-select={name} value="" />)}
        <div class="activity-filters__search tw:relative tw:flex tw:min-w-0 tw:flex-1 tw:items-end tw:gap-2 tw:max-md:h-15 tw:min-[1400px]:grid tw:min-[1400px]:grid-cols-[minmax(0,1fr)_32px] tw:min-[1400px]:grid-rows-[16px_36px] tw:min-[1400px]:gap-x-0 tw:min-[1400px]:gap-y-2">
            <label class={String.raw`activity-field activity-field--search tw:flex tw:min-w-25.75 tw:flex-auto tw:flex-col tw:gap-2 tw:text-ink tw:text-sm tw:font-normal tw:leading-4 tw:[&>span]:whitespace-nowrap tw:max-md:[&>span]:hidden tw:min-[1400px]:contents tw:w-full tw:max-md:block tw:max-md:w-auto tw:max-md:flex-1 tw:min-[1400px]:[.activity-filters\_\_desktop-fields_>_&:has(.activity-multiselect,.activity-select)::after]:content-none tw:max-[1400px]:min-[768px]:flex tw:max-[1400px]:min-[768px]:w-auto tw:max-[1400px]:min-[768px]:flex-1 tw:max-[1400px]:min-[768px]:[&_>_span]:hidden tw:max-[1400px]:min-[768px]:[&_input]:pr-10.5 tw:min-[1400px]:flex-col tw:relative tw:min-[1400px]:after:absolute tw:min-[1400px]:after:right-2 tw:min-[1400px]:after:bottom-2`}>
                <span class="tw:text-ink tw:text-sm tw:font-normal tw:leading-4 tw:min-[1400px]:h-4 tw:min-[1400px]:text-ink tw:min-[1400px]:font-sans tw:min-[1400px]:text-sm tw:min-[1400px]:font-normal tw:min-[1400px]:tracking-normal tw:min-[1400px]:leading-4 tw:min-[1400px]:p-0 tw:min-[1400px]:m-0">Buscar</span>
                <input class="tw:min-[1400px]:col-start-1 tw:min-[1400px]:col-span-2 tw:min-[1400px]:row-start-2 tw:min-[1400px]:pr-10 tw:w-full tw:h-9 tw:border-2 tw:border-solid tw:rounded-none tw:bg-white tw:text-periwinkle tw:text-base tw:font-normal tw:leading-6 tw:border-accent tw:py-1 tw:px-3 tw:focus-visible:outline-3 tw:focus-visible:outline-lime tw:focus-visible:outline-offset-0.5 tw:hover:border-accent tw:focus:border-accent tw:focus:[outline:0] tw:min-[1400px]:h-9 tw:min-[1400px]:border-[rgb(66_66_246/25%)] tw:min-[1400px]:font-sans tw:min-[1400px]:font-bold tw:min-[1400px]:tracking-normal tw:min-[1400px]:leading-6 tw:min-[1400px]:py-1 tw:min-[1400px]:px-3 tw:placeholder:text-periwinkle tw:placeholder:opacity-100 tw:max-md:w-full tw:max-md:pr-3 tw:max-md:text-sm" name="search" type="search" placeholder="Parlamentar, proposta, termo…" autocomplete="off" />
            </label>
            <button class="activity-search-button tw:min-[1400px]:z-1 tw:min-[1400px]:col-start-2 tw:min-[1400px]:row-start-2 tw:hover:bg-ink tw:max-md:hidden tw:w-8 tw:h-9 tw:flex-none tw:border-0 tw:[background:#4242f6_var(--search-icon)_center/16px_16px_no-repeat] tw:cursor-pointer tw:focus-visible:outline-3 tw:focus-visible:outline-lime tw:focus-visible:outline-offset-0.5 tw:min-[1400px]:w-8 tw:min-[1400px]:h-8 tw:min-[1400px]:self-center tw:min-[1400px]:[justify-self:start] tw:min-[1400px]:bg-size-[15.5px_15.5px] tw:max-[1400px]:min-[768px]:absolute tw:max-[1400px]:min-[768px]:right-27.5" type="submit" aria-label="Buscar"></button>
            <button class="activity-mobile-filter-button tw:hover:bg-ink tw:hover:border-ink tw:hover:text-white! tw:focus-visible:bg-ink tw:focus-visible:border-ink tw:focus-visible:text-white! tw:relative tw:hidden tw:w-28.5 tw:h-9 tw:flex-none tw:items-center tw:justify-center tw:[justify-self:end] tw:border-2 tw:border-solid tw:border-accent tw:bg-accent tw:text-white! tw:font-display tw:text-sm tw:font-bold tw:[font-variation-settings:'wdth'_75] tw:leading-6 tw:text-center tw:uppercase tw:whitespace-nowrap tw:cursor-pointer tw:py-1 tw:px-3 tw:focus-visible:outline-3 tw:focus-visible:outline-lime tw:focus-visible:outline-offset-0.5 tw:max-md:inline-flex tw:max-md:w-19.25 tw:max-md:bg-white tw:max-md:text-accent! tw:max-md:py-1 tw:max-md:px-2 tw:[.activity-explorer.has-overlay_&]:z-82 tw:max-[1400px]:min-[768px]:in-[.activity-explorer]:inline-flex tw:max-[1400px]:min-[768px]:in-[.activity-explorer]:w-19.5 tw:max-[1400px]:min-[768px]:in-[.activity-explorer]:bg-white tw:max-[1400px]:min-[768px]:in-[.activity-explorer]:text-accent! tw:max-[1400px]:min-[768px]:in-[.activity-explorer]:py-1 tw:max-[1400px]:min-[768px]:in-[.activity-explorer]:px-2" type="button" data-open-filters="basic" aria-expanded="false" aria-controls="activity-filter-panel">Filtros <span class="tw:absolute tw:-top-3 tw:-right-2 tw:flex tw:size-5.5 tw:items-center tw:justify-center tw:rounded-full tw:bg-[#ff5865] tw:text-xs tw:text-white" data-filter-count hidden>0</span></button>
        </div>

        <div class="activity-filters__desktop-fields tw:hidden tw:min-[1400px]:contents">
            <div class={String.raw`activity-field tw:flex tw:min-w-25.75 tw:flex-col tw:gap-2 tw:text-ink tw:text-sm tw:font-normal tw:leading-4 tw:[&>span]:whitespace-nowrap tw:w-27.25 tw:flex-none tw:min-[1400px]:w-auto tw:min-[1400px]:min-w-0 tw:min-[1400px]:h-15 tw:min-[1400px]:gap-0 tw:min-[1400px]:gap-y-2 tw:min-[1400px]:[.activity-filters\_\_desktop-fields_>_&:has(.activity-multiselect,.activity-select)::after]:content-none tw:min-[1400px]:flex tw:min-[1400px]:flex-col tw:relative`}><span class="tw:min-[1400px]:h-4 tw:min-[1400px]:text-ink tw:min-[1400px]:font-sans tw:min-[1400px]:text-sm tw:min-[1400px]:font-normal tw:min-[1400px]:tracking-normal tw:min-[1400px]:leading-4 tw:min-[1400px]:p-0 tw:min-[1400px]:m-0">Casa</span><ActivitySelect client:load name="house" label="Casa" options={houseOptions} /></div>
            <div class={String.raw`activity-field activity-field--year tw:flex tw:min-w-25.75 tw:flex-col tw:gap-2 tw:text-ink tw:text-sm tw:font-normal tw:leading-4 tw:[&>span]:whitespace-nowrap tw:w-25.75 tw:flex-none tw:min-[1400px]:w-auto tw:min-[1400px]:min-w-0 tw:min-[1400px]:h-15 tw:min-[1400px]:gap-0 tw:min-[1400px]:gap-y-2 tw:min-[1400px]:[.activity-filters\_\_desktop-fields_>_&:has(.activity-multiselect,.activity-select)::after]:content-none tw:min-[1400px]:flex tw:min-[1400px]:flex-col tw:relative`}><span class="tw:min-[1400px]:h-4 tw:min-[1400px]:text-ink tw:min-[1400px]:font-sans tw:min-[1400px]:text-sm tw:min-[1400px]:font-normal tw:min-[1400px]:tracking-normal tw:min-[1400px]:leading-4 tw:min-[1400px]:p-0 tw:min-[1400px]:m-0">Ano</span><ActivityYearRange client:load /></div>
            <div class={String.raw`activity-field tw:flex tw:min-w-25.75 tw:flex-col tw:gap-2 tw:text-ink tw:text-sm tw:font-normal tw:leading-4 tw:[&>span]:whitespace-nowrap tw:w-33.25 tw:flex-none tw:min-[1400px]:w-auto tw:min-[1400px]:min-w-0 tw:min-[1400px]:h-15 tw:min-[1400px]:gap-0 tw:min-[1400px]:gap-y-2 tw:min-[1400px]:[.activity-filters\_\_desktop-fields_>_&:has(.activity-multiselect,.activity-select)::after]:content-none tw:min-[1400px]:flex tw:min-[1400px]:flex-col tw:relative`}><span class="tw:min-[1400px]:h-4 tw:min-[1400px]:text-ink tw:min-[1400px]:font-sans tw:min-[1400px]:text-sm tw:min-[1400px]:font-normal tw:min-[1400px]:tracking-normal tw:min-[1400px]:leading-4 tw:min-[1400px]:p-0 tw:min-[1400px]:m-0">Partido</span><ActivityMultiSelect client:load name="party" label="Partido" placeholder="Todos" /></div>
            <div class={String.raw`activity-field activity-field--wide tw:flex tw:flex-col tw:gap-2 tw:text-ink tw:text-sm tw:font-normal tw:leading-4 tw:[&>span]:whitespace-nowrap tw:min-w-45 tw:w-60 tw:flex-none tw:min-[1400px]:w-auto tw:min-[1400px]:min-w-0 tw:min-[1400px]:h-15 tw:min-[1400px]:gap-0 tw:min-[1400px]:gap-y-2 tw:min-[1400px]:[.activity-filters\_\_desktop-fields_>_&:has(.activity-multiselect,.activity-select)::after]:content-none tw:min-[1400px]:flex tw:min-[1400px]:flex-col tw:relative`}><span class="tw:min-[1400px]:h-4 tw:min-[1400px]:text-ink tw:min-[1400px]:font-sans tw:min-[1400px]:text-sm tw:min-[1400px]:font-normal tw:min-[1400px]:tracking-normal tw:min-[1400px]:leading-4 tw:min-[1400px]:p-0 tw:min-[1400px]:m-0">Categoria</span><ActivityMultiSelect client:load name="category" label="Categoria" placeholder="Todas as categorias" /></div>
            <div class={String.raw`activity-field activity-field--assessment tw:flex tw:flex-col tw:gap-2 tw:text-ink tw:text-sm tw:font-normal tw:leading-4 tw:[&>span]:whitespace-nowrap tw:min-w-40 tw:w-45.75 tw:flex-none tw:min-[1400px]:w-auto tw:min-[1400px]:min-w-0 tw:min-[1400px]:h-15 tw:min-[1400px]:gap-0 tw:min-[1400px]:gap-y-2 tw:min-[1400px]:[.activity-filters\_\_desktop-fields_>_&:has(.activity-multiselect,.activity-select)::after]:content-none tw:min-[1400px]:flex tw:min-[1400px]:flex-col tw:relative`}><span class="tw:min-[1400px]:h-4 tw:min-[1400px]:text-ink tw:min-[1400px]:font-sans tw:min-[1400px]:text-sm tw:min-[1400px]:font-normal tw:min-[1400px]:tracking-normal tw:min-[1400px]:leading-4 tw:min-[1400px]:p-0 tw:min-[1400px]:m-0">Avaliação</span><ActivitySelect client:load name="assessment" label="Avaliação" options={assessmentOptions} /></div>
            <button class="activity-more-filters tw:hover:bg-ink tw:hover:border-ink tw:hover:text-white! tw:focus-visible:bg-ink tw:focus-visible:border-ink tw:focus-visible:text-white! tw:relative tw:inline-flex tw:w-28.5 tw:h-9 tw:flex-none tw:items-center tw:justify-center tw:[justify-self:end] tw:border-2 tw:border-solid tw:border-accent tw:bg-accent tw:text-white! tw:font-display tw:text-sm tw:font-bold tw:[font-variation-settings:'wdth'_75] tw:leading-6 tw:text-center tw:uppercase tw:whitespace-nowrap tw:cursor-pointer tw:py-1 tw:px-3 tw:focus-visible:outline-3 tw:focus-visible:outline-lime tw:focus-visible:outline-offset-0.5 tw:min-[1400px]:ml-0 tw:min-[1400px]:flex-none tw:min-[1400px]:font-display tw:min-[1400px]:text-lg tw:min-[1400px]:pt-1.75 tw:min-[1400px]:pb-1.25 tw:min-[1400px]:pr-3 tw:min-[1400px]:pl-3.5 tw:[.activity-explorer.has-overlay_&]:z-82" type="button" data-open-filters="advanced" aria-expanded="false" aria-controls="activity-filter-panel">Mais filtros <span class="tw:absolute tw:-top-3 tw:-right-2 tw:flex tw:size-5.5 tw:items-center tw:justify-center tw:rounded-full tw:bg-[#ff5865] tw:text-xs tw:text-white" data-filter-count hidden>0</span></button>
        </div>

        <aside class="activity-filter-panel tw:absolute tw:z-81 tw:top-[83.8px] tw:right-12 tw:flex tw:w-96 tw:h-210.5 tw:overflow-hidden tw:border tw:border-solid tw:border-accent tw:bg-white tw:flex-col tw:p-6 tw:[&_h2]:font-display tw:[&_h2]:text-2xl tw:[&_h2]:font-bold tw:[&_h2]:[font-variation-settings:'wdth'_75] tw:[&_h2]:leading-8 tw:[&_h2]:uppercase tw:[&_h2]:m-0 tw:max-md:top-21 tw:max-md:right-auto tw:max-md:left-4 tw:max-md:w-[calc(100%-32px)] tw:max-md:h-128.75 tw:max-md:max-h-[calc(100dvh-32px)] tw:max-md:transform-none tw:max-md:border tw:max-md:border-solid tw:max-md:border-accent tw:max-md:gap-0 tw:max-md:overflow-hidden tw:max-md:p-6 tw:max-md:[&_h2]:text-xl tw:max-md:[&_h2]:leading-6 tw:[[hidden]]:hidden tw:max-md:[&.is-advanced]:h-160 tw:max-[1400px]:min-[768px]:right-6" id="activity-filter-panel" data-filter-panel hidden aria-label="Filtros da atividade legislativa">
            <header class="tw:hidden tw:max-md:absolute tw:max-md:top-1.5 tw:max-md:right-2 tw:max-md:z-1"><h2 class="tw:hidden tw:max-md:hidden">Filtros</h2><button class="tw:w-8 tw:h-8 tw:border-0 tw:[background:none] tw:text-accent tw:text-3xl tw:leading-none tw:cursor-pointer tw:focus-visible:outline-3 tw:focus-visible:outline-lime tw:focus-visible:outline-offset-0.5 tw:max-md:w-7 tw:max-md:h-7 tw:max-md:text-[26px]" type="button" data-close-filters aria-label="Fechar filtros">×</button></header>
            <div class="activity-filter-panel__scroll tw:flex tw:min-h-0 tw:flex-1 tw:flex-col tw:gap-3 tw:overflow-y-auto tw:max-md:flex-auto tw:max-md:gap-3 tw:max-md:overflow-y-auto tw:max-md:scrollbar-thin tw:max-md:[scrollbar-color:#aeb7ea_transparent] tw:max-md:p-0">
                <div class="activity-filter-panel__basic tw:flex tw:min-w-0 tw:flex-none tw:flex-col tw:gap-3 tw:md:hidden tw:max-md:gap-3 tw:max-[1400px]:min-[768px]:flex">
                    <div class={String.raw`activity-field tw:flex tw:min-w-25.75 tw:flex-auto tw:flex-col tw:gap-2 tw:text-ink tw:text-sm tw:font-normal tw:leading-4 tw:[&>span]:whitespace-nowrap tw:max-md:w-27.25 tw:max-md:max-w-full tw:max-md:flex-none tw:min-[1400px]:[.activity-filters\_\_desktop-fields_>_&:has(.activity-multiselect,.activity-select)::after]:content-none tw:min-[1400px]:flex-col tw:relative tw:min-[1400px]:after:absolute tw:min-[1400px]:after:right-2 tw:min-[1400px]:after:bottom-2`}><span>Casa</span><ActivitySelect client:load name="house" label="Casa" options={houseOptions} /></div>
                    <div class={String.raw`activity-field activity-field--year tw:flex tw:min-w-25.75 tw:flex-auto tw:flex-col tw:gap-2 tw:text-ink tw:text-sm tw:font-normal tw:leading-4 tw:[&>span]:whitespace-nowrap tw:max-md:w-39.5 tw:max-md:max-w-full tw:max-md:flex-none tw:min-[1400px]:[.activity-filters\_\_desktop-fields_>_&:has(.activity-multiselect,.activity-select)::after]:content-none tw:min-[1400px]:flex-col tw:relative tw:min-[1400px]:after:absolute tw:min-[1400px]:after:right-2 tw:min-[1400px]:after:bottom-2`}><span>Ano</span><ActivityYearRange client:load /></div>
                    <div class={String.raw`activity-field tw:flex tw:min-w-25.75 tw:flex-auto tw:flex-col tw:gap-2 tw:text-ink tw:text-sm tw:font-normal tw:leading-4 tw:[&>span]:whitespace-nowrap tw:max-md:w-33.25 tw:max-md:max-w-full tw:max-md:flex-none tw:min-[1400px]:[.activity-filters\_\_desktop-fields_>_&:has(.activity-multiselect,.activity-select)::after]:content-none tw:min-[1400px]:flex-col tw:relative tw:min-[1400px]:after:absolute tw:min-[1400px]:after:right-2 tw:min-[1400px]:after:bottom-2`}><span>Partido</span><ActivityMultiSelect client:load name="party" label="Partido" placeholder="Todos" /></div>
                    <div class={String.raw`activity-field tw:flex tw:min-w-25.75 tw:flex-auto tw:flex-col tw:gap-2 tw:text-ink tw:text-sm tw:font-normal tw:leading-4 tw:[&>span]:whitespace-nowrap tw:max-md:w-60 tw:max-md:max-w-full tw:max-md:flex-none tw:min-[1400px]:[.activity-filters\_\_desktop-fields_>_&:has(.activity-multiselect,.activity-select)::after]:content-none tw:min-[1400px]:flex-col tw:relative tw:min-[1400px]:after:absolute tw:min-[1400px]:after:right-2 tw:min-[1400px]:after:bottom-2`}><span>Categoria</span><ActivityMultiSelect client:load name="category" label="Categoria" placeholder="Todas as categorias" /></div>
                    <div class={String.raw`activity-field tw:flex tw:min-w-25.75 tw:flex-auto tw:flex-col tw:gap-2 tw:text-ink tw:text-sm tw:font-normal tw:leading-4 tw:[&>span]:whitespace-nowrap tw:max-md:w-45.75 tw:max-md:max-w-full tw:max-md:flex-none tw:min-[1400px]:[.activity-filters\_\_desktop-fields_>_&:has(.activity-multiselect,.activity-select)::after]:content-none tw:min-[1400px]:flex-col tw:relative tw:min-[1400px]:after:absolute tw:min-[1400px]:after:right-2 tw:min-[1400px]:after:bottom-2`}><span>Avaliação</span><ActivitySelect client:load name="assessment" label="Avaliação" options={assessmentOptions} /></div>
                </div>
                <button class="activity-filter-panel__toggle tw:self-start tw:border-0 tw:border-b tw:border-solid tw:border-b-current tw:[background:none] tw:text-accent tw:font-bold tw:cursor-pointer tw:p-0 tw:md:hidden tw:max-md:mt-0 tw:focus-visible:outline-3 tw:focus-visible:outline-lime tw:focus-visible:outline-offset-0.5 tw:max-[1400px]:min-[768px]:block" type="button" data-toggle-advanced aria-expanded="false" aria-controls="activity-filter-panel-advanced">Mais filtros</button>
                <div class="activity-filter-panel__advanced tw:hidden tw:flex-none tw:flex-col tw:gap-3 tw:md:flex tw:[.activity-filter-panel.is-advanced_&]:flex tw:max-[1400px]:min-[768px]:hidden tw:max-[1400px]:min-[768px]:[.activity-filter-panel.is-advanced_&]:flex" id="activity-filter-panel-advanced">
                    <fieldset class="tw:flex tw:min-w-0 tw:flex-none tw:flex-col tw:gap-3 tw:w-full tw:border-0 tw:p-0 tw:m-0">
                        <legend class="tw:font-sans tw:text-sm tw:font-normal tw:[font-variation-settings:'wdth'_75] tw:leading-4 tw:normal-case tw:flex tw:w-full tw:h-4 tw:items-center tw:gap-2 tw:text-muted tw:mt-0 tw:mb-3 tw:mx-0 tw:after:h-px tw:after:flex-1 tw:after:bg-muted tw:after:content-['']">Proposição</legend>
