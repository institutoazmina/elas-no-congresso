---
const { partners } = Astro.props as { partners: { name: string; logo_url: string }[] };
---

<ul class="tw:mx-auto tw:grid tw:w-[min(1344px,calc(100vw-96px))] tw:grid-cols-3 tw:gap-6 tw:pt-12 tw:md:grid-cols-5 tw:md:gap-10 tw:md:pt-20 tw:max-[900px]:w-full">
    {partners.map(({ name, logo_url }) => (
        <li class="tw:flex tw:items-center tw:justify-center">
            <img src={logo_url} alt={name} title={name} loading="lazy" width="160" class="tw:h-auto tw:w-20 tw:md:w-40" />
        </li>
    ))}
</ul>
