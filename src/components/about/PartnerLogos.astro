<div class="partner-logos-wrap tw:items-center tw:flex tw:justify-center tw:min-h-63 tw:w-full tw:py-20 tw:px-6.5 tw:max-[901px]:pl-0 tw:max-[901px]:pr-0 tw:[.sobre-page_&]:items-center tw:[.sobre-page_&]:flex tw:[.sobre-page_&]:justify-center tw:[.sobre-page_&]:min-h-63 tw:[.sobre-page_&]:w-full tw:[.sobre-page_&]:pt-20 tw:[.sobre-page_&]:pb-0 tw:[.sobre-page_&]:px-6.5 tw:max-[901px]:[.sobre-page_&]:pl-0 tw:max-[901px]:[.sobre-page_&]:pr-0 tw:[body:has(.sobre-page)_.sobre-page_&]:pb-0 tw:max-[701px]:[body:has(.sobre-page)_.sobre-page_&:focus-visible]:outline-2 tw:max-[701px]:[body:has(.sobre-page)_.sobre-page_&:focus-visible]:outline-accent tw:max-[701px]:[body:has(.sobre-page)_.sobre-page_&:focus-visible]:-outline-offset-1 tw:max-[701px]:[body:has(.sobre-page)_.sobre-page_&]:items-start tw:max-[701px]:[body:has(.sobre-page)_.sobre-page_&]:block tw:max-[701px]:[body:has(.sobre-page)_.sobre-page_&]:h-63 tw:max-[701px]:[body:has(.sobre-page)_.sobre-page_&]:justify-start tw:max-[701px]:[body:has(.sobre-page)_.sobre-page_&]:min-h-63 tw:max-[701px]:[body:has(.sobre-page)_.sobre-page_&]:overflow-x-auto tw:max-[701px]:[body:has(.sobre-page)_.sobre-page_&]:w-screen tw:max-[701px]:[body:has(.sobre-page)_.sobre-page_&]:mt-0 tw:max-[701px]:[body:has(.sobre-page)_.sobre-page_&]:py-12 tw:max-[701px]:[body:has(.sobre-page)_.sobre-page_&]:pr-17 tw:max-[701px]:[body:has(.sobre-page)_.sobre-page_&]:pl-6.5">
    <div class="partner-logos-layer tw:[.sobre-page_&]:h-180.5 tw:[.sobre-page_&]:overflow-hidden tw:[.sobre-page_&]:relative tw:[.sobre-page_&]:w-329.5 tw:[.sobre-page_&_img]:block tw:[.sobre-page_&_img]:max-w-none tw:[.sobre-page_&_img]:object-fill tw:max-[901px]:[.sobre-page_&]:h-auto tw:max-[901px]:[.sobre-page_&]:max-w-full tw:max-[901px]:[.sobre-page_&]:origin-[top_left] tw:max-[901px]:[.sobre-page_&]:w-329.5 tw:max-[701px]:[body:has(.sobre-page)_.sobre-page_&]:h-39 tw:max-[701px]:[body:has(.sobre-page)_.sobre-page_&]:max-w-none tw:max-[701px]:[body:has(.sobre-page)_.sobre-page_&]:overflow-hidden tw:max-[701px]:[body:has(.sobre-page)_.sobre-page_&]:w-329.5">
        {logos.map(({ src, left, top, width, height }) => (
            <Image
                src={src}
                alt=""
                loading="lazy"
                width={width}
                height={height}
                densities={[1, 2]}
                style={{ position: "absolute", left: `${left}px`, top: `${top}px`, width: `${width}px`, height: `${height}px` }}
            />
        ))}
    </div>
</div>
