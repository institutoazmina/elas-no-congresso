---
type Event = {
    date_prefix: string;
    year: string;
    description_before_link: string;
    link_text: string;
    link_url: string;
    description_after_link: string;
    tag: string;
};

const { events, note } = Astro.props as {
    events: Event[];
    note: { link_text: string; link_url: string; after_link: string };
};
---

<div class="timeline tw:w-336 tw:max-w-full tw:overflow-x-auto tw:pt-10 tw:pb-6 tw:max-[701px]:w-full tw:max-[701px]:px-6" aria-label="Linha do tempo do projeto">
    <div class="tw:relative tw:flex tw:min-w-max tw:items-stretch">
        <span aria-hidden="true" class="tw:absolute tw:inset-x-0 tw:top-3 tw:h-0.5 tw:bg-ink tw:after:absolute tw:after:right-0 tw:after:-top-2 tw:after:border-y-8 tw:after:border-y-transparent tw:after:border-l-14 tw:after:border-l-ink tw:after:content-['']"></span>
        {events.map((event, index) => (
            <article class="tw:relative tw:flex tw:w-64 tw:shrink-0 tw:flex-col tw:gap-3.5">
                <span aria-hidden="true" class:list={["tw:relative tw:z-1 tw:block tw:size-6 tw:shrink-0 tw:border-2 tw:border-ink", index === events.length - 1 ? "tw:bg-lime" : "tw:bg-white"]}></span>
                <div class:list={["tw:relative tw:flex tw:flex-1 tw:flex-col tw:gap-3 tw:pr-7 tw:pb-6", index > 0 && "tw:pl-6 tw:before:absolute tw:before:inset-y-0 tw:before:left-0 tw:before:w-0.5 tw:before:bg-accent/25 tw:before:content-['']"]}>
                    <h3 class="tw:m-0 tw:flex tw:min-h-14.5 tw:flex-col tw:gap-1.5 tw:font-display tw:text-xl tw:font-bold tw:uppercase tw:leading-6 tw:[font-variation-settings:'wdth'_75]">
                        <em class="tw:block tw:font-sans tw:text-sm tw:font-light tw:not-italic tw:uppercase tw:leading-7 tw:tracking-[1px]">{event.date_prefix}</em>
                        {event.year}
                    </h3>
                    <p class="tw:m-0 tw:text-sm tw:leading-6">
                        {event.description_before_link}
                        {event.link_url && event.link_text && <a class="tw:text-accent tw:underline tw:decoration-1 tw:[text-underline-position:from-font]" href={event.link_url} target="_blank" rel="noopener noreferrer">{event.link_text}</a>}
                        {event.description_after_link}
                    </p>
                    <b class="tw:self-start tw:border-2 tw:border-ink tw:bg-lime tw:px-2 tw:py-1 tw:font-sans tw:text-xs tw:font-bold tw:uppercase tw:leading-4 tw:tracking-[1px]">{event.tag}</b>
                </div>
            </article>
        ))}
    </div>
    <small class="tw:mt-3.5 tw:block tw:w-108 tw:max-w-full tw:text-sm tw:leading-6 tw:text-muted">
        <a class="tw:text-accent tw:underline tw:decoration-1 tw:[text-underline-position:from-font]" href={note.link_url} target="_blank" rel="noopener noreferrer">{note.link_text}</a>{note.after_link}
    </small>
</div>
