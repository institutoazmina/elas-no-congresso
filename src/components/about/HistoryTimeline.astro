---
const label1a = "/assets/images/sobre/timeline/label-1a.svg";
const label1b = "/assets/images/sobre/timeline/label-1b.svg";
const label2a = "/assets/images/sobre/timeline/label-2a.svg";
const label2b = "/assets/images/sobre/timeline/label-2b.svg";
const label2c = "/assets/images/sobre/timeline/label-2c.svg";
const label2d = "/assets/images/sobre/timeline/label-2d.svg";
const label3a = "/assets/images/sobre/timeline/label-3a.svg";
const label3b = "/assets/images/sobre/timeline/label-3b.svg";
const label3c = "/assets/images/sobre/timeline/label-3c.svg";
const label3d = "/assets/images/sobre/timeline/label-3d.svg";
const label4a = "/assets/images/sobre/timeline/label-4a.svg";
const label4b = "/assets/images/sobre/timeline/label-4b.svg";
const label5a = "/assets/images/sobre/timeline/label-5a.svg";
const label5b = "/assets/images/sobre/timeline/label-5b.svg";
const label5c = "/assets/images/sobre/timeline/label-5c.svg";
const label5d = "/assets/images/sobre/timeline/label-5d.svg";

const timeline = [
    [
        "Março de",
        "2020",
        "Lançamento da robô @elasnocongresso no Twitter (X), projeto selecionado pelo Google News Initiative entre mais de 300 concorrentes na América Latina. A automação acompanhou as tramitações diárias até junho de 2023, quando foi descontinuada com o fechamento do acesso gratuito à API da plataforma.",
        "Nasce o projeto",
    ],
    [
        "Junho de",
        "2020",
        "Primeiro levantamento e análise de atividade legislativa, primeiro ranking parlamentar e estreia da newsletter, com curadoria de projetos e análise política semanal.",
        "1ª newsletter",
    ],
    [
        "De 2020 a",
        "2024",
        "Edições periódicas do Ranking dos Parlamentares, metodologicamente inspirado no Ruralômetro (Repórter Brasil).",
        "Ranking",
    ],
    [
        "Ano de",
        "2024",
        "Na revisão metodológica que antecedeu a criação da inteligência artificial, optamos por descontinuar o ranking e concentrar esforços na análise qualitativa das proposições — tirando o foco da ação individual dos parlamentares em favor de uma abordagem mais contextual. No fim do ano, lançamos a QuitérIA.",
        "Fim do ranking",
    ],
    [
        "Ano de",
        "2026",
        "Retreinamento da QuitérIA, criação da API, relançamento do site com evolução do painel público e sistema automatizado de alertas diários e semanais.",
        "QuitérIA 2.0",
    ],
];
const timelineLabelClasses = [
    ["tw:left-[-1.766px] tw:top-[-4.959px] tw:w-[129.535px]", "tw:left-[15.616px] tw:top-[-0.059px] tw:w-[112.141px]"],
    ["tw:left-[2.711px] tw:top-[-1.274px] tw:w-[105.412px]", "tw:left-[-1.358px] tw:top-[-1.122px] tw:w-[109.439px]", "tw:left-[-1.389px] tw:top-[5.893px] tw:w-[110.184px]", "tw:left-[13.453px] tw:top-[8.403px] tw:w-[95.328px]"],
    ["tw:left-[1.445px] tw:top-[-0.3px] tw:w-[70.671px] tw:-scale-x-100", "tw:left-[1.504px] tw:top-[-0.3px] tw:w-[74.451px] tw:-scale-x-100", "tw:left-[0.792px] tw:top-[6.644px] tw:w-[75.206px] tw:-scale-x-100", "tw:left-[0.813px] tw:top-[9.037px] tw:w-[65.977px] tw:-scale-x-100"],
    ["tw:left-[-5.166px] tw:top-[-8.959px] tw:w-[129.535px]", "tw:left-[12.216px] tw:top-[-4.059px] tw:w-[112.141px]"],
    ["tw:left-[1.651px] tw:top-[-0.274px] tw:w-[98.729px]", "tw:left-[-2.816px] tw:top-[-0.122px] tw:w-[102.499px]", "tw:left-[-2.789px] tw:top-[5.893px] tw:w-[103.207px]", "tw:left-[10.335px] tw:top-[8.403px] tw:w-[89.286px]"],
];
const timelineLabelAssets = [
    [label1a, label1b],
    [label2a, label2b, label2c, label2d],
    [label3a, label3b, label3c, label3d],
    [label4a, label4b],
    [label5a, label5b, label5c, label5d],
];
---

<div class="timeline tw:w-[1344px] tw:max-w-full tw:pt-[38.8px] tw:pb-0 tw:max-[701px]:w-[1510px] tw:max-[701px]:max-w-none tw:max-[701px]:px-6 tw:max-[701px]:pb-6" aria-label="Linha do tempo do projeto">
    <div class="tw:relative tw:flex tw:items-stretch">
        <span aria-hidden="true" class="tw:absolute tw:inset-x-0 tw:top-[11px] tw:h-0.5 tw:bg-ink tw:after:absolute tw:after:right-0 tw:after:-top-[7px] tw:after:border-y-8 tw:after:border-y-transparent tw:after:border-l-[14px] tw:after:border-l-ink tw:after:content-['']"></span>
        {timeline.map(([prefix, year, text, tag], index) => (
            <article class="tw:relative tw:flex tw:min-w-0 tw:flex-1 tw:flex-col tw:gap-3.5">
                <span aria-hidden="true" class:list={["tw:relative tw:z-1 tw:block tw:size-6 tw:shrink-0 tw:border-2 tw:border-ink", index === timeline.length - 1 ? "tw:bg-lime" : "tw:bg-white"]}></span>
                <div class:list={["tw:relative tw:flex tw:min-h-[348px] tw:flex-1 tw:flex-col tw:gap-3 tw:pr-7 tw:pb-[22.4px]", index > 0 && "tw:pl-6 tw:before:absolute tw:before:inset-y-0 tw:before:left-0 tw:before:w-0.5 tw:before:bg-accent/25 tw:before:content-['']"]}>
                    <h3 class="tw:m-0 tw:flex tw:min-h-[57.5px] tw:flex-col tw:gap-[5.5px] tw:font-display tw:text-xl tw:font-bold tw:uppercase tw:leading-6 tw:[font-variation-settings:'wdth'_75]">
                        <em class="tw:block tw:font-sans tw:text-sm tw:font-light tw:not-italic tw:uppercase tw:leading-7 tw:tracking-[0.84px]">{prefix}</em>
                        {year}
                    </h3>
                    {index === 0 ? (
                        <p class="tw:m-0 tw:text-sm tw:leading-[22.4px]">
                            Lançamento da{" "}
                            <a class="tw:text-accent tw:underline tw:[text-decoration-thickness:1px] tw:[text-underline-position:from-font]"
                                href="https://azmina.com.br/reportagens/uma-robo-para-monitorar-direitos-das-mulheres-azmina-lanca-o-elas-no-congresso/"
                                target="_blank"
                            >
                                robô @elasnocongresso no
                                Twitter (X)
                            </a>
                            , projeto selecionado pelo
                            Google News Initiative entre
                            mais de 300 concorrentes na
                            América Latina. A automação
                            acompanhou as tramitações
                            diárias até junho de 2023,
                            quando foi descontinuada com o
                            fechamento do acesso gratuito à
                            API da plataforma.
                        </p>
                    ) : index === 2 ? (
                        <p class="tw:m-0 tw:text-sm tw:leading-[22.4px]">
                            Edições periódicas do Ranking
                            dos Parlamentares,
                            metodologicamente inspirado no{" "}
                            <a class="tw:text-accent tw:underline tw:[text-decoration-thickness:1px] tw:[text-underline-position:from-font]"
                                href="https://ruralometro.reporterbrasil.org.br/"
                                target="_blank"
                            >
                                Ruralômetro
                            </a>{" "}
                            (Repórter Brasil).
                        </p>
                    ) : (
                        <p class="tw:m-0 tw:text-sm tw:leading-[22.4px]">{text}</p>
                    )}
                    <span
                        class:list={[
                            "timeline__tag tw:relative tw:h-5 tw:shrink-0 tw:self-start tw:overflow-visible",
                            `timeline__tag--${index + 1}`,
                            ["tw:w-[131px]", "tw:w-[110px]", "tw:w-[73px]", "tw:w-[120px] tw:-left-0.5 tw:-top-[0.47px]", "tw:w-[98px]"][index],
                        ]}
                    >
                        {timelineLabelAssets[index].map(
                            (asset, layerIndex) => (
                                <img
                                    class:list={["tw:absolute tw:z-0 tw:h-auto tw:max-w-none", timelineLabelClasses[index][layerIndex]]}
                                    src={asset}
                                    alt=""
                                    aria-hidden="true"
                                />
                            ),
                        )}
                        <b class="tw:relative tw:z-1 tw:inline-block tw:whitespace-nowrap tw:px-2 tw:py-[3px] tw:font-sans tw:text-[11px] tw:font-bold tw:uppercase tw:leading-[14px] tw:tracking-[0.88px]">{tag}</b>
                    </span>

                </div>
            </article>
        ))}
    </div>
    <small class="tw:mt-3.5 tw:block tw:w-[431px] tw:text-sm tw:leading-[23.1px] tw:text-muted">
        <a class="tw:text-accent tw:underline tw:[text-decoration-thickness:1px] tw:[text-underline-position:from-font]" href="https://www.instagram.com/p/DFVVODpRP9A/" target="_blank">Em 2025, a AzMina encerrou definitivamente suas atividades no X</a>.
    </small>
</div>
