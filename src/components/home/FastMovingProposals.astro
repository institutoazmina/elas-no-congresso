---
import ProposalCarousel from "./ProposalCarousel.astro";
import { Image } from "astro:assets";
import attention from "../../assets/images/party-chart/attention.svg";
import { fetchFastUnfavorable } from "../../lib/activity-api";
import { API_BASE_URL } from "astro:env/server";
import rocketEmoji from "../../assets/images/home/rocket.png";

const proposals = await fetchFastUnfavorable(API_BASE_URL);
---
{proposals.length > 0 && <section class="
    fast-moving-proposals tw:w-full tw:h-[822px] tw:overflow-hidden tw:bg-white tw:text-ink
    tw:font-sans tw:[&_h2]:w-180 tw:[&_h2]:h-16.5 tw:[&_h2]:font-display tw:[&_h2]:text-4xl tw:[&_h2]:font-bold
    tw:[&_h2]:leading-8 tw:[&_h2]:uppercase tw:[&_h2]:[font-variation-settings:'wdth'_75] tw:[&_h2]:m-0 tw:[&_p]:m-0
    tw:max-md:h-[698px] tw:max-md:py-12 tw:max-md:px-0 tw:max-md:[&_h2]:w-[344px]
    tw:max-md:[&_h2]:max-w-full tw:max-md:[&_h2]:h-auto tw:max-md:[&_h2]:text-[28px] tw:max-md:[&_h2]:leading-8
    tw:max-md:[&_h2]:tracking-normal
" aria-labelledby="fast-moving-proposals-title">
    <header class="
        fast-moving-proposals__header tw:flex tw:w-204 tw:h-43.5 tw:flex-col tw:items-start tw:gap-4 tw:p-12 tw:my-0
        tw:mx-auto tw:[&>img]:w-24 tw:[&>img]:h-1 tw:[&_p]:w-180 tw:[&_p]:text-lg tw:[&_p]:leading-6 tw:max-md:w-full
        tw:max-md:h-auto tw:max-md:py-0 tw:max-md:px-[16px] tw:max-md:[&_p]:w-[344px] tw:max-md:[&_p]:max-w-full
        tw:max-md:[&_p]:h-auto tw:max-md:[&_p]:text-sm tw:max-md:[&_p]:font-normal tw:max-md:[&_p]:leading-6
    ">
        <Image class="" src={attention} alt="" />
        <h2 class="" id="fast-moving-proposals-title">Veja o que restringe nossos direitos e tá tramitando rapidinho <Image src={rocketEmoji} alt="" class="fast-moving-proposals__emoji tw:inline-block tw:h-[1em] tw:w-auto tw:[vertical-align:-0.12em] " /></h2>
        <p class="">Projetos desfavoráveis que estão avançando nas comissões e no Plenário</p>
    </header>
    <ProposalCarousel projects={proposals} variant="fast" />
</section>}
