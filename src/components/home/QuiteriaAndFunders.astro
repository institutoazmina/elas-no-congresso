---
import { Image } from "astro:assets";
import quiteria from "../../assets/images/quiteria.png";
import chevron from "../../assets/images/home-reportagens/chevron-right.svg";
---

<section class="quiteria-funders tw:bg-white tw:shadow-[0_-24px_0_#fff,_0_48px_0_#fff] tw:text-ink tw:font-sans" aria-label="QuitérIA">
    <div class="
        quiteria-funders__quiteria tw:flex tw:w-full tw:max-w-180 tw:h-auto tw:flex-col tw:items-center tw:gap-8
        tw:overflow-hidden tw:mt-6 tw:mb-12 tw:mx-auto tw:max-md:py-7.5 tw:max-md:px-[16px] tw:max-md:my-0
        tw:max-md:mx-auto tw:md:w-180 tw:md:h-auto tw:md:pb-12 tw:md:mt-6 tw:md:mb-0 tw:md:mx-auto
    ">
        <Image
            class="
                quiteria-funders__image tw:w-full tw:h-auto tw:object-contain tw:max-md:aspect-[2/1] tw:max-md:object-contain
                tw:md:w-180 tw:md:h-90 tw:md:object-contain
            "
            src={quiteria}
            alt="QuitérIA, inteligência artificial feminista"
        />
        <div class="
            quiteria-funders__explanation-frame tw:flex tw:w-full tw:h-auto tw:min-w-0 tw:flex-none tw:items-center
            tw:justify-center tw:max-md:items-start tw:md:w-180 tw:md:h-[76px] tw:md:min-w-180
        ">
            <div class="
                quiteria-funders__explanation-rotation tw:w-full tw:flex-none tw:[transform:rotate(-0.18deg)]
                tw:max-md:[transform:none] tw:max-md:min-w-0 tw:max-md:[overflow-wrap:anywhere]
            ">
                <div class="
                    quiteria-funders__explanation-flow tw:flex tw:w-full tw:flex-col tw:justify-center tw:text-ink tw:font-sans
                    tw:text-[0] tw:font-normal tw:leading-[0] tw:[&_p]:text-lg tw:[&_p]:font-normal tw:[&_p]:leading-[0]
                    tw:[&_p]:tracking-normal tw:[&_p]:text-left tw:[&_p]:m-0 tw:max-md:min-w-0 tw:max-md:[overflow-wrap:anywhere]
                ">
                    <p class="tw:max-md:min-w-0 tw:max-md:[overflow-wrap:anywhere]">
                        <span class="tw:leading-6 ">
                            Esses levantamentos foram feitos com base em
                            análises da{" "}
                        </span>
                        <span class="
                            quiteria-funders__explanation-quiteria tw:leading-6 tw:text-accent tw:font-sans tw:font-bold tw:underline
                            tw:[text-decoration-thickness:1px] tw:underline-offset-0
                        ">
                            QuitérIA
                        </span>
                        <span class="tw:leading-6 ">, a </span>
                        <span class="quiteria-funders__explanation-ia tw:font-sans tw:font-bold tw:leading-6 ">
                            IA feminista
                        </span>
                        <span class="tw:leading-6 ">
                            {" "}
                            que monitora pautas de gênero no Congresso Nacional
                            diariamente, e com validação humana.
                        </span>
                    </p>
                </div>
            </div>
        </div>
        <a class="
            quiteria-funders__button tw:flex tw:w-[256px] tw:h-14 tw:items-center tw:justify-center tw:gap-2 tw:border-0
            tw:rounded-none tw:bg-accent tw:text-white tw:font-display tw:text-xl tw:font-bold tw:leading-6 tw:uppercase
            tw:[font-variation-settings:'wdth'_75] tw:cursor-pointer tw:no-underline
            tw:[transition:background-color_220ms_ease-out] tw:pt-4.5 tw:pb-3.5 tw:px-6 tw:[&_img]:block
            tw:[&_img]:w-[14px] tw:[&_img]:h-[10px] tw:[&_img]:[transform:rotate(-90deg)] tw:hover:bg-ink
            tw:focus-visible:outline-2 tw:focus-visible:outline-ink tw:focus-visible:outline-offset-1
        " href="/ia-feminista">
            Entenda a metodologia <Image class="" src={chevron} alt="" />
        </a>
    </div>
</section>


