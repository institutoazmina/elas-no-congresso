---
const attention = "/assets/images/party-chart/attention.svg";
const documentImage = "/assets/images/hero/proposicao-9.png";
const favorableThumb = "/assets/images/thumbs-up.svg";
const unfavorableThumb = "/assets/images/thumbs-down.svg";
const bookIcon = "/assets/images/enacted-projects/book.svg";
const mobileBackgroundPattern = "/assets/images/enacted-projects/carousel-pattern.png";
const backgroundPattern = "/assets/images/parliamentarians/bg-pattern.svg";
const halftoneShadow = "/assets/images/hero/halftone-shadow.png";
const arrowBack = "/assets/images/parliamentarians/arrow-back.svg";
const arrowForward = "/assets/images/parliamentarians/arrow-forward.svg";
import { fetchEnactedProjects, type EnactedProject } from "../../lib/activity-api";
import { propositionRoute } from "../../lib/proposition-utils";
import { API_BASE_URL } from "astro:env/server";

let projects: EnactedProject[] = [];
try {
    projects = await fetchEnactedProjects(API_BASE_URL);
} catch {
    // The homepage remains available while the API is being deployed or unavailable.
}

const groupSize = projects.length;
const initialPhysical = groupSize;
const cards = Array.from({ length: groupSize * 3 }, (_, physical) => ({
    project: projects[physical % groupSize],
    physical,
}));
const formatCategory = (project: EnactedProject) => project.category_label?.trim()
    || project.category?.replaceAll("_", " ")
    || "Sem categoria";
const formatEnactedDate = (value: string) => new Intl.DateTimeFormat("pt-BR", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
}).format(new Date(`${value}T00:00:00Z`));
---

{projects.length > 0 && <section class="
    enacted-projects tw:h-[908px] tw:bg-white tw:text-ink tw:font-sans tw:overflow-hidden
    tw:[&_h2]:font-display tw:[&_h2]:text-4xl tw:[&_h2]:font-bold tw:[&_h2]:leading-6 tw:[&_h2]:uppercase
    tw:[&_h2]:[font-variation-settings:'wdth'_75] tw:[&_h2]:m-0 tw:[&_p]:m-0 tw:max-md:w-full tw:max-md:h-[710px]
    tw:max-md:min-h-0 tw:max-md:[&_h2]:w-[344px] tw:max-md:[&_h2]:max-w-full tw:max-md:[&_h2]:h-auto
    tw:max-md:[&_h2]:text-[28px] tw:max-md:[&_h2]:leading-8 tw:max-md:[&_h2]:text-left tw:max-md:[&_h2]:p-0
    tw:max-md:[&_h2]:m-0
" aria-labelledby="enacted-projects-title" style={`--enacted-projects-background: url(${backgroundPattern}); --enacted-projects-mobile-background: url(${mobileBackgroundPattern}); --enacted-projects-halftone-shadow: url(${halftoneShadow})`}>
    <header class="
        enacted-projects__header tw:w-204 tw:h-21 tw:flex tw:flex-col tw:gap-4 tw:py-0 tw:px-12 tw:mt-12 tw:mb-2.5
        tw:mx-auto tw:[&>img]:w-24 tw:[&>img]:h-1 tw:[&_p]:text-lg tw:[&_p]:leading-6 tw:max-md:w-full tw:max-md:h-auto
        tw:max-md:box-border tw:max-md:items-start tw:max-md:gap-4 tw:max-md:pt-12 tw:max-md:pb-2.5 tw:max-md:px-[16px]
        tw:max-md:m-0 tw:max-md:[&>img]:block tw:max-md:[&_p]:w-[344px] tw:max-md:[&_p]:max-w-full tw:max-md:[&_p]:h-auto
        tw:max-md:[&_p]:text-sm tw:max-md:[&_p]:font-normal tw:max-md:[&_p]:leading-6 tw:max-md:[&_p]:text-left
        tw:max-md:[&_p]:p-0 tw:max-md:[&_p]:m-0
    ">
        <img src={attention} alt="" />
        <h2 id="enacted-projects-title">Projetos que viraram lei</h2>
        <p>Projetos favoráveis e desfavoráveis que viraram lei<span class="enacted-projects__desktop-period tw:max-md:hidden"></span></p>
    </header>

    <div class="
        enacted-projects__figure tw:h-[718px] tw:overflow-hidden tw:py-6 tw:px-0 tw:max-md:w-full
        tw:max-md:h-[488px] tw:max-md:pt-6 tw:max-md:pb-0 tw:max-md:px-0
    " data-enacted-carousel data-group-size={String(groupSize)}>
        <div class="
            enacted-projects__carousel tw:relative tw:h-[670px] tw:overflow-hidden tw:bg-repeat tw:bg-top-left
            tw:bg-[image:var(--enacted-projects-background)] tw:bg-size-[400px_400px] tw:p-12 tw:before:absolute
            tw:before:z-1 tw:before:block tw:before:w-full tw:before:h-6
            tw:before:bg-[image:var(--enacted-projects-halftone-shadow)] tw:before:bg-bottom-left tw:before:bg-repeat-x
            tw:before:bg-size-[1440px_24px] tw:before:content-[''] tw:before:pointer-events-none tw:before:mix-blend-multiply
            tw:before:top-0 tw:before:left-0 tw:before:[transform:scaleY(-1)] tw:after:absolute tw:after:z-1 tw:after:block
            tw:after:w-full tw:after:h-6 tw:after:bg-[image:var(--enacted-projects-halftone-shadow)] tw:after:bg-bottom-left
            tw:after:bg-repeat-x tw:after:bg-size-[1440px_24px] tw:after:content-[''] tw:after:pointer-events-none
            tw:after:mix-blend-multiply tw:after:bottom-0 tw:after:left-0 tw:max-md:w-full tw:max-md:h-[464px]
            tw:max-md:[border-top:0] tw:max-md:bg-[image:var(--enacted-projects-mobile-background)]! tw:max-md:bg-top
            tw:max-md:bg-size-[400px_400px] tw:max-md:p-12 tw:max-md:before:h-3 tw:max-md:before:bg-size-[1440px_12px]
            tw:max-md:after:h-3 tw:max-md:after:bg-size-[1440px_12px]
        " style={`--enacted-projects-background: url(${backgroundPattern}); --enacted-projects-mobile-background: url(${mobileBackgroundPattern}); --enacted-projects-halftone-shadow: url(${halftoneShadow}); background-image: url(${backgroundPattern})`} aria-label="Projetos que viraram lei">
            <div class="
                enacted-projects__controls tw:absolute tw:z-3 tw:top-12 tw:left-[calc(50%_-_58px)] tw:flex tw:gap-1
                tw:[&_button]:w-14 tw:[&_button]:h-10 tw:[&_button]:border-[2px] tw:[&_button]:border-solid
                tw:[&_button]:border-accent tw:[&_button]:rounded-none tw:[&_button]:bg-white tw:[&_button]:py-2 tw:[&_button]:px-4
                tw:[&_img]:block tw:[&_img]:w-6 tw:[&_img]:h-6 tw:max-md:top-12 tw:max-md:left-[calc(50%_-_58px)] tw:max-md:w-29
                tw:max-md:h-10 tw:max-md:gap-1 tw:max-md:[&_button]:w-14 tw:max-md:[&_button]:h-10
                tw:max-md:[&_button]:border-[2px] tw:max-md:[&_button]:py-2 tw:max-md:[&_button]:px-4 tw:max-md:[&_img]:w-6
                tw:max-md:[&_img]:h-6 tw:[&_button]:flex tw:[&_button]:items-center tw:[&_button]:justify-center
            ">
                <button class="
                    tw:w-14 tw:h-10 tw:border tw:border-solid tw:border-accent tw:bg-white tw:text-accent tw:[font:32px/1_Arial]
                    tw:cursor-pointer tw:focus-visible:outline-2 tw:focus-visible:outline-ink tw:focus-visible:outline-offset-1
                " type="button" aria-label="Projeto anterior" data-previous><img src={arrowBack} alt="" /></button>
                <button class="
                    tw:w-14 tw:h-10 tw:border tw:border-solid tw:border-accent tw:bg-white tw:text-accent tw:[font:32px/1_Arial]
                    tw:cursor-pointer tw:focus-visible:outline-2 tw:focus-visible:outline-ink tw:focus-visible:outline-offset-1
                " type="button" aria-label="Próximo projeto" data-next><img src={arrowForward} alt="" /></button>
            </div>
            <div class="
                enacted-projects__viewport tw:absolute tw:top-28 tw:left-0 tw:w-full tw:overflow-hidden tw:z-2 tw:overflow-x-clip
                tw:overflow-y-visible tw:max-md:top-28 tw:max-md:w-full tw:max-md:h-[304px] tw:max-md:overflow-x-clip
                tw:max-md:overflow-y-visible
            "><div class="
                enacted-projects__track tw:flex tw:w-max tw:items-start tw:gap-12 tw:[transform:translateX(-3216px)]
                tw:[transition:transform_.2s_ease] tw:relative tw:left-[50%] tw:max-md:left-[50%] tw:max-md:items-start
                tw:max-md:gap-[26px]
            " data-track>
                {cards.map(({ project, physical }) => <a
                    class:list={["enacted-projects__card tw:flex tw:w-96 tw:h-auto tw:min-h-0 tw:flex-none tw:flex-col tw:self-start tw:border tw:border-solid tw:border-muted tw:bg-white tw:text-inherit tw:overflow-visible tw:no-underline tw:cursor-pointer tw:max-md:w-[226px] tw:max-md:h-auto tw:max-md:min-h-0 tw:max-md:border-muted tw:max-md:border tw:max-md:shadow-none tw:data-[featured=true]:border-ink tw:data-[featured=true]:shadow-[-4px_4px_0_#0b0f5e] tw:group", `enacted-projects__card--${project.assessment_label}`, { "enacted-projects__card--featured": physical === initialPhysical }]}
                    href={propositionRoute({ numero: project.number_label, house: project.house }) || "/atividade-legislativa"}
                    data-featured={String(physical === initialPhysical)}
                    data-approved={String(project.assessment_label === "favorável")}
                    aria-label={`Ver proposição ${project.number_label}`}
                    aria-hidden={physical === initialPhysical ? undefined : "true"}
                >
                    <header class="
                        enacted-projects__card-header tw:flex tw:min-h-[70px] tw:flex-none tw:items-center
                        tw:justify-between tw:gap-3 tw:border-b tw:border-solid tw:border-b-muted tw:py-2 tw:px-4
                        tw:[&>strong]:font-display tw:[&>strong]:text-xl tw:[&>strong]:leading-6
                        tw:[&>strong]:[font-variation-settings:'wdth'_75] tw:max-md:min-h-[42px] tw:max-md:border-b-[.584px]
                        tw:max-md:py-[6px] tw:max-md:px-[10px] tw:max-md:[&>strong]:text-[16px]
                        tw:max-md:[&>strong]:leading-[20px]
                    ">
                        <strong>{project.number_label}</strong>
                        <span class="enacted-projects__status tw:flex tw:flex-none tw:items-center tw:gap-0 tw:max-md:gap-0">
                            <img class="enacted-projects__document tw:w-9 tw:h-[52px] tw:-mr-2 tw:[transform:rotate(-5deg)] tw:max-md:w-[22px] tw:max-md:h-[30px]" src={documentImage} alt="" />
                            <span class="
                                enacted-projects__rating tw:flex tw:items-center tw:gap-2 tw:[&_b]:font-display tw:[&_b]:text-base
                                tw:[&_b]:leading-6 tw:[&_b]:uppercase tw:[&_b]:[font-variation-settings:'wdth'_75] tw:max-md:gap-[6px]
                                tw:max-md:[&_b]:text-[12px] tw:max-md:[&_b]:leading-[16px]
                            ">
                                <span class="
                                    enacted-projects__rating-icon tw:block tw:w-8 tw:h-8 tw:rounded-[50%] tw:overflow-hidden tw:[&_img]:block
                                    tw:[&_img]:w-8 tw:[&_img]:h-8 tw:max-md:w-[20px] tw:max-md:h-[20px] tw:max-md:[&_img]:w-[20px]
                                    tw:max-md:[&_img]:h-[20px]
                                "><img src={project.assessment_label === "favorável" ? favorableThumb : unfavorableThumb} alt="" /></span>
                                <b>{project.assessment_label}</b>
                            </span>
                        </span>
                    </header>
                    <div class={String.raw`
                        enacted-projects__details tw:min-h-0 tw:overflow-hidden tw:flex tw:flex-none tw:flex-col tw:gap-4 tw:py-6 tw:px-4
                        tw:max-md:h-auto tw:max-md:gap-[10px] tw:max-md:py-[16px] tw:max-md:px-[10px]
                        tw:[.enacted-projects\_\_card--desfavorável_&]:h-auto
                        tw:max-md:[.enacted-projects\_\_card--desfavorável_&]:h-auto
                        tw:max-md:[.enacted-projects\_\_card--desfavorável_&]:gap-[10px]
                        tw:max-md:[.enacted-projects\_\_card--desfavorável_&]:py-[16px]
                        tw:max-md:[.enacted-projects\_\_card--desfavorável_&]:px-[10px]
                        tw:max-md:[.enacted-projects\_\_card--favorável_&]:h-auto
                    `}>
                        <div class="
                            enacted-projects__authors tw:flex tw:min-h-6 tw:flex-col tw:gap-2.5 tw:[&_p]:h-6 tw:[&_p]:flex
                            tw:[&_p]:justify-between tw:[&_p]:text-lg tw:[&_p]:leading-6 tw:[&_p]:min-w-0 tw:max-md:min-h-[16px]
                            tw:max-md:gap-[6px] tw:max-md:[&_p]:h-[16px] tw:max-md:[&_p]:text-[12px]
                            tw:max-md:[&_p]:leading-[16px]
                        ">
                            {project.authors.slice(0, 3).map((author) => <p><span class="tw:min-w-0">{author.name}</span><strong class="tw:min-w-0 tw:font-bold">{[author.party, author.state].filter(Boolean).join("/")}</strong></p>)}
                            {!project.authors.length && <p>Autoria indisponível</p>}
                            {project.authors.length > 3 && <p class="enacted-projects__more tw:block! tw:text-accent">+{project.authors.length - 3} parlamentares</p>}
                        </div>
                        <span class="
                            enacted-projects__theme tw:w-max tw:max-w-full tw:h-8 tw:bg-accent tw:text-white tw:font-display tw:text-base
                            tw:font-bold tw:leading-6 tw:uppercase tw:[font-variation-settings:'wdth'_75] tw:py-1 tw:px-2 tw:max-md:w-max
                            tw:max-md:h-[20px] tw:max-md:text-[12px] tw:max-md:leading-[16px] tw:max-md:pt-[4px]
                            tw:max-md:pb-[2px] tw:max-md:px-[6px]
                        ">{formatCategory(project)}</span>
                        <p class="
                            enacted-projects__description tw:text-ink tw:text-base tw:leading-6 tw:opacity-66 tw:line-clamp-5
                            tw:text-ellipsis tw:max-md:w-[206px] tw:max-md:flex-none tw:max-md:text-[10px] tw:max-md:leading-[16px]
                            tw:max-md:line-clamp-5
                        ">{project.ementa}</p>
                    </div>
                    <footer class="
                        enacted-projects__law-footer tw:flex tw:w-full tw:shrink-0 tw:items-center tw:justify-between tw:border-t
                        tw:border-muted tw:p-4 tw:text-accent tw:group-data-[featured=true]:bg-accent
                        tw:group-data-[featured=true]:text-white tw:max-md:p-2.5 tw:[&>div]:flex tw:[&>div]:min-w-0 tw:[&>div]:flex-col
                        tw:[&>div]:gap-2 tw:[&_p]:flex tw:[&_p]:items-center tw:[&_p]:gap-2 tw:[&_p]:text-lg tw:[&_p]:leading-6
                        tw:[&_small]:text-xs tw:[&_small]:leading-4 tw:[&_small]:opacity-66 tw:max-md:[&_p]:text-[12px]
                        tw:max-md:[&_p]:leading-[14px] tw:max-md:[&_small]:text-[8px] tw:max-md:[&_small]:leading-[10px]
                        tw:max-md:[&>div]:gap-1 tw:[&>span]:text-3xl tw:[&>span]:opacity-0
                        tw:group-data-[featured=true]:[&>span]:opacity-100
                    ">
                        <div><p><span class={String.raw`
                            enacted-projects__law-icon tw:block tw:relative tw:w-6 tw:h-6 tw:flex-none tw:[&_img]:absolute tw:[&_img]:top-0.5
                            tw:[&_img]:left-1 tw:[&_img]:w-4! tw:[&_img]:h-5! tw:max-md:w-[16px] tw:max-md:h-[16px]
                            tw:max-md:[&_img]:top-[2px] tw:max-md:[&_img]:left-[4px] tw:max-md:[&_img]:w-[10px]!
                            tw:max-md:[&_img]:h-[12px]! tw:[.enacted-projects\_\_card--featured_&_img]:[filter:brightness(0)_invert(1)]
                            tw:max-md:[.enacted-projects\_\_card--featured_&_img]:[filter:brightness(0)_invert(1)]
                        `}><img src={bookIcon} alt="" /></span><strong>{project.enactment.law_label}</strong></p><small>Aprovada em {formatEnactedDate(project.enactment.enacted_at)}</small></div>
                        <span aria-hidden="true">›</span>
                    </footer>
                </a>)}
            </div></div>
        </div>
    </div>
</section>
}

<script>
    const initializeEnactedProjects = () => {
        document.querySelectorAll<HTMLElement>("[data-enacted-carousel]").forEach((carousel) => {
            if (carousel.dataset.enactedCarouselInitialized) return;
            carousel.dataset.enactedCarouselInitialized = "true";
            const track = carousel.querySelector<HTMLElement>("[data-track]");
            const previous = carousel.querySelector<HTMLButtonElement>("[data-previous]");
            const next = carousel.querySelector<HTMLButtonElement>("[data-next]");
            if (!track || !previous || !next) return;
            const groupSize = Number(carousel.dataset.groupSize);
            if (!groupSize) return;
            const cards = Array.from(track.querySelectorAll<HTMLElement>(".enacted-projects__card"));
            let physical = groupSize;
            let resetting = false;
            const update = () => {
                const activeCard = cards[physical];
                const cardWidth = activeCard?.getBoundingClientRect().width ?? 0;
                const gap = Number.parseFloat(getComputedStyle(track).columnGap) || 0;
                track.style.transform = `translateX(${-physical * (cardWidth + gap) - cardWidth / 2}px)`;
                cards.forEach((card, index) => {
                    const active = index === physical;
                    card.classList.toggle("enacted-projects__card--featured", active);
                    card.dataset.featured = String(active);
                    card.setAttribute("aria-hidden", String(!active));
                });
            };
            const move = (direction: number) => {
                if (!resetting) {
                    physical += direction;
                    update();
                }
            };
            track.addEventListener("transitionend", (event) => {
                if (event.propertyName !== "transform" || (physical >= groupSize && physical < groupSize * 2)) return;
                resetting = true;
                physical += physical < groupSize ? groupSize : -groupSize;
                track.style.transition = "none";
                update();
                requestAnimationFrame(() => requestAnimationFrame(() => {
                    track.style.transition = "";
                    resetting = false;
                }));
            });
            previous.addEventListener("click", () => move(-1));
            next.addEventListener("click", () => move(1));
            window.addEventListener("resize", update, { passive: true });
            update();
        });
    };

    initializeEnactedProjects();
    document.addEventListener("astro:page-load", initializeEnactedProjects);
</script>


