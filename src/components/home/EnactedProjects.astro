---
const { content } = Astro.props;
import ProposalCarousel from "./ProposalCarousel.astro";
import { Image } from "astro:assets";
import attention from "../../assets/images/party-chart/attention.svg";
import { fetchEnactedProjects, type EnactedProject } from "../../lib/activity-api";
import { API_BASE_URL } from "astro:env/server";

let projects: EnactedProject[] = [];
try {
    projects = await fetchEnactedProjects(API_BASE_URL);
} catch {
    // The homepage remains available while the API is being deployed or unavailable.
}

---

{projects.length > 0 && <section class="
    enacted-projects tw:h-[908px] tw:bg-white tw:text-ink tw:font-sans tw:overflow-hidden
    tw:[&_h2]:font-display tw:[&_h2]:text-4xl tw:[&_h2]:font-bold tw:[&_h2]:leading-6 tw:[&_h2]:uppercase
    tw:[&_h2]:[font-variation-settings:'wdth'_75] tw:[&_h2]:m-0 tw:[&_p]:m-0 tw:max-md:w-full tw:max-md:h-[710px]
    tw:max-md:min-h-0 tw:max-md:[&_h2]:w-[344px] tw:max-md:[&_h2]:max-w-full tw:max-md:[&_h2]:h-auto
    tw:max-md:[&_h2]:text-[28px] tw:max-md:[&_h2]:leading-8 tw:max-md:[&_h2]:text-left tw:max-md:[&_h2]:p-0
    tw:max-md:[&_h2]:m-0
" aria-labelledby="enacted-projects-title">
    <header class="
        enacted-projects__header tw:w-204 tw:h-21 tw:flex tw:flex-col tw:gap-4 tw:py-0 tw:px-12 tw:mt-12 tw:mb-2.5
        tw:mx-auto tw:[&>img]:w-24 tw:[&>img]:h-1 tw:[&_p]:text-lg tw:[&_p]:leading-6 tw:max-md:w-full tw:max-md:h-auto
        tw:max-md:box-border tw:max-md:items-start tw:max-md:gap-4 tw:max-md:pt-12 tw:max-md:pb-2.5 tw:max-md:px-[16px]
        tw:max-md:m-0 tw:max-md:[&>img]:block tw:max-md:[&_p]:w-[344px] tw:max-md:[&_p]:max-w-full tw:max-md:[&_p]:h-auto
        tw:max-md:[&_p]:text-sm tw:max-md:[&_p]:font-normal tw:max-md:[&_p]:leading-6 tw:max-md:[&_p]:text-left
        tw:max-md:[&_p]:p-0 tw:max-md:[&_p]:m-0
    ">
        <Image src={attention} alt="" />
        <h2 id="enacted-projects-title">{content.enacted_title}</h2>
        <p>{content.enacted_subtitle}<span class="enacted-projects__desktop-period tw:max-md:hidden"></span></p>
    </header>
    <ProposalCarousel projects={projects} variant="enacted" />
</section>}
