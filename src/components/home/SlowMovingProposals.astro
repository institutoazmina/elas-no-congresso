---
import ProposalCarousel from "./ProposalCarousel.astro";
import { Image } from "astro:assets";
import attention from "../../assets/images/party-chart/attention.svg";
import turtleEmoji from "../../assets/images/home/turtle.png";
import { fetchSlowFavorable } from "../../lib/activity-api";
import { API_BASE_URL } from "astro:env/server";

let proposals: Awaited<ReturnType<typeof fetchSlowFavorable>> = [];
try {
    proposals = await fetchSlowFavorable(API_BASE_URL);
} catch {
    // The homepage remains available while the API is being deployed or unavailable.
}
---

{proposals.length > 0 && <section class="
    slow-moving-proposals tw:h-[924px] tw:overflow-hidden tw:bg-white tw:text-ink tw:font-sans
    tw:[&_h2]:w-180 tw:[&_h2]:h-16.5 tw:[&_h2]:font-display tw:[&_h2]:text-4xl tw:[&_h2]:font-bold
    tw:[&_h2]:leading-8 tw:[&_h2]:uppercase tw:[&_h2]:[font-variation-settings:'wdth'_75] tw:[&_h2]:m-0 tw:[&_p]:m-0
    tw:max-md:[&_h2]:w-[344px] tw:max-md:[&_h2]:text-[28px] tw:max-md:[&_h2]:h-auto tw:max-md:[&_h2]:max-w-full
    tw:max-md:[&_h2]:leading-8 tw:max-md:[&_h2]:tracking-normal tw:max-md:h-[728px]
    tw:max-md:box-border tw:max-md:py-12 tw:max-md:px-0
" aria-labelledby="slow-moving-proposals-title">
    <header class="
        slow-moving-proposals__header tw:flex tw:w-204 tw:h-43.5 tw:flex-col tw:gap-4 tw:p-12 tw:m-auto tw:[&>img]:w-24
        tw:[&>img]:h-1 tw:[&_p]:text-lg tw:[&_p]:leading-6 tw:max-md:w-full tw:max-md:px-[16px] tw:max-md:h-auto
        tw:max-md:items-start tw:max-md:gap-4 tw:max-md:py-0 tw:max-md:my-0 tw:max-md:mx-auto tw:max-md:[&_p]:w-[344px]
        tw:max-md:[&_p]:max-w-full tw:max-md:[&>p]:h-auto tw:max-md:[&>p]:text-sm tw:max-md:[&>p]:font-normal
        tw:max-md:[&>p]:leading-6
    "><Image class="" src={attention} alt="" /><h2 class="" id="slow-moving-proposals-title">E o que é bom pra gente, mas<br class="tw:max-md:hidden" />tá indo beeeem devagar: <Image src={turtleEmoji} alt="" class="slow-moving-proposals__emoji tw:inline-block tw:h-[1em] tw:w-auto tw:[vertical-align:-0.12em]" /></h2><p class="">Projetos favoráveis que ainda aguardam relatoria, parecer ou votação</p></header>
    <ProposalCarousel projects={proposals} variant="slow" />
</section>}
