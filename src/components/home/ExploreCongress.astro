---
const { content, image } = Astro.props;
import { Image } from "astro:assets";
import CuttingMat from "../shared/CuttingMat.astro";
import chevron from "../../assets/images/home-news/chevron-right.svg";
---

<CuttingMat class="
    explore-congress tw:flex tw:w-full tw:min-h-0 tw:h-auto tw:mt-12 tw:items-center tw:justify-center
    tw:overflow-clip tw:shadow-[0_-48px_0_#fff]
    tw:py-16 tw:px-6 tw:[&_h2]:w-auto tw:[&_h2]:h-auto tw:[&_h2]:text-white
    tw:[&_h2]:font-display tw:[&_h2]:text-[32px] tw:[&_h2]:font-bold tw:[&_h2]:[font-variation-settings:'wdth'_75]
    tw:[&_h2]:leading-8 tw:[&_h2]:text-center tw:[&_h2]:uppercase tw:[&_h2]:mt-0 tw:[&_h2]:mb-3 tw:[&_h2]:mx-0
    tw:max-md:w-full tw:max-md:min-h-0 tw:max-md:items-start tw:max-md:justify-start tw:max-md:py-13
    tw:max-md:px-6 tw:max-md:[&_h2]:w-auto tw:max-md:[&_h2]:h-auto tw:max-md:[&_h2]:text-[28px]
    tw:max-md:[&_h2]:leading-8 tw:max-md:[&_h2]:text-left tw:md:p-[64px_max(24px,_calc((100vw_-_660px)_/_2))]
" aria-labelledby="explore-congress-title">
    <a href={content.explore_cta_url} aria-labelledby="explore-congress-title explore-congress-cta" class="explore-congress__content tw:group tw:no-underline tw:cursor-pointer tw:focus-visible:outline-2 tw:focus-visible:outline-white tw:focus-visible:outline-offset-4 tw:flex tw:w-full tw:h-auto tw:min-w-0 tw:flex-col tw:items-center tw:gap-0 tw:max-md:items-start tw:md:w-165 tw:md:min-w-0 ">
        <h2 class="" id="explore-congress-title">{content.explore_title}</h2>
        <p class="
            explore-congress__subtitle tw:max-md:max-w-full tw:max-md:text-lg tw:max-md:leading-6 tw:max-md:text-center
            tw:md:w-165 tw:md:h-auto tw:w-full tw:h-auto tw:text-white tw:font-sans tw:text-lg
            tw:font-normal tw:leading-6 tw:text-center tw:mt-0 tw:mb-7 tw:mx-0
        ">{content.explore_subtitle}</p>
        <div class="
            explore-congress__screen-wrap tw:flex tw:w-full tw:max-w-165 tw:h-auto tw:items-start tw:justify-center tw:p-0
            tw:mt-0 tw:mb-7 tw:mx-0 tw:max-md:justify-start tw:md:w-165
        ">
            <img class="explore-congress__screen tw:block tw:w-full tw:h-auto tw:flex-none tw:border-[2px] tw:border-solid tw:border-accent tw:rounded-2xl tw:bg-white " src={image.url} width={image.width} height={image.height} alt={content.explore_image_alt} loading="lazy" />
        </div>
        <span id="explore-congress-cta" class="
            explore-congress__button tw:flex tw:w-full tw:max-w-85 tw:h-14 tw:items-center tw:justify-center tw:gap-2
            tw:border-0 tw:rounded-none tw:bg-accent tw:text-white tw:font-display tw:text-xl tw:font-bold
            tw:[font-variation-settings:'wdth'_75] tw:leading-6 tw:text-left tw:uppercase tw:cursor-pointer tw:no-underline
            tw:pt-4.5 tw:pb-3.5 tw:px-6 tw:m-0 tw:[&_img]:block tw:[&_img]:w-[14px] tw:[&_img]:h-[10px]
            tw:[&_img]:[transform:rotate(-90deg)] tw:group-hover:bg-ink tw:group-hover:outline-1 tw:group-hover:outline-white tw:group-focus-visible:bg-ink
            tw:max-md:w-max
            tw:max-md:max-w-full tw:max-md:self-start tw:max-md:justify-start tw:max-md:text-base tw:max-md:whitespace-nowrap
            tw:md:w-85 tw:md:max-w-none
        ">{content.explore_cta_text} <Image class="" src={chevron} alt="" /></span>
    </a>
</CuttingMat>
