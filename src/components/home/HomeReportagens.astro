---
import { Image } from "astro:assets";
import chevronRight from "../../assets/images/home-reportagens/chevron-right.svg";
import cuttingMatPattern from "../../assets/images/home-reportagens/bg-pattern-cutting-mat.svg";
import { fetchReportagens } from "../../lib/wp";

const reports = await fetchReportagens(1988, 3);

function formatDate(date: string) {
    return new Intl.DateTimeFormat("pt-BR", {
        day: "numeric",
        month: "long",
        year: "numeric",
        timeZone: "UTC",
    }).format(new Date(`${date}Z`));
}
---

<section class="tw:overflow-hidden tw:bg-[#0B0F5E] tw:py-12 tw:text-white tw:lg:py-24" style={`background-image: url('${cuttingMatPattern.src}'); background-position: center top; background-repeat: repeat; background-size: 200px 200px;`} aria-labelledby="home-reportagens-title">
    <header class="
        tw:mx-auto tw:flex tw:w-full tw:max-w-[720px] tw:flex-col tw:items-center tw:px-[16px] tw:text-center
        tw:lg:h-[62px] tw:lg:px-0 tw:max-md:items-start tw:max-md:text-left
    ">
        <h2 id="home-reportagens-title" class="tw:m-0 tw:text-[32px] tw:font-bold tw:leading-8 tw:uppercase tw:font-display tw:[font-variation-settings:'wdth'_75] tw:max-md:ml-0 tw:max-md:mr-0 tw:max-md:text-left">
            Reportagens
        </h2>
        <p class="tw:m-0 tw:mt-[6px] tw:text-lg tw:font-normal tw:leading-6 tw:max-md:ml-0 tw:max-md:mr-0 tw:max-md:text-left">
            O que os dados do Elas no Congresso revelam sobre o que está em disputa no Congresso e na vida das mulheres
        </p>
    </header>

    <div class="tw:mt-10 tw:overflow-x-auto tw:overflow-y-hidden tw:px-[16px] tw:lg:mt-2.5 tw:lg:overflow-hidden tw:lg:px-12 tw:lg:pt-12" aria-label="Lista de reportagens em destaque">
        <div class="tw:flex tw:w-max tw:justify-start tw:gap-4 tw:pb-2 tw:lg:w-full tw:lg:justify-center-safe tw:lg:gap-12 tw:lg:pb-0">
            {reports.map((report) => {
                const image = report._embedded?.["wp:featuredmedia"]?.[0];
                const imageSource = image?.source_url ?? image?.link;
                const imageUrl = imageSource ? new URL(imageSource, report.link).href : undefined;
                const date = report.modified || report.date;

                return (
                <article class="tw:flex tw:w-[min(384px,calc(100vw-72px))] tw:shrink-0 tw:flex-col tw:gap-4 tw:lg:w-96">
                    <a href={report.link} class="home-reportagem-image-link tw:block tw:w-full tw:cursor-pointer" target="_blank" rel="noopener noreferrer" aria-label={`Ler: ${report.title.rendered.replace(/<[^>]*>/g, "").trim()}`}>
                        <figure class="tw:m-0 tw:w-full tw:border-2 tw:border-[#4242F6]">
                            {imageUrl && <Image class="tw:block tw:aspect-[384/216] tw:w-full tw:object-cover" src={imageUrl} width={768} height={432} alt={image?.alt_text ?? ""} loading="lazy" decoding="async" />}
                        </figure>
                    </a>
                    <h3 class="tw:m-0 tw:text-2xl tw:font-bold tw:leading-8 tw:uppercase tw:font-display tw:[font-variation-settings:'wdth'_75]">
                        <a href={report.link} class="
                            home-reportagem-title-link tw:text-inherit tw:no-underline tw:hover:text-inherit tw:hover:no-underline
                            tw:focus-visible:outline-2 tw:focus-visible:outline-white tw:focus-visible:outline-offset-1
                        " target="_blank" rel="noopener noreferrer" aria-label={`Ler: ${report.title.rendered.replace(/<[^>]*>/g, "").trim()}`}>
                            <Fragment set:html={report.title.rendered} />
                        </a>
                    </h3>
                    <div class="tw:mt-auto tw:flex tw:h-[70px] tw:flex-col tw:items-start tw:gap-4">
                        <a class="
                            tw:flex tw:h-[38px] tw:items-center tw:gap-2 tw:bg-[#4242F6] tw:pb-1.5 tw:pl-[14px] tw:pr-3 tw:pt-2 tw:text-lg
                            tw:font-bold tw:leading-6 tw:uppercase tw:font-display tw:[font-variation-settings:'wdth'_75]
                        " href={report.link} target="_blank" rel="noopener noreferrer">
                            <span>Ler reportagem</span>
                            <span class="tw:flex tw:h-6 tw:w-3 tw:items-center tw:justify-end" aria-hidden="true">
                                <Image class="tw:h-[6px] tw:w-3 tw:rotate-[-90deg]" src={chevronRight} alt="" />
                            </span>
                        </a>
                        <time datetime={date} class="tw:text-sm tw:font-normal tw:leading-4">Atualizada em {formatDate(date)}</time>
                    </div>
                </article>
                );
            })}
        </div>
    </div>
</section>


