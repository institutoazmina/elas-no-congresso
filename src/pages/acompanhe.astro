---
import SiteLayout from "../layouts/SiteLayout.astro";
import Share from "../components/shared/Share.astro";
import NewsletterSection from "../components/newsletter/NewsletterSection.astro";
import { fetchReportagens } from "../lib/wp";

const posts = await fetchReportagens(1988, 99);
---

<SiteLayout title="Reportagens">
    <main>
        <header class="tw:relative tw:flex tw:min-[992px]:min-h-[60vh] tw:flex-col tw:justify-center tw:bg-periwinkle tw:bg-[url('/assets/images/backgrounds/abertura-acompanhe.webp')] tw:bg-contain tw:bg-no-repeat tw:bg-bottom tw:pt-4 tw:pb-12 tw:min-[992px]:pt-12 tw:min-h-[50vh]!">
            <Share title="Reportagens" />

            <div class="tw:w-full tw:mx-auto tw:px-4 tw:min-[992px]:px-8 tw:max-w-[1310px]">
                <div class="tw:flex tw:flex-wrap tw:-mx-4">
                    <div class="tw:w-full tw:min-w-0 tw:px-4 tw:min-[992px]:w-[58.3333%] tw:min-[992px]:ml-[8.3333%]">
                        <h2 class="tw:font-display tw:uppercase tw:break-normal tw:text-white tw:text-[clamp(36.4px,calc(2.275rem_+_15.6*(100vw_-_500px)/700),52px)] tw:leading-[1.5] tw:mb-8">
                            <span class="tw:font-black tw:[font-variation-settings:'wdth'_350]">Reportagens</span>
                        </h2>
                    </div>
                </div>
            </div>
        </header>

        {
            posts.length > 0 && (
                <article class="tw:relative tw:bg-white tw:py-20 tw:before:content-[''] tw:before:absolute tw:before:z-2 tw:before:left-0 tw:before:bottom-[calc(100%_-_32px)] tw:before:w-full tw:before:h-[7vh] tw:before:bg-[url('/assets/images/backgrounds/paper-edge.svg')] tw:before:bg-cover tw:before:bg-top tw:before:pointer-events-none tw:[&_p]:mb-4 tw:[&_p]:leading-[1.3] tw:[&_article]:mb-12 tw:[&_table]:w-full tw:[&_table]:text-sm tw:[&_th]:p-2 tw:[&_td]:p-2 tw:[&_tbody_tr]:border-b tw:[&_tbody_tr]:border-periwinkle/20">
                    <div class="tw:w-full tw:mx-auto tw:px-4 tw:min-[992px]:px-8 tw:max-w-[1310px]">
                        <div class="tw:flex tw:flex-wrap tw:-mx-4">
                            <div class="tw:w-full tw:min-w-0 tw:px-4">
                                <h3 class="tw:text-2xl tw:md:text-3xl tw:font-semibold tw:font-display tw:mb-8! tw:text-periwinkle tw:text-center">
                                    Veja as histórias que os dados do Congresso
                                    nos conta.
                                </h3>
                            </div>
                        </div>
                        <div class="tw:flex tw:flex-wrap tw:-mx-4">
                            {posts.map((post) => {
                                const img =
                                    post._embedded?.["wp:featuredmedia"]?.[0]
                                        ?.link ?? "/uploads/card1.png";
                                return (
                                    <div class="tw:w-full tw:min-w-0 tw:px-4 tw:min-[768px]:w-1/2 tw:min-[992px]:w-[33.3333%]">
                                        <a
                                            href={post.link}
                                            class="tw:mt-4 tw:mb-12 tw:flex tw:flex-col tw:gap-4 tw:text-navy tw:[&_figure]:m-0"
                                        >
                                            <figure class="tw:h-24 tw:relative">
                                                <img
                                                    src={img}
                                                    alt=""
                                                    loading="lazy"
                                                    decoding="async"
                                                    class="tw:object-cover! tw:object-center! tw:w-full! tw:h-full!"
                                                />
                                            </figure>
                                            <h3
                                                class="tw:font-display tw:font-black tw:text-2xl tw:leading-[1.25] tw:[font-variation-settings:'wdth'_200]"
                                                set:html={post.title.rendered}
                                            />
                                            <button class="tw:mt-4 tw:inline-flex tw:items-center tw:gap-3 tw:border-0 tw:text-[#ff808a] tw:text-xs tw:leading-[18px] tw:font-display tw:font-bold tw:uppercase tw:after:content-['→']">
                                                Ler matéria
                                            </button>
                                        </a>
                                    </div>
                                );
                            })}
                        </div>
                    </div>
                </article>
            )
        }

        <NewsletterSection />
    </main>
</SiteLayout>
