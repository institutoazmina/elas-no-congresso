---
import PageLayout from "../layouts/PageLayout.astro";
import AlertsHero from "../components/alerts/AlertsHero.astro";
import AlertsList from "../components/alerts/AlertsList.astro";
import { getCategoryOptions, getAlertPropositions } from "../service/api/alerts";
import { getAlertsPageContent } from "../service/api/cms";

const [propositionPage, categories, content] = await Promise.all([
    getAlertPropositions(),
    getCategoryOptions(),
    getAlertsPageContent(),
]);
---

<PageLayout
    title="Receba alertas sobre gênero no Congresso | Elas no Congresso"
    description="Receba alertas sobre projetos de lei e pautas de gênero que afetam os direitos de meninas, mulheres e pessoas LGBTQIAPN+ no Congresso Nacional."
    canonical="https://www.elasnocongresso.com.br/alertas"
>
    <main class="tw:bg-white">
        <AlertsHero content={content} categories={categories} />
        <section
            class="tw:mx-auto tw:flex tw:w-full tw:max-w-224 tw:flex-col tw:gap-8 tw:px-6 tw:py-12 tw:md:px-8 tw:md:py-16 tw:lg:px-10 tw:lg:pt-25 tw:lg:pb-14"
            aria-label="Alertas recentes"
        >
            <AlertsList propositions={propositionPage.items} total={propositionPage.count} />
        </section>
    </main>
</PageLayout>
