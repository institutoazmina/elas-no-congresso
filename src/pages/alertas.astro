---
import { ClientRouter } from "astro:transitions";
import RedesignHeader from "../components/redesign/RedesignHeader.astro";
import AlertsHero from "../components/redesign/alerts/AlertsHero.astro";
import AlertsToolbar from "../components/redesign/alerts/AlertsToolbar.astro";
import AlertsList from "../components/redesign/alerts/AlertsList.astro";
import AlertsEmailModal from "../components/redesign/alerts/AlertsEmailModal.astro";
import RedesignFooter from "../components/redesign/RedesignFooter.astro";
import "../styles/tailwind.css";
import "../styles/redesign-shared-background.css";
---

<!doctype html>
<html lang="pt-BR">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Alertas | Elas no Congresso</title>
        <link rel="preload" href="/assets/fonts/ETCAnybodyVariable.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;700&display=swap" rel="stylesheet" />
        <ClientRouter fallback="swap" />
    </head>
    <body class="tw:!pt-0 tw:!bg-white">
        <div class="redesign-alerts-page">
            <div class="redesign-alerts-header-background redesign-shared-background">
                <RedesignHeader />
            </div>
            <main class="redesign-alerts-main">
                <AlertsHero />
                <section class="alerts-content" aria-label="Alertas recentes">
                    <AlertsToolbar />
                    <AlertsList />
                </section>
            </main>
            <RedesignFooter />
            <AlertsEmailModal />
        </div>
    </body>
</html>

<style is:global>
    @font-face { font-family: "ETC Anybody"; font-style: normal; font-weight: 50 1000; font-display: swap; src: url("/assets/fonts/ETCAnybodyVariable.woff2") format("woff2-variations"); }
    body:has(.redesign-header) { margin: 0; }
    .redesign-header .container-fluid { width: 100%; }
    .redesign-header .wrap { max-width: 1310px; }
    .redesign-header .ff1 { font-family: "ETC Anybody", sans-serif; }
    .redesign-alerts-header-background { position: relative; z-index: 12; }
    .redesign-alerts-main { background: #fff; }
    .alerts-content { box-sizing: border-box; display: flex; flex-direction: column; gap: 32px; margin: 0 auto; padding: 100px 40px 56px; width: 896px; }
    @media (max-width: 940px) { .alerts-content { padding: 64px 32px; width: 100%; } }
    @media (max-width: 767px) {
        .alerts-content { gap: 32px; padding: 48px 24px; }
        .redesign-alerts-page .redesign-header.redesign-header--scrolled {
            inset: 0 0 auto;
            position: fixed;
        }
        .redesign-alerts-page .redesign-header .highlighter-marks {
            display: none !important;
        }
        .redesign-alerts-page .redesign-header:not(.redesign-header--scrolled):has(.redesign-header__mobile-menu[open]) {
            inset: auto;
            position: relative;
        }
        .redesign-alerts-page .redesign-header__content:has(.redesign-header__mobile-menu[open]) {
            display: block;
            padding: 0;
        }
        .redesign-alerts-page .redesign-header__content:has(.redesign-header__mobile-menu[open]) > .redesign-header__brand {
            left: 16px;
            position: absolute;
            top: 19px;
            z-index: 2;
        }
        .redesign-alerts-page .redesign-header__mobile-menu[open] {
            display: block;
            padding-top: 12px;
            width: 100%;
        }
        .redesign-alerts-page .redesign-header__mobile-menu[open] > summary {
            margin-left: auto;
            margin-right: 16px;
        }
        .redesign-alerts-page .redesign-header__mobile-menu[open] > .redesign-header__mobile-panel {
            height: auto;
            inset: auto;
            margin-top: 12px;
            min-height: 0;
            overflow-y: visible;
            position: static;
        }
        .redesign-alerts-page .redesign-header__mobile-panel a[href="/alertas"] {
            background: transparent;
            color: #fff;
            text-decoration: none;
        }
        .redesign-alerts-page .redesign-header__mobile-panel a[href="/alertas"] > span {
            background: #def279;
            color: #0b0f5e;
            text-decoration: underline;
            text-decoration-thickness: 2px;
            text-underline-offset: 4px;
        }
    }
</style>
