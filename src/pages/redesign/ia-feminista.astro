---
import { ClientRouter } from "astro:transitions";
import RedesignHeader from "../../components/redesign/RedesignHeader.astro";
import RedesignFooter from "../../components/redesign/RedesignFooter.astro";
import heroIllustration from "../../assets/images/redesign/ia-feminista/hero-illustration.png";
import attention from "../../assets/images/redesign/hero/attention.svg";
import halftoneShadow from "../../assets/images/redesign/hero/halftone-shadow.png";
import "../../styles/tailwind.css";
import "../../styles/redesign-shared-background.css";

const categories = [
  ["Violências de Gênero", "Propostas relacionadas à prevenção, enfrentamento, responsabilização e reparação das diversas formas de violência baseadas em gênero, assédio, violência doméstica, sexual, política, institucional, obstétrica, digital e feminicídio, além de proposições sobre acesso a armas ou que alterem a Lei Maria da Penha."],
  ["Direitos Sexuais e Reprodutivos", "Autonomia corporal, direitos reprodutivos e sexuais, acesso à contracepção, aborto, planejamento familiar, reprodução assistida e garantia de direitos ligados à sexualidade."],
  ["Saúde", "Promoção, prevenção e acesso à saúde, com atenção às necessidades específicas de mulheres, pessoas gestantes, pessoas LGBTQIAPN+ e outros grupos em situação de vulnerabilidade. Abrange saúde materna, menstruação e dignidade menstrual, menopausa, climatério, cânceres do aparelho reprodutor, saúde mental, acesso a medicamentos, prevenção de doenças e organização dos serviços de saúde."],
  ["Igualdade e Antidiscriminação", "Iniciativas voltadas a promover igualdade de direitos e oportunidades e a combater discriminações baseadas em gênero, sexo, orientação sexual, identidade de gênero, raça, território e outras formas de desigualdade."],
  ["LGBTQIAPN+", "Direitos, cidadania, proteção e reconhecimento das pessoas LGBTQIAPN+, incluindo identidade de gênero, orientação sexual, acesso a direitos e combate à violência e à discriminação."],
  ["Família, Parentalidade e Relações Civis", "Organização familiar, casamento, união estável, divórcio, filiação, guarda, adoção, poder familiar, registro civil e demais direitos e deveres nas relações familiares."],
  ["Educação e Cultura", "Educação formal e não formal, produção cultural, liberdade de ensino, conteúdos curriculares, memória e preservação histórica, homenagens e reconhecimento de personalidades ou marcos relevantes para a igualdade de gênero, a diversidade e os direitos humanos."],
  ["Infância e Adolescência", "[A produzir]"],
  ["Trabalho, Economia, Cuidado e Proteção Social", "Mercado de trabalho, economia, geração de renda, empreendedorismo, previdência, seguridade e assistência social, políticas de proteção econômica e social, maternidade, licença-maternidade e outros direitos trabalhistas, acesso a creches e políticas de cuidado, valorização do trabalho doméstico e de cuidados, regulamentação ou direitos relacionados à prostituição, além de iniciativas sobre os impactos das mudanças climáticas e das políticas ambientais nas condições de vida, trabalho, cuidado e proteção social."],
  ["Participação Política e Institucionalidade", "Participação de mulheres e da população LGBTQIAPN+ nos espaços de poder, representação política, cargos e funcionamento das instituições públicas, mecanismos de participação social e políticas públicas de promoção da igualdade de gênero."],
];
const metrics = [["Acurácia","0,82","0,87","↑"],["AUC","–","0,85","–"],["F1 Score Índice 0","0,88","0,92","↑"],["F1 Score Índice 1","0,64","0,67","↑"],["Precisão Índice 0","0,91","0,89","↓"],["Precisão Índice 1","0,59","0,75","↑"],["Revocação Índice 0","0,86","0,94","↑"],["Revocação Índice 1","0,70","0,61","↓"]];
---
<!doctype html><html lang="pt-BR" transition:animate="none"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>IA Feminista | Elas no Congresso</title><link rel="preload" href="/assets/fonts/ETCAnybodyVariable.woff2" as="font" type="font/woff2" crossorigin /><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" /><ClientRouter fallback="swap" /></head>
<body class="tw:!pt-0 tw:!bg-white"><div class="ia-page"><RedesignHeader /><main>
<section class="ia-hero redesign-shared-background" aria-labelledby="ia-hero-title" style={`--ia-hero-halftone-shadow: url(${halftoneShadow.src})`}><div class="ia-hero__top-row"><div class="ia-hero__copy"><img class="ia-hero__attention" src={attention.src} alt="" /><h1 id="ia-hero-title"><span class="hero__title-narrow">Quem foi </span><strong>Maria Quitéria?</strong></h1><p>O nome da ferramenta homenageia a heroína baiana Maria Quitéria de Jesus (1792–1853), primeira mulher a integrar o Exército Brasileiro. Em 1822, ela se apresentou como homem, sob o pseudônimo "Soldado Medeiros", para lutar na Guerra de Independência do Brasil na Bahia. A QuitérIA carrega esse legado de coragem e resistência para o combate à opacidade legislativa.</p></div><div class="ia-hero__art"><div class="ia-hero__illustration"><div class="ia-hero__illustration-inner"><img src={heroIllustration.src} alt="Ilustração de Maria Quitéria" /></div></div></div></div><div class="ia-hero__shadow" aria-hidden="true"></div></section>
<section class="ia-section"><header><i></i><h2>Diferencial tecnológico</h2></header><div class="ia-narrow"><p>Diferente das IAs genéricas, treinadas com dados indeterminados da internet, a QuitérIA parte de um modelo de linguagem pré-treinado em português brasileiro (BERTimbau Base), com ajuste fino sobre um dataset construído ao longo de anos de avaliação humana de projetos de lei sensíveis a gênero na Câmara e no Senado.</p><p>O foco estratégico está no Processamento de Linguagem Natural (PLN) aplicado tanto às ementas quanto ao inteiro teor das matérias, priorizando eixos como violência de gênero, direitos sexuais e reprodutivos e igualdade no trabalho.</p><p>A escolha por modelos compactos e especializados, em vez de Large Language Models (LLMs), alia eficiência e soberania tecnológica: consomem significativamente menos energia e poder computacional, garantem maior autonomia operacional e facilitam futuros retreinamentos.</p><h3>Arquitetura dos modelos</h3><div class="ia-cards"><article><h4>Modelo de Desfavorabilidade</h4><p>Principal modelo da ferramenta. Baseado no BERTimbau Base, adaptado ao português brasileiro, com uma camada adicional de classificação para ajuste fino.</p><b>87% de acurácia</b><small>na avaliação de matérias de gênero</small></article><article><h4>Modelo de Temas</h4><p>Mesma estratégia do modelo anterior, com o desafio adicional de classificação <em>multi-label</em>, cobrindo dez temas diferentes de projetos de lei.</p></article></div></div></section>
<section class="ia-section ia-section--border"><header><i></i><h2>feminismo de dados e treinamento ético</h2></header><div class="ia-narrow"><p>A QuitérIA aplica na prática os princípios do Feminismo de Dados e, como integrante da Rede Feminista de Inteligência Artificial da América Latina e do Caribe, <a href="https://iafeminista.lat/declaracion-de-principios/">reconhece e adota sua declaração de princípios</a>.</p><p>Na prática, a IA faz a triagem, classifica as proposições por categoria e calcula uma pontuação de desfavorabilidade de 0 a 1. Mas nunca opera de forma 100% autônoma: projetos ambíguos ou divergentes são encaminhados para validação por analistas humanos, e as correções feitas pelas especialistas retroalimentam o sistema em ciclos contínuos de readequação e retreinamento.</p><p>Esse processo prevê retreinamentos periódicos. <b>Atualmente estamos no segundo ciclo.</b> A cada ciclo, novas proposições são avaliadas e o modelo é atualizado com os ajustes feitos pela equipe humana.</p></div><div class="ia-wide"><h3>As dez categorias temáticas</h3><table><thead><tr><th>Categoria</th><th>Conceito</th></tr></thead><tbody>{categories.map(([name, text]) => <tr><th>{name}</th><td class={text === "[A produzir]" ? "pending" : ""}>{text}</td></tr>)}</tbody></table></div></section>
<section class="ia-section ia-section--border ia-governance"><header><i></i><h2>Governança, transparência e segurança</h2></header><div class="ia-narrow"><p>Infraestruturas de dados e sistemas de inteligência artificial são, majoritariamente, orientados por lógicas institucionais, corporativas ou opacas. A QuitérIA propõe uma reapropriação crítica dessas tecnologias a partir de uma perspectiva feminista e voltada ao interesse público, concretizando, no campo do monitoramento legislativo, os princípios da <a href="https://azmina.com.br/revista-azmina/#uso-de-inteligencia-artificial" target="_blank">política de uso de inteligência artificial do Instituto AzMina</a>, que estabelece a revisão humana como condição inegociável, o compromisso com a transparência e a abertura de código sempre que possível.</p><p>Por isso tornamos públicos não apenas os resultados do monitoramento, mas também os processos, critérios e metodologias usados na coleta, seleção e análise das proposições. Cada proposição monitorada vem acompanhada de informações sobre tramitação, autoria, situação legislativa, classificação de impacto e, quando aplicável, a organização responsável pela avaliação e sua justificativa técnica. A metodologia de coleta, os critérios de inclusão, o protocolo de avaliação e a documentação da IA também são públicos, permitindo escrutínio e aperfeiçoamento contínuo.</p><h3>Duas instâncias de supervisão</h3><div class="ia-cards"><article><h4>Comitê de Governança</h4><p>Responsável pelas diretrizes estratégicas, aprovação de protocolos metodológicos, gestão de riscos tecnológicos e salvaguarda dos princípios éticos.</p><small>Atuação vigente de junho a setembro de 2026.</small></article><article><h4>Comitê de Validação</h4><p>Instância técnica encarregada de auditar as classificações da IA, monitorar possíveis vieses algorítmicos, avaliar indicadores de desempenho e propor ajustes nos dados de treino.</p><small>Atuação vigente de agosto a setembro de 2026.</small></article></div><h3 class="ia-not-do__title">O que a QuitérIA&nbsp;<span>não faz</span></h3><p>O papel do sistema é apoiar a análise, a organização e o monitoramento, e não automatizar decisões políticas complexas. A QuitérIA:</p><ul class="ia-not-do__list"><li>não substitui decisões humanas em temas políticos, jurídicos ou de direitos humanos;</li><li>não define sozinha, de forma definitiva, se uma proposta é favorável ou desfavorável;</li><li>não toma decisões de moderação sem supervisão nem atua como autoridade jurídica;</li><li>não invisibiliza divergências políticas legítimas;</li><li>não substitui a análise contextual especializada, e opera com transparência sobre suas limitações e margens de erro;</li><li>não reproduz vieses presentes nos dados legislativos ou nas anotações humanas sem mecanismos de auditoria e revisão crítica.</li></ul></div></section>
<section class="ia-section ia-section--border"><header><i></i><h2>Métricas e avaliação</h2></header><div class="ia-narrow"><h5>Métricas do modelo de avaliação de desfavorabilidade</h5><table class="metrics"><thead><tr><th>Métricas</th><th>QuitérIA 1.0 (2025)</th><th>QuitérIA 2.0 (2026)</th><th></th></tr></thead><tbody>{metrics.map(row => <tr>{row.map(cell => <td>{cell}</td>)}</tr>)}</tbody></table><h5>Partição dos dados</h5><table class="metrics partition"><thead><tr><th>Partição</th><th>Acurácia</th><th>Percentual da base</th><th>Quantidade absoluta</th></tr></thead><tbody><tr><td>Treino</td><td>0,92</td><td>80,93%</td><td>2.518</td></tr><tr><td>Validação</td><td>0,84</td><td>9,03%</td><td>281</td></tr><tr><td>Teste</td><td>0,87</td><td>10,06%</td><td>313</td></tr></tbody></table></div><div class="placeholder">[ Gráfico / tabela de categorização — a inserir ]</div></section>
<section class="ia-section ia-section--border"><header><i></i><h2>código e dados abertos</h2></header><div class="ia-narrow"><p>A QuitérIA é um ecossistema aberto, transparente e replicável para outros campos da defesa dos direitos humanos. Visite os dados, códigos e documentação:</p><ul><li><a href="https://github.com/institutoazmina/ia-feminista-elas-no-congresso">Repositório de treinamento da QuitérIA</a></li><li><a href="https://github.com/institutoazmina/elasnocongressobot">Código do raspador</a></li><li><a href="https://api.elasnocongresso.com.br/api/v1/docs">API pública</a></li><li><a href="https://github.com/institutoazmina/elasnocongressobot/blob/master/README.md">Documentação</a></li><li><a href="https://github.com/institutoazmina/elasnocongressobot/blob/master/LICENSE.txt">Licença de uso</a></li></ul></div></section>
</main><RedesignFooter /></div></body></html>
