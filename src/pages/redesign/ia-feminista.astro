@font-face{font-family:"ETC Anybody";font-style:normal;font-weight:50 1000;font-display:swap;src:url("/assets/fonts/ETCAnybodyVariable.woff2") format("woff2-variations")}body:has(.ia-page){margin:0}.ia-page{color:#0b0f5e;font-family:"Plus Jakarta Sans",sans-serif}.ia-page *{box-sizing:border-box}.ia-page p{margin:0;font-size:18px;line-height:29.7px}.ia-page h1,.ia-page h2,.ia-page h3,.ia-page h4{font-family:"ETC Anybody",sans-serif;font-weight:700;font-variation-settings:"wdth" 75;text-transform:uppercase}.ia-hero{display:flex;align-items:center;justify-content:space-between;min-height:452px;padding:24px 48px}.ia-hero>div:first-child{width:681px}.ia-page i{display:block;width:96px;height:4px;background:#0b0f5e;margin-bottom:16px}.ia-hero i{height:8px;margin-bottom:24px}.ia-hero h1{font-size:72px;line-height:72px;margin:0 0 24px}.ia-hero h1 strong{font-variation-settings:"wdth" 75}.ia-hero h1{font-variation-settings:"wdth" 60}.ia-hero p{font-weight:700;line-height:24px;width:640px}.ia-hero-art{display:flex;align-items:center;justify-content:center;width:580px;height:380px;background-image:var(--ia-hero-pattern);background-size:cover;overflow:hidden}.ia-hero-art img{width:506px;height:487px;object-fit:contain}.ia-section{display:flex;flex-direction:column;gap:28px;padding:64px 48px}.ia-section--border{border-top:2px solid rgba(66,66,246,.06);padding-top:66px}.ia-section header,.ia-narrow{width:820px;margin:auto}.ia-section h2{font-size:36px;line-height:42px;margin:0}.ia-narrow{display:flex;flex-direction:column;gap:19.2px}.ia-narrow h3,.ia-wide h3{font-size:32px;line-height:32px;margin:12px 0 4px}.ia-cards{display:flex;gap:24px;padding-top:4px}.ia-cards article{border:2px solid #0b0f5e;flex:1;min-height:255px;padding:30px 26px;display:flex;flex-direction:column}.ia-cards h4{font-size:24px;line-height:32px;margin:0}.ia-cards p{font-size:16px;line-height:24px;margin-top:14px}.ia-cards b{font-family:"ETC Anybody";font-variation-settings:"wdth" 75;font-size:18px;line-height:24px;margin-top:auto;text-transform:uppercase}.ia-cards small{color:#998d96;font-size:14px;line-height:23.1px}.ia-wide{width:1344px;margin:auto}.ia-wide h3{font-size:28px;margin:0 0 24px}table{border-collapse:collapse;width:100%;font-size:16px;line-height:24.8px}th,td{border-bottom:1px solid rgba(66,66,246,.25);padding:16px 20px;text-align:left;vertical-align:top}thead th{border-bottom:2px solid #0b0f5e;font-family:"ETC Anybody";font-weight:300;text-transform:uppercase}tbody th{font-weight:700;width:30.3%}tbody tr:nth-child(even){background:rgba(66,66,246,.06)}td.pending{color:#998d96;font-style:italic}.ia-narrow h5{font-size:18px;line-height:29.7px;margin:0 0 4px}.metrics{margin:14px 0 18px}.metrics th,.metrics td{text-align:center;padding:12px 16px}.metrics th:first-child,.metrics td:first-child{text-align:left}.placeholder{align-items:center;border:2px dashed rgba(66,66,246,.25);display:flex;height:281px;justify-content:center;margin:auto;width:1344px;color:#998d96;font-family:"ETC Anybody";font-size:18px;font-weight:300;letter-spacing:.9px;text-transform:uppercase}.ia-narrow ul{list-style:none;margin:4px 0 0;padding:0;display:flex;flex-direction:column;gap:15px}.ia-narrow li{padding-left:24px;position:relative}.ia-narrow li:before{content:"→";position:absolute;left:0}.ia-narrow a{color:#4242f6;font-weight:700;text-decoration:none}.ia-narrow p a{text-decoration:underline}@media(max-width:900px){.ia-hero{flex-direction:column;align-items:flex-start;padding:48px 24px}.ia-hero>div:first-child,.ia-hero p,.ia-section header,.ia-narrow,.ia-wide,.placeholder{width:100%}.ia-hero h1{font-size:52px;line-height:56px}.ia-hero-art{width:100%;margin-top:24px}.ia-section{padding:48px 24px}.ia-section h2{font-size:32px;line-height:36px}.ia-wide{overflow:auto}.ia-wide table{min-width:820px}.placeholder{padding:24px;text-align:center}.ia-cards{flex-direction:column}}@media(max-width:560px){.ia-hero h1{font-size:40px;line-height:44px}.ia-hero-art{height:300px}.ia-hero-art img{width:100%;height:auto}.ia-page p{font-size:16px;line-height:25px}.ia-section h2{font-size:28px;line-height:32px}}
.ia-hero{align-items:flex-start;display:flex;flex-direction:column;height:452px;justify-content:center;padding:0}.ia-hero__top-row{align-items:center;display:flex;flex:0 0 428px;height:428px;justify-content:space-between;padding:24px 48px;width:100%;z-index:auto}.ia-hero__shadow{bottom:auto;flex:0 0 24px;height:24px;left:auto;position:relative;width:100%;z-index:auto}.ia-hero__art{align-items:center;display:flex;flex:0 0 auto;height:380px;justify-content:center;padding:10px;position:relative;width:580px}.ia-hero__illustration{height:487px;overflow:hidden;position:relative;width:506px}.ia-hero__illustration-inner{height:576.881px;left:calc(50% - 15.56px);position:absolute;top:calc(50% - 38.44px);transform:translate(-50%,-50%);width:351.877px}.ia-hero__illustration-inner>img{height:104.39%;left:-16.01%;max-width:none;position:absolute;top:-1.63%;width:136.91%}@media(max-width:900px){.ia-hero{height:610px}.ia-hero__top-row{flex-basis:586px;height:586px;width:100%}.ia-hero__shadow{flex-basis:24px}}
.ia-hero {
    height: 500px;
    overflow: hidden;
    position: relative;
    justify-content: flex-start;
}

.ia-hero__top-row {
    align-items: center;
    flex: 0 0 476px;
    height: 476px;
    padding: 48px;
    position: relative;
    width: 100%;
    z-index: 2;
}

.ia-hero > div.ia-hero__top-row {
    width: 100%;
}

.ia-hero__copy {
    align-items: flex-start;
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    gap: 24px;
    justify-content: center;
    max-width: 960px;
    min-width: 0;
    width: 681px;
}

.ia-hero__attention {
    display: block;
    height: 8px;
    width: 96px;
}

.ia-hero h1 {
    color: #0b0f5e;
    font-size: 72px;
    font-variation-settings: "wdth" 75;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 72px;
    margin: 0;
    mix-blend-mode: multiply;
    white-space: nowrap;
    width: 681px;
}

.ia-hero .hero__title-narrow {
    font-variation-settings: "wdth" 60;
    font-weight: 400;
}

.ia-hero h1 strong {
    font-variation-settings: "wdth" 75;
}

.ia-hero__copy > p {
    color: #0b0f5e;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 18px;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 24px;
    margin: 0;
    mix-blend-mode: multiply;
    width: 640px;
}

.ia-hero__art {
    bottom: 24px;
    flex: 0 0 auto;
    overflow: visible;
    position: absolute;
    right: 48px;
}

.ia-hero__shadow {
    background-image: var(--ia-hero-halftone-shadow);
    background-position: left bottom;
    background-repeat: repeat-x;
    background-size: 1440px 24px;
    bottom: 0;
    display: block;
    height: 24px;
    left: 0;
    mix-blend-mode: multiply;
    pointer-events: none;
    position: absolute;
    width: 100%;
    z-index: 3;
}

@media (max-width: 900px) {
    .ia-hero__copy,
    .ia-hero h1,
    .ia-hero__copy > p {
        width: 100%;
    }

    .ia-hero h1 {
        white-space: normal;
    }
}
/* Figma: IA Feminista — ajustes localizados */
