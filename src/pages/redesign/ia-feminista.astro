.ia-governance .ia-cards article>p{font-size:16px;line-height:26.4px;margin:0;padding-top:2.085px}
.ia-governance .ia-cards article:nth-child(2)>p{padding-bottom:.67px;padding-top:2.28px}
.ia-governance .ia-cards article>small{font-size:14px;font-weight:400;letter-spacing:0;line-height:23.1px;margin-top:0}
