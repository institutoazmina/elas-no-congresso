.ia-not-do__title{align-items:flex-start;display:flex;font-size:28px!important;line-height:32px!important;margin:0!important;padding-top:24.2px!important;white-space:nowrap}
.ia-not-do__title span{background:linear-gradient(104.044deg,rgba(255,88,101,.25) 0%,rgba(255,88,101,.5) 30%,rgba(255,88,101,.5) 70%,rgba(255,88,101,.25) 100%);font-family:"ETC Anybody",sans-serif;font-size:24px;font-weight:300;font-variation-settings:"wdth" 100;line-height:28px;margin-left:0;padding:.5px 8px;text-transform:uppercase}
