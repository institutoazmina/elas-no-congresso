---
import activityData from "../../../data/dados.json";
import {
    authorSlug,
    buildAuthorActivity,
    getActivityAuthorIds,
    type ActivityData,
} from "../../../lib/author-page";

// Compatibilidade: /propostas-e-votacoes/autoria/[slug] →
/// /atividade-legislativa/autoria/[slug], preservando o slug.
export function getStaticPaths() {
    const data = activityData as unknown as ActivityData;
    return getActivityAuthorIds(data)
        .map((id) => {
            const activity = buildAuthorActivity(data, id);
            const slug = authorSlug(activity?.author.nome);
            if (!slug) throw new Error(`Parlamentar ${id} não possui nome válido para slug público.`);
            return { params: { slug } };
        });
}

const { slug } = Astro.params;
return Astro.redirect(`/atividade-legislativa/autoria/${slug}`, 301);
---
