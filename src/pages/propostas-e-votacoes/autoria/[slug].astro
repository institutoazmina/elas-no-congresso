---
import { authorSlug } from "../../../lib/author-page";
import { fetchActivity } from "../../../lib/activity-api";
import { API_BASE_URL } from "astro:env/server";

// Compatibilidade: /propostas-e-votacoes/autoria/[slug] →
/// /atividade-legislativa/autoria/[slug], preservando o slug.
export async function getStaticPaths() {
    const paths = new Map<string, { params: { slug: string } }>();
    for (const proposition of await fetchActivity(API_BASE_URL)) {
        for (const author of proposition.authors) {
            if (author.id === null) continue;
            const slug = authorSlug(author.name);
            if (slug && !paths.has(slug)) paths.set(slug, { params: { slug } });
        }
    }
    return [...paths.values()];
}

const { slug } = Astro.params;
return Astro.redirect(`/atividade-legislativa/autoria/${slug}`, 301);
---
