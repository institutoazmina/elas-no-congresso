---
import { ClientRouter } from "astro:transitions";
import RedesignHeader from "../components/redesign/RedesignHeader.astro";
import ActivityHero from "../components/redesign/ActivityHero.astro";
import ActivityExplorer from "../components/redesign/ActivityExplorer.astro";
import RedesignFooter from "../components/redesign/RedesignFooter.astro";
import "../styles/tailwind.css";
import "../styles/redesign-shared-background.css";
---

<!doctype html>
<html lang="pt-BR">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="Explore proposições sensíveis a gênero, avaliações e movimentações do Congresso Nacional." />
        <title>Atividade Legislativa | Elas no Congresso</title>
        <link rel="preload" href="/assets/fonts/ETCAnybodyVariable.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;700&display=swap" rel="stylesheet" />
        <ClientRouter fallback="swap" />
    </head>
    <body class="tw:!m-0 tw:!bg-white tw:!pt-0">
        <div class="activity-page redesign-shared-background">
            <RedesignHeader />
            <main>
                <ActivityHero />
                <ActivityExplorer />
            </main>
            <RedesignFooter />
        </div>
    </body>
</html>

<style is:global>
    @font-face {
        font-family: "ETC Anybody";
        font-style: normal;
        font-weight: 50 1000;
        font-display: swap;
        src: url("/assets/fonts/ETCAnybodyVariable.woff2") format("woff2-variations");
    }
    html { scroll-behavior: smooth; }
    body:has(.activity-page) { margin: 0; background: #fff; }
    .activity-page { min-width: 320px; overflow-x: clip; }
    .redesign-header, .redesign-header * { box-sizing: border-box; }
    .redesign-header .container-fluid { width: 100%; }
    .redesign-header .wrap { max-width: 1310px; }
    .redesign-header .ff1 { font-family: "ETC Anybody", sans-serif; }
    .activity-page > .redesign-shared-background { background: transparent; }
    /* Contém a textura no hero: o wrapper da página fica branco puro e o
       hero (que mantém a própria classe redesign-shared-background + faixa
       halftone interna com overflow hidden) continua sendo o único dono da textura. */
    .activity-page.redesign-shared-background { background-image: none; background-color: #fff; }
    .activity-page main { position: relative; background-color: #fff; }
    .activity-page .activity-hero { isolation: isolate; }
</style>
