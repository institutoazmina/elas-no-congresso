<script is:inline data-astro-rerun>
    (() => {
        const page = document.querySelector(".sobre-page");
        if (!page) return;

        if (document.fonts) {
            void Promise.all([
                document.fonts.load('400 72px "ETC Anybody"'),
                document.fonts.load('700 72px "ETC Anybody"'),
            ]);
        }
        const wrapMobileOverflow = (element, className, label) => {
            if (
                !element ||
                element.parentElement?.classList.contains(className)
            )
                return;
            const wrapper = document.createElement("div");
            wrapper.className = className;
            wrapper.tabIndex = 0;
            wrapper.setAttribute("aria-label", label);
            element.before(wrapper);
            wrapper.append(element);
        };
        wrapMobileOverflow(
            page.querySelector(".sobre-history .timeline"),
            "timeline-scroll",
            "Linha do tempo do projeto. Role horizontalmente para ver todos os períodos.",
        );
        const channels = page.querySelector(
            ".sobre-history + .sobre-section .channels",
        );
        if (channels)
            channels.innerHTML =
                '<article class="channel-card channel-card--daily"><h3>Radar Diário</h3><p>Alerta customizável por tema, casa legislativa, comissão ou proposição, entregue por e-mail.<br><a href="/alertas">Cadastre-se aqui</a></p></article><article class="channel-card channel-card--newsletter"><h3>Newsletter com Radar Semanal</h3><p>Principal canal de acompanhamento contínuo do projeto. Reúne, contextualiza e analisa os impactos políticos das tramitações, funcionando como instrumento de transparência e mobilização para a sociedade civil. A newsletter é a mesma para todas as pessoas assinantes; o Radar Semanal que a acompanha é customizável por tema.</p></article><article class="channel-card channel-card--activity"><h3>Painel de Atividade Legislativa</h3><p>Na página <a href="/atividade-legislativa">Atividade Legislativa</a> você navega pelas propostas, compara a avaliação da <strong>QuitérIA</strong> com a avaliação humana e filtra por partido, tema e outros critérios.</p></article>';
        wrapMobileOverflow(
            channels,
            "channels-scroll",
            "Canais do Elas no Congresso. Role horizontalmente para ver todos os canais.",
        );
        const flowPlaceholder = page.querySelector(".flow-placeholder");
        if (
            flowPlaceholder &&
            !flowPlaceholder.querySelector(".flow-placeholder__mobile")
        ) {
            const mobileFlow = document.createElement("div");
            mobileFlow.className = "flow-placeholder__mobile";
            mobileFlow.setAttribute("aria-hidden", "true");
            mobileFlow.innerHTML =
                '<span class="flow-api">API</span><span class="flow-note flow-note--1">transexual<br>meninas</span><span class="flow-note flow-note--2">feminicídio</span><span class="flow-note flow-note--3">útero</span><span class="flow-note flow-note--4">misoginia<br>stalking</span>';
            flowPlaceholder.append(mobileFlow);
        }
        const partnerSection = page.querySelector(
            ".sobre-history + .sobre-section + .sobre-section",
        );
        if (partnerSection) {
            partnerSection.classList.add("partner-section");
            const partnerNarrow = partnerSection.querySelector(".sobre-narrow");
            const partnerHeader = partnerNarrow?.querySelector("header");
            const partnerLogos = partnerSection.querySelector(".partner-logos");
            if (partnerHeader && partnerNarrow)
                partnerSection.insertBefore(partnerHeader, partnerNarrow);
            const partnerIntro = partnerNarrow?.querySelector("p:last-child");
            if (partnerIntro && !partnerIntro.querySelector("strong"))
                partnerIntro.innerHTML = partnerIntro.innerHTML.replace(
                    "Fazem parte da rede:",
                    "<strong>Fazem parte da rede:</strong>",
                );
            if (
                partnerLogos &&
                !partnerLogos.parentElement?.classList.contains(
                    "partner-logos-wrap",
                )
            ) {
                const logosWrap = document.createElement("div");
                logosWrap.className = "partner-logos-wrap";
                partnerLogos.before(logosWrap);
                logosWrap.append(partnerLogos);
            }
            if (
                partnerLogos &&
                !partnerSection.querySelector(".partner-logos-layer")
            ) {
                const assets = [
                    ["frame8.png", 0, 25, 173, 90],
                    ["frame16.png", 455, 193, 162, 163],
                    ["frame19.png", 1137, 227, 150, 61],
                    ["frame10.png", 466, 0, 140, 141],
                    ["frame17.png", 686, 184, 149, 148],
                    ["frame13.png", 1123, 56, 173, 40],
                    ["frame11.png", 667, 7, 186, 125],
                    ["frame12.png", 909, 0, 152, 150],
                    ["frame15.png", 214, 221, 186, 71],
                    ["frame26.png", 3, 585, 168, 109],
                    ["frame22.png", 460, 411, 152, 81],
                    ["frame24.png", 907, 434, 156, 35],
                    ["frame27.png", 248, 568, 125, 125],
                    ["frame25.png", 1132, 423, 156, 52],
                    ["frame28.png", 454, 615, 165, 49],
                    ["tIyTvX.png", 235, 37, 154, 66],
                    ["q0Z1he.png", 952, 187, 66, 142],
                    ["vk8Ttm.png", 22, 413, 131, 77],
                    ["pFSdNq.png", 235, 394, 152, 114],
                    ["frame14.png", 5, 210, 165, 96],
                    ["frame23.svg", 673, 423, 175, 58],
                    ["rectangle.png", 676.252, 434.197, 168.485, 35.599],
                ];
                const layer = document.createElement("div");
                layer.className = "partner-logos-layer";
                assets.forEach(([file, left, top, width, height]) => {
                    const logo = document.createElement("img");
                    logo.alt = "";
                    logo.src = `/assets/images/redesign/sobre/partners/${file}`;
                    Object.assign(logo.style, {
                        height: `${height}px`,
                        left: `${left}px`,
                        position: "absolute",
                        top: `${top}px`,
                        width: `${width}px`,
                    });
                    layer.append(logo);
                });
                partnerLogos.replaceWith(layer);
            }
        }
    })();
