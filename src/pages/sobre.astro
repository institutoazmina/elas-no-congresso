---
import PageLayout from "../layouts/PageLayout.astro";
import PageHero from "../components/shared/PageHero.astro";
import HistoryTimeline from "../components/about/HistoryTimeline.astro";
import PartnerLogos from "../components/about/PartnerLogos.astro";
import Team from "../components/about/Team.astro";
import keywordNotes from "../assets/images/about/keyword-notes.png";
import {
    renderMarkdown,
    splitMarkdownComponents,
    splitMarkdownSections,
} from "../lib/markdown";
import { getAboutPage } from "../service/api/cms";

const page = await getAboutPage();
const content = page.content.replace("/images/about/keyword-notes.svg", keywordNotes.src);
const sections = splitMarkdownSections(content).map((source) => ({
    parts: splitMarkdownComponents(source),
    partners: source.includes("::: logo grid :::"),
}));
---

<PageLayout
    title={page.seo_title}
    description={page.seo_description}
    fontVariant="editorial"
    htmlClass="tw:max-w-full tw:overflow-x-clip"
    bodyClass="tw:max-w-full tw:overflow-x-clip"
    pageClass="sobre-page tw:text-ink tw:font-sans"
>
    <main class="markdown-page markdown-page--about">
        <PageHero content={page.hero} />

        {sections.map((section, index) => (
            <section class:list={[
                "markdown-section",
                {
                    "markdown-section--tinted": index % 2 === 1,
                    "markdown-section--partners": section.partners,
                },
            ]}>
                {section.parts.map((part) => part.type === "logo-grid" ? (
                    <PartnerLogos partners={page.partners} />
                ) : part.type === "timeline" ? (
                    <HistoryTimeline source={part.content} />
                ) : part.type === "team" ? (
                    <Team groups={page.team} />
                ) : (
                    <div class="markdown-content" set:html={renderMarkdown(part.content)} />
                ))}
            </section>
        ))}
    </main>
</PageLayout>
