                                        <td class="tw:text-right">0,84</td>
                                        <td class="tw:text-right">0,86</td>
                                        <td class="tw:text-right">19</td>
                                    </tr>
                                    <tr>
                                        <th>Direitos Sociais</th>
                                        <td class="tw:text-right">0,61</td>
                                        <td class="tw:text-right">0,58</td>
                                        <td class="tw:text-right">0,59</td>
                                        <td class="tw:text-right">19</td>
                                    </tr>
                                    <tr>
                                        <th>Economia</th>
                                        <td class="tw:text-right">0,78</td>
                                        <td class="tw:text-right">0,50</td>
                                        <td class="tw:text-right">0,61</td>
                                        <td class="tw:text-right">14</td>
                                    </tr>
                                    <tr>
                                        <th>Feminicídio</th>
                                        <td class="tw:text-right">0,67</td>
                                        <td class="tw:text-right">0,80</td>
                                        <td class="tw:text-right">0,73</td>
                                        <td class="tw:text-right">5</td>
                                    </tr>
                                    <tr>
                                        <th>Gênero</th>
                                        <td class="tw:text-right">0,81</td>
                                        <td class="tw:text-right">1,00</td>
                                        <td class="tw:text-right">0,90</td>
                                        <td class="tw:text-right">13</td>
                                    </tr>
                                    <tr>
                                        <th>Maternidade</th>
                                        <td class="tw:text-right">0,70</td>
                                        <td class="tw:text-right">0,74</td>
                                        <td class="tw:text-right">0,72</td>
                                        <td class="tw:text-right">19</td>
                                    </tr>
                                    <tr>
                                        <th>Politica</th>
                                        <td class="tw:text-right">1,00</td>
                                        <td class="tw:text-right">0,88</td>
                                        <td class="tw:text-right">0,93</td>
                                        <td class="tw:text-right">8</td>
                                    </tr>
                                    <tr>
                                        <th>Violência Contra a Mulher</th>
                                        <td class="tw:text-right">0,86</td>
                                        <td class="tw:text-right">0,93</td>
                                        <td class="tw:text-right">0,89</td>
                                        <td class="tw:text-right">54</td>
                                    </tr>
                                    <tr>
                                        <th>Acurácia</th>
                                        <td class="tw:text-right"></td>
                                        <td class="tw:text-right"></td>
                                        <td class="tw:text-right">0,82</td>
                                        <td class="tw:text-right">168</td>
                                    </tr>
                                    <tr>
                                        <th>Média macro</th>
                                        <td class="tw:text-right">0,81</td>
                                        <td class="tw:text-right">0,79</td>
                                        <td class="tw:text-right">0,79</td>
                                        <td class="tw:text-right">168</td>
                                    </tr>
                                    <tr>
                                        <th>Média ponderada</th>
                                        <td class="tw:text-right">0,82</td>
                                        <td class="tw:text-right">0,82</td>
                                        <td class="tw:text-right">0,81</td>
                                        <td class="tw:text-right">168</td>
                                    </tr>
                                </tbody>
                            </table></div>
                        </div>
                    </article>

                    <article id="codigo-fonte-da-quiteria">
                        <h3 class="tw:font-display tw:text-[clamp(28.8px,calc(1.8rem_+_7.2*(100vw_-_500px)/700),36px)] tw:leading-[1.5] tw:uppercase tw:break-normal tw:text-periwinkle tw:mb-4">
                            <span class="tw:font-black tw:[font-variation-settings:'wdth'_200]">Código-<span class="tw:[font-variation-settings:'wdth'_150]">fonte</span></span>
                            <span class="tw:font-semibold tw:[font-variation-settings:'wdth'_100]">da</span>
                            <span class="tw:font-black tw:[font-variation-settings:'wdth'_350] tw:block">QuitérIA</span>
                        </h3>
                        <ul>
                            <li>
                                <b>Explore a ferramenta</b>: Acesse o <a href="https://drive.google.com/drive/u/0/folders/1UIki2K7NVX4yBSNm6uBHTqgkbqnjvnw9">painel da QuitérIA</a> para visualizar os dados dos projetos de lei e obter análises automatizadas.
                            </li>
                            <li>
                                <b>Contribua com o código</b>: O código-fonte da QuitérIA está <a href="https://github.com/institutoazmina/ia-feminista-elas-no-congresso">disponível no GitHub</a>, permitindo que você participe do aprimoramento da ferramenta.
                            </li>
                        </ul>
                    </article>
