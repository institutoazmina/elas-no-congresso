---
import RedesignHeader from "../components/redesign/RedesignHeader.astro";
import Hero from "../components/redesign/Hero.astro";
import RightsUnderAttack from "../components/redesign/RightsUnderAttack.astro";
import LegislativeSetbacks from "../components/redesign/LegislativeSetbacks.astro";
import WomenInDefense from "../components/redesign/WomenInDefense.astro";
import PartyRightsChart from "../components/redesign/PartyRightsChart.astro";
import UfProjectsChart from "../components/redesign/UfProjectsChart.astro";
import HomeAlerts from "../components/redesign/HomeAlerts.astro";
import FastMovingProposals from "../components/redesign/FastMovingProposals.astro";
import SlowMovingProposals from "../components/redesign/SlowMovingProposals.astro";
import EnactedProjects from "../components/redesign/EnactedProjects.astro";
import ExploreCongress from "../components/redesign/ExploreCongress.astro";
import ParliamentariansCarousel from "../components/redesign/ParliamentariansCarousel.astro";
import QuiteriaAndFunders from "../components/redesign/QuiteriaAndFunders.astro";
import RedesignFooter from "../components/redesign/RedesignFooter.astro";
import HomeReportagens from "../components/redesign/HomeReportagens.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/tailwind.css";
import "../styles/redesign-shared-background.css";
---

<!doctype html>
<html lang="pt-BR">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Redesign | Elas no Congresso</title>
        <link
            rel="preload"
            href="/assets/fonts/ETCAnybodyVariable.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;700&display=swap"
            rel="stylesheet"
        />
        <ClientRouter fallback="swap" />
    </head>
    <body class="tw:!pt-0 tw:!bg-white">
        <div class="redesign-home-background redesign-shared-background">
            <RedesignHeader />
            <Hero />
            <RightsUnderAttack />
            <LegislativeSetbacks />
            <HomeReportagens />
            <WomenInDefense />
            <PartyRightsChart />
            <UfProjectsChart />
            <HomeAlerts />
            <FastMovingProposals />
            <SlowMovingProposals />
            <EnactedProjects />
            <ExploreCongress />
            <ParliamentariansCarousel />
            <QuiteriaAndFunders />
            <RedesignFooter />
        </div>
    </body>
</html>

<style is:global>
    @media (prefers-reduced-motion: no-preference) {
        html {
            scroll-behavior: smooth;
        }
    }

    @font-face {
        font-family: "ETC Anybody";
        font-style: normal;
        font-weight: 50 1000;
        font-display: swap;
        src: url("/assets/fonts/ETCAnybodyVariable.woff2") format("woff2-variations");
    }

    .redesign-header,
    .redesign-header * {
        box-sizing: border-box;
    }

    body:has(.redesign-header) {
        margin: 0;
    }

    .redesign-header .container-fluid {
        width: 100%;
    }

    .redesign-header .wrap {
        max-width: 1310px;
    }

    .redesign-header .ff1 {
        font-family: "ETC Anybody", sans-serif;
    }

    .redesign-home-background > .redesign-shared-background {
        background: transparent;
    }

</style>
