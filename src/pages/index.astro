---
import PageLayout from "../layouts/PageLayout.astro";
import Hero from "../components/home/Hero.astro";
import RightsUnderAttack from "../components/charts/RightsUnderAttack.astro";
import LegislativeSetbacks from "../components/charts/LegislativeSetbacks.astro";
import WomenInDefense from "../components/charts/WomenInDefense.astro";
import PartyRightsChart from "../components/charts/PartyRightsChart.astro";
import UfProjectsChart from "../components/charts/UfProjectsChart.astro";
import HomeAlerts from "../components/home/HomeAlerts.astro";
import FastMovingProposals from "../components/home/FastMovingProposals.astro";
import SlowMovingProposals from "../components/home/SlowMovingProposals.astro";
import EnactedProjects from "../components/home/EnactedProjects.astro";
import ExploreCongress from "../components/home/ExploreCongress.astro";
import ParliamentariansCarousel from "../components/home/ParliamentariansCarousel.astro";
import QuiteriaAndFunders from "../components/home/QuiteriaAndFunders.astro";
import HomeNews from "../components/home/HomeNews.astro";
import { getHomePage } from "../service/api/cms";

const home = await getHomePage();
---

<PageLayout title={home.content.seo_title}
    description={home.content.seo_description}
    htmlClass="tw:motion-safe:[scroll-behavior:smooth]"
    pageClass="site-home-background site-shared-background tw:[.site-home-background_>_&]:bg-transparent tw:bg-white tw:bg-[url('/src/assets/images/background/bg-pattern-rough-paper.png')] tw:bg-top tw:bg-repeat tw:bg-size-[400px_400px]"
>
            <Hero content={home.content} image={home.images.hero} />
            <RightsUnderAttack content={home.content} />
            <LegislativeSetbacks content={home.content} />
            <HomeNews content={home.content} />
            <WomenInDefense content={home.content} />
            <PartyRightsChart content={home.content} />
            <UfProjectsChart content={home.content} />
            <HomeAlerts content={home.content} />
            <FastMovingProposals content={home.content} />
            <SlowMovingProposals content={home.content} />
            <EnactedProjects content={home.content} />
            <ExploreCongress content={home.content} image={home.images.explore} />
            <ParliamentariansCarousel content={home.content} />
            <QuiteriaAndFunders content={home.content} image={home.images.quiteria} />
</PageLayout>
