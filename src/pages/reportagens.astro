---
import PageLayout from "../layouts/PageLayout.astro";
import PageHero from "../components/shared/PageHero.astro";
import CuttingMat from "../components/shared/CuttingMat.astro";
import ReportsList from "../components/home/ReportsList";
import RecentReports from "../components/home/RecentReports";
import { getPageHero } from "../service/api/cms";

const hero = await getPageHero("reports");
---

<PageLayout
    title={hero.seo_title}
    description={hero.seo_description}
>
    <main class="tw:text-ink">
        <PageHero content={hero} />
        <CuttingMat
            class="tw:relative tw:py-16 tw:before:absolute tw:before:inset-x-0 tw:before:top-0 tw:before:h-3 tw:before:bg-linear-to-b tw:before:from-accent/25 tw:before:to-transparent tw:before:content-[''] tw:md:min-h-162 tw:md:pt-24 tw:md:pb-26.5"
            aria-labelledby="recent-news-title"
        >
            <h2
                id="recent-news-title"
                class="tw:px-6 tw:font-display tw:text-[32px] tw:leading-8 tw:font-bold tw:uppercase tw:[font-variation-settings:'wdth'_75] tw:md:text-center"
            >
                Reportagens mais recentes
            </h2>
            <RecentReports client:load />
        </CuttingMat>
        <ReportsList client:load />
    </main>
</PageLayout>
