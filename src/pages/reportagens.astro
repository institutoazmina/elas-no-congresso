                    {recentPosts.length > 0 ? (
                        <div
                            class="reportagens-recent__scroll tw:max-[901px]:pl-6 tw:max-[901px]:pr-6 tw:flex tw:gap-12 tw:justify-center tw:overflow-x-auto tw:[scroll-snap-type:x_mandatory] tw:w-full tw:pt-0 tw:pb-4 tw:px-12 tw:mt-12 tw:mb-0 tw:mx-auto tw:max-[561px]:block tw:max-[561px]:overflow-x-auto tw:max-[561px]:overflow-y-hidden tw:max-[561px]:relative tw:max-[561px]:[scroll-snap-type:none] tw:max-[561px]:[scrollbar-width:thin] tw:max-[561px]:w-full tw:max-[561px]:z-2 tw:max-[561px]:pt-0 tw:max-[561px]:pb-4 tw:max-[561px]:px-0 tw:max-[561px]:mt-14.5 tw:max-[561px]:mb-0 tw:max-[561px]:mx-0"
                            tabindex="0"
                            aria-label="Lista de reportagens mais recentes"
                        >
                            <div class="reportagens-recent__track tw:flex tw:flex-none tw:gap-12 tw:max-[561px]:gap-12 tw:max-[561px]:w-max tw:max-[561px]:py-0 tw:max-[561px]:px-6">
                                {recentPosts.map((post) => (
                                    <ReportagemCard post={post} dark />
                                ))}
                            </div>
                        </div>
                    ) : (
                        <p class="reportagens-feedback tw:text-white tw:text-base tw:leading-6 tw:relative tw:z-2 tw:mt-12 tw:mb-0 tw:mx-6" role="status">
                            N&atilde;o foi poss&iacute;vel carregar as
                            reportagens mais recentes.
                        </p>
                    )}
                </section>
                <section
                    class="reportagens-all tw:[&_h2]:items-start tw:[&_h2]:flex tw:[&_h2]:font-display tw:[&_h2]:text-[32px] tw:[&_h2]:font-bold tw:[&_h2]:[font-variation-settings:'wdth'_75] tw:[&_h2]:leading-[42px] tw:[&_h2]:max-w-full tw:[&_h2]:uppercase tw:[&_h2]:w-205 tw:[&_h2]:mt-0 tw:[&_h2]:mb-12 tw:[&_h2]:mx-0 tw:max-[901px]:[&_h2]:mb-10 tw:[--reportagens-all-inline-padding:48px] tw:p-[72px_var(--reportagens-all-inline-padding)_0] tw:max-[901px]:[--reportagens-all-inline-padding:24px] tw:max-[901px]:p-[64px_var(--reportagens-all-inline-padding)_0] tw:max-[561px]:[--reportagens-all-inline-padding:24px] tw:max-[561px]:pt-18 tw:max-[561px]:pb-[85px] tw:max-[561px]:pr-[23px] tw:max-[561px]:pl-6"
                    aria-labelledby="todas-reportagens-title"
                    data-reportagens-pagination
                    data-pagination-endpoint={WP_REPORTAGENS_ENDPOINT}
                    data-pagination-total-pages={allPostsTotalPages}
                >
                    <div class="reportagens-all__content tw:max-w-336 tw:w-full tw:my-0 tw:mx-auto">
                        <h2 class="tw:max-[561px]:leading-8 tw:max-[561px]:mb-12 tw:max-[561px]:min-h-10.5 tw:max-[561px]:[text-box-edge:cap_alphabetic] tw:max-[561px]:[text-box-trim:trim-both] tw:max-[561px]:w-full" id="todas-reportagens-title">
                            <span class="tw:flex-[0_0_292px] tw:text-center tw:max-[561px]:basis-73 tw:max-[561px]:text-left tw:max-[561px]:leading-8">Todas as reportagens</span>
                        </h2>
                        {posts.length > 0 ? (
                            <div class={String.raw`reportagens-all__grid tw:mx-auto tw:flex tw:max-w-336 tw:flex-wrap tw:justify-between tw:gap-24 tw:[&>*]:min-w-0 tw:[&>*]:flex-none tw:[&>*]:w-[calc((100%_-_192px)/3)] tw:max-[901px]:gap-x-6 tw:max-[901px]:gap-y-16 tw:max-[901px]:[&>*]:w-[calc((100%_-_24px)/2)] tw:max-[901px]:[&_.reportagem-card]:w-full tw:max-[901px]:[&_.reportagem-card\_\_image]:w-full tw:max-[561px]:w-full tw:max-[561px]:max-w-none tw:max-[561px]:flex-col tw:max-[561px]:gap-24 tw:max-[561px]:[&>*]:w-full tw:max-[561px]:[&_.reportagem-card]:flex-none tw:max-[561px]:[&_.reportagem-card\_\_image]:aspect-[384/216] tw:max-[561px]:[&_.reportagem-card\_\_image]:h-auto tw:max-[561px]:[&_.reportagem-card_h3]:min-h-0`}>
                                {posts.map((post) => (
                                    <div class="tw:max-[561px]:w-full" data-reportagem-pagination-card>
                                        <ReportagemCard post={post} />
                                    </div>
                                ))}
                            </div>
                        ) : (
                            <p
                                class="reportagens-feedback reportagens-feedback--light tw:text-base tw:leading-6 tw:relative tw:z-2 tw:text-navy tw:my-12 tw:mx-0"
                                role="status"
                            >
                                N&atilde;o foi poss&iacute;vel carregar as
                                reportagens.
                            </p>
                        )}
                    </div>
                    {allPostsTotalPages > 1 && (
                        <div
                            class="reportagens-pagination-region tw:h-[195px] tw:ml-[calc(var(--reportagens-all-inline-padding)_*_-1)] tw:mt-7.5 tw:overflow-hidden tw:relative tw:w-[calc(100%_+_(var(--reportagens-all-inline-padding)_*_2))] tw:max-[561px]:-ml-6 tw:max-[561px]:mt-[69.5px] tw:max-[561px]:w-[calc(100%_+_47px)] tw:before:bg-[image:var(--reportagens-hero-halftone-shadow)] tw:before:bg-top-left tw:before:bg-repeat-x tw:before:bg-size-[1440px_24px] tw:before:content-[''] tw:before:h-6 tw:before:left-0 tw:before:mix-blend-multiply tw:before:pointer-events-none tw:before:absolute tw:before:right-0 tw:before:top-7.5 tw:before:[transform:rotate(180deg)] tw:before:z-1 tw:max-[561px]:before:bg-[image:var(--reportagens-hero-halftone-shadow)] tw:max-[561px]:before:bg-top-left tw:max-[561px]:before:bg-repeat-x tw:max-[561px]:before:bg-size-[720px_12px] tw:max-[561px]:before:content-[''] tw:max-[561px]:before:h-3 tw:max-[561px]:before:left-0 tw:max-[561px]:before:mix-blend-multiply tw:max-[561px]:before:pointer-events-none tw:max-[561px]:before:absolute tw:max-[561px]:before:right-0 tw:max-[561px]:before:z-1 tw:max-[561px]:before:top-7.5 tw:max-[561px]:before:[transform:rotate(180deg)] tw:max-[561px]:after:bg-[image:var(--reportagens-hero-halftone-shadow)] tw:max-[561px]:after:bg-top-left tw:max-[561px]:after:bg-repeat-x tw:max-[561px]:after:bg-size-[720px_12px] tw:max-[561px]:after:content-[''] tw:max-[561px]:after:h-3 tw:max-[561px]:after:left-0 tw:max-[561px]:after:mix-blend-multiply tw:max-[561px]:after:pointer-events-none tw:max-[561px]:after:absolute tw:max-[561px]:after:right-0 tw:max-[561px]:after:z-1 tw:max-[561px]:after:bottom-[29px]"
                            style={`--reportagens-hero-halftone-shadow: url(${halftoneShadow})`}
                        >
                            <div
                                class="reportagens-pagination-region__texture site-shared-background tw:max-[561px]:bottom-[29px] tw:max-[561px]:top-7.5 tw:[background-position:center_-30px] tw:bottom-0 tw:left-0 tw:pointer-events-none tw:absolute tw:right-0 tw:top-7.5 tw:z-0 tw:bg-white tw:bg-[url('/assets/images/background/bg-pattern-rough-paper.png')] tw:bg-top tw:bg-repeat tw:bg-size-[400px_400px]"
                                aria-hidden="true"
                            ></div>
                            <nav
                                class="reportagens-pagination tw:items-start tw:flex tw:gap-1 tw:justify-center tw:left-0 tw:absolute tw:right-0 tw:top-19.5 tw:z-2 tw:m-0"
                                aria-label="Pagina&#231;&#227;o das reportagens"
                            >
                                <button
                                    class="reportagens-pagination__button tw:items-center tw:bg-white tw:border-[2px] tw:border-solid tw:border-accent tw:text-accent tw:cursor-pointer tw:flex tw:h-10 tw:justify-center tw:[transition:background-color_150ms_ease,_color_150ms_ease] tw:w-14 tw:py-2 tw:px-4 tw:[&>span]:items-center tw:[&>span]:flex tw:[&>span]:h-6 tw:[&>span]:justify-center tw:[&>span]:w-6 tw:[&_img]:block tw:[&_img]:h-4 tw:[&_img]:w-4 tw:focus-visible:bg-accent tw:focus-visible:outline-2 tw:focus-visible:outline-ink tw:focus-visible:outline-offset-0.5 tw:disabled:cursor-default tw:disabled:opacity-40 tw:[&:hover:not(:disabled)]:bg-accent tw:[&:hover:not(:disabled)]:outline-none tw:[&:hover:not(:disabled)_img]:[filter:brightness(0)_invert(1)] tw:[&:focus-visible_img]:[filter:brightness(0)_invert(1)]"
                                    type="button"
                                    data-pagination-previous
                                    aria-label="P&#225;gina anterior"
                                    disabled
                                >
                                    <span>
                                        <img
                                            src={paginationPrevious}
                                            alt=""
                                        />
                                    </span>
                                </button>
                                <button
                                    class="reportagens-pagination__button tw:items-center tw:bg-white tw:border-[2px] tw:border-solid tw:border-accent tw:text-accent tw:cursor-pointer tw:flex tw:h-10 tw:justify-center tw:[transition:background-color_150ms_ease,_color_150ms_ease] tw:w-14 tw:py-2 tw:px-4 tw:[&>span]:items-center tw:[&>span]:flex tw:[&>span]:h-6 tw:[&>span]:justify-center tw:[&>span]:w-6 tw:[&_img]:block tw:[&_img]:h-4 tw:[&_img]:w-4 tw:focus-visible:bg-accent tw:focus-visible:outline-2 tw:focus-visible:outline-ink tw:focus-visible:outline-offset-0.5 tw:disabled:cursor-default tw:disabled:opacity-40 tw:[&:hover:not(:disabled)]:bg-accent tw:[&:hover:not(:disabled)]:outline-none tw:[&:hover:not(:disabled)_img]:[filter:brightness(0)_invert(1)] tw:[&:focus-visible_img]:[filter:brightness(0)_invert(1)]"
                                    type="button"
                                    data-pagination-next
                                    aria-label="Pr&oacute;xima p&aacute;gina"
                                >
                                    <span>
                                        <img src={paginationNext} alt="" />
                                    </span>
                                </button>
                                <span
                                    class="reportagens-pagination__status tw:h-[1px] tw:overflow-hidden tw:absolute tw:w-[1px] tw:[clip:rect(0_0_0_0)] tw:m-[-1px]"
                                    aria-live="polite"
                                    data-pagination-status
                                >
                                    P&aacute;gina 1 de {allPostsTotalPages}
                                </span>
                            </nav>
                        </div>
                    )}
                </section>
            </main>
            <Footer />
        </div>
    </body>
</html>

<script>
    type ClientFeaturedMedia = {
        alt_text?: string;
        link?: string;
        source_url?: string;
        media_details?: { sizes?: Record<string, { source_url?: string }> };
    };
    type ClientPost = {
        modified?: string;
        link: string;
        title: { rendered: string };
        _embedded?: { "wp:featuredmedia"?: ClientFeaturedMedia[] };
    };
    type PaginationWindow = Window & {
        __reportagensPaginationAbortController?: AbortController;
    };

    const POSTS_PER_PAGE = 9;
    const RECENT_POST_COUNT = 3;
    const paginationWindow = window as PaginationWindow;

    function initialiseReportagensPagination() {
        const section = document.querySelector<HTMLElement>(
            "[data-reportagens-pagination]",
        );

        if (!section) {
            paginationWindow.__reportagensPaginationAbortController?.abort();
            paginationWindow.__reportagensPaginationAbortController = undefined;
            return;
        }

        if (section.dataset.paginationInitialised === "true") return;

        const cards = Array.from(
            section.querySelectorAll<HTMLElement>(
                "[data-reportagem-pagination-card]",
            ),
        );
        const grid = section.querySelector<HTMLElement>(
            ".reportagens-all__grid",
        );
        const previousButton = section.querySelector<HTMLButtonElement>(
            "[data-pagination-previous]",
        );
        const nextButton = section.querySelector<HTMLButtonElement>(
            "[data-pagination-next]",
        );
        const status = section.querySelector<HTMLElement>(
            "[data-pagination-status]",
        );
        const endpoint = section.dataset.paginationEndpoint;
        let totalPages = Number(section.dataset.paginationTotalPages ?? 0);
        let currentPage = 1;

        if (
            !grid ||
            !previousButton ||
            !nextButton ||
            !status ||
            !endpoint ||
            totalPages < 2
        )
            return;

        paginationWindow.__reportagensPaginationAbortController?.abort();
        const controller = new AbortController();
        paginationWindow.__reportagensPaginationAbortController = controller;
        section.dataset.paginationInitialised = "true";

        const decodeTitle = (html: string) => {
            const documentFragment = new DOMParser().parseFromString(
                html,
                "text/html",
            );
            return documentFragment.body.textContent?.trim() ?? "";
        };

        const resolveImage = (media?: ClientFeaturedMedia) => {
            const imagePath =
                media?.media_details?.sizes?.["az-article-thumbnail-large"]
                    ?.source_url ??
                media?.source_url ??
                media?.link;
            return imagePath ? new URL(imagePath, endpoint).href : undefined;
        };

        const updateCard = (card: HTMLElement, post?: ClientPost) => {
            card.hidden = !post;
            if (!post) return;

            const title = card.querySelector<HTMLElement>(
                "[data-reportagem-title]",
            );
            const imageLink = card.querySelector<HTMLAnchorElement>(
                ".reportagem-card__image",
            );
            const date = card.querySelector<HTMLTimeElement>(
                "[data-reportagem-date]",
            );
            const plainTitle = decodeTitle(post.title.rendered);
            const media = post._embedded?.["wp:featuredmedia"]?.[0];
            const imageSource = resolveImage(media);

            card.querySelectorAll<HTMLAnchorElement>(
                "[data-reportagem-link]",
            ).forEach((link) => {
                link.href = post.link;
                if (
                    link.classList.contains("reportagem-card__image") ||
                    link.classList.contains("reportagem-card__title-link")
                ) {
                    link.setAttribute("aria-label", `Ler: ${plainTitle}`);
                }
            });

            if (title) title.innerHTML = post.title.rendered;
            if (imageLink) {
                imageLink.setAttribute("aria-label", `Ler: ${plainTitle}`);
                let image = imageLink.querySelector<HTMLImageElement>(
                    "[data-reportagem-image]",
                );

                if (imageSource) {
                    if (!image) {
                        image = document.createElement("img");
                        image.dataset.reportagemImage = "";
                        image.loading = "lazy";
                        image.decoding = "async";
                        image.width = 384;
                        image.height = 216;
                        imageLink.append(image);
                    }
                    image.src = imageSource;
                    image.alt = media?.alt_text?.trim() || plainTitle;
                } else {
                    image?.remove();
                }
            }

            if (date) {
                if (post.modified) {
                    date.hidden = false;
                    date.dateTime = post.modified;
                    date.textContent = `Atualizada em ${new Intl.DateTimeFormat(
                        "pt-BR",
                        {
                            day: "numeric",
                            month: "long",
                            year: "numeric",
                            timeZone: "America/Sao_Paulo",
                        },
                    ).format(new Date(post.modified))}`;
                } else {
                    date.hidden = true;
                    date.removeAttribute("datetime");
                    date.textContent = "";
                }
            }
        };

        const renderState = () => {
            previousButton.disabled = currentPage === 1;
            nextButton.disabled = currentPage === totalPages;
            status.textContent = `P\u00e1gina ${currentPage} de ${totalPages}`;
        };

        const updateUrl = (page: number, mode: "push" | "replace" | "none") => {
            if (mode === "none") return;
            const url = new URL(window.location.href);
            if (page === 1) url.searchParams.delete("pagina");
            else url.searchParams.set("pagina", String(page));
            history[mode === "push" ? "pushState" : "replaceState"](
                {},
                "",
                url,
            );
        };

        const renderPage = async (
            page: number,
            historyMode: "push" | "replace" | "none" = "push",
        ) => {
            const requestedPage = Math.min(Math.max(page, 1), totalPages);
            if (requestedPage === currentPage) {
                updateUrl(currentPage, historyMode);
                renderState();
                return;
            }

            grid.setAttribute("aria-busy", "true");
            previousButton.disabled = true;
            nextButton.disabled = true;
            status.textContent = "Carregando reportagens.";

            try {
                const url = new URL(endpoint);
                url.searchParams.set("_embed", "wp:featuredmedia");
                url.searchParams.set("per_page", String(POSTS_PER_PAGE));
                url.searchParams.set(
                    "offset",
                    String(
                        RECENT_POST_COUNT +
                            (requestedPage - 1) * POSTS_PER_PAGE,
                    ),
                );
                url.searchParams.set("orderby", "date");
                url.searchParams.set("order", "desc");

                const response = await fetch(url, {
                    headers: { Accept: "application/json" },
                    signal: controller.signal,
                });
                if (!response.ok)
                    throw new Error(
                        `WordPress respondeu com ${response.status}`,
                    );

                const posts = (await response.json()) as ClientPost[];
                const responseTotal = Number(
                    response.headers.get("x-wp-total"),
                );
                if (responseTotal > 0)
                    totalPages = Math.ceil(
                        Math.max(responseTotal - RECENT_POST_COUNT, 0) /
                            POSTS_PER_PAGE,
                    );
                if (posts.length === 0)
                    throw new Error(
                        "A pagina solicitada nao possui reportagens.",
                    );

                cards.forEach((card, index) => updateCard(card, posts[index]));
                currentPage = Math.min(requestedPage, totalPages);
                section.dataset.paginationTotalPages = String(totalPages);
                updateUrl(currentPage, historyMode);
                renderState();
            } catch (error) {
                if ((error as Error).name !== "AbortError") {
                    status.textContent =
                        "N\u00e3o foi poss\u00edvel carregar esta p\u00e1gina. Tente novamente.";
                    renderState();
                }
            } finally {
                grid.removeAttribute("aria-busy");
            }
        };

        previousButton.addEventListener(
            "click",
            () => void renderPage(currentPage - 1),
            { signal: controller.signal },
        );
        nextButton.addEventListener(
            "click",
            () => void renderPage(currentPage + 1),
            { signal: controller.signal },
        );
        window.addEventListener(
            "popstate",
            () => {
                const requestedPage = Number(
                    new URL(window.location.href).searchParams.get("pagina") ??
                        1,
                );
                void renderPage(
                    Number.isFinite(requestedPage) ? requestedPage : 1,
                    "none",
                );
            },
            { signal: controller.signal },
        );

        renderState();
        const requestedPage = Number(
            new URL(window.location.href).searchParams.get("pagina") ?? 1,
        );
        if (Number.isFinite(requestedPage) && requestedPage > 1)
            void renderPage(requestedPage, "replace");
    }

    initialiseReportagensPagination();
    document.addEventListener(
        "astro:page-load",
        initialiseReportagensPagination,
    );
</script>
