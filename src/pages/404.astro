---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página não encontrada">
<main>
    <header class="tw:min-h-[50vh] tw:flex tw:items-center tw:justify-center tw:bg-[#1e2546] tw:text-white">
        <div class="tw:w-full tw:mx-auto tw:px-6 tw:max-w-[1310px] tw:text-center">
            <h1 class="tw:text-6xl tw:font-black tw:font-display tw:!mb-4">404</h1>
            <p class="tw:text-2xl tw:font-display tw:!mb-8">Página não encontrada</p>
            <a href="/" class="tw:inline-block tw:bg-white tw:text-[#1e2546] tw:px-6 tw:py-3 tw:rounded tw:font-bold tw:hover:bg-gray-100 tw:duration-150">
                Voltar para a home
            </a>
        </div>
    </header>
</main>
</BaseLayout>