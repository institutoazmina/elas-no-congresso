---
import PageLayout from "../layouts/PageLayout.astro";
import PageHero from "../components/shared/PageHero.astro";
import ActivityExplorer from "../components/activity/ActivityExplorer.astro";
import { getPageHero } from "../service/api/cms";

const hero = await getPageHero("activity");
---

<PageLayout
    title="Atividade Legislativa e pautas de gênero | Elas no Congresso"
    description="Explore dados sobre projetos de lei e pautas de gênero no Congresso Nacional em um dashboard interativo sobre atividade legislativa e direitos."
    htmlClass="tw:[scroll-behavior:smooth]"
    pageClass="tw:min-w-80 tw:overflow-x-clip"
>
    <main class="tw:relative tw:bg-white">
        <PageHero content={hero} />
        <ActivityExplorer />
    </main>
</PageLayout>
