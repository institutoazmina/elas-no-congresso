---
import PageLayout from "../layouts/PageLayout.astro";
import ActivityHero from "../components/activity/ActivityHero.astro";
import ActivityExplorer from "../components/activity/ActivityExplorer.astro";
---

<PageLayout title="Atividade Legislativa | Elas no Congresso" description="Explore proposições sensíveis a gênero, avaliações e movimentações do Congresso Nacional." htmlClass="tw:[scroll-behavior:smooth]"
    pageClass="activity-page site-shared-background tw:min-w-80 tw:overflow-x-clip tw:bg-none tw:bg-white tw:[&_.activity-hero]:isolate tw:bg-white tw:bg-[url('/assets/images/background/bg-pattern-rough-paper.png')] tw:bg-top tw:bg-repeat tw:bg-size-[400px_400px]"
>
            <main class="tw:relative tw:bg-white">
                <ActivityHero />
                <ActivityExplorer />
            </main>
</PageLayout>
