---
import { ClientRouter } from "astro:transitions";
import Header from "../components/layout/Header.astro";
import ActivityHero from "../components/activity/ActivityHero.astro";
import ActivityExplorer from "../components/activity/ActivityExplorer.astro";
import Footer from "../components/layout/Footer.astro";
import "../styles/tailwind.css";
---

<!doctype html>
<html class="tw:[scroll-behavior:smooth]" lang="pt-BR">
    <head>
        <link rel="icon" type="image/png" href="/assets/images/site-icon.png" />
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="Explore proposições sensíveis a gênero, avaliações e movimentações do Congresso Nacional." />
        <title>Atividade Legislativa | Elas no Congresso</title>
        <link rel="preload" href="/assets/fonts/ETCAnybodyVariable.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;700&display=swap" rel="stylesheet" />
        <ClientRouter fallback="swap" />
    </head>
    <body class="tw:!m-0 tw:!bg-white tw:!pt-0 tw:bg-white tw:m-0">
        <div class="activity-page site-shared-background tw:min-w-80 tw:overflow-x-clip tw:bg-none tw:bg-white tw:[&_.activity-hero]:isolate tw:bg-white tw:bg-[url('/assets/images/background/bg-pattern-rough-paper.png')] tw:bg-top tw:bg-repeat tw:bg-size-[400px_400px]">
            <Header />
            <main class="tw:relative tw:bg-white">
                <ActivityHero />
                <ActivityExplorer />
            </main>
            <Footer />
        </div>
    </body>
</html>
