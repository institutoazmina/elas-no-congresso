---
import PropositionProgress from "../../../components/activity/PropositionProgress";
import BackLink from "../../../components/shared/BackLink";
import { Photo } from "../../../components/shared/react-utils";
import { Image } from "astro:assets";
import PageLayout from "../../../layouts/PageLayout.astro";
import thumbsUp from "../../../assets/images/activity/thumbs-up.svg";
import thumbsDown from "../../../assets/images/activity/thumbs-down.svg";
import paper from "../../../assets/images/activity/author-hero-paper.png";
import paperclip from "../../../assets/images/activity/author-paperclip.png";
import statusLabel from "../../../assets/images/activity/proposition-status-label.svg";
import { authorRoute, normalizePhotoUrl } from "../../../lib/author-page";
import { propositionSlug } from "../../../lib/proposition-utils";
import { formatPresentedDate } from "../../../lib/canonical";
import { fetchActivity, fetchFastUnfavorable, type ActivityProposition } from "../../../lib/activity-api";
import { HOUSE_LABELS } from "../../../lib/house-labels";
import { API_BASE_URL } from "astro:env/server";

export async function getStaticPaths() {
  const paths = new Map<string, { params: { slug: string }; props: { activity: ActivityProposition } }>();
  const [activities, fastUnfavorable] = await Promise.all([
    fetchActivity(API_BASE_URL),
    fetchFastUnfavorable(API_BASE_URL),
  ]);
  for (const activity of [...activities, ...fastUnfavorable]) {
    const slug = propositionSlug(activity.number_label);
    const houseSlug = propositionSlug(activity.house);
    if (!slug) continue;
    if (houseSlug) paths.set(`${houseSlug}-${slug}`, { params: { slug: `${houseSlug}-${slug}` }, props: { activity } });
    if (!paths.has(slug)) paths.set(slug, { params: { slug }, props: { activity } });
  }
  return [...paths.values()];
}

const activityFromProps = (Astro.props as { activity?: ActivityProposition }).activity;
const routeHouse = Astro.params.slug?.match(/^(camara|senado)-/)?.[1] || null;
const routeNumberSlug = routeHouse
  ? Astro.params.slug?.slice(routeHouse.length + 1)
  : Astro.params.slug;
const activity = activityFromProps ?? (await (async () => {
  const [activities, fastUnfavorable] = await Promise.all([
    fetchActivity(API_BASE_URL),
    fetchFastUnfavorable(API_BASE_URL),
  ]);
  return [...activities, ...fastUnfavorable].find((candidate) =>
    propositionSlug(candidate.number_label) === routeNumberSlug
    && (!routeHouse || candidate.house === routeHouse)
  );
})());
if (!activity) throw new Error(`A API não retornou a proposição ${Astro.params.slug ?? "solicitada"}`);

const authors = activity.authors.map((author) => ({
  name: author.name,
  party: author.party,
  state: author.state,
  photo: author.photo_url,
}));
const assessment = activity.is_favorable === true ? "Favorável" : activity.is_favorable === false ? "Desfavorável" : "Sem avaliação";
let houseJourney = HOUSE_LABELS[activity.house].full;
if (activity.current_house && activity.current_house !== activity.house) {
  houseJourney += ` → ${HOUSE_LABELS[activity.current_house].full}`;
}
const officialLink = activity.tramitation_url?.trim().replace(/^http:/, "https:") || null;
const category = activity.category_label?.trim() || activity.category?.trim() || null;
const presentedDate = formatPresentedDate(activity.presented_at);
const themes = activity.themes?.filter(Boolean) || (category ? [category] : []);
const title = `${activity.number_label} | Atividade Legislativa | Elas no Congresso`;
const description = `Consulte a ementa, a autoria e a tramitação do ${activity.number_label} e acompanhe sua avaliação sobre pautas de gênero e direitos no Elas no Congresso.`;
---

<PageLayout title={title} description={description} fontVariant="medium"
    pageClass="proposition-page tw:min-w-80 tw:text-ink tw:font-sans"
      pageStyle={`--proposition-paper: url(${paper.src}); --proposition-paperclip: url(${paperclip.src}); --proposition-status-label: url(${statusLabel.src})`}
>
      <main class="tw:overflow-clip">
        <section class="proposition-hero tw:[&>a]:absolute tw:[&>a]:z-1 tw:[&>a]:top-3 tw:[&>a]:left-12 tw:[&>a]:text-[#d0d0fd] tw:[&>a]:text-base tw:[&>a]:font-bold tw:[&>a]:leading-6 tw:[&>a]:no-underline tw:[&_p]:font-display tw:[&_p]:font-bold tw:[&_p]:[font-variation-settings:'wdth'_75] tw:[&_p]:text-center tw:[&_p]:uppercase tw:[&_p]:text-2xl tw:[&_p]:leading-8 tw:[&_p]:m-0 tw:[&_h1]:font-display tw:[&_h1]:font-bold tw:[&_h1]:[font-variation-settings:'wdth'_75] tw:[&_h1]:text-center tw:[&_h1]:uppercase tw:[&_h1]:m-0 tw:max-md:h-55 tw:max-md:bg-center tw:max-md:bg-size-[cover] tw:max-md:[&>a]:top-3 tw:max-md:[&>a]:left-4 tw:max-md:[&>a]:text-sm tw:max-md:[&_p]:text-lg tw:max-md:[&_p]:leading-6 tw:max-md:[&_h1]:mt-1 tw:max-md:[&_h1]:text-[clamp(36px,_12vw,_48px)] tw:max-md:[&_h1]:leading-[1] tw:relative tw:h-53 tw:overflow-hidden tw:bg-[#3838d9] tw:bg-[image:var(--proposition-paper)] tw:[background-blend-mode:multiply] tw:bg-center tw:bg-no-repeat tw:bg-size-[cover] tw:text-white" data-page-hero aria-labelledby="proposition-title">
          <BackLink className="tw:hover:text-white tw:hover:underline tw:focus-visible:text-white tw:focus-visible:underline" href="/atividade-legislativa" data-history-back client:load>←&nbsp; Voltar ao painel</BackLink>
          <div class="tw:absolute tw:top-[58px] tw:left-[50%] tw:flex tw:w-[min(720px,_calc(100%_-_32px))] tw:[transform:translateX(-50%)] tw:items-center tw:flex-col tw:max-md:top-18">
            <p>Proposição</p>
            <h1 class="tw:text-7xl tw:leading-18 tw:[overflow-wrap:anywhere]" id="proposition-title">{activity.number_label}</h1>
          </div>
        </section>

        <section class="proposition-overview tw:relative tw:border-t tw:border-solid tw:border-t-[rgb(153_141_150_/_28%)] tw:bg-white tw:shadow-[0_-2px_10px_rgb(0_0_0_/_27%)] tw:pt-22 tw:pb-10 tw:px-12 tw:max-[1280px]:px-8 tw:max-md:min-h-0 tw:max-md:pt-18 tw:max-md:pb-14 tw:max-md:px-4" aria-label={`Detalhes de ${activity.number_label}`}>
          <span class="proposition-overview__paperclip tw:absolute tw:z-2 tw:top-[-22px] tw:left-[max(42px,_calc(50%_-_678px))] tw:w-[48px] tw:h-[86px] tw:[background:var(--proposition-paperclip)_center_/_contain_no-repeat] tw:pointer-events-none tw:max-md:left-4 tw:max-md:w-9 tw:max-md:h-16.5" aria-hidden="true"></span>
          <div class="proposition-overview__grid tw:w-[min(1260px,_100%)] tw:gap-5 tw:items-start tw:justify-center tw:my-0 tw:mx-auto tw:max-[1280px]:gap-y-12 tw:max-md:gap-12 tw:grid tw:grid-cols-[repeat(4,minmax(0,300px))] tw:min-[768px]:max-[1280px]:grid-cols-[repeat(2,minmax(0,300px))] tw:max-md:grid-cols-1 tw:[&>*]:min-w-0">
            <article class="proposition-column proposition-summary tw:min-w-0 tw:max-md:[&_h2]:mb-5 tw:max-md:[&_h2]:text-[28px] tw:max-md:[&_h2]:leading-8 tw:max-md:[&>p]:w-full">
              <h2 class="tw:text-ink tw:font-display tw:text-[32px] tw:font-bold tw:[font-variation-settings:'wdth'_75] tw:leading-8 tw:[text-box-edge:cap_alphabetic] tw:[text-box-trim:trim-both] tw:uppercase tw:mt-0 tw:mb-[24px] tw:mx-0">Ementa</h2>
              <p class="tw:w-67 tw:max-w-full tw:text-[#4b5563] tw:text-lg tw:font-normal tw:leading-6 tw:[white-space:pre-line] tw:mt-0 tw:mb-6 tw:mx-0">{activity.ementa || "Indisponível"}</p>
              <div class="proposition-summary__links tw:flex tw:flex-col tw:gap-3 tw:text-accent tw:text-lg tw:leading-6 tw:[&_a]:text-inherit tw:[&_a]:no-underline tw:[&_span]:text-muted">
                {officialLink
                  ? <a class="tw:hover:underline tw:focus-visible:underline" href={officialLink} target="_blank" rel="noopener noreferrer">Ver no site do Congresso</a>
                  : <span>Indisponível</span>}
              </div>
            </article>

            <article class="proposition-column proposition-assessment tw:min-w-0 tw:max-md:[&_h2]:mb-5 tw:max-md:[&_h2]:text-[28px] tw:max-md:[&_h2]:leading-8 tw:pt-[4px]" aria-label="Avaliação da proposição">
              <h2 class="tw:text-ink tw:font-display tw:text-[32px] tw:font-bold tw:[font-variation-settings:'wdth'_75] tw:leading-8 tw:[text-box-edge:cap_alphabetic] tw:[text-box-trim:trim-both] tw:uppercase tw:mt-0 tw:mb-[24px] tw:mx-0">Avaliação</h2>
              <div class:list={[
                "proposition-assessment__value tw:flex tw:min-h-8 tw:items-center tw:gap-2 tw:text-ink tw:[&_img]:block tw:[&_img]:w-8 tw:[&_img]:h-8 tw:[&_strong]:font-display tw:[&_strong]:text-lg tw:[&_strong]:font-bold tw:[&_strong]:[font-variation-settings:'wdth'_75] tw:[&_strong]:leading-6 tw:[&_strong]:uppercase",
                { "is-favorable": assessment === "Favorável", "is-unfavorable": assessment === "Desfavorável", [String.raw`is-unrated tw:[.proposition-assessment\_\_value&]:text-muted tw:[.activity-table\_\_stance&]:text-muted tw:[.author-table\_\_stance&]:text-muted`]: assessment === "Sem avaliação" },
              ]}>
                {assessment === "Favorável" && <Image src={thumbsUp} alt="" loading="eager" />}
                {assessment === "Desfavorável" && <Image src={thumbsDown} alt="" loading="eager" />}
                <strong>{assessment}</strong>
              </div>
              <p class="proposition-assessment__comment tw:text-ink tw:text-lg tw:leading-6 tw:mt-4 tw:mb-0 tw:mr-2 tw:ml-0">
                {activity.assessment_comments ? `“${activity.assessment_comments}”` : "Indisponível"}
              </p>
              <p class="proposition-assessment__evaluator tw:text-ink tw:text-lg tw:leading-6 tw:mt-4 tw:mb-0 tw:mr-2 tw:ml-0">
                <span aria-hidden="true">— </span><strong>{activity.assessment_organization?.trim() || "Indisponível"}</strong>
              </p>
            </article>

            <article class="proposition-column proposition-authors tw:min-w-0 tw:max-md:[&_h2]:mb-5 tw:max-md:[&_h2]:text-[28px] tw:max-md:[&_h2]:leading-8" aria-labelledby="proposition-authors-title">
              <h2 class="tw:text-ink tw:font-display tw:text-[32px] tw:font-bold tw:[font-variation-settings:'wdth'_75] tw:leading-8 tw:[text-box-edge:cap_alphabetic] tw:[text-box-trim:trim-both] tw:uppercase tw:mt-0 tw:mb-[24px] tw:mx-0" id="proposition-authors-title">Autoria</h2>
              {authors.length > 0
                ? <div class="proposition-authors__list tw:flex tw:flex-col tw:gap-4 tw:py-2 tw:px-0">
                    {authors.map((author) => {
                      const photo = normalizePhotoUrl(author.photo);
                      const initials = author.name.split(/\s+/).slice(0, 2).map((part) => part[0]).join("").toUpperCase();
                      return <a class="proposition-author tw:flex tw:w-full tw:min-w-0 tw:items-start tw:gap-2 tw:text-ink tw:no-underline tw:[&_strong]:text-sm tw:[&_strong]:font-normal tw:[&_strong]:leading-4 tw:[&_small]:text-sm tw:[&_small]:font-normal tw:[&_small]:leading-4 tw:[&:hover_strong]:text-accent tw:[&:hover_strong]:underline tw:[&:focus-visible_strong]:text-accent tw:[&:focus-visible_strong]:underline" href={authorRoute(author.name) || "/atividade-legislativa"} aria-label={`Ver autoria de ${author.name}`}>
                        {photo
                          ? <span class="proposition-author__photo tw:w-7.5 tw:h-10 tw:flex-[0_0_30px] tw:border tw:border-solid tw:border-muted tw:overflow-hidden tw:[&_img]:w-full tw:[&_img]:h-full tw:[&_img]:object-cover tw:[&_img]:object-[top] tw:flex tw:items-center tw:justify-center">
                              <Photo src={photo} name={author.name} client:visible />
                              <span class={String.raw`proposition-author__fallback tw:flex-[0_0_30px] tw:border tw:border-solid tw:border-muted tw:bg-[#f1f1ff] tw:text-accent tw:text-[12px] tw:font-bold tw:w-full tw:h-full tw:object-cover tw:object-[top] tw:[.proposition-author\_\_photo_&[hidden]]:hidden tw:flex tw:items-center tw:justify-center`} aria-hidden="true" hidden>{initials}</span>
                            </span>
                          : <span class={String.raw`proposition-author__fallback tw:w-7.5 tw:h-10 tw:flex-[0_0_30px] tw:border tw:border-solid tw:border-muted tw:bg-[#f1f1ff] tw:text-accent tw:text-[12px] tw:font-bold tw:[.proposition-author\_\_photo_&[hidden]]:hidden tw:flex tw:items-center tw:justify-center`} aria-hidden="true">{initials}</span>}
                        <span class="tw:flex tw:min-w-0 tw:flex-col">
                          <strong>{author.name}</strong>
                          <small>{[author.party, author.state].filter(Boolean).join("/") || "Indisponível"}</small>
                        </span>
                      </a>;
                    })}
                  </div>
                : <p class="proposition-unavailable tw:text-muted tw:text-lg tw:leading-6 tw:m-0">Indisponível</p>}
            </article>

            <aside class="proposition-details tw:flex tw:min-h-74 tw:border tw:border-solid tw:border-[rgb(66_66_246_/_25%)] tw:flex-col tw:items-start tw:gap-4 tw:p-[24px] tw:max-md:w-full" aria-label="Informações complementares">
              <strong class="proposition-details__tag tw:inline-flex tw:min-h-10 tw:items-center tw:bg-accent tw:text-white tw:font-display tw:text-xl tw:font-bold tw:[font-variation-settings:'wdth'_75] tw:leading-6 tw:uppercase tw:pt-[6px] tw:pb-[4px] tw:px-2.5">{category || "Indisponível"}</strong>
              <div class="proposition-details__body tw:w-full tw:text-[#4b5563] tw:text-lg tw:leading-6 tw:[&_p]:mt-0 tw:[&_p:not(:last-child)]:mb-6 tw:[&_p]:mx-0">
                <p>
                  <span class="tw:block tw:text-muted tw:text-sm tw:leading-4">Data de apresentação:</span>
                  {presentedDate}<br />
                  {houseJourney}
                </p>
                <p>
                  <span class="tw:block tw:text-muted tw:text-sm tw:leading-4">Última movimentação:</span>
                  {activity.celerity.last_event_at ? formatPresentedDate(activity.celerity.last_event_at) : activity.current_status?.trim() || "Indisponível"}
                </p>
                <p class="proposition-details__themes tw:flex tw:flex-col tw:gap-1.5 tw:text-accent tw:mb-0">
                  {themes.length > 0 ? themes.map((theme) => <span class="tw:block tw:text-accent tw:text-sm tw:leading-4">#{theme.replace(/^#+/, "")}</span>) : "Indisponível"}
                </p>
              </div>
            </aside>
          </div>
        </section>

        <PropositionProgress number={activity.number_label} house={activity.house} client:visible={{ rootMargin: "240px" }} />
      </main>
</PageLayout>
