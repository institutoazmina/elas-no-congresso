---
import PageLayout from "../../../layouts/PageLayout.astro";
const thumbsUp = "/assets/images/activity/thumbs-up.svg";
const thumbsDown = "/assets/images/activity/thumbs-down.svg";
const paper = "/assets/images/activity/author-hero-paper.png";
const paperclip = "/assets/images/activity/author-paperclip.png";
const statusLabel = "/assets/images/activity/proposition-status-label.svg";
import { authorRoute, normalizePhotoUrl } from "../../../lib/author-page";
import { propositionSlug } from "../../../lib/proposition-utils";
import { formatPresentedDate } from "../../../lib/canonical";
import { fetchActivity, fetchFastUnfavorable, type ActivityProposition } from "../../../lib/activity-api";
import { API_BASE_URL } from "astro:env/server";

export async function getStaticPaths() {
  const paths = new Map<string, { params: { slug: string }; props: { activity: ActivityProposition } }>();
  const [activities, fastUnfavorable] = await Promise.all([
    fetchActivity(API_BASE_URL),
    fetchFastUnfavorable(API_BASE_URL),
  ]);
  for (const activity of [...activities, ...fastUnfavorable]) {
    const slug = propositionSlug(activity.number_label);
    const houseSlug = propositionSlug(activity.house);
    if (!slug) continue;
    if (houseSlug) paths.set(`${houseSlug}-${slug}`, { params: { slug: `${houseSlug}-${slug}` }, props: { activity } });
    if (!paths.has(slug)) paths.set(slug, { params: { slug }, props: { activity } });
  }
  return [...paths.values()];
}

const activityFromProps = (Astro.props as { activity?: ActivityProposition }).activity;
const routeHouse = Astro.params.slug?.match(/^(camara|senado)-/)?.[1] || null;
const routeNumberSlug = routeHouse
  ? Astro.params.slug?.slice(routeHouse.length + 1)
  : Astro.params.slug;
const activity = activityFromProps ?? (await (async () => {
  const [activities, fastUnfavorable] = await Promise.all([
    fetchActivity(API_BASE_URL),
    fetchFastUnfavorable(API_BASE_URL),
  ]);
  return [...activities, ...fastUnfavorable].find((candidate) =>
    propositionSlug(candidate.number_label) === routeNumberSlug
    && (!routeHouse || candidate.house === routeHouse)
  );
})());
if (!activity) throw new Error(`A API não retornou a proposição ${Astro.params.slug ?? "solicitada"}`);

const authors = activity.authors.map((author) => ({
  nome: author.name,
  partido: author.party,
  estado: author.state,
  foto: author.photo_url,
}));
const assessment = activity.is_favorable === true ? "Favorável" : activity.is_favorable === false ? "Desfavorável" : "Sem avaliação";
const house = /sen/i.test(activity.house)
  ? "Senado Federal"
  : /dep|câm|cam/i.test(activity.house)
    ? "Câmara dos Deputados"
    : activity.house?.trim() || "Indisponível";
const activityHouse = activity.house === "senado" ? "senado" : activity.house === "camara" ? "camara" : "";
const officialLink = activity.tramitation_url?.trim().replace(/^http:/, "https:") || null;
const category = activity.category_label?.trim() || activity.category?.trim() || null;
const presentedDate = formatPresentedDate(activity.presented_at);
const themes = activity.themes?.filter(Boolean) || (category ? [category] : []);
const title = `${activity.number_label} | Atividade Legislativa | Elas no Congresso`;
---

<PageLayout title={title} description={activity.ementa} fontVariant="medium"
    pageClass="proposition-page tw:min-w-80 tw:text-ink tw:font-sans"
      pageStyle={`--proposition-paper: url(${paper}); --proposition-paperclip: url(${paperclip}); --proposition-status-label: url(${statusLabel})`}
>
      <main class="tw:overflow-clip">
        <section class="proposition-hero tw:[&>a]:absolute tw:[&>a]:z-1 tw:[&>a]:top-3 tw:[&>a]:left-12 tw:[&>a]:text-[#d0d0fd] tw:[&>a]:text-base tw:[&>a]:font-bold tw:[&>a]:leading-6 tw:[&>a]:no-underline tw:[&_p]:font-display tw:[&_p]:font-bold tw:[&_p]:[font-variation-settings:'wdth'_75] tw:[&_p]:text-center tw:[&_p]:uppercase tw:[&_p]:text-2xl tw:[&_p]:leading-8 tw:[&_p]:m-0 tw:[&_h1]:font-display tw:[&_h1]:font-bold tw:[&_h1]:[font-variation-settings:'wdth'_75] tw:[&_h1]:text-center tw:[&_h1]:uppercase tw:[&_h1]:m-0 tw:max-md:h-55 tw:max-md:bg-center tw:max-md:bg-size-[cover] tw:max-md:[&>a]:top-3 tw:max-md:[&>a]:left-4 tw:max-md:[&>a]:text-sm tw:max-md:[&_p]:text-lg tw:max-md:[&_p]:leading-6 tw:max-md:[&_h1]:mt-1 tw:max-md:[&_h1]:text-[clamp(36px,_12vw,_48px)] tw:max-md:[&_h1]:leading-[1] tw:relative tw:h-53 tw:overflow-hidden tw:bg-[#3838d9] tw:bg-[image:var(--proposition-paper)] tw:[background-blend-mode:multiply] tw:bg-center tw:bg-no-repeat tw:bg-size-[cover] tw:text-white" data-page-hero aria-labelledby="proposition-title">
          <a class="tw:hover:text-white tw:hover:underline tw:focus-visible:text-white tw:focus-visible:underline" href="/atividade-legislativa" data-history-back>←&nbsp; Voltar ao painel</a>
          <div class="tw:absolute tw:top-[57.5px] tw:left-[50%] tw:flex tw:w-[min(720px,_calc(100%_-_32px))] tw:[transform:translateX(-50%)] tw:items-center tw:flex-col tw:max-md:top-18">
            <p>Proposição</p>
            <h1 class="tw:text-7xl tw:leading-18 tw:[overflow-wrap:anywhere]" id="proposition-title">{activity.number_label}</h1>
          </div>
        </section>

        <section class="proposition-overview tw:relative tw:border-t tw:border-solid tw:border-t-[rgb(153_141_150_/_28%)] tw:bg-white tw:shadow-[0_-2px_9.8px_rgb(0_0_0_/_27%)] tw:pt-22 tw:pb-10 tw:px-12 tw:max-[1280px]:px-8 tw:max-md:min-h-0 tw:max-md:pt-18 tw:max-md:pb-14 tw:max-md:px-4" aria-label={`Detalhes de ${activity.number_label}`}>
          <span class="proposition-overview__paperclip tw:absolute tw:z-2 tw:top-[-20.933px] tw:left-[max(42px,_calc(50%_-_678px))] tw:w-[46.213px] tw:h-[84.412px] tw:[background:var(--proposition-paperclip)_center_/_contain_no-repeat] tw:pointer-events-none tw:max-md:left-4 tw:max-md:w-9 tw:max-md:h-16.5" aria-hidden="true"></span>
          <div class="proposition-overview__grid tw:w-[min(1260px,_100%)] tw:gap-5 tw:items-start tw:justify-center tw:my-0 tw:mx-auto tw:max-[1280px]:gap-y-12 tw:max-md:gap-12 tw:grid tw:grid-cols-[repeat(4,minmax(0,300px))] tw:min-[768px]:max-[1280px]:grid-cols-[repeat(2,minmax(0,300px))] tw:max-md:grid-cols-1 tw:[&>*]:min-w-0">
            <article class="proposition-column proposition-summary tw:min-w-0 tw:max-md:[&_h2]:mb-5 tw:max-md:[&_h2]:text-[28px] tw:max-md:[&_h2]:leading-8 tw:max-md:[&>p]:w-full">
              <h2 class="tw:text-ink tw:font-display tw:text-[32px] tw:font-bold tw:[font-variation-settings:'wdth'_75] tw:leading-8 tw:[text-box-edge:cap_alphabetic] tw:[text-box-trim:trim-both] tw:uppercase tw:mt-0 tw:mb-[23px] tw:mx-0">Ementa</h2>
              <p class="tw:w-67 tw:max-w-full tw:text-[#4b5563] tw:text-lg tw:font-normal tw:leading-6 tw:[white-space:pre-line] tw:mt-0 tw:mb-6 tw:mx-0">{activity.ementa || "Indisponível"}</p>
              <div class="proposition-summary__links tw:flex tw:flex-col tw:gap-3 tw:text-accent tw:text-lg tw:leading-6 tw:[&_a]:text-inherit tw:[&_a]:no-underline tw:[&_span]:text-muted">
                {officialLink
                  ? <a class="tw:hover:underline tw:focus-visible:underline" href={officialLink} target="_blank" rel="noopener noreferrer">Ver no site do Congresso</a>
                  : <span>Indisponível</span>}
              </div>
            </article>

            <article class="proposition-column proposition-assessment tw:min-w-0 tw:max-md:[&_h2]:mb-5 tw:max-md:[&_h2]:text-[28px] tw:max-md:[&_h2]:leading-8 tw:pt-[3px]" aria-label="Avaliação da proposição">
              <h2 class="tw:text-ink tw:font-display tw:text-[32px] tw:font-bold tw:[font-variation-settings:'wdth'_75] tw:leading-8 tw:[text-box-edge:cap_alphabetic] tw:[text-box-trim:trim-both] tw:uppercase tw:mt-0 tw:mb-[23px] tw:mx-0">Avaliação</h2>
              <div class:list={[
                "proposition-assessment__value tw:flex tw:min-h-8 tw:items-center tw:gap-2 tw:text-ink tw:[&_img]:block tw:[&_img]:w-8 tw:[&_img]:h-8 tw:[&_strong]:font-display tw:[&_strong]:text-lg tw:[&_strong]:font-bold tw:[&_strong]:[font-variation-settings:'wdth'_75] tw:[&_strong]:leading-6 tw:[&_strong]:uppercase",
                { "is-favorable": assessment === "Favorável", "is-unfavorable": assessment === "Desfavorável", [String.raw`is-unrated tw:[.proposition-assessment\_\_value&]:text-muted tw:[.activity-table\_\_stance&]:text-muted tw:[.author-table\_\_stance&]:text-muted`]: assessment === "Sem avaliação" },
              ]}>
                {assessment === "Favorável" && <img src={thumbsUp} alt="" />}
                {assessment === "Desfavorável" && <img src={thumbsDown} alt="" />}
                <strong>{assessment}</strong>
              </div>
              <p class="proposition-assessment__comment tw:text-ink tw:text-lg tw:leading-6 tw:mt-4 tw:mb-0 tw:mr-2 tw:ml-0">
                {activity.assessment_comments ? `“${activity.assessment_comments}”` : "Indisponível"}
              </p>
              <p class="proposition-assessment__evaluator tw:text-ink tw:text-lg tw:leading-6 tw:mt-4 tw:mb-0 tw:mr-2 tw:ml-0">
                <span aria-hidden="true">— </span><strong>{activity.assessment_organization?.trim() || "Indisponível"}</strong>
              </p>
            </article>

            <article class="proposition-column proposition-authors tw:min-w-0 tw:max-md:[&_h2]:mb-5 tw:max-md:[&_h2]:text-[28px] tw:max-md:[&_h2]:leading-8" aria-labelledby="proposition-authors-title">
              <h2 class="tw:text-ink tw:font-display tw:text-[32px] tw:font-bold tw:[font-variation-settings:'wdth'_75] tw:leading-8 tw:[text-box-edge:cap_alphabetic] tw:[text-box-trim:trim-both] tw:uppercase tw:mt-0 tw:mb-[23px] tw:mx-0" id="proposition-authors-title">Autoria</h2>
              {authors.length > 0
                ? <div class="proposition-authors__list tw:flex tw:flex-col tw:gap-4 tw:py-2 tw:px-0">
                    {authors.map((author) => {
                      const photo = normalizePhotoUrl(author.foto);
                      const initials = author.nome.split(/\s+/).slice(0, 2).map((part) => part[0]).join("").toUpperCase();
                      return <a class="proposition-author tw:flex tw:w-full tw:min-w-0 tw:items-start tw:gap-2 tw:text-ink tw:no-underline tw:[&_strong]:text-sm tw:[&_strong]:font-normal tw:[&_strong]:leading-4 tw:[&_small]:text-sm tw:[&_small]:font-normal tw:[&_small]:leading-4 tw:[&:hover_strong]:text-accent tw:[&:hover_strong]:underline tw:[&:focus-visible_strong]:text-accent tw:[&:focus-visible_strong]:underline" href={authorRoute(author.nome) || "/atividade-legislativa"} aria-label={`Ver autoria de ${author.nome}`}>
                        {photo
                          ? <span class="proposition-author__photo tw:w-7.5 tw:h-10 tw:flex-[0_0_30px] tw:border tw:border-solid tw:border-muted tw:overflow-hidden tw:[&_img]:w-full tw:[&_img]:h-full tw:[&_img]:object-cover tw:[&_img]:object-[top] tw:flex tw:items-center tw:justify-center">
                              <img src={photo} alt={`Foto de ${author.nome}`} loading="lazy" onerror="this.hidden = true; this.nextElementSibling.hidden = false" />
                              <span class={String.raw`proposition-author__fallback tw:flex-[0_0_30px] tw:border tw:border-solid tw:border-muted tw:bg-[#f1f1ff] tw:text-accent tw:text-[11px] tw:font-bold tw:w-full tw:h-full tw:object-cover tw:object-[top] tw:[.proposition-author\_\_photo_&[hidden]]:hidden tw:flex tw:items-center tw:justify-center`} aria-hidden="true" hidden>{initials}</span>
                            </span>
                          : <span class={String.raw`proposition-author__fallback tw:w-7.5 tw:h-10 tw:flex-[0_0_30px] tw:border tw:border-solid tw:border-muted tw:bg-[#f1f1ff] tw:text-accent tw:text-[11px] tw:font-bold tw:[.proposition-author\_\_photo_&[hidden]]:hidden tw:flex tw:items-center tw:justify-center`} aria-hidden="true">{initials}</span>}
                        <span class="tw:flex tw:min-w-0 tw:flex-col">
                          <strong>{author.nome}</strong>
                          <small>{[author.partido, author.estado].filter(Boolean).join("/") || "Indisponível"}</small>
                        </span>
                      </a>;
                    })}
                  </div>
                : <p class="proposition-unavailable tw:text-muted tw:text-lg tw:leading-6 tw:m-0">Indisponível</p>}
            </article>

            <aside class="proposition-details tw:flex tw:min-h-74 tw:border tw:border-solid tw:border-[rgb(66_66_246_/_25%)] tw:flex-col tw:items-start tw:gap-4 tw:p-[23px] tw:max-md:w-full" aria-label="Informações complementares">
              <strong class="proposition-details__tag tw:inline-flex tw:min-h-10 tw:items-center tw:bg-accent tw:text-white tw:font-display tw:text-xl tw:font-bold tw:[font-variation-settings:'wdth'_75] tw:leading-6 tw:uppercase tw:pt-[5px] tw:pb-[3px] tw:px-2.5">{category || "Indisponível"}</strong>
              <div class="proposition-details__body tw:w-full tw:text-[#4b5563] tw:text-lg tw:leading-6 tw:[&_p]:mt-0 tw:[&_p:not(:last-child)]:mb-6 tw:[&_p]:mx-0">
                <p>
                  <span class="tw:block tw:text-muted tw:text-sm tw:leading-4">Data de apresentação:</span>
                  {presentedDate}<br />
                  {house}
                </p>
                <p>
                  <span class="tw:block tw:text-muted tw:text-sm tw:leading-4">Última movimentação:</span>
                  {activity.celerity.last_event_at ? formatPresentedDate(activity.celerity.last_event_at) : activity.current_status?.trim() || "Indisponível"}
                </p>
                <p class="proposition-details__themes tw:flex tw:gap-[0_5px] tw:text-accent tw:mb-0">
                  {themes.length > 0 ? themes.map((theme) => <span class="tw:block tw:text-muted tw:text-sm tw:leading-4">{theme.replace(/^#/, "")}</span>) : "Indisponível"}
                </p>
              </div>
            </aside>
          </div>
        </section>

        <section class="proposition-progress tw:w-full tw:bg-white tw:pt-25 tw:pb-10 tw:px-4 tw:max-md:pt-22 tw:max-md:pb-24 tw:max-md:px-4" aria-labelledby="proposition-progress-title" data-proposition-progress data-proposition-number={activity.number_label} data-proposition-house={activityHouse}>
          <div class="proposition-progress__bar tw:max-md:h-20.5 tw:max-md:py-0 tw:max-md:px-3.5 tw:max-md:[&_h2]:top-[-43px] tw:max-md:[&_h2]:text-[28px] tw:relative tw:flex tw:w-[min(741px,_100%)] tw:h-[65px] tw:items-center tw:justify-between tw:bg-[#6262ff] tw:bg-[image:var(--proposition-paper)] tw:[background-blend-mode:multiply] tw:[background-position:center_-70px] tw:bg-no-repeat tw:bg-size-[741px_auto] tw:py-0 tw:pr-[25px] tw:pl-5 tw:my-0 tw:mx-auto">
            <h2 class="tw:absolute tw:-top-11.5 tw:left-[50%] tw:[transform:translateX(-50%)] tw:text-navy tw:font-display tw:text-[32px] tw:font-bold tw:[font-variation-settings:'wdth'_75] tw:leading-8 tw:text-center tw:[text-box-edge:cap_alphabetic] tw:[text-box-trim:trim-both] tw:uppercase tw:whitespace-nowrap tw:m-0" id="proposition-progress-title">Como está?</h2>
            <strong class="proposition-progress__status tw:relative tw:z-0 tw:flex tw:min-w-29.5 tw:h-11 tw:items-center tw:justify-center tw:gap-[5px] tw:text-navy tw:text-2xl tw:font-medium tw:leading-[44px] tw:whitespace-nowrap tw:py-0 tw:px-1.5 tw:[&>span]:text-[19px] tw:[&>span]:leading-[1] tw:max-md:min-w-28 tw:max-md:text-xl tw:before:absolute tw:before:z-[-1] tw:before:top-0 tw:before:-right-2 tw:before:-left-2 tw:before:h-11.5 tw:before:[background:var(--proposition-status-label)_center_/_100%_100%_no-repeat] tw:before:content-[''] tw:max-md:before:-right-1.5 tw:max-md:before:-left-1.5" data-progress-status>Carregando</strong>
            <span class="proposition-progress__summary tw:[&>span]:font-normal tw:max-md:max-w-30 tw:max-md:text-sm tw:max-md:leading-[18px] tw:max-md:text-right tw:text-white tw:text-lg tw:font-bold tw:leading-6 tw:[text-shadow:1px_2px_1px_rgb(0_0_0_/_20%)]" data-progress-summary>Histórico carregado ao chegar nesta seção</span>
          </div>
          <div class="proposition-timeline is-empty tw:w-[min(741px,_100%)] tw:min-h-74 tw:border-[2px] tw:border-solid tw:border-navy tw:bg-white tw:my-0 tw:mx-auto tw:[&>p]:text-muted tw:[&>p]:text-base tw:[&>p]:leading-6 tw:[&>p]:text-center tw:[&>p]:m-0 tw:max-md:min-h-39 tw:[&.is-empty]:p-[25px] tw:[&:not(.is-empty)]:min-h-0 tw:max-md:[&.is-empty]:p-5 tw:[&.is-empty]:flex tw:[&.is-empty]:items-center tw:[&.is-empty]:justify-center" aria-live="polite" data-progress-timeline>
            <p>Histórico de movimentações indisponível</p>
          </div>
        </section>
      </main>
    <Fragment slot="scripts">
<script>
      import { PUBLIC_API_BASE_URL } from "astro:env/client";

      type ActivityEvent = {
        event_at: string;
        title: string | null;
        description: string | null;
        url: string | null;
        situation: string | null;
        committee_acronym: string | null;
        committee_name: string | null;
      };

      type Activity = {
        celerity: {
          label: string;
          days_without_movement: number;
          movements_last_90_days: number;
        };
        tramitation_url: string | null;
        events: ActivityEvent[];
      };

      const formatEventDate = (value: string) => new Intl.DateTimeFormat("pt-BR", {
        day: "2-digit",
        month: "2-digit",
        year: "2-digit",
        timeZone: "UTC",
      }).format(new Date(value));

      const celerityPresentation = (celerity: Activity["celerity"]) => {
        const labels = {
          Esquecida: "⛔",
          Travada: "🧱",
          Lenta: "🐢",
          Rápida: "⏫",
          "Tá voando": "🚀",
        } as const;
        const emoji = labels[celerity.label as keyof typeof labels];
        const inactive = ["Esquecida", "Travada", "Lenta"].includes(celerity.label);
        const movement = celerity.movements_last_90_days;

        return {
          label: emoji ? `${emoji} ${celerity.label}` : celerity.label,
          summary: inactive
            ? `${celerity.days_without_movement} ${celerity.days_without_movement === 1 ? "dia" : "dias"} sem movimentação`
            : `${movement} ${movement === 1 ? "movimentação" : "movimentações"} em 3 meses`,
        };
      };

      const initializePropositionProgress = () => {
        document.querySelectorAll<HTMLElement>("[data-proposition-progress]:not([data-ready])").forEach((root) => {
          root.dataset.ready = "true";
          const number = root.dataset.propositionNumber || "";
          const house = root.dataset.propositionHouse || "";
          const status = root.querySelector<HTMLElement>("[data-progress-status]");
          const summary = root.querySelector<HTMLElement>("[data-progress-summary]");
          const timeline = root.querySelector<HTMLElement>("[data-progress-timeline]");
          if (!number || !house || !status || !summary || !timeline) return;

          const renderUnavailable = () => {
            status.textContent = "Indisponível";
            summary.textContent = "Histórico de movimentações indisponível";
            timeline.classList.add("is-empty");
            timeline.replaceChildren(Object.assign(document.createElement("p"), { textContent: "Histórico de movimentações indisponível" }));
          };

          const renderEvents = (activity: Activity) => {
            if (!activity.events.length) {
              timeline.classList.add("is-empty");
              timeline.replaceChildren(Object.assign(document.createElement("p"), { textContent: "Ainda não há movimentações registradas." }));
              return;
            }

            const list = document.createElement("ol");
            list.className = "proposition-timeline__events tw:list-none tw:p-0 tw:m-0 tw:[&_li]:border-b-[2px] tw:[&_li]:border-solid tw:[&_li]:border-b-navy tw:[&_li:last-child]:[border-bottom:0] tw:[&_header]:flex tw:[&_header]:items-center tw:[&_header]:justify-between tw:[&_header]:gap-4 tw:[&_header_strong]:text-navy tw:[&_header_strong]:font-display tw:[&_header_strong]:text-xl tw:[&_header_strong]:font-bold tw:[&_header_strong]:[font-variation-settings:'wdth'_75] tw:[&_header_strong]:leading-6 tw:[&_header_strong]:uppercase tw:[&_time]:text-navy tw:[&_time]:font-display tw:[&_time]:text-xl tw:[&_time]:font-bold tw:[&_time]:[font-variation-settings:'wdth'_75] tw:[&_time]:leading-6 tw:[&_time]:uppercase tw:[&_time]:flex-none tw:[&_time]:text-right";
            for (const event of activity.events) {
              const item = document.createElement("li");
              const destination = event.url || activity.tramitation_url;
              const card = document.createElement("a");
              card.className = "proposition-timeline__event-card tw:block tw:text-inherit tw:no-underline tw:pt-5 tw:pb-7 tw:px-4 tw:max-md:pt-4.5 tw:max-md:pb-5.5 tw:max-md:px-3.5 tw:[&[href]:hover]:bg-[#f7f6f7] tw:[&[href]:focus-visible]:outline-2 tw:[&[href]:focus-visible]:outline-accent tw:[&[href]:focus-visible]:-outline-offset-0.5 tw:[&_>_p]:text-muted tw:[&_>_p]:font-sans tw:[&_>_p]:text-base tw:[&_>_p]:font-normal tw:[&_>_p]:[font-variant-numeric:lining-nums_tabular-nums] tw:[&_>_p]:leading-6 tw:[&_>_p]:text-left tw:[&_>_p]:mt-3 tw:[&_>_p]:mb-0 tw:[&_>_p]:mx-0";
              if (destination) {
                card.href = destination;
                card.target = "_blank";
                card.rel = "noopener noreferrer";
              }
              const header = document.createElement("header");
              const title = document.createElement("strong");
              title.textContent = event.title || event.situation || "Movimentação legislativa";
              const date = document.createElement("time");
              date.dateTime = event.event_at;
              date.textContent = formatEventDate(event.event_at);
              header.append(title, date);
              card.append(header);

              const description = event.description?.trim();
              if (description) {
                const copy = document.createElement("p");
                copy.textContent = description;
                card.append(copy);
              }
              item.append(card);
              list.append(item);
            }
            timeline.classList.remove("is-empty");
            timeline.replaceChildren(list);
          };

          const load = async () => {
            const isLocal = ["localhost", "127.0.0.1", "[::1]"].includes(location.hostname);
            const apiBase = isLocal ? `${location.origin}/api/v1` : PUBLIC_API_BASE_URL;
            const activityUrl = new URL(`${apiBase}/activity/by-number`);
            activityUrl.searchParams.set("house", house);
            activityUrl.searchParams.set("number_label", number);
            const activityResponse = await fetch(activityUrl);
            if (!activityResponse.ok) throw new Error(String(activityResponse.status));
            const activity = await activityResponse.json() as Activity;
            const presentation = celerityPresentation(activity.celerity);
            status.textContent = presentation.label;
            const summaryParts = presentation.summary.split(" em ");
            if (summaryParts.length === 2) {
              const connector = document.createElement("span");
              connector.textContent = "em";
              summary.replaceChildren(`${summaryParts[0]} `, connector, ` ${summaryParts[1]}`);
            } else {
              summary.textContent = presentation.summary;
            }
            renderEvents(activity);
          };

          const loadWhenVisible = () => {
            const startLoading = () => {
              status.textContent = "Carregando";
              summary.textContent = "Buscando movimentações oficiais";
              load().catch(renderUnavailable);
            };

            if (!("IntersectionObserver" in window)) {
              startLoading();
              return;
            }

            const observer = new IntersectionObserver((entries) => {
              if (!entries.some((entry) => entry.isIntersecting)) return;
              observer.disconnect();
              startLoading();
            }, { rootMargin: "240px 0px" });
            observer.observe(root);
          };

          loadWhenVisible();
        });
      };


      document.addEventListener("astro:page-load", initializePropositionProgress);
      initializePropositionProgress();
    </script>
    </Fragment>
</PageLayout>
