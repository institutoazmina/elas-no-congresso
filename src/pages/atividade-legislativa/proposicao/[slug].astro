---
import { ClientRouter } from "astro:transitions";
import RedesignHeader from "../../../components/redesign/RedesignHeader.astro";
import RedesignFooter from "../../../components/redesign/RedesignFooter.astro";
import thumbsUp from "../../../assets/images/redesign/activity/thumbs-up.svg";
import thumbsDown from "../../../assets/images/redesign/activity/thumbs-down.svg";
import paper from "../../../assets/images/redesign/activity/author-hero-paper.png";
import paperclip from "../../../assets/images/redesign/activity/author-paperclip.png";
import statusLabel from "../../../assets/images/redesign/activity/proposition-status-label.svg";
import { authorRoute, normalizePhotoUrl } from "../../../lib/author-page";
import { propositionSlug } from "../../../lib/proposition-utils";
import { formatPresentedDate } from "../../../lib/canonical";
import { fetchActivity, fetchFastUnfavorable, type ActivityProposition } from "../../../lib/activity-api";
import { API_BASE_URL } from "astro:env/server";
import "../../../styles/tailwind.css";

export async function getStaticPaths() {
  const paths = new Map<string, { params: { slug: string }; props: { activity: ActivityProposition } }>();
  const [activities, fastUnfavorable] = await Promise.all([
    fetchActivity(API_BASE_URL),
    fetchFastUnfavorable(API_BASE_URL),
  ]);
  for (const activity of [...activities, ...fastUnfavorable]) {
    const slug = propositionSlug(activity.number_label);
    if (slug && !paths.has(slug)) paths.set(slug, { params: { slug }, props: { activity } });
  }
  return [...paths.values()];
}

const activityFromProps = (Astro.props as { activity?: ActivityProposition }).activity;
const activity = activityFromProps ?? (await (async () => {
  const [activities, fastUnfavorable] = await Promise.all([
    fetchActivity(API_BASE_URL),
    fetchFastUnfavorable(API_BASE_URL),
  ]);
  return [...activities, ...fastUnfavorable].find((candidate) => propositionSlug(candidate.number_label) === Astro.params.slug);
})());
if (!activity) throw new Error(`A API não retornou a proposição ${Astro.params.slug ?? "solicitada"}`);

const authors = activity.authors.map((author) => ({
  nome: author.name,
  partido: author.party,
  estado: author.state,
  foto: author.photo_url,
}));
const assessment = activity.is_favorable === true ? "Favorável" : activity.is_favorable === false ? "Desfavorável" : "Sem avaliação";
const house = /sen/i.test(activity.house)
  ? "Senado Federal"
  : /dep|câm|cam/i.test(activity.house)
    ? "Câmara dos Deputados"
    : activity.house?.trim() || "Indisponível";
const activityHouse = activity.house === "senado" ? "senado" : activity.house === "camara" ? "camara" : "";
const officialLink = activity.tramitation_url?.trim().replace(/^http:/, "https:") || null;
const category = activity.category?.trim() || null;
const presentedDate = formatPresentedDate(activity.presented_at);
const themes = category ? [category] : [];
const title = `${activity.number_label} | Atividade Legislativa | Elas no Congresso`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={activity.ementa} />
    <link rel="preload" href="/assets/fonts/ETCAnybodyVariable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700&display=swap" rel="stylesheet" />
    <ClientRouter fallback="swap" />
  </head>
  <body class="tw:!m-0 tw:!bg-white tw:!pt-0">
    <div
      class="proposition-page"
      style={`--proposition-paper: url(${paper.src}); --proposition-paperclip: url(${paperclip.src}); --proposition-status-label: url(${statusLabel.src})`}
    >
      <RedesignHeader />
      <main>
        <section class="proposition-hero" data-page-hero aria-labelledby="proposition-title">
          <a href="/atividade-legislativa">←&nbsp; Voltar ao painel</a>
          <div>
            <p>Proposição</p>
            <h1 id="proposition-title">{activity.number_label}</h1>
          </div>
        </section>

        <section class="proposition-overview" aria-label={`Detalhes de ${activity.number_label}`}>
          <span class="proposition-overview__paperclip" aria-hidden="true"></span>
          <div class="proposition-overview__grid">
            <article class="proposition-column proposition-summary">
              <h2>Ementa</h2>
              <p>{activity.ementa || "Indisponível"}</p>
              <div class="proposition-summary__links">
                {officialLink
                  ? <a href={officialLink} target="_blank" rel="noopener noreferrer">Ver no site do Congresso</a>
                  : <span>Indisponível</span>}
              </div>
            </article>

            <article class="proposition-column proposition-assessment" aria-label="Avaliação da proposição">
              <h2>Avaliação</h2>
              <div class:list={[
                "proposition-assessment__value",
                { "is-favorable": assessment === "Favorável", "is-unfavorable": assessment === "Desfavorável", "is-unrated": assessment === "Sem avaliação" },
              ]}>
                {assessment === "Favorável" && <img src={thumbsUp.src} alt="" />}
                {assessment === "Desfavorável" && <img src={thumbsDown.src} alt="" />}
                <strong>{assessment}</strong>
              </div>
              <p class="proposition-assessment__comment">
                {activity.assessment_comments ? `“${activity.assessment_comments}”` : "Indisponível"}
              </p>
              <p class="proposition-assessment__evaluator">
                <span aria-hidden="true">— </span><strong>{activity.assessment_organization?.trim() || "Indisponível"}</strong>
              </p>
            </article>

            <article class="proposition-column proposition-authors" aria-labelledby="proposition-authors-title">
              <h2 id="proposition-authors-title">Autoria</h2>
              {authors.length > 0
                ? <div class="proposition-authors__list">
                    {authors.map((author) => {
                      const photo = normalizePhotoUrl(author.foto);
                      const initials = author.nome.split(/\s+/).slice(0, 2).map((part) => part[0]).join("").toUpperCase();
                      return <a class="proposition-author" href={authorRoute(author.nome) || "/atividade-legislativa"} aria-label={`Ver autoria de ${author.nome}`}>
                        {photo
                          ? <span class="proposition-author__photo">
                              <img src={photo} alt={`Foto de ${author.nome}`} loading="lazy" onerror="this.hidden = true; this.nextElementSibling.hidden = false" />
                              <span class="proposition-author__fallback" aria-hidden="true" hidden>{initials}</span>
                            </span>
                          : <span class="proposition-author__fallback" aria-hidden="true">{initials}</span>}
                        <span>
                          <strong>{author.nome}</strong>
                          <small>{[author.partido, author.estado].filter(Boolean).join("/") || "Indisponível"}</small>
                        </span>
                      </a>;
                    })}
                  </div>
                : <p class="proposition-unavailable">Indisponível</p>}
            </article>

            <aside class="proposition-details" aria-label="Informações complementares">
              <strong class="proposition-details__tag">{category || "Indisponível"}</strong>
              <div class="proposition-details__body">
                <p>
                  <span>Data de apresentação:</span>
                  {presentedDate}<br />
                  {house}
                </p>
                <p>
                  <span>Última movimentação:</span>
                  {activity.celerity.last_event_at ? formatPresentedDate(activity.celerity.last_event_at) : activity.current_status?.trim() || "Indisponível"}
                </p>
                <p class="proposition-details__themes">
                  {themes.length > 0 ? themes.map((theme) => <span>#{theme.replace(/^#/, "")}</span>) : "Indisponível"}
                </p>
              </div>
            </aside>
          </div>
        </section>

        <section class="proposition-progress" aria-labelledby="proposition-progress-title" data-proposition-progress data-proposition-number={activity.number_label} data-proposition-house={activityHouse}>
          <div class="proposition-progress__bar">
            <h2 id="proposition-progress-title">Como está?</h2>
            <strong class="proposition-progress__status" data-progress-status>Carregando</strong>
            <span class="proposition-progress__summary" data-progress-summary>Histórico carregado ao chegar nesta seção</span>
          </div>
          <div class="proposition-timeline is-empty" aria-live="polite" data-progress-timeline>
            <p>Histórico de movimentações indisponível</p>
          </div>
        </section>
      </main>
      <RedesignFooter />
    </div>
    <script>
      import { PUBLIC_API_BASE_URL } from "astro:env/client";

      type ActivityEvent = {
        event_at: string;
        title: string | null;
        description: string | null;
        url: string | null;
        situation: string | null;
        committee_acronym: string | null;
        committee_name: string | null;
      };

      type Activity = {
        celerity: {
          label: string;
          days_without_movement: number;
          movements_last_90_days: number;
        };
        tramitation_url: string | null;
        events: ActivityEvent[];
      };

      const formatEventDate = (value: string) => new Intl.DateTimeFormat("pt-BR", {
        day: "2-digit",
        month: "2-digit",
        year: "2-digit",
        timeZone: "UTC",
      }).format(new Date(value));

      const celerityPresentation = (celerity: Activity["celerity"]) => {
        const labels = {
          Esquecida: "⛔",
          Travada: "🧱",
          Lenta: "🐢",
          Rápida: "⏫",
          "Tá voando": "🚀",
        } as const;
        const emoji = labels[celerity.label as keyof typeof labels];
        const inactive = ["Esquecida", "Travada", "Lenta"].includes(celerity.label);
        const movement = celerity.movements_last_90_days;

        return {
          label: emoji ? `${emoji} ${celerity.label}` : celerity.label,
          summary: inactive
            ? `${celerity.days_without_movement} ${celerity.days_without_movement === 1 ? "dia" : "dias"} sem movimentação`
            : `${movement} ${movement === 1 ? "movimentação" : "movimentações"} em 3 meses`,
        };
      };

      const initializePropositionProgress = () => {
        document.querySelectorAll<HTMLElement>("[data-proposition-progress]:not([data-ready])").forEach((root) => {
          root.dataset.ready = "true";
          const number = root.dataset.propositionNumber || "";
          const house = root.dataset.propositionHouse || "";
          const status = root.querySelector<HTMLElement>("[data-progress-status]");
          const summary = root.querySelector<HTMLElement>("[data-progress-summary]");
          const timeline = root.querySelector<HTMLElement>("[data-progress-timeline]");
          if (!number || !house || !status || !summary || !timeline) return;

          const renderUnavailable = () => {
            status.textContent = "Indisponível";
            summary.textContent = "Histórico de movimentações indisponível";
            timeline.classList.add("is-empty");
            timeline.replaceChildren(Object.assign(document.createElement("p"), { textContent: "Histórico de movimentações indisponível" }));
          };

          const renderEvents = (activity: Activity) => {
            if (!activity.events.length) {
              timeline.classList.add("is-empty");
              timeline.replaceChildren(Object.assign(document.createElement("p"), { textContent: "Ainda não há movimentações registradas." }));
              return;
            }

            const list = document.createElement("ol");
            list.className = "proposition-timeline__events";
            for (const event of activity.events) {
              const item = document.createElement("li");
              const destination = event.url || activity.tramitation_url;
              const card = document.createElement("a");
              card.className = "proposition-timeline__event-card";
              if (destination) {
                card.href = destination;
                card.target = "_blank";
                card.rel = "noopener noreferrer";
              }
              const header = document.createElement("header");
              const title = document.createElement("strong");
              title.textContent = event.title || event.situation || "Movimentação legislativa";
              const date = document.createElement("time");
              date.dateTime = event.event_at;
              date.textContent = formatEventDate(event.event_at);
              header.append(title, date);
              card.append(header);

              const description = event.description?.trim();
              if (description) {
                const copy = document.createElement("p");
                copy.textContent = description;
                card.append(copy);
              }
              item.append(card);
              list.append(item);
            }
            timeline.classList.remove("is-empty");
            timeline.replaceChildren(list);
          };

          const load = async () => {
            const isLocal = ["localhost", "127.0.0.1", "[::1]"].includes(location.hostname);
            const apiBase = isLocal ? `${location.origin}/api/v1` : PUBLIC_API_BASE_URL;
            const activityUrl = new URL(`${apiBase}/activity/by-number`);
            activityUrl.searchParams.set("house", house);
            activityUrl.searchParams.set("number_label", number);
            const activityResponse = await fetch(activityUrl);
            if (!activityResponse.ok) throw new Error(String(activityResponse.status));
            const activity = await activityResponse.json() as Activity;
            const presentation = celerityPresentation(activity.celerity);
            status.textContent = presentation.label;
            const summaryParts = presentation.summary.split(" em ");
            if (summaryParts.length === 2) {
              const connector = document.createElement("span");
              connector.textContent = "em";
              summary.replaceChildren(`${summaryParts[0]} `, connector, ` ${summaryParts[1]}`);
            } else {
              summary.textContent = presentation.summary;
            }
            renderEvents(activity);
          };

          const loadWhenVisible = () => {
            const startLoading = () => {
              status.textContent = "Carregando";
              summary.textContent = "Buscando movimentações oficiais";
              load().catch(renderUnavailable);
            };

            if (!("IntersectionObserver" in window)) {
              startLoading();
              return;
            }

            const observer = new IntersectionObserver((entries) => {
              if (!entries.some((entry) => entry.isIntersecting)) return;
              observer.disconnect();
              startLoading();
            }, { rootMargin: "240px 0px" });
            observer.observe(root);
          };

          loadWhenVisible();
        });
      };

      document.addEventListener("astro:page-load", initializePropositionProgress);
      initializePropositionProgress();
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "ETC Anybody";
    font-style: normal;
    font-weight: 50 1000;
    font-display: swap;
    src: url("/assets/fonts/ETCAnybodyVariable.woff2") format("woff2-variations");
  }

  .proposition-page,
  .proposition-page * { box-sizing: border-box; }
  .proposition-page { min-width: 320px; color: #0b0f5e; font-family: "Plus Jakarta Sans", sans-serif; }
  .proposition-page main { overflow: clip; }

  .proposition-hero {
    position: relative;
    height: 212px;
    overflow: hidden;
    background-color: #3838d9;
    background-image: var(--proposition-paper);
    background-blend-mode: multiply;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    color: #fff;
  }
  .proposition-hero > a {
    position: absolute;
    z-index: 1;
    top: 12px;
    left: 48px;
    color: #d0d0fd;
    font-size: 16px;
    font-weight: 700;
    line-height: 24px;
    text-decoration: none;
  }
  .proposition-hero > a:hover,
  .proposition-hero > a:focus-visible { color: #fff; text-decoration: underline; }
  .proposition-hero > div {
    position: absolute;
    top: 57.5px;
    left: 50%;
    display: flex;
    width: min(720px, calc(100% - 32px));
    transform: translateX(-50%);
    align-items: center;
    flex-direction: column;
  }
  .proposition-hero p,
  .proposition-hero h1 {
    margin: 0;
    font-family: "ETC Anybody", sans-serif;
    font-weight: 700;
    font-variation-settings: "wdth" 75;
    text-align: center;
    text-transform: uppercase;
  }
  .proposition-hero p { font-size: 24px; line-height: 32px; }
  .proposition-hero h1 { font-size: 72px; line-height: 72px; overflow-wrap: anywhere; }

  .proposition-overview {
    position: relative;
    border-top: 1px solid rgb(153 141 150 / 28%);
    background: #fff;
    box-shadow: 0 -2px 9.8px rgb(0 0 0 / 27%);
    padding: 88px 48px 40px;
  }
  .proposition-overview__paperclip {
    position: absolute;
    z-index: 2;
    top: -20.933px;
    left: max(42px, calc(50% - 678px));
    width: 46.213px;
    height: 84.412px;
    background: var(--proposition-paperclip) center / contain no-repeat;
    pointer-events: none;
  }
  .proposition-overview__grid {
    display: grid;
    width: min(1260px, 100%);
    margin: 0 auto;
    grid-template-columns: repeat(4, minmax(0, 300px));
    gap: 20px;
    align-items: start;
    justify-content: center;
  }
  .proposition-column { min-width: 0; }
  .proposition-column h2 {
    margin: 0 0 23px;
    color: #0b0f5e;
    font-family: "ETC Anybody", sans-serif;
    font-size: 32px;
    font-weight: 700;
    font-variation-settings: "wdth" 75;
    line-height: 32px;
    text-box-edge: cap alphabetic;
    text-box-trim: trim-both;
    text-transform: uppercase;
  }
  .proposition-summary > p {
    width: 268px;
    max-width: 100%;
    margin: 0 0 24px;
    color: #4b5563;
    font-size: 18px;
    font-weight: 400;
    line-height: 24px;
    white-space: pre-line;
  }
  .proposition-summary__links {
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: #4242f6;
    font-size: 18px;
    line-height: 24px;
  }
  .proposition-summary__links a { color: inherit; text-decoration: none; }
  .proposition-summary__links a:hover,
  .proposition-summary__links a:focus-visible { text-decoration: underline; }
  .proposition-summary__links span { color: #998d96; }

  .proposition-assessment { padding-top: 3px; }
  .proposition-assessment__value {
    display: flex;
    min-height: 32px;
    align-items: center;
    gap: 8px;
    color: #0b0f5e;
  }
  .proposition-assessment__value img { display: block; width: 32px; height: 32px; }
  .proposition-assessment__value strong {
    font-family: "ETC Anybody", sans-serif;
    font-size: 18px;
    font-weight: 700;
    font-variation-settings: "wdth" 75;
    line-height: 24px;
    text-transform: uppercase;
  }
  .proposition-assessment__value.is-unrated { color: #998d96; }
  .proposition-assessment__comment,
  .proposition-assessment__evaluator {
    margin: 16px 8px 0 0;
    color: #0b0f5e;
    font-size: 18px;
    line-height: 24px;
  }
  .proposition-assessment__evaluator { margin-top: 16px; }

  .proposition-authors__list {
    display: flex;
    padding: 8px 0;
    flex-direction: column;
    gap: 16px;
  }
  .proposition-author {
    display: flex;
    width: 100%;
    min-width: 0;
    align-items: flex-start;
    gap: 8px;
    color: #0b0f5e;
    text-decoration: none;
  }
  .proposition-author__photo,
  .proposition-author__fallback {
    display: grid;
    width: 30px;
    height: 40px;
    flex: 0 0 30px;
    border: 1px solid #998d96;
    place-items: center;
  }
  .proposition-author__photo { overflow: hidden; }
  .proposition-author__photo img,
  .proposition-author__photo .proposition-author__fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .proposition-author__photo .proposition-author__fallback[hidden] { display: none; }
  .proposition-author__fallback { background: #f1f1ff; color: #4242f6; font-size: 11px; font-weight: 700; }
  .proposition-author > span:last-child { display: flex; min-width: 0; flex-direction: column; }
  .proposition-author strong,
  .proposition-author small {
    font-size: 14px;
    font-weight: 400;
    line-height: 16px;
  }
  .proposition-author:hover strong,
  .proposition-author:focus-visible strong { color: #4242f6; text-decoration: underline; }
  .proposition-unavailable { margin: 0; color: #998d96; font-size: 18px; line-height: 24px; }

  .proposition-details {
    display: flex;
    min-height: 296px;
    padding: 23px;
    border: 1px solid rgb(66 66 246 / 25%);
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  .proposition-details__tag {
    display: inline-flex;
    min-height: 40px;
    padding: 5px 10px 3px;
    align-items: center;
    background: #4242f6;
    color: #fff;
    font-family: "ETC Anybody", sans-serif;
    font-size: 20px;
    font-weight: 700;
    font-variation-settings: "wdth" 75;
    line-height: 24px;
    text-transform: uppercase;
  }
  .proposition-details__body { width: 100%; color: #4b5563; font-size: 18px; line-height: 24px; }
  .proposition-details__body p { margin: 0 0 24px; }
  .proposition-details__body p:last-child { margin-bottom: 0; }
  .proposition-details__body p > span:first-child {
    display: block;
    color: #998d96;
    font-size: 14px;
    line-height: 16px;
  }
  .proposition-details__themes { display: flex; flex-wrap: wrap; gap: 0 5px; color: #4242f6; }

  .proposition-progress {
    width: 100%;
    padding: 100px 16px 40px;
    background: #fff;
  }
  .proposition-progress__bar {
    position: relative;
    display: flex;
    width: min(741px, 100%);
    height: 65px;
    margin: 0 auto;
    padding: 0 25px 0 20px;
    align-items: center;
    justify-content: space-between;
    background-color: #6262ff;
    background-image: var(--proposition-paper);
    background-blend-mode: multiply;
    background-position: center -70px;
    background-repeat: no-repeat;
    background-size: 741px auto;
  }
  .proposition-progress__bar h2 {
    position: absolute;
    top: -46px;
    left: 50%;
    margin: 0;
    transform: translateX(-50%);
    color: #1e2546;
    font-family: "ETC Anybody", sans-serif;
    font-size: 32px;
    font-weight: 700;
    font-variation-settings: "wdth" 75;
    line-height: 32px;
    text-align: center;
    text-box-edge: cap alphabetic;
    text-box-trim: trim-both;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .proposition-progress__status {
    position: relative;
    z-index: 0;
    display: flex;
    min-width: 118px;
    padding: 0 6px;
    height: 44px;
    align-items: center;
    justify-content: center;
    gap: 5px;
    color: #1e2546;
    font-size: 24px;
    font-weight: 500;
    line-height: 44px;
    white-space: nowrap;
  }
  .proposition-progress__status::before {
    position: absolute;
    z-index: -1;
    top: 0;
    right: -8px;
    left: -8px;
    height: 46px;
    background: var(--proposition-status-label) center / 100% 100% no-repeat;
    content: "";
  }
  .proposition-progress__status > span { font-size: 19px; line-height: 1; }
  .proposition-progress__summary {
    color: #fff;
    font-size: 18px;
    font-weight: 700;
    line-height: 24px;
    text-shadow: 1px 2px 1px rgb(0 0 0 / 20%);
  }
  .proposition-progress__summary > span { font-weight: 400; }
  .proposition-timeline {
    width: min(741px, 100%);
    min-height: 296px;
    margin: 0 auto;
    border: 2px solid #1e2546;
    background: #fff;
  }
