---
import { ClientRouter } from "astro:transitions";
import RedesignHeader from "../../../components/redesign/RedesignHeader.astro";
import RedesignFooter from "../../../components/redesign/RedesignFooter.astro";
import AuthorPage from "../../../components/redesign/AuthorPage.astro";
import {
    buildAuthorActivityFromApi,
    authorSlug,
    partyForTerm,
    type ApiParliamentarian,
    type ApiParty,
    type AuthorInitialData,
} from "../../../lib/author-page";
import { fetchActivity } from "../../../lib/activity-api";
import { API_BASE_URL } from "astro:env/server";
import "../../../styles/tailwind.css";

export async function getStaticPaths() {
    const activityData = await fetchActivity(API_BASE_URL);
    let directory: { parliamentarians: ApiParliamentarian[]; parties: ApiParty[] } = { parliamentarians: [], parties: [] };
    try {
        const apiBase = API_BASE_URL.replace(/\/$/, "");
        const apiJson = async <T>(url: string): Promise<T> => {
            const response = await fetch(url);
            if (!response.ok) throw new Error(`API ${response.status}: ${url}`);
            return response.json() as Promise<T>;
        };
        const [parliamentarians, parties] = await Promise.all([
            Promise.all(["camara", "senado"].map((house) => apiJson<{ items: ApiParliamentarian[] }>(`${apiBase}/legislatures/parliamentarians?house=${house}&limit=2000&offset=0`))),
            apiJson<{ items: ApiParty[] }>(`${apiBase}/legislatures/parties?limit=100&offset=0`),
        ]);
        directory = {
            parliamentarians: parliamentarians.flatMap((result) => result.items || []),
            parties: parties.items || [],
        };
    } catch (error) {
        console.warn("Não foi possível carregar o diretório de parlamentares durante o build:", error);
    }

    const authors = new Map<number, { name: string; party: string | null; state: string | null; gender: string | null; photoUrl: string | null; role: string | null; house: string }>();
    for (const proposition of activityData) {
        for (const author of proposition.authors) {
            if (author.id === null || authors.has(author.id)) continue;
            authors.set(author.id, {
                name: author.name,
                party: author.party,
                state: author.state,
                gender: author.gender,
                photoUrl: author.photo_url,
                role: author.role,
                house: proposition.house,
            });
        }
    }
    const paths = new Map<string, { params: { slug: string }; props: Props }>();
    for (const [authorId, author] of authors) {
        const slug = authorSlug(author.name);
        if (!slug || paths.has(slug)) continue;
        const activity = buildAuthorActivityFromApi(activityData, authorId);
        if (!activity) continue;
        const person = directory.parliamentarians.find((item) => item.id === authorId);
        const fallbackTerm = {
            id: null,
            parliamentarian: authorId,
            legislature_number: 0,
            party: 0,
            house: author.house,
            role: author.role || "Parlamentar",
            state: author.state || "",
            external_id: authorId,
            start_date: "",
            end_date: null,
        } as const;
        const term = person?.terms.find((item) => item.end_date === null) ?? person?.terms[0] ?? fallbackTerm;
        const initialPerson = person || {
            id: authorId,
            full_name: author.name,
            social_name: author.name,
            photo_url: author.photoUrl,
            gender: author.gender,
            birth_date: null,
            race: null,
            education: null,
            birthplace: null,
            profession: null,
            religion: null,
            bio: null,
            favorable_propositions_count: activity.favorable,
            unfavorable_propositions_count: activity.unfavorable,
            terms: [fallbackTerm],
        } satisfies ApiParliamentarian;
        const parties = person ? directory.parties : author.party ? [{ id: 0, acronym: author.party, name: author.party }] : [];
        paths.set(slug, {
            params: { slug },
            props: { authorId, house: author.role || "Parlamentar", initial: { person: initialPerson, term, parties, activity } },
        });
    }
    return [...paths.values()];
}

interface Props { authorId: number; house: string; initial: AuthorInitialData | null; }
const { authorId, house, initial } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="Consulte o perfil e a atividade legislativa desta pessoa parlamentar." />
        <title>Autoria | Atividade Legislativa | Elas no Congresso</title>
        <link rel="preload" href="/assets/fonts/ETCAnybodyVariable.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;700&display=swap" rel="stylesheet" />
        <ClientRouter fallback="swap" />
    </head>
    <body class="tw:!m-0 tw:!bg-white tw:!pt-0">
        <div class="author-route-page">
            <RedesignHeader />
            <AuthorPage authorId={authorId} house={house} initial={initial} />
            <RedesignFooter />
        </div>
    </body>
</html>

<style is:global>
    @font-face { font-family: "ETC Anybody"; font-style: normal; font-weight: 50 1000; font-display: swap; src: url("/assets/fonts/ETCAnybodyVariable.woff2") format("woff2-variations"); }
    body:has(.author-route-page) { margin: 0; background: #fff; }
    .author-route-page { min-width: 320px; overflow-x: clip; }
    .author-route-page .redesign-header, .author-route-page .redesign-header * { box-sizing: border-box; }
    .author-route-page .redesign-header .container-fluid { width: 100%; }.author-route-page .redesign-header .wrap { max-width: 1310px; }.author-route-page .redesign-header .ff1 { font-family: "ETC Anybody", sans-serif; }
</style>
