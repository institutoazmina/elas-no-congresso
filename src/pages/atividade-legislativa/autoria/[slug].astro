---
import PageLayout from "../../../layouts/PageLayout.astro";
import AuthorPage from "../../../components/activity/AuthorPage.astro";
import { getAuthorPaths, type AuthorPageProps } from "../../../lib/author-paths";
import { API_BASE_URL } from "astro:env/server";
import { PUBLIC_API_BASE_URL } from "astro:env/client";
import { withAuthorCacheKeys } from "../../../lib/author-build-cache";

export async function getStaticPaths() {
    return withAuthorCacheKeys(
        await getAuthorPaths(API_BASE_URL),
        JSON.stringify([import.meta.env.OG_IMAGE_BASE_URL || '', PUBLIC_API_BASE_URL]),
    );
}

type Props = AuthorPageProps;
const { authorId, house, initial } = Astro.props;
const name = initial.person.social_name || initial.person.full_name || initial.activity.author.name;
const title = `${name} | Atividade Legislativa | Elas no Congresso`;
const description = `Acompanhe a atuação de ${name} no Congresso Nacional e consulte suas propostas sobre gênero e direitos das mulheres e pessoas LGBTQIAPN+.`;
// Publicada pela API (elas-no-congresso-api, apps/og) direto no bucket, no mesmo caminho.
const ogImage = `${Astro.url.pathname.replace(/\/$/, "")}/og.png`;
---

<PageLayout title={title} description={description}
    ogType="profile"
    ogImage={{ src: ogImage, width: 1200, height: 630, alt: `Foto, partido, estado e favorabilidade de ${name}` }}
    pageClass="author-route-page tw:min-w-80 tw:overflow-x-clip tw:[body:has(&)]:bg-white tw:[body:has(&)]:m-0"
>
            <AuthorPage authorId={authorId} house={house} initial={initial} />
</PageLayout>
