---
import "../../../styles/tailwind.css";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Histórico da proposição | Elas no Congresso</title>
  </head>
  <body>
    <main class="proposition-history" data-proposition-history>
      <a class="proposition-history__back" href="/atividade-legislativa">Voltar ao painel</a>
      <p data-history-status>Carregando histórico legislativo...</p>
      <article data-history-content hidden>
        <header>
          <p data-house></p>
          <h1 data-number></h1>
          <p data-summary></p>
          <a data-source target="_blank" rel="noreferrer">Ver na fonte oficial</a>
        </header>
        <section aria-labelledby="history-title">
          <h2 id="history-title">Como está?</h2>
          <div class="proposition-history__celerity" data-celerity></div>
          <ol data-events></ol>
        </section>
      </article>
    </main>
    <script>
      const root = document.querySelector<HTMLElement>("[data-proposition-history]");
      const status = root?.querySelector<HTMLElement>("[data-history-status]");
      const content = root?.querySelector<HTMLElement>("[data-history-content]");
      const id = new URLSearchParams(window.location.search).get("id");
      const apiBase = (import.meta.env.PUBLIC_API_BASE_URL || "https://api.elasnocongresso.com.br/api/v1").replace(/\/$/, "");

      const formatDate = (value: string) => new Intl.DateTimeFormat("pt-BR").format(new Date(value));

      if (!id || !root || !status || !content) {
        if (status) status.textContent = "Proposição não informada.";
      } else {
        fetch(`${apiBase}/activity/${encodeURIComponent(id)}`)
          .then(async (response) => {
            if (!response.ok) throw new Error(String(response.status));
            return response.json();
          })
          .then((proposal) => {
            document.title = `${proposal.number_label} | Elas no Congresso`;
            root.querySelector<HTMLElement>("[data-house]")!.textContent = proposal.house === "senado" ? "Senado Federal" : "Câmara dos Deputados";
            root.querySelector<HTMLElement>("[data-number]")!.textContent = proposal.number_label;
            root.querySelector<HTMLElement>("[data-summary]")!.textContent = proposal.ementa;
            const source = root.querySelector<HTMLAnchorElement>("[data-source]")!;
            source.href = proposal.tramitation_url;

            const celerity = root.querySelector<HTMLElement>("[data-celerity]")!;
            celerity.classList.add(`is-${proposal.celerity.label.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().replaceAll(" ", "-")}`);
            const celerityLabel = document.createElement("strong");
            celerityLabel.textContent = proposal.celerity.label;
            const celerityMovements = document.createElement("span");
            celerityMovements.textContent = `${proposal.celerity.movements_last_90_days} movimentações em 3 meses`;
            const celerityInactivity = document.createElement("small");
            celerityInactivity.textContent = `${proposal.celerity.days_without_movement} dias desde a última movimentação`;
            celerity.replaceChildren(celerityLabel, celerityMovements, celerityInactivity);

            const events = root.querySelector<HTMLOListElement>("[data-events]")!;
            proposal.events.forEach((event: { event_at: string; committee_acronym?: string; committee_name?: string; title?: string; description?: string }) => {
              const entry = document.createElement("li");
              const eventHeader = document.createElement("header");
              const eventCommittee = document.createElement("strong");
              eventCommittee.textContent = event.committee_acronym || event.committee_name || "Congresso Nacional";
              const eventDate = document.createElement("time");
              eventDate.textContent = formatDate(event.event_at);
              const eventTitle = document.createElement("b");
              eventTitle.textContent = event.title || "Movimentação legislativa";
              const eventDescription = document.createElement("p");
              eventDescription.textContent = event.description || "Sem descrição disponível.";
              eventHeader.append(eventCommittee, eventDate);
              entry.append(eventHeader, eventTitle, eventDescription);
              events.append(entry);
            });
            status.hidden = true;
            content.hidden = false;
          })
          .catch(() => {
            status.textContent = "Não foi possível carregar o histórico desta proposição.";
          });
      }
    </script>
  </body>
</html>

<style>
  .proposition-history { width: min(100% - 32px, 720px); margin: 0 auto; padding: 40px 0 72px; color: #0b0f5e; font-family: "Plus Jakarta Sans", sans-serif; }
  .proposition-history__back, .proposition-history a { color: #4242f6; font-weight: 700; }
  .proposition-history article > header { margin-top: 32px; border-bottom: 2px solid #0b0f5e; padding-bottom: 24px; }
  .proposition-history article > header p:first-child { margin: 0; font-size: 14px; font-weight: 700; text-transform: uppercase; }
  .proposition-history h1, .proposition-history h2 { font-family: "ETC Anybody", sans-serif; font-variation-settings: "wdth" 75; text-transform: uppercase; }
  .proposition-history h1 { margin: 8px 0; font-size: clamp(32px, 7vw, 52px); line-height: 1; }
  .proposition-history h2 { margin: 40px 0 0; font-size: 28px; }
  .proposition-history__celerity { display: grid; margin-top: 12px; padding: 14px 16px; background: #4242f6; color: #fff; grid-template-columns: 1fr auto; gap: 2px 16px; }
  .proposition-history__celerity strong { font-family: "ETC Anybody", sans-serif; font-size: 20px; text-transform: uppercase; }
  .proposition-history__celerity small { grid-column: 1 / -1; opacity: .85; }
  .proposition-history__celerity.is-esquecida { background: #4a455c; }.proposition-history__celerity.is-travada { background: #8c5d49; }.proposition-history__celerity.is-lenta { background: #5c7c56; }.proposition-history__celerity.is-ta-voando { background: #ff5865; }
  .proposition-history ol { margin: 0; padding: 0; list-style: none; border: 1px solid #0b0f5e; }
  .proposition-history li { padding: 20px 16px; border-bottom: 1px solid #0b0f5e; }.proposition-history li:last-child { border-bottom: 0; }
  .proposition-history li header { display: flex; justify-content: space-between; gap: 12px; font-family: "ETC Anybody", sans-serif; font-size: 14px; font-variation-settings: "wdth" 75; text-transform: uppercase; }
  .proposition-history li b { display: block; margin-top: 14px; font-family: "ETC Anybody", sans-serif; font-size: 16px; text-transform: uppercase; }.proposition-history li p { margin: 8px 0 0; color: #62628f; line-height: 1.5; }
</style>
