---
import PageLayout from "../layouts/PageLayout.astro";
import attention from "../assets/images/activity/attention.svg";
import halftoneShadow from "../assets/images/hero/halftone-shadow.png";
import { Image } from "astro:assets";
import { getFeministAIPage } from "../service/api/cms";

const cms = await getFeministAIPage();
const c = cms.content;
const { images, limitations, open_links } = cms;
const categories = cms.categories.map(({ name, concept }) => [name, concept] as const);
const metrics = cms.evaluation_metrics.map(({ label, url, ...rest }) => {
    const linkedLabel = label.replace(/ Índice [01]$/, "");
    return { ...rest, label: linkedLabel, suffix: label.slice(linkedLabel.length), href: url };
});
const thematicMetrics = cms.thematic_metrics.map(({ label, value }) => [label, value] as const);
const thematicPartitions = cms.thematic_partitions.map(
    ({ label, training, validation, test }) => [label, training, validation, test] as const,
);
const limitationParts = c.limitations_heading.match(/^(.*)\s+(\S+\s+\S+)$/);
