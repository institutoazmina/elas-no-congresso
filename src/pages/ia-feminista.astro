<PageLayout title="IA Feminista | Elas no Congresso" fontVariant="italic"
    pageClass="ia-page ia-feminista-page tw:text-ink tw:font-sans tw:text-lg tw:leading-[30px]  tw:[&_h1]:font-display tw:[&_h1]:font-bold tw:[&_h1]:[font-variation-settings:'wdth'_75] tw:[&_h1]:uppercase tw:[&_h2]:font-display tw:[&_h2]:font-bold tw:[&_h2]:[font-variation-settings:'wdth'_75] tw:[&_h2]:uppercase tw:[&_h3]:font-display tw:[&_h3]:font-bold tw:[&_h3]:[font-variation-settings:'wdth'_75] tw:[&_h3]:uppercase tw:[&_h4]:font-display tw:[&_h4]:font-bold tw:[&_h4]:[font-variation-settings:'wdth'_75] tw:[&_h4]:uppercase tw:max-md:[&_.ia-wide_h3]:text-[28px] tw:max-md:[&_.ia-wide_h3]:leading-8 tw:max-md:[&_.ia-wide_h3]:pt-[14px] tw:max-md:[&_.ia-wide_h3]:m-0"
>
            <main>
                <section
                    class="ia-hero site-shared-background tw:flex tw:items-start tw:justify-start tw:min-h-113 tw:flex-col tw:h-125 tw:overflow-hidden tw:relative tw:p-0 tw:[&_h1]:text-7xl tw:[&_h1]:leading-18 tw:[&_h1]:[font-variation-settings:'wdth'_75] tw:[&_h1]:text-ink tw:[&_h1]:font-bold tw:[&_h1]:tracking-normal tw:[&_h1]:mix-blend-multiply tw:[&_h1]:whitespace-nowrap tw:[&_h1]:w-[682px] tw:[&_h1]:m-0 tw:[&_p]:font-bold tw:[&_p]:leading-6 tw:[&_p]:w-160 tw:max-[901px]:flex-col tw:max-[901px]:items-start tw:max-[901px]:h-152.5 tw:max-[901px]:py-12 tw:max-[901px]:px-6 tw:max-[901px]:[&_p]:w-full tw:max-[901px]:[&_h1]:text-[52px] tw:max-[901px]:[&_h1]:leading-[56px] tw:max-[901px]:[&_h1]:w-full tw:max-[901px]:[&_h1]:whitespace-normal tw:max-[561px]:[&_h1]:text-[40px] tw:max-[561px]:[&_h1]:leading-[44px] tw:max-md:h-auto tw:max-md:min-h-0 tw:max-md:overflow-hidden tw:max-md:justify-start tw:max-md:pt-6 tw:max-md:pb-12 tw:max-md:px-6 tw:[&_i]:h-2 tw:[&_i]:mb-6 tw:bg-white tw:bg-[url('/assets/images/background/bg-pattern-rough-paper.png')] tw:bg-top tw:bg-repeat tw:bg-size-[400px_400px]"
                    data-page-hero
                    aria-labelledby="ia-hero-title"
                    style={`--ia-hero-halftone-shadow: url(${halftoneShadow})`}
                >
                    <div class="ia-hero__top-row tw:items-center tw:flex tw:flex-[0_0_476px] tw:h-119 tw:justify-between tw:w-full tw:z-2 tw:relative tw:p-12 tw:max-[901px]:basis-146.5 tw:max-[901px]:h-146.5 tw:max-[901px]:w-full tw:max-md:flex-none tw:max-md:h-auto tw:max-md:flex-col tw:max-md:items-start tw:max-md:justify-start tw:max-md:gap-3 tw:max-md:p-0">
                        <div class="ia-hero__copy tw:items-start tw:flex tw:flex-none tw:flex-col tw:gap-6 tw:justify-center tw:max-w-240 tw:min-w-0 tw:w-[682px] tw:[&>p]:text-ink tw:[&>p]:font-sans tw:[&>p]:text-lg tw:[&>p]:font-medium tw:[&>p]:tracking-normal tw:[&>p]:leading-6 tw:[&>p]:mix-blend-multiply tw:[&>p]:w-160 tw:[&>p]:m-0 tw:max-[901px]:w-full tw:max-[901px]:[&>p]:w-full tw:max-md:w-full tw:max-md:max-w-full tw:max-md:gap-3">
                            <img
                                class="ia-hero__attention tw:block tw:h-2 tw:w-24 tw:max-md:w-8 tw:max-md:h-1 tw:max-md:m-0"
                                src={attention}
                                alt=""
                            />
                            <h1 class="tw:max-md:text-[32px]! tw:max-md:leading-8! tw:max-md:w-full tw:max-md:max-w-60 tw:max-md:whitespace-normal" id="ia-hero-title">
                                <span class="hero__title-narrow tw:[font-variation-settings:'wdth'_60] tw:font-normal">
                                    Quem foi{" "}
                                </span>
                                <strong class="tw:[font-variation-settings:'wdth'_75] tw:max-md:whitespace-nowrap">Maria Quitéria?</strong>
                            </h1>
                            <p class="tw:max-md:max-w-80 tw:max-md:w-full tw:max-md:text-lg tw:max-md:font-medium tw:max-md:leading-6 tw:max-md:pt-[6px] tw:max-md:pb-0">
                                O nome da ferramenta homenageia a heroína baiana
                                Maria Quitéria de Jesus (1792–1853), primeira
                                mulher a integrar o Exército Brasileiro. Em
                                1822, ela se apresentou como homem, sob o
                                pseudônimo "Soldado Medeiros", para lutar na
                                Guerra de Independência do Brasil na Bahia. A
                                QuitérIA carrega esse legado de coragem e
                                resistência para o combate à opacidade
                                legislativa.
                            </p>
                        </div>
                        <div class="ia-hero__art tw:items-center tw:flex tw:flex-none tw:h-95 tw:justify-center tw:absolute tw:w-145 tw:bottom-6 tw:overflow-visible tw:right-12 tw:p-2.5 tw:max-md:hidden">
                            <div class="ia-hero__illustration tw:h-auto tw:w-125">
                                <div class="ia-hero__illustration-inner tw:h-125 tw:absolute tw:-bottom-12.5 tw:right-[30%] tw:w-auto tw:[&>img]:object-contain tw:[&>img]:h-full tw:[&>img]:w-auto">
                                    <img
                                        src={heroIllustration}
                                        alt="Ilustração de Maria Quitéria"
                                    />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="ia-hero__shadow tw:bottom-0 tw:flex-[0_0_24px] tw:h-6 tw:left-0 tw:absolute tw:w-full tw:z-3 tw:bg-[image:var(--ia-hero-halftone-shadow)] tw:bg-bottom-left tw:bg-repeat-x tw:bg-size-[1440px_24px] tw:block tw:mix-blend-multiply tw:pointer-events-none tw:max-[901px]:basis-6 tw:max-md:absolute tw:max-md:bottom-0 tw:max-md:left-0 tw:max-md:h-6 tw:max-md:w-full" aria-hidden="true"></div>
                </section>
                <section class="ia-section ia-differential tw:flex tw:flex-col tw:gap-7 tw:py-16 tw:px-12 tw:[&_h2]:text-4xl tw:[&_h2]:leading-[42px] tw:[&_h2]:m-0 tw:max-[901px]:py-12 tw:max-[901px]:px-6 tw:max-md:gap-[28px] tw:max-md:py-16 tw:max-md:px-6 tw:[&:has(>_.ia-wide)]:gap-[28px] tw:[&:has(>_.ia-wide)_>_.ia-wide]:contents tw:[&:has(>_.ia-wide)_.ia-wide_h3]:self-stretch tw:[&:has(>_.ia-wide)_.ia-wide_h3]:font-display tw:[&:has(>_.ia-wide)_.ia-wide_h3]:text-[28px] tw:[&:has(>_.ia-wide)_.ia-wide_h3]:not-italic tw:[&:has(>_.ia-wide)_.ia-wide_h3]:font-bold tw:[&:has(>_.ia-wide)_.ia-wide_h3]:[font-variation-settings:'wdth'_75] tw:[&:has(>_.ia-wide)_.ia-wide_h3]:leading-8 tw:[&:has(>_.ia-wide)_.ia-wide_h3]:uppercase tw:[&:has(>_.ia-wide)_.ia-wide_h3]:w-full tw:[&:has(>_.ia-wide)_.ia-wide_h3]:pt-[14px] tw:[&:has(>_.ia-wide)_.ia-wide_h3]:pb-0 tw:[&:has(>_.ia-wide)_.ia-wide_h3]:px-0 tw:[&:has(>_.ia-wide)_.ia-wide_h3]:m-0 tw:[&:has(>_.ia-wide)_.ia-wide_table]:w-336 tw:[&:has(>_.ia-wide)_.ia-wide_table]:mt-[6px] tw:[&:has(>_.ia-wide)_.ia-wide_table]:mb-0 tw:[&:has(>_.ia-wide)_.ia-wide_table]:mx-auto tw:[&:has(>_.ia-wide)_.ia-wide_>_table_>_thead_th]:text-[var(--Arapawa,_var(--color-blue-21,_#0b0f5e))] tw:[&:has(>_.ia-wide)_.ia-wide_>_table_>_thead_th]:font-display tw:[&:has(>_.ia-wide)_.ia-wide_>_table_>_thead_th]:text-lg tw:[&:has(>_.ia-wide)_.ia-wide_>_table_>_thead_th]:not-italic tw:[&:has(>_.ia-wide)_.ia-wide_>_table_>_thead_th]:font-light tw:[&:has(>_.ia-wide)_.ia-wide_>_table_>_thead_th]:[font-variation-settings:'wdth'_100] tw:[&:has(>_.ia-wide)_.ia-wide_>_table_>_thead_th]:tracking-normal tw:[&:has(>_.ia-wide)_.ia-wide_>_table_>_thead_th]:leading-normal tw:[&:has(>_.ia-wide)_.ia-wide_>_table_>_thead_th]:uppercase">
                    <header class="tw:w-205 tw:m-auto tw:max-[901px]:w-full tw:max-md:w-full tw:max-md:m-0">
                        <i class="tw:block tw:w-24 tw:h-1 tw:bg-ink tw:mb-4"></i>
                        <h2 class="tw:max-md:text-4xl tw:max-md:leading-[42px]">Diferencial tecnológico</h2>
                    </header>
                    <div class="ia-narrow tw:w-205 tw:flex tw:flex-col tw:gap-[20px] tw:m-auto tw:[&_h3]:text-[32px] tw:[&_h3]:leading-8 tw:[&_h3]:m-0 tw:max-md:[&_h3]:text-[28px] tw:[&_h5]:text-lg tw:[&_h5]:leading-[30px] tw:[&_h5]:mt-0 tw:[&_h5]:mb-1 tw:[&_h5]:mx-0 tw:[&_a]:text-accent tw:[&_a]:font-normal tw:[&_a]:no-underline tw:max-[901px]:w-full tw:min-[901px]:contents tw:max-md:w-full tw:max-md:gap-[20px] tw:max-md:m-0 tw:[&_li:before]:[content:'→'] tw:[&_li:before]:absolute tw:[&_li:before]:left-0 tw:[.ia-section:has(>_.ia-wide)_>_&]:h-102 tw:max-[901px]:[.ia-section:has(>_.ia-wide)_>_&]:h-auto">
                        <div class="ia-differential__content tw:min-[901px]:flex tw:min-[901px]:flex-col tw:min-[901px]:gap-[20px] tw:min-[901px]:w-205 tw:min-[901px]:my-0 tw:min-[901px]:mx-auto tw:min-[901px]:[&>p]:leading-6 tw:contents tw:max-md:flex tw:max-md:flex-col tw:max-md:gap-[20px] tw:max-md:w-full">
                            <p class="tw:max-md:text-lg! tw:max-md:leading-6">
                                Diferente das IAs genéricas, treinadas com dados
                                indeterminados da internet, a QuitérIA parte de
                                um modelo de linguagem pré-treinado em português
                                brasileiro (BERTimbau Base), com ajuste fino
                                sobre um dataset construído ao longo de anos de
                                avaliação humana de projetos de lei sensíveis a
                                gênero na Câmara e no Senado.
                            </p>
                            <p class="tw:max-md:text-lg! tw:max-md:leading-6">
                                O foco estratégico está no Processamento de
                                Linguagem Natural (PLN) aplicado tanto às
                                ementas quanto ao inteiro teor das matérias,
                                priorizando eixos como violência de gênero,
                                direitos sexuais e reprodutivos e igualdade no
                                trabalho.
                            </p>
                            <p class="tw:max-md:text-lg! tw:max-md:leading-6">
                                A escolha por modelos compactos e
                                especializados, em vez de Large Language Models
                                (LLMs), alia eficiência e soberania tecnológica:
                                consomem significativamente menos energia e
                                poder computacional, garantem maior autonomia
                                operacional e facilitam futuros retreinamentos.
                            </p>
                            <h3 class="ia-flow__eyebrow tw:min-[901px]:text-[28px]! tw:min-[901px]:leading-8! tw:min-[901px]:pt-[14px] tw:min-[901px]:m-0! tw:max-md:text-[28px]! tw:max-md:leading-8! tw:max-md:pt-[14px] tw:max-md:m-0!">Veja como funciona</h3>
                            <div class="ia-flow ia-flow--desktop tw:w-full tw:max-md:hidden">
                                <img class="tw:block tw:h-auto tw:max-w-full tw:w-205 tw:my-0 tw:mx-auto"
                                    src={fluxoProcessamento}
                                    alt="Fluxo de processamento da QuitérIA em cinco etapas"
                                />
                            </div>
                            <div class="ia-flow ia-flow--mobile tw:w-full tw:hidden tw:max-md:flex tw:max-md:w-83 tw:max-md:max-w-[calc(100vw_-_44px)] tw:max-md:mx-auto tw:max-md:bg-white tw:max-md:flex-col tw:max-md:justify-center tw:max-md:items-center tw:max-md:overflow-hidden tw:max-md:pt-10">
                                <img class="tw:block tw:h-auto tw:max-w-full tw:w-205 tw:my-0 tw:mx-auto tw:max-md:w-full tw:max-md:h-auto tw:max-md:block tw:max-md:m-0"
                                    src={fluxoProcessamentoMobile}
                                    width={524}
                                    height={574}
                                    style={`max-width:${524}px`}
                                    alt="Fluxo de processamento da QuitérIA em cinco etapas"
                                />
                            </div>
                        </div>
                        <header class="tw:w-205 tw:m-auto tw:max-[901px]:w-full tw:max-md:w-full tw:max-md:m-0">
                            <h3 class="ia-architecture__title tw:min-[901px]:text-[32px] tw:min-[901px]:leading-8 tw:min-[901px]:mb-0 tw:min-[901px]:mt-0 tw:min-[901px]:min-h-10 tw:min-[901px]:pt-3 tw:max-md:text-[32px] tw:max-md:leading-8 tw:max-md:pt-[14px] tw:max-md:m-0">
                                Arquitetura dos modelos
                            </h3>
                        </header>
                        <div class="ia-cards ia-architecture__cards tw:flex tw:gap-6 tw:pt-1 tw:[&_h4]:text-2xl tw:[&_h4]:leading-8 tw:[&_h4]:m-0 tw:[&_p]:text-base tw:[&_p]:leading-6 tw:[&_p]:mt-3.5 tw:[&_b]:font-display tw:[&_b]:[font-variation-settings:'wdth'_75] tw:[&_b]:text-lg tw:[&_b]:leading-6 tw:[&_b]:mt-auto tw:[&_b]:uppercase tw:[&_small]:text-muted tw:[&_small]:text-sm tw:[&_small]:leading-[24px] tw:max-[901px]:flex-col tw:ml-auto tw:mr-auto tw:max-w-205 tw:w-full tw:min-[901px]:h-[272px] tw:min-[901px]:pt-1 tw:max-md:flex-col tw:max-md:gap-6 tw:max-md:w-full tw:max-md:max-w-83 tw:max-md:pt-1 tw:max-md:my-0 tw:max-md:mx-auto">
                            <article class="tw:border-[2px] tw:border-solid tw:border-ink tw:flex-1 tw:min-h-[256px] tw:flex tw:flex-col tw:py-7.5 tw:px-6.5 tw:min-[901px]:h-[268px] tw:min-[901px]:min-h-0 tw:max-md:w-full tw:max-md:min-h-0 tw:max-md:h-auto">
                                <h4>Modelo de Desfavorabilidade</h4>
                                <p class="tw:max-md:text-lg! tw:max-md:leading-6">
                                    Principal modelo da ferramenta. Baseado no
                                    BERTimbau Base, adaptado ao português
                                    brasileiro, com uma camada adicional de
                                    classificação para ajuste fino.
                                </p>
                                <b>87% de acurácia</b>
                                <small>
                                    na avaliação de matérias de gênero
                                </small>
                            </article>
