---
import PageLayout from "../layouts/PageLayout.astro";
import PageHero from "../components/shared/PageHero.astro";
import { renderMarkdown, splitMarkdownSections } from "../lib/markdown";
import { getFeministAIPage } from "../service/api/cms";

const page = await getFeministAIPage();
const sections = splitMarkdownSections(page.content);
---

<PageLayout
    title={page.seo_title}
    description={page.seo_description}
    fontVariant="italic"
    pageClass="ia-feminista-page tw:text-ink tw:font-sans"
>
    <main class="markdown-page">
        <PageHero content={page.hero} />

        {sections.map((section, index) => (
            <section class:list={["markdown-section", { "markdown-section--tinted": index % 2 === 1 }]}>
                <div class="markdown-content" set:html={renderMarkdown(section)} />
            </section>
        ))}
    </main>
</PageLayout>
