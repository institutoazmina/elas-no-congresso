---
import siteIcon from "../assets/images/site-icon.png";
import defaultOgImage from "../assets/images/og-default.png";
import { ClientRouter } from "astro:transitions";
import "../styles/tailwind.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

interface Props {
    title: string;
    description?: string;
    canonical?: string;
    noindex?: boolean;
    ogImage?: { src: string | URL; width: number; height: number; alt: string };
    ogType?: "website" | "profile";
    htmlClass?: string;
    bodyClass?: string;
    pageClass?: string;
    pageStyle?: string;
    fontVariant?: "default" | "medium" | "editorial" | "italic";
}

const {
    title,
    description,
    canonical,
    noindex = false,
    ogImage = { ...defaultOgImage, alt: "Elas no Congresso" },
    ogType = "website",
    htmlClass,
    bodyClass,
    pageClass,
    pageStyle,
    fontVariant = "default",
} = Astro.props;

// Images must resolve on the deployed host, which may differ from the canonical site.
const ogImageUrl = new URL(ogImage.src, import.meta.env.OG_IMAGE_BASE_URL || Astro.site || Astro.url);
const pageUrl = canonical ?? new URL(Astro.url.pathname, Astro.site ?? Astro.url);

// Preserve the weights used by each page while sharing font loading and preconnects.
const fontVariants = {
    default: "wght@400;700",
    medium: "wght@400;500;700",
    editorial: "wght@400;500;700;800",
    italic: "ital,wght@0,400;0,700;1,400",
};
const fontUrl = `https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:${fontVariants[fontVariant]}&display=swap`;
---

<!doctype html>
<html lang="pt-BR" class={htmlClass}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        {canonical && <link rel="canonical" href={canonical} />}
        {description && <meta name="description" content={description} />}
        {noindex && <meta name="robots" content="noindex" />}
        <meta property="og:type" content={ogType} />
        <meta property="og:site_name" content="Elas no Congresso" />
        <meta property="og:title" content={title} />
        {description && <meta property="og:description" content={description} />}
        <meta property="og:url" content={pageUrl} />
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content={String(ogImage.width)} />
        <meta property="og:image:height" content={String(ogImage.height)} />
        <meta property="og:image:alt" content={ogImage.alt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        {description && <meta name="twitter:description" content={description} />}
        <meta name="twitter:image" content={ogImageUrl} />
        <meta name="twitter:image:alt" content={ogImage.alt} />
        <link rel="icon" type="image/png" href={siteIcon.src} />
        <link rel="preload" href="/assets/fonts/ETCAnybodyVariable.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href={fontUrl} rel="stylesheet" />
        <ClientRouter fallback="swap" />
        <!-- Google tag (gtag.js) -->
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-SV7MEGERHL"></script>
        <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', 'G-SV7MEGERHL');
        </script>
        <slot name="head" />
    </head>
    <body class:list={["tw:m-0! tw:pt-0! tw:bg-white!", bodyClass]}>
        <div class={pageClass} style={pageStyle}>
            <Header />
            <slot />
            <Footer />
        </div>
        <slot name="scripts" />
    </body>
</html>
