# Base da API consumida no build (sem barra no fim).
# Sem .env o build usa este mesmo valor, definido como default em astro.config.mjs.
API_BASE_URL=https://api.elasnocongresso.com.br/api/v1

# Mesma API, mas embutida no bundle do browser: o modal de alertas faz POST em
# runtime. A origem do site precisa estar em CORS_ALLOWED_ORIGINS lá na API.
PUBLIC_API_BASE_URL=https://api.elasnocongresso.com.br/api/v1

# Optional deployed origin for OG images when different from the canonical site.
# OG_IMAGE_BASE_URL=https://homologacao.elasnocongresso.com.br
